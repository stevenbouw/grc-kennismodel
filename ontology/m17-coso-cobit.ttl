@prefix fw:      <https://grc.example.org/framework/> .
@prefix ctrl:    <https://grc.example.org/control/> .
@prefix risk:    <https://grc.example.org/risk/> .
@prefix roles:   <https://grc.example.org/roles/> .
@prefix compl:   <https://grc.example.org/compliance/> .
@prefix isms:    <https://grc.example.org/isms/> .
@prefix biz:     <https://grc.example.org/business/> .
@prefix bio:     <https://grc.example.org/bio/> .
@prefix ext:     <https://grc.example.org/extended/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix csf:     <https://grc.example.org/csf/> .

# =============================================================================
# GRC Ontologie — Module M17: COSO ICF/ERM + COBIT 2019 (geconsolideerd)
# Versie: 4.0.0-alpha | Datum: 2026-03-19 | Profiel: OWL 2 DL
#
# Ontwerpbeslissing D10: COSO ICF en COSO ERM als enterprise-governance-laag
# boven COBIT. Hiërarchie: COSO (enterprise) → COBIT (IT-governance) →
# BIO 2.0/ISO 27001 (IB) → ISO 27002/NIST (technische maatregelen).
#
# Dit bestand VERVANGT m-cobit-interim.ttl en bevat:
# - ext:FrameworkComponent TBox (herbruikbaar patroon)
# - ext:COSOComponent + ext:COBITObjective (gecorrigeerd: niet meer subClassOf fw:GRCFramework)
# - ext:isComponentOf (vervangt compl:derivedFrom voor component→framework relaties)
# - fw:COSO_ICF en fw:COSO_ERM als fw:BestPractice individuals
# - 10 COSO-componenten (5 ICF + 5 ERM)
# - 8 COBIT-objectives (gemigreerd uit m-cobit-interim.ttl)
# - Governance-hiërarchie relaties: COBIT → COSO, ISO → COSO
#
# Bron: COSO Internal Control — Integrated Framework (2013)
#       COSO Enterprise Risk Management — Integrating with Strategy
#       and Performance (2017)
#       COBIT 2019 Framework: Introduction and Methodology (ISACA)
# =============================================================================

<https://grc.example.org/ontology/m17-coso-cobit>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M17 — COSO ICF/ERM + COBIT 2019"@nl ;
    rdfs:comment "Enterprise-governance-laag (D10): COSO ICF en ERM met componenten, COBIT 2019 objectives, en governance-hiërarchie relaties."@nl ;
    owl:imports <https://grc.example.org/ontology/> .

# =============================================================================
# SECTIE 1 — TBOX: FRAMEWORK COMPONENT PATROON (herbruikbaar)
# =============================================================================

ext:FrameworkComponent
    rdf:type owl:Class ;
    rdfs:label "Framework Component"@en , "Kaderwerkcomponent"@nl ;
    rdfs:comment
        "A structural element within a GRC framework, such as a COSO component, COBIT objective, or NIST CSF function. Distinguished from fw:GRCFramework: a component is part of a framework, not a framework itself."@en ,
        "Een structureel element binnen een GRC-kaderwerk, zoals een COSO-component, COBIT-doelstelling of NIST CSF-functie. Onderscheiden van fw:GRCFramework: een component is onderdeel van een kaderwerk, niet zelf een kaderwerk."@nl .

ext:COSOComponent
    rdf:type owl:Class ;
    rdfs:subClassOf ext:FrameworkComponent ;
    rdfs:label "COSO Component"@en , "COSO-component"@nl ;
    rdfs:comment
        "A component of the COSO Internal Control or Enterprise Risk Management framework."@en ,
        "Een component van het COSO Internal Control of Enterprise Risk Management framework."@nl .

ext:COBITObjective
    rdf:type owl:Class ;
    rdfs:subClassOf ext:FrameworkComponent ;
    rdfs:label "COBIT 2019 Governance/Management Objective"@en ,
               "COBIT 2019 Governance/Beheersdoelstelling"@nl ;
    rdfs:comment
        "One of the 40 COBIT 2019 governance or management objectives (ISACA). Corrected from v3: no longer rdfs:subClassOf fw:GRCFramework (a COBIT objective is not a framework)."@en ,
        "Één van de 40 COBIT 2019 governance- of beheersdoelstellingen (ISACA). Gecorrigeerd t.o.v. v3: niet langer rdfs:subClassOf fw:GRCFramework (een COBIT-doelstelling is geen kaderwerk)."@nl .

# =============================================================================
# SECTIE 2 — TBOX: PROPERTIES
# =============================================================================

ext:isComponentOf
    rdf:type owl:ObjectProperty ;
    rdfs:domain ext:FrameworkComponent ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "is component of"@en , "is component van"@nl ;
    rdfs:comment
        "Links a framework component to the framework it belongs to. Standard property for component-framework relationships, replacing ad-hoc use of compl:derivedFrom for this purpose."@en ,
        "Koppelt een kaderwerkcomponent aan het kaderwerk waartoe het behoort. Standaard-property voor component-framework relaties, vervangt ad-hoc gebruik van compl:derivedFrom voor dit doel."@nl .

fw:geeftITInvullingAan
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "provides IT implementation of"@en , "geeft IT-invulling aan"@nl ;
    rdfs:comment
        "Indicates that the subject framework provides the IT-specific implementation or operationalisation of the (broader, enterprise-level) object framework. E.g. COBIT fw:geeftITInvullingAan COSO ICF."@en ,
        "Geeft aan dat het subject-framework de IT-specifieke invulling of operationalisatie biedt van het (bredere, enterprise-level) object-framework. Bijv. COBIT fw:geeftITInvullingAan COSO ICF."@nl .

# Existing COBIT properties (retained from interim module)
ext:cobitDomain
    rdf:type owl:DatatypeProperty ;
    rdfs:domain ext:COBITObjective ;
    rdfs:range xsd:string ;
    rdfs:label "COBIT domain"@en , "COBIT-domein (EDM/APO/BAI/DSS/MEA)"@nl .

ext:cobitObjectiveID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain ext:COBITObjective ;
    rdfs:range xsd:string ;
    rdfs:label "COBIT objective ID"@en , "COBIT-doelstellingscode"@nl .

# =============================================================================
# SECTIE 3 — ABOX: ISSUING BODY
# =============================================================================

fw:COSO
    rdf:type fw:IssuingBody ;
    rdfs:label "COSO (Committee of Sponsoring Organizations of the Treadway Commission)"@en ,
               "COSO (Committee of Sponsoring Organizations of the Treadway Commission)"@nl ;
    rdfs:comment
        "COSO is a joint initiative of five private-sector organisations dedicated to providing thought leadership through the development of comprehensive frameworks for enterprise risk management, internal control, and fraud deterrence."@en ,
        "COSO is een gezamenlijk initiatief van vijf private-sector organisaties gericht op thought leadership door de ontwikkeling van frameworks voor enterprise risk management, interne beheersing en fraudepreventie."@nl ;
    foaf:name "COSO" .

# =============================================================================
# SECTIE 4 — ABOX: COSO FRAMEWORK INDIVIDUALS
# =============================================================================

fw:COSO_ICF
    rdf:type fw:BestPractice ;
    rdfs:label "COSO Internal Control — Integrated Framework (2013)"@en ,
               "COSO Interne Beheersing — Geïntegreerd Raamwerk (2013)"@nl ;
    rdfs:comment
        "Enterprise-wide framework for internal control. Defines five components: Control Environment, Risk Assessment, Control Activities, Information & Communication, and Monitoring Activities. Provides the foundation that COBIT operationalises for the IT domain."@en ,
        "Organisatiebreed raamwerk voor interne beheersing. Definieert vijf componenten: Beheersomgeving, Risicobeoordeling, Beheersingsactiviteiten, Informatie & Communicatie, en Monitoringactiviteiten. Vormt het fundament dat COBIT voor het IT-domein operationaliseert."@nl ;
    fw:hasIdentifier "COSO-ICF-2013" ;
    fw:hasVersionLabel "2013" ;
    fw:hasPublicationDate "2013-05-14"^^xsd:date ;
    fw:isMandatoryForDutchGovernment "false"^^xsd:boolean ;
    fw:issuedBy fw:COSO ;
    fw:appliesInJurisdiction fw:JurisdictionInternational ;
    fw:hasDomain fw:DomainITGovernance , fw:DomainCompliance .

fw:COSO_ERM
    rdf:type fw:BestPractice ;
    rdfs:label "COSO Enterprise Risk Management — Integrating with Strategy and Performance (2017)"@en ,
               "COSO Enterprise Risk Management — Integratie met Strategie en Prestatie (2017)"@nl ;
    rdfs:comment
        "Enterprise-wide framework for risk management. Defines five components: Governance & Culture, Strategy & Objective-Setting, Performance, Review & Revision, and Information Communication & Reporting. Provides the enterprise risk context that ISO 27005/ISO 31000 operationalise for information security risk."@en ,
        "Organisatiebreed raamwerk voor risicomanagement. Definieert vijf componenten: Governance & Cultuur, Strategie & Doelstelling, Prestatie, Evaluatie & Revisie, en Informatie Communicatie & Rapportage. Biedt de enterprise-risicocontext die ISO 27005/ISO 31000 voor informatiebeveiligingsrisico operationaliseren."@nl ;
    fw:hasIdentifier "COSO-ERM-2017" ;
    fw:hasVersionLabel "2017" ;
    fw:hasPublicationDate "2017-09-06"^^xsd:date ;
    fw:isMandatoryForDutchGovernment "false"^^xsd:boolean ;
    fw:issuedBy fw:COSO ;
    fw:appliesInJurisdiction fw:JurisdictionInternational ;
    fw:hasDomain fw:DomainRiskManagement .

# =============================================================================
# SECTIE 5 — ABOX: COSO ICF COMPONENTEN (5)
# =============================================================================

ext:COSO_ICF_ControlEnvironment
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Control Environment"@en , "Beheersomgeving"@nl ;
    rdfs:comment "De set normen, processen en structuren die de basis vormen voor interne beheersing in de organisatie. Omvat integriteit, ethische waarden, governance-structuur, toewijzing van autoriteit en verantwoordelijkheid, en HR-beleid."@nl ;
    ext:isComponentOf fw:COSO_ICF .

ext:COSO_ICF_RiskAssessment
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Risk Assessment"@en , "Risicobeoordeling"@nl ;
    rdfs:comment "Het dynamische en iteratieve proces voor het identificeren en analyseren van risico's die het bereiken van doelstellingen bedreigen. Vormt de basis voor het bepalen hoe risico's moeten worden beheerst."@nl ;
    ext:isComponentOf fw:COSO_ICF .

ext:COSO_ICF_ControlActivities
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Control Activities"@en , "Beheersingsactiviteiten"@nl ;
    rdfs:comment "De acties die worden vastgelegd door beleid en procedures om ervoor te zorgen dat de richtlijnen van het management voor risicobeheersing worden uitgevoerd. Omvat preventieve en detectieve maatregelen op alle niveaus."@nl ;
    ext:isComponentOf fw:COSO_ICF .

ext:COSO_ICF_InformationCommunication
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Information & Communication"@en , "Informatie & Communicatie"@nl ;
    rdfs:comment "De informatie die de organisatie nodig heeft om haar interne-beheersingverantwoordelijkheden uit te voeren, en de communicatie die nodig is om deze informatie beschikbaar te stellen."@nl ;
    ext:isComponentOf fw:COSO_ICF .

ext:COSO_ICF_MonitoringActivities
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Monitoring Activities"@en , "Monitoringactiviteiten"@nl ;
    rdfs:comment "Doorlopende evaluaties, afzonderlijke evaluaties of een combinatie daarvan, om vast te stellen of alle vijf componenten van interne beheersing aanwezig en werkzaam zijn."@nl ;
    ext:isComponentOf fw:COSO_ICF .

# =============================================================================
# SECTIE 6 — ABOX: COSO ERM COMPONENTEN (5)
# =============================================================================

ext:COSO_ERM_GovernanceCulture
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Governance & Culture"@en , "Governance & Cultuur"@nl ;
    rdfs:comment "Governance stelt de organisatietoon vast, versterkt het belang van en stelt toezichtverantwoordelijkheden vast voor ERM. Cultuur betreft ethische waarden, gewenst gedrag en begrip van risico."@nl ;
    ext:isComponentOf fw:COSO_ERM .

ext:COSO_ERM_StrategyObjectiveSetting
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Strategy & Objective-Setting"@en , "Strategie & Doelstelling"@nl ;
    rdfs:comment "ERM wordt geïntegreerd in het strategisch planningsproces. Risicobereidheid wordt vastgesteld in lijn met strategie en bedrijfsdoelstellingen."@nl ;
    ext:isComponentOf fw:COSO_ERM .

ext:COSO_ERM_Performance
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Performance"@en , "Prestatie"@nl ;
    rdfs:comment "Risico's die het bereiken van strategie en bedrijfsdoelstellingen kunnen beïnvloeden worden geïdentificeerd en beoordeeld. Risico's worden geprioriteerd op basis van ernst in de context van risicobereidheid."@nl ;
    ext:isComponentOf fw:COSO_ERM .

ext:COSO_ERM_ReviewRevision
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Review & Revision"@en , "Evaluatie & Revisie"@nl ;
    rdfs:comment "Door de prestaties van ERM te evalueren kan de organisatie beoordelen hoe goed de ERM-componenten functioneren en welke revisies nodig zijn."@nl ;
    ext:isComponentOf fw:COSO_ERM .

ext:COSO_ERM_InformationCommunicationReporting
    rdf:type ext:COSOComponent , owl:NamedIndividual ;
    rdfs:label "Information, Communication & Reporting"@en , "Informatie, Communicatie & Rapportage"@nl ;
    rdfs:comment "ERM vereist een continu proces van het verkrijgen en delen van noodzakelijke informatie, uit zowel interne als externe bronnen, die stroomt door de gehele organisatie."@nl ;
    ext:isComponentOf fw:COSO_ERM .

# =============================================================================
# SECTIE 7 — ABOX: COBIT 2019 OBJECTIVES (gemigreerd uit m-cobit-interim.ttl)
# Wijzigingen t.o.v. interim:
# - compl:derivedFrom fw:COBIT_2019 → ext:isComponentOf fw:COBIT_2019
# - rdf:type ext:COBITObjective (was al correct, nu subClassOf ext:FrameworkComponent)
# =============================================================================

ext:COBIT_EDM01 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "EDM01 — Governance-kader instellen en onderhouden"@nl ,
               "EDM01 — Ensured Governance Framework Setting and Maintenance"@en ;
    rdfs:comment "Analyseer en beoordeel de governancevereisten. Stel en handhaaf een effectief governance-kader voor IT."@nl ;
    ext:cobitDomain "EDM"^^xsd:string ;
    ext:cobitObjectiveID "EDM01"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 ;
    skos:relatedMatch fw:ISO_IEC_27001_2022 ;
    skos:relatedMatch fw:BesluitCIOStelsel .

ext:COBIT_EDM02 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "EDM02 — Waarderealisatie borgen"@nl ,
               "EDM02 — Ensured Benefits Delivery"@en ;
    rdfs:comment "Zorg voor optimale waardecreatie door IT-enabled investeringen en diensten."@nl ;
    ext:cobitDomain "EDM"^^xsd:string ;
    ext:cobitObjectiveID "EDM02"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 ;
    skos:relatedMatch fw:ISO_IEC_27001_2022 .

ext:COBIT_EDM03 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "EDM03 — Risicooptimalisatie borgen"@nl ,
               "EDM03 — Ensured Risk Optimisation"@en ;
    rdfs:comment "Zorg dat de risicotolerantie gedefinieerd is en dat risico's in lijn zijn met risicobereidheid."@nl ;
    ext:cobitDomain "EDM"^^xsd:string ;
    ext:cobitObjectiveID "EDM03"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 ;
    skos:relatedMatch fw:ISO_IEC_27005_2024 ;
    skos:relatedMatch fw:ISO_31000_2018 .

ext:COBIT_EDM04 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "EDM04 — Resourceoptimalisatie borgen"@nl ,
               "EDM04 — Ensured Resource Optimisation"@en ;
    rdfs:comment "Zorg voor adequate IT-resources: mensen, processen en technologie."@nl ;
    ext:cobitDomain "EDM"^^xsd:string ;
    ext:cobitObjectiveID "EDM04"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 .

ext:COBIT_EDM05 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "EDM05 — Stakeholderbetrokkenheid borgen"@nl ,
               "EDM05 — Ensured Stakeholder Engagement"@en ;
    rdfs:comment "Zorg voor transparantie en effectieve communicatie richting stakeholders over IT-prestaties en -risico's."@nl ;
    ext:cobitDomain "EDM"^^xsd:string ;
    ext:cobitObjectiveID "EDM05"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 ;
    skos:relatedMatch fw:ISO_IEC_27001_2022 .

ext:COBIT_APO12 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "APO12 — IT-risicobeheer"@nl ,
               "APO12 — Managed Risk"@en ;
    rdfs:comment "Integreer IT-risicobeheer in de algehele organisatorische risicobeheerpraktijken."@nl ;
    ext:cobitDomain "APO"^^xsd:string ;
    ext:cobitObjectiveID "APO12"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 ;
    skos:relatedMatch fw:ISO_IEC_27005_2024 ;
    skos:relatedMatch fw:NIST_SP_800_39 ;
    skos:relatedMatch fw:ISO_31000_2018 .

ext:COBIT_APO13 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "APO13 — Informatiebeveiliging beheren"@nl ,
               "APO13 — Managed Security"@en ;
    rdfs:comment "Definieer, exploiteer en moniteer een ISMS conform best practices."@nl ;
    ext:cobitDomain "APO"^^xsd:string ;
    ext:cobitObjectiveID "APO13"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 ;
    skos:closeMatch fw:ISO_IEC_27001_2022 ;
    skos:relatedMatch fw:BIO_2_0 .

ext:COBIT_DSS05 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "DSS05 — Beveiligingsdiensten beheren"@nl ,
               "DSS05 — Managed Security Services"@en ;
    rdfs:comment "Bescherm bedrijfsinformatie om het informatierisico te verminderen."@nl ;
    ext:cobitDomain "DSS"^^xsd:string ;
    ext:cobitObjectiveID "DSS05"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 ;
    skos:relatedMatch fw:ISO_IEC_27002_2022 .

ext:COBIT_MEA02 rdf:type ext:COBITObjective , owl:NamedIndividual ;
    rdfs:label "MEA02 — Systeem van interne beheersing beheren"@nl ,
               "MEA02 — Managed System of Internal Control"@en ;
    rdfs:comment
        "Moniteer en evalueer de interne-beheersingsomgeving, inclusief zelfbeoordelingen en onafhankelijke beoordelingen. Verwijst direct naar COSO ICF."@nl ,
        "Monitor and evaluate the internal control environment, including self-assessments and independent reviews. Directly references COSO ICF."@en ;
    ext:cobitDomain "MEA"^^xsd:string ;
    ext:cobitObjectiveID "MEA02"^^xsd:string ;
    ext:isComponentOf fw:COBIT_2019 ;
    skos:relatedMatch ext:COSO_ICF_MonitoringActivities ;
    skos:relatedMatch fw:ENSIA .

# =============================================================================
# SECTIE 8 — GOVERNANCE-HIËRARCHIE RELATIES
# D10: COSO (enterprise) → COBIT (IT) → BIO/ISO 27001 (IB)
# =============================================================================

# COBIT is de IT-invulling van COSO
fw:COBIT_2019
    fw:geeftITInvullingAan fw:COSO_ICF ;
    fw:geeftITInvullingAan fw:COSO_ERM .

# Specifieke component-mappings: COBIT EDM → COSO ICF
ext:COBIT_EDM01 skos:relatedMatch ext:COSO_ICF_ControlEnvironment .
ext:COBIT_EDM03 skos:relatedMatch ext:COSO_ICF_RiskAssessment .
ext:COBIT_EDM05 skos:relatedMatch ext:COSO_ICF_InformationCommunication .

# COBIT MEA02 (Monitoring) → COSO ICF Monitoring
ext:COBIT_MEA02 skos:relatedMatch ext:COSO_ICF_MonitoringActivities .

# Rijksoverheid governance-besluiten → COBIT EDM01 (Governance Framework)
fw:BesluitBVAStelsel skos:relatedMatch ext:COBIT_EDM01 .
fw:BesluitCIOStelsel skos:relatedMatch ext:COBIT_EDM01 .

# COBIT APO12 (IT-risicobeheer) → COSO ERM Performance
ext:COBIT_APO12 skos:relatedMatch ext:COSO_ERM_Performance .
ext:COBIT_EDM03 skos:relatedMatch ext:COSO_ERM_Performance .

# ISO 27005 / ISO 31000 → COSO ERM (IB-risico als invulling van enterprise-risico)
fw:ISO_IEC_27005_2024
    skos:broadMatch fw:COSO_ERM .

fw:ISO_31000_2018
    skos:relatedMatch fw:COSO_ERM .

# =============================================================================
# SECTIE 9 — FRAMEWORK-LEVEL SKOS ALIGNMENTS
# Validatieniveau: analytisch
# =============================================================================

fw:COSO_ICF
    skos:relatedMatch fw:COBIT_2019 ;
    skos:relatedMatch fw:ISO_IEC_27001_2022 .

fw:COSO_ERM
    skos:relatedMatch fw:COBIT_2019 ;
    skos:relatedMatch fw:ISO_31000_2018 ;
    skos:relatedMatch fw:ISO_IEC_27005_2024 .

# Note: APO13 skos:exactMatch → skos:closeMatch gecorrigeerd (APO13 ≈ ISMS maar niet identiek)

# =============================================================================
# EINDE MODULE M17
# =============================================================================

# =============================================================================
# v4.5.0 Fase 3 — Stap 7: GOVERN-overlap CSF ↔ COSO/COBIT
# Datum: 2026-05-19
# Bron: Conceptuele mapping op basis van CSWP 29 Category-statements en
#       COSO ICF/ERM/COBIT-individual-comments uit m17 (geen externe XLSX).
# Match-type: skos:relatedMatch (besluit 7 — conceptuele overlap, geen exact-equivalentie)
# Eén richting: csf:GV_* → ext:COSO_* / ext:COBIT_*
# =============================================================================
# 13 mappings totaal, opgebouwd uit:
#   - 12 voorgesteld door tech-chat (Stap 7-preview)
#   - 1 toegevoegd door masterchat na heroverweging: GV.RM → COSO_ERM_Performance
#     (rationale: Performance = continue risk-portfolio-management tijdens uitvoering,
#      complement aan StrategyObjectiveSetting = vaststelling vooraf)
#
# GV.SC bewust niet gemapt (SKIP, G1 "bij twijfel niet leggen"):
#   COSO/COBIT-clusters in m17 bevatten geen native cybersecurity-supply-chain-component.
#   Mapping zou geforceerd zijn. Toekomstige sprint kan dit heroverwegen bij Spoor B-data.
#
# Bewust niet-gemapt (7 targets, zou geforceerd zijn):
#   COBIT_DSS05 (PROTECT-domein, niet GOVERN); COBIT_EDM02 (IT-waardecreatie);
#   COBIT_EDM04 (IT-resources algemeen); COBIT_EDM05 (IT-prestatie-communicatie);
#   COSO_ERM_InformationCommunicationReporting (generieke informatiestromen);
#   COSO_ICF_InformationCommunication (generieke interne-beheersing-info).

# --- GV.OC — Organizational Context (2 mappings) ---
csf:GV_OrganizationalContext skos:relatedMatch
    ext:COSO_ICF_ControlEnvironment ,
    ext:COBIT_EDM01 .

# --- GV.RM — Risk Management Strategy (4 mappings; #14 toegevoegd door masterchat) ---
csf:GV_RiskManagementStrategy skos:relatedMatch
    ext:COSO_ICF_RiskAssessment ,
    ext:COSO_ERM_StrategyObjectiveSetting ,
    ext:COSO_ERM_Performance ,
    ext:COBIT_EDM03 .

# --- GV.RR — Roles, Responsibilities, and Authorities (2 mappings) ---
csf:GV_RolesResponsibilitiesAndAuthorities skos:relatedMatch
    ext:COSO_ICF_ControlEnvironment ,
    ext:COSO_ERM_GovernanceCulture .

# --- GV.PO — Policy (2 mappings) ---
csf:GV_Policy skos:relatedMatch
    ext:COSO_ICF_ControlActivities ,
    ext:COBIT_APO13 .

# --- GV.OV — Oversight (3 mappings) ---
csf:GV_Oversight skos:relatedMatch
    ext:COSO_ICF_MonitoringActivities ,
    ext:COSO_ERM_ReviewRevision ,
    ext:COBIT_MEA02 .

# --- GV.SC — Cybersecurity Supply Chain Risk Management (SKIP, G1) ---
