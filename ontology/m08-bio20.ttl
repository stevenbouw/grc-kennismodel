    bio:correspondsToISO ctrl:ISO27002_8_19 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_19_1 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_19_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
