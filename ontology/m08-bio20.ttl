# ── 8.24: Gebruik van cryptografie ──
bio:ISO27002_8_24 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Gebruik van cryptografie"@nl ;
    rdfs:comment "Regels voor het doeltreffende gebruik van cryptografie, met inbegrip van het beheer van cryptografische sleutels, behoren te worden gedefinieerd en geïmplementeerd."@nl ;
    bio:bioControlNummer "8.24" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_24 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_24_1 , bio:BIO2_8_24_2 , bio:BIO2_8_24_3 , bio:BIO2_8_24_4 , bio:BIO2_8_24_5 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_24_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.24.1"@nl ;
    bio:bioMaatregelNummer "8.24.1" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "In het cryptografiebeleid zijn minimaal de volgende onderwerpen uitgewerkt: \n(a) Wanneer cryptografie ingezet wordt. \n(b) Wie verantwoordelijk is voor de implementatie.\n(c) Wie verantwoordelijk is voor het sleutelbeheer. \n(d) Welke normen als basis dienen voor cryptografie en de wijze waarop de normen van het Forum Standaardisatie worden toegepast. \n(e) De wijze waarop het beschermingsniveau vastgesteld wordt. \n(f) Bij communicatie tussen organisaties wordt het beleid onderling vastgesteld" ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_24_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.24.2"@nl ;
    bio:bioMaatregelNummer "8.24.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Cryptografische toepassingen voldoen aan passende standaarden van het Forum Standaardisatie." ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_24_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.24.3"@nl ;
    bio:bioMaatregelNummer "8.24.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "De sterkte van de cryptografie wordt waar mogelijk gebaseerd op de actuele adviezen van het NCSC." ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_24_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.24.4"@nl ;
    bio:bioMaatregelNummer "8.24.4" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "In geval van PKIoverheid-certificaten hanteer de PKIoverheid-eisen ten aanzien van het sleutelbeheer. In overige situaties hanteer de norm ISO 11770-1 voor het beheer van cryptografische sleutels." ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_24_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.24.5"@nl ;
    bio:bioMaatregelNummer "8.24.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Er zijn (contractuele) afspraken over reservecertificaten van een alternatieve leverancier als uit risicoafweging blijkt dat deze noodzakelijk zijn." ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 .

