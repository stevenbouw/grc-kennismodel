    rdfs:label "BIO2 Maatregel 8.07.4"@nl ;
    bio:bioMaatregelNummer "8.07.4" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "De malwarescan wordt uitgevoerd op: \n(a) alle omgevingen, bijvoorbeeld op mailservers, (desktop)computers en bij de toegangsverlening tot het netwerk van de organisatie;\n(b) alle gedownloade content voorafgaand aan executie of opslag;\n(c) alle bestanden die via netwerken of via elke vorm van opslagmedium zijn ontvangen, vóór gebruik of opslag in de eigen omgeving." ;
    bio:implementsControl bio:ISO27002_8_07 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.08: Beheer van technische kwetsbaarheden ──
bio:ISO27002_8_08 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Beheer van technische kwetsbaarheden"@nl ;
    rdfs:comment "Er behoort informatie te worden verkregen over technische kwetsbaarheden van in gebruik zijnde informatiesystemen, de blootstelling van de organisatie aan dergelijke kwetsbaarheden behoort te worden geëvalueerd en er behorende passende maatregelen te"@nl ;
    bio:bioControlNummer "8.08" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_08 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_08_1 , bio:BIO2_8_08_2 , bio:BIO2_8_08_3 , bio:BIO2_8_08_4 , bio:BIO2_8_08_5 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_08_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.08.1"@nl ;
    bio:bioMaatregelNummer "8.08.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Als de kans op misbruik en de verwachte schade beide hoog zijn (bijvoorbeeld met de NCSC-Inschalingsmatrix beveiligingsadviezen of leveranciersbeveiligingsadviezen), worden passende mitigerende maatregelen zo snel mogelijk, maar uiterlijk binnen een week getroffen." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_08_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.08.2"@nl ;
    bio:bioMaatregelNummer "8.08.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Op basis van een expliciete risicoafweging wordt bepaald op welke wijze mitigerende maatregelen getroffen worden." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_08_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.08.3"@nl ;
    bio:bioMaatregelNummer "8.08.3" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "In de tussentijd of als installatie binnen een week niet mogelijk is, worden op basis van een expliciete risicoafweging mitigerende maatregelen getroffen." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_08_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.08.4"@nl ;
    bio:bioMaatregelNummer "8.08.4" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Informatiesystemen worden bij voorkeur jaarlijks gecontroleerd op technische naleving van beveiligingsnormen en risico’s ten aanzien van de feitelijke veiligheid. Dit kan bijvoorbeeld door (geautomatiseerde) kwetsbaarheidsanalyses, penetratietesten of red-teamingstesten." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_08_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.08.5"@nl ;
    bio:bioMaatregelNummer "8.08.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Internetfacing-systemen hebben een verplichte (bij voorkeur geautomatiseerde) penetratietest bij iedere nieuwe release of major update. Als daar bevindingen met een hoog risico uitkomen, mag het systeem niet in productie." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.09: Configuratiebeheer ──
bio:ISO27002_8_09 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Configuratiebeheer"@nl ;
    rdfs:comment "Configuraties, met inbegrip van beveiligingsconfiguraties, van hardware, software, diensten en netwerken behoren te worden vastgesteld, gedocumenteerd, geïmplementeerd, gemonitord en beoordeeld."@nl ;
    bio:bioControlNummer "8.09" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_09 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.1: Wissen van informatie ──
bio:ISO27002_8_10 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Wissen van informatie"@nl ;
    rdfs:comment "In informatiesystemen, apparaten of andere opslagmedia opgeslagen informatie behoort te worden gewist als deze niet langer vereist is."@nl ;
    bio:bioControlNummer "8.1" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_01 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.11: Maskeren van gegevens ──
bio:ISO27002_8_11 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Maskeren van gegevens"@nl ;
    rdfs:comment "Gegevens behoren te worden gemaskeerd overeenkomstig het onderwerpspecifieke beleid inzake toegangsbeveiliging en andere gerelateerde onderwerpspecifieke beleidsregels, en bedrijfseisen van de organisatie, rekening houdend met de toepasselijke wetgev"@nl ;
    bio:bioControlNummer "8.11" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_11 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.12: Voorkomen van gegevenslekken (data leakage prevention) ──
bio:ISO27002_8_12 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Voorkomen van gegevenslekken (data leakage prevention)"@nl ;
    rdfs:comment "Maatregelen om gegevenslekken te voorkomen, behoren te worden toegepast in systemen, netwerken en andere apparaten waarop of waarmee gevoelige informatie wordt verwerkt, opgeslagen of getransporteerd."@nl ;
    bio:bioControlNummer "8.12" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_12 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.13: Back-up van informatie ──
bio:ISO27002_8_13 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Back-up van informatie"@nl ;
    rdfs:comment "Back-ups van informatie, software en systemen behoren te worden bewaard en regelmatig te worden getest overeenkomstig het overeengekomen onderwerpspecifieke beleid inzake back-ups."@nl ;
    bio:bioControlNummer "8.13" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_13 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_13_1 , bio:BIO2_8_13_2 , bio:BIO2_8_13_3 , bio:BIO2_8_13_4 , bio:BIO2_8_13_5 , bio:BIO2_8_13_6 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_13_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.13.1"@nl ;
    bio:bioMaatregelNummer "8.13.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Er is een back-upbeleid waarin de eisen voor het bewaren en beschermen zijn gedefinieerd en vastgesteld. Er moet speciale aandacht zijn voor het beschermen van de back-up tegen ransomware-aanvallen." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_13_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.13.2"@nl ;
    bio:bioMaatregelNummer "8.13.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Op basis van een expliciete risicoafweging is bepaald wat het maximaal toegestane dataverlies is en wat de maximale hersteltijd is na een incident." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_13_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.13.3"@nl ;
    bio:bioMaatregelNummer "8.13.3" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "In het back-upbeleid staan minimaal de volgende eisen:\n(a) Dataverlies bedraagt maximaal 28 uur.\n(b) Hersteltijd in geval van incidenten is maximaal 16 werkuren (2 dagen van 8 uur) in 85% van de gevallen." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_13_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.13.4"@nl ;
    bio:bioMaatregelNummer "8.13.4" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Het back-upproces voorziet in opslag van de back-up op een locatie, waarbij een incident op de ene locatie niet kan leiden tot schade op de andere." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_13_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.13.5"@nl ;
    bio:bioMaatregelNummer "8.13.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Zorg dat ten minste één back-up niet online benaderbaar is en beschermd wordt tegen veranderingen." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_13_6 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.13.6"@nl ;
    bio:bioMaatregelNummer "8.13.6" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "De herstelprocedure wordt minimaal jaarlijks getest of na een grote wijziging, om de goede werking te waarborgen als deze in noodgevallen uitgevoerd moet worden." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.14: Redundantie van informatieverwerkende faciliteiten ──
bio:ISO27002_8_14 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Redundantie van informatieverwerkende faciliteiten"@nl ;
    rdfs:comment "Informatieverwerkende faciliteiten behoren met voldoende redundantie te worden geïmplementeerd om aan beschikbaarheidseisen te voldoen."@nl ;
    bio:bioControlNummer "8.14" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_14 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.15: Logging ──
bio:ISO27002_8_15 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Logging"@nl ;
    rdfs:comment "Er behoren logbestanden waarin activiteiten, uitzonderingen, fouten en andere relevante gebeurtenissen worden geregistreerd, te worden geproduceerd, opgeslagen, beschermd en geanalyseerd."@nl ;
    bio:bioControlNummer "8.15" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_15 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_15_1 , bio:BIO2_8_15_2 , bio:BIO2_8_15_3 , bio:BIO2_8_15_4 , bio:BIO2_8_15_5 , bio:BIO2_8_15_6 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_15_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.15.1"@nl ;
    bio:bioMaatregelNummer "8.15.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Een logregel bevat minimaal:\n(a) de gebeurtenis;\n(b) de benodigde informatie die nodig is om het incident met hoge mate van zekerheid te herleiden tot een natuurlijk persoon; \n(c) het gebruikte apparaat;\n(d) het resultaat van de handeling;\n(e) een datum en tijdstip van de gebeurtenis." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_15_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.15.2"@nl ;
    bio:bioMaatregelNummer "8.15.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Een logregel bevat in geen geval gegevens die tot het doorbreken van de beveiliging kunnen leiden." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_15_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.15.3"@nl ;
    bio:bioMaatregelNummer "8.15.3" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Er is een overzicht van logbestanden die worden gegenereerd." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_15_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.15.4"@nl ;
    bio:bioMaatregelNummer "8.15.4" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Ten behoeve van de loganalyse is op basis van een expliciete risicoafweging de bewaarperiode van de logging bepaald. Binnen deze periode is de beschikbaarheid van de loginformatie gewaarborgd." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_15_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.15.5"@nl ;
    bio:bioMaatregelNummer "8.15.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Oneigenlijk wijzigen, verwijderen of pogingen daartoe van loggegevens worden zo snel mogelijk gemeld als beveiligingsincident via de procedure voor informatiebeveiligingsincidenten conform control 5.24." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_15_6 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.15.6"@nl ;
    bio:bioMaatregelNummer "8.15.6" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Minimaal halfjaarlijks wordt door een onafhankelijke functionaris (ten opzichte van de uitvoering) getoetst op het ongewijzigd bestaan van logbestanden gedurende de bewaartermijn." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.16: Monitoren van activiteiten ──
bio:ISO27002_8_16 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Monitoren van activiteiten"@nl ;
    rdfs:comment "Netwerken, systemen en toepassingen behoren te worden gemonitord op afwijkend gedrag en er behoren passende maatregelen te worden getroffen om potentiële informatiebeveiligingsincidenten te evalueren."@nl ;
    bio:bioControlNummer "8.16" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_16 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_16_1 , bio:BIO2_8_16_2 , bio:BIO2_8_16_3 , bio:BIO2_8_16_4 , bio:BIO2_8_16_5 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_16_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.16.1"@nl ;
    bio:bioMaatregelNummer "8.16.1" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "De informatieverwerkende omgeving wordt gemonitord met een detectie- en response-oplossing, waarmee aanvallen kunnen worden gedetecteerd en afwijkingen worden adequaat en tijdig behandeld." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_16_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.16.2"@nl ;
    bio:bioMaatregelNummer "8.16.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Actieve netwerkcomponenten zijn voorzien van logging en monitoring van die logging om afwijkende gebeurtenissen te kunnen waarnemen en daarop te reageren." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_16_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.16.3"@nl ;
    bio:bioMaatregelNummer "8.16.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Een risicoafweging bepaalt de bewaartermijn van de logging." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_16_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.16.4"@nl ;
    bio:bioMaatregelNummer "8.16.4" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Bij ontdekte nieuwe dreigingen (aanvallen) via 8.16.1 worden deze binnen geldende juridische kaders verplicht gedeeld binnen de overheid, waaronder met het NCSC (alleen voor rijksoverheidsorganisaties) of via de sectorale CERT (voor andere overheidsorganisaties), middels (bij voorkeur geautomatiseerde) threat intelligence sharing mechanismen." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_16_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.16.5"@nl ;
    bio:bioMaatregelNummer "8.16.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "De SIEM en/of SOC hebben heldere regels over wanneer een incident moet worden gerapporteerd aan het verantwoordelijk management." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.17: Kloksynchronisatie ──
bio:ISO27002_8_17 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Kloksynchronisatie"@nl ;
    rdfs:comment "De klokken van informatieverwerkende systemen die door de organisatie worden gebruikt, behoren te worden gesynchroniseerd met goedgekeurde tijdsbronnen."@nl ;
    bio:bioControlNummer "8.17" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Integriteit" ;
    bio:correspondsToISO ctrl:ISO27002_8_17 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.18: Gebruik van speciale systeemhulpmiddelen ──
bio:ISO27002_8_18 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Gebruik van speciale systeemhulpmiddelen"@nl ;
    rdfs:comment "Het gebruik van systeemhulpmiddelen die in staat kunnen zijn om beheersmaatregelen voor systemen en toepassingen te omzeilen, behoort te worden beperkt en nauwkeurig te worden gecontroleerd."@nl ;
    bio:bioControlNummer "8.18" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_18 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_18_1 , bio:BIO2_8_18_2 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_18_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.18.1"@nl ;
    bio:bioMaatregelNummer "8.18.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Alleen bevoegd personeel heeft toegang tot systeemhulpmiddelen." ;
    bio:implementsControl bio:ISO27002_8_18 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_18_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.18.2"@nl ;
    bio:bioMaatregelNummer "8.18.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Het gebruik van systeemhulpmiddelen wordt gelogd. De logging is een halfjaar beschikbaar voor onderzoek." ;
    bio:implementsControl bio:ISO27002_8_18 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.19: Installeren van software op operationele systemen ──
bio:ISO27002_8_19 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Installeren van software op operationele systemen"@nl ;
    rdfs:comment "Er behoren procedures en maatregelen te worden geïmplementeerd om het installeren van software op operationele systemen op beveiligde wijze te beheren."@nl ;
    bio:bioControlNummer "8.19" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
