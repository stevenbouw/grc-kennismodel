# ── 8.01: ‘User endpoint devices’ ──
bio:ISO27002_8_01 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "'User endpoint devices'"@nl ;
    rdfs:comment "Informatie die is opgeslagen op, wordt verwerkt door of toegankelijk is via 'user endpoint devices' behoort te worden beschermd."@nl ;
    bio:bioControlNummer "8.01" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_01 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_01_1 , bio:BIO2_8_01_2 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_01_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.01.1"@nl ;
    bio:bioMaatregelNummer "8.01.1" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Mobiele apparatuur is zo ingericht dat bedrijfsinformatie niet onbewust wordt opgeslagen (‘zero footprint’). Als zero footprint (nog) niet realiseerbaar is, biedt een mobiel apparaat (zoals een laptop, tablet en smartphone) de mogelijkheid om de toegang te beschermen door middel van een toegangsbeveiligingsmechanisme en, indien vertrouwelijke gegevens worden opgeslagen, versleuteling van die gegevens. In het geval van opslag van vertrouwelijke informatie moet op deze mobiele apparatuur ‘wissen o" ;
    bio:implementsControl bio:ISO27002_8_01 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_01_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.01.2"@nl ;
    bio:bioMaatregelNummer "8.01.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Bij de inzet van mobiele apparatuur zijn minimaal de volgende aspecten geïmplementeerd:\n(a) In bewustwordingsprogramma’s komen gedragsaspecten van veilig mobiel werken aan de orde. \n(b) Het apparaat maakt deel uit van patchmanagement en hardening.\n(c) Er wordt gebruik gemaakt van Mobile Device Management (MDM) of van Mobile Application Management (MAM)-oplossingen. \n(d) Gebruikers tekenen een gebruikersovereenkomst voor mobiel werken, waarmee zij verklaren zich bewust te zijn van de gevaren " ;
    bio:implementsControl bio:ISO27002_8_01 ;
    ctrl:definedInFramework fw:BIO_2_0 .

