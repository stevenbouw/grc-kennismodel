    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.2: Beveiliging netwerkcomponenten ──
bio:ISO27002_8_20 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Beveiliging netwerkcomponenten"@nl ;
    rdfs:comment "Netwerken en netwerkapparaten behoren te worden beveiligd, beheerd en beheerst om informatie in systemen en toepassingen te beschermen."@nl ;
    bio:bioControlNummer "8.2" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_02 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 8.21: Beveiliging van netwerkdiensten ──
bio:ISO27002_8_21 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Beveiliging van netwerkdiensten"@nl ;
    rdfs:comment "Beveiligingsmechanismen, dienstverleningsniveaus en dienstverleningseisen voor alle netwerkdiensten behoren te worden geïdentificeerd, geïmplementeerd en gemonitord."@nl ;
    bio:bioControlNummer "8.21" ;
    bio:hasControlType "Technologisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_8_21 ;
    bio:hasOverheidsMaatregel bio:BIO2_8_21_1 , bio:BIO2_8_21_2 , bio:BIO2_8_21_3 , bio:BIO2_8_21_4 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_21_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.21.1"@nl ;
    bio:bioMaatregelNummer "8.21.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "In koppelpunten met externe of onvertrouwde zones zijn maatregelen getroffen om mogelijke aanvallen die de beschikbaarheid van de informatievoorziening negatief beïnvloeden (bijvoorbeeld DDoS-aanvallen, Distributed Denial of Service attacks) te signaleren en hierop te reageren." ;
    bio:implementsControl bio:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_21_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.21.2"@nl ;
    bio:bioMaatregelNummer "8.21.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Het dataverkeer dat de organisatie binnenkomt of uitgaat, wordt bewaakt/geanalyseerd op kwaadaardige elementen middels detectievoorzieningen (zoals beschreven in de richtlijn voor implementatie van detectieoplossingen), zoals het Nationaal Detectie Netwerk (alleen voor rijksoverheidsorganisaties) of GDI, die worden ingezet op basis van een risicoafweging, mede aan de hand van de aard van de te beschermen gegevens en informatiesystemen." ;
    bio:implementsControl bio:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_21_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.21.3"@nl ;
    bio:bioMaatregelNummer "8.21.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Bij ontdekte nieuwe dreigingen vanuit 8.21.2 worden deze, rekening houdend met de geldende juridische kaders, verplicht gedeeld binnen de overheid, waaronder met het NCSC (alleen voor rijksoverheidsorganisaties) of de sectorale CERT, bij voorkeur door geautomatiseerde mechanismen (threat intelligence sharing)." ;
    bio:implementsControl bio:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_21_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.21.4"@nl ;
    bio:bioMaatregelNummer "8.21.4" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Bij draadloze verbindingen zoals wifi en bij bedrade verbindingen buiten het gecontroleerd gebied wordt gebruik gemaakt van encryptiemiddelen waarvoor het Nationaal Bureau voor Verbindingsbeveiliging (NBV) een positief inzetadvies heeft afgegeven." ;
    bio:implementsControl bio:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 .

