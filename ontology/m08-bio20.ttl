# ── 8.05: Beveiligde authenticatie ──
bio:ISO27002_8_05 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Beveiligde authenticatie"@nl ;
    rdfs:comment "Er behoren beveiligde authenticatietechnologieën en -procedures te worden geïmplementeerd op basis van beperkingen van de toegang tot informatie en het onderwerpspecifieke beleid inzake toegangsbeveiliging."@nl ;
    bio:bioControlNummer "8.05" ;
    bio:hasControlType "Technologisch" ;
