    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Alle medewerkers en contractanten die gebruikmaken van de informatiesystemen en -diensten hebben binnen drie maanden na indiensttreding een training I-bewustzijn succesvol gevolgd." ;
    bio:implementsControl bio:ISO27002_6_03 ;
    ctrl:definedInFramework fw:BIO_2_0 .

