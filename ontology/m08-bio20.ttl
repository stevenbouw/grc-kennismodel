bio:BIO2_8_05_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.05.1"@nl ;
    bio:bioMaatregelNummer "8.05.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Als vanuit een onvertrouwde zone toegang wordt verleend naar een vertrouwde zone, gebeurt dit alleen op basis van minimaal tweefactor-authenticatie." ;
    bio:implementsControl bio:ISO27002_8_05 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_8_05_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 8.05.2"@nl ;
    bio:bioMaatregelNummer "8.05.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Voor het verlenen van toegang tot het netwerk aan externe leveranciers wordt vooraf een risicoafweging gemaakt. De risicoafweging bepaalt onder welke voorwaarden de leveranciers toegang krijgen. Uit een registratie blijkt hoe de rechten zijn toegekend." ;
    bio:implementsControl bio:ISO27002_8_05 ;
    ctrl:definedInFramework fw:BIO_2_0 .

