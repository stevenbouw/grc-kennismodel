# ── 7.1: Opslagmedia ──
bio:ISO27002_7_10 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Opslagmedia"@nl ;
    rdfs:comment "Opslagmedia behoren te worden beheerd gedurende hun volledige levenscyclus van aanschaf, gebruik, transport en verwijdering overeenkomstig het classificatieschema en de hanteringseisen van de organisatie."@nl ;
    bio:bioControlNummer "7.1" ;
    bio:hasControlType "Fysiek" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_7_01 ;
    bio:hasOverheidsMaatregel bio:BIO2_7_10_1 , bio:BIO2_7_10_2 , bio:BIO2_7_10_3 , bio:BIO2_7_10_4 , bio:BIO2_7_10_5 , bio:BIO2_7_10_6 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_10_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.10.1"@nl ;
    bio:bioMaatregelNummer "7.10.1" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Er is een verwijderinstructie waarin is opgenomen dat van verwijderbare media die herbruikbaar zijn en die de organisatie verlaten de onnodige inhoud onherstelbaar verwijderd is." ;
    bio:implementsControl bio:ISO27002_7_10 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_10_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.10.2"@nl ;
    bio:bioMaatregelNummer "7.10.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Media die vertrouwelijke informatie bevatten, zijn opgeslagen op een plek die niet toegankelijk is voor onbevoegden." ;
    bio:implementsControl bio:ISO27002_7_10 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_10_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.10.3"@nl ;
    bio:bioMaatregelNummer "7.10.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Er is een vastgestelde procedure voor het fysiek transport van media." ;
    bio:implementsControl bio:ISO27002_7_10 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_10_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.10.4"@nl ;
    bio:bioMaatregelNummer "7.10.4" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Het gebruik van koeriers of transporteurs voor transport van op BBN2 of hoger geclassificeerde informatie voldoet aan vooraf opgestelde betrouwbaarheidseisen." ;
    bio:implementsControl bio:ISO27002_7_10 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_10_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.10.5"@nl ;
    bio:bioMaatregelNummer "7.10.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Verwijdering vindt plaats op een veilige manier, bijvoorbeeld door verbranding of versnippering. Verwijdering van alleen gegevens is ook mogelijk door het wissen van de gegevens voordat de media worden gebruikt voor een andere toepassing in de organisatie." ;
    bio:implementsControl bio:ISO27002_7_10 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_10_6 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.10.6"@nl ;
    bio:bioMaatregelNummer "7.10.6" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Voor het wissen van alle data op het medium, wordt de data onherstelbaar verwijderd, bijvoorbeeld door minimaal twee keer te overschrijven met vaste data en één keer met random data. Er wordt gecontroleerd of alle data onherstelbaar verwijderd is en er wordt verslag van gemaakt." ;
    bio:implementsControl bio:ISO27002_7_10 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 7.11: Nutsvoorzieningen ──
