@prefix fw:      <https://grc.example.org/framework/> .
@prefix ctrl:    <https://grc.example.org/control/> .
@prefix risk:    <https://grc.example.org/risk/> .
@prefix roles:   <https://grc.example.org/roles/> .
@prefix compl:   <https://grc.example.org/compliance/> .
@prefix isms:    <https://grc.example.org/isms/> .
@prefix biz:     <https://grc.example.org/business/> .
@prefix bio:     <https://grc.example.org/bio/> .
@prefix ext:     <https://grc.example.org/extended/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix csf:     <https://grc.example.org/csf/> .

# =============================================================================
# GRC Ontologie — Module M8: BIO 2.0
# Versie: 4.0.0-alpha | Datum: 2026-03-19 | Profiel: OWL 2 DL
# =============================================================================

<https://grc.example.org/ontology/m08-bio20>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M8 — BIO 2.0"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

# ═══ MODULE M8 — BIO 2.0 ═══

# ═══════════════════════════════════════════════════════════════════════════
# MODULE M8 — BIO 2.0 (Baseline Informatiebeveiliging Overheid v1.3)
# Bron: Handreiking BIO2-opmaat v2.5 — 5 maart 2026
# 93 ISO/IEC 27002:2022 controls + overheidsspecifieke maatregelen
# ═══════════════════════════════════════════════════════════════════════════

bio:BIOControl rdf:type owl:Class ;
    rdfs:subClassOf ctrl:Control ;
    rdfs:label "BIO Beheersmaatregel"@nl ;
    rdfs:label "BIO Control"@en .

bio:OverheidsMaatregel rdf:type owl:Class ;
    rdfs:subClassOf ctrl:Control ;
    rdfs:label "Overheidsmaatregel"@nl ;
    rdfs:label "Government-Specific Measure"@en .

bio:hasControlType rdf:type owl:DatatypeProperty ;
    rdfs:domain bio:BIOControl ;
    rdfs:range xsd:string ;
    rdfs:label "heeft controlsoort"@nl .

bio:hasIBEigenschap rdf:type owl:DatatypeProperty ;
    rdfs:domain bio:BIOControl ;
    rdfs:range xsd:string ;
    rdfs:label "heeft IB-eigenschap"@nl .

bio:hasMaatregel rdf:type owl:DatatypeProperty ;
    rdfs:domain bio:OverheidsMaatregel ;
    rdfs:range xsd:string ;
    rdfs:label "heeft maatregeltekst"@nl .

bio:hasVerantwoordelijke rdf:type owl:DatatypeProperty ;
    rdfs:domain bio:BIOControl ;
    rdfs:range xsd:string ;
    rdfs:label "heeft verantwoordelijke"@nl .

bio:bioControlNummer rdf:type owl:DatatypeProperty ;
    rdfs:domain bio:BIOControl ;
    rdfs:range xsd:string ;
    rdfs:label "BIO controlenummer"@nl .

bio:bioMaatregelNummer rdf:type owl:DatatypeProperty ;
    rdfs:domain bio:OverheidsMaatregel ;
    rdfs:range xsd:string ;
    rdfs:label "BIO maatregelnummer"@nl .

bio:implementsControl rdf:type owl:ObjectProperty ;
    rdfs:domain bio:OverheidsMaatregel ;
    rdfs:range bio:BIOControl ;
    rdfs:label "implementeert beheersmaatregel"@nl .

bio:hasOverheidsMaatregel rdf:type owl:ObjectProperty ;
    owl:inverseOf bio:implementsControl ;
    rdfs:domain bio:BIOControl ;
    rdfs:range bio:OverheidsMaatregel ;
    rdfs:label "heeft overheidsmaatregel"@nl .

bio:correspondsToISO rdf:type owl:ObjectProperty ;
    rdfs:domain bio:BIOControl ;
    rdfs:range ctrl:Control ;
    rdfs:label "correspondeert met ISO 27002 control"@nl .



# ── 5.01: Beleidsregels voor informatiebeveiliging ──
bio:ISO27002_5_01 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Beleidsregels voor informatiebeveiliging"@nl ;
    rdfs:comment "Informatiebeveiligingsbeleid en onderwerpspecifieke beleidsregels behoren te worden gedefinieerd, goedgekeurd door het management, gepubliceerd, gecommuniceerd aan en erkend door relevant personeel en relevante belanghebbenden en met geplande tussenp"@nl ;
    bio:bioControlNummer "5.01" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Secretaris/Algemeen directeur" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_01 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_01_1 , bio:BIO2_5_01_2 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_01_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.01.1"@nl ;
    bio:bioMaatregelNummer "5.01.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "De organisatie heeft een informatiebeveiligingsbeleid opgesteld. Dit beleid is vastgesteld door de leiding van de organisatie en bevat ten minste de volgende punten:\n(a) De strategische uitgangspunten en randvoorwaarden die de organisatie hanteert voor informatiebeveiliging en in het bijzonder de inbedding in en afstemming op het algemene beveiligingsbeleid en het informatievoorzieningsbeleid.\n(b) De organisatie van de informatiebeveiligingsfunctie, waaronder verantwoordelijkheden, taken en be" ;
    bio:implementsControl bio:ISO27002_5_01 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_01_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.01.2"@nl ;
    bio:bioMaatregelNummer "5.01.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Het informatiebeveiligingsbeleid wordt periodiek en in aansluiting bij de (bestaande) bestuurs- en Planning & Control (P&C)-cycli en externe ontwikkelingen beoordeeld en zo nodig bijgesteld." ;
    bio:implementsControl bio:ISO27002_5_01 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.02: Rollen en verantwoordelijkheden bij informatiebeveiligi ──
bio:ISO27002_5_02 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Rollen en verantwoordelijkheden bij informatiebeveiliging"@nl ;
    rdfs:comment "Rollen en verantwoordelijkheden bij informatiebeveiliging behoren te worden gedefinieerd en toegewezen overeenkomstig de behoeften van de organisatie."@nl ;
    bio:bioControlNummer "5.02" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Secretaris/Algemeen directeur" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_02 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_02_1 , bio:BIO2_5_02_2 , bio:BIO2_5_02_3 , bio:BIO2_5_02_4 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_02_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.02.1"@nl ;
    bio:bioMaatregelNummer "5.02.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "De leiding van de organisatie heeft vastgelegd wat de verantwoordelijkheden en rollen zijn op het gebied van informatiebeveiliging binnen haar organisatie." ;
    bio:implementsControl bio:ISO27002_5_02 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_02_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.02.2"@nl ;
    bio:bioMaatregelNummer "5.02.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "De verantwoordelijkheden en rollen ten aanzien van informatiebeveiliging zijn gebaseerd op relevante voorschriften en wetten." ;
    bio:implementsControl bio:ISO27002_5_02 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_02_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.02.3"@nl ;
    bio:bioMaatregelNummer "5.02.3" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "De rol en verantwoordelijkheden van de Chief Information Security Officer (CISO) zijn in een CISO-functieprofiel vastgelegd." ;
    bio:implementsControl bio:ISO27002_5_02 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_02_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.02.4"@nl ;
    bio:bioMaatregelNummer "5.02.4" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Er is een CISO aangesteld conform een vastgesteld CISO-functieprofiel." ;
    bio:implementsControl bio:ISO27002_5_02 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.03: Functiescheiding ──
bio:ISO27002_5_03 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Functiescheiding"@nl ;
    rdfs:comment "Conflicterende taken en conflicterende verantwoordelijkheden behoren te worden gescheiden."@nl ;
    bio:bioControlNummer "5.03" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_03 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_03_1 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_03_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.03.1"@nl ;
    bio:bioMaatregelNummer "5.03.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Er zijn maatregelen getroffen die onbedoelde of ongeautoriseerde toegang tot bedrijfsmiddelen waarnemen of voorkomen." ;
    bio:implementsControl bio:ISO27002_5_03 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.04: Managementverantwoordelijkheden ──
bio:ISO27002_5_04 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Managementverantwoordelijkheden"@nl ;
    rdfs:comment "Het management behoort van al het personeel te eisen dat ze informatiebeveiliging toepassen overeenkomstig het vastgestelde informatiebeveiligingsbeleid, de onderwerpspecifieke beleidsregels en procedures van de organisatie."@nl ;
    bio:bioControlNummer "5.04" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Secretaris/Algemeen directeur" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_04 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_04_1 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_04_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.04.1"@nl ;
    bio:bioMaatregelNummer "5.04.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Er is aansluiting bij een klokkenluidersregeling, zodat iedereen anoniem en veilig beveiligingsissues kan melden." ;
    bio:implementsControl bio:ISO27002_5_04 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.05: Contact met overheidsinstanties ──
bio:ISO27002_5_05 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Contact met overheidsinstanties"@nl ;
    rdfs:comment "De organisatie behoort contact met de relevante instanties te leggen en te onderhouden."@nl ;
    bio:bioControlNummer "5.05" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasVerantwoordelijke "Secretaris/Algemeen directeur\nProceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_05 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_05_1 , bio:BIO2_5_05_2 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_05_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.05.1"@nl ;
    bio:bioMaatregelNummer "5.05.1" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "De organisatie heeft uitgewerkt wie met welke (overheids)instanties en toezichthouders contact heeft ten aanzien van informatiebeveiligingsaangelegenheden (vergunningen/incidenten/calamiteiten) en welke eisen voor deze aangelegenheden relevant zijn." ;
    bio:implementsControl bio:ISO27002_5_05 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_05_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.05.2"@nl ;
    bio:bioMaatregelNummer "5.05.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Het contactoverzicht wordt jaarlijks geactualiseerd." ;
    bio:implementsControl bio:ISO27002_5_05 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.06: Contact met speciale belangengroepen ──
bio:ISO27002_5_06 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Contact met speciale belangengroepen"@nl ;
    rdfs:comment "De organisatie behoort contacten met speciale belangengroepen of andere gespecialiseerde beveiligingsfora en beroepsverenigingen te leggen en te onderhouden."@nl ;
    bio:bioControlNummer "5.06" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_06 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.07: Informatie en analyses over dreigingen ──
bio:ISO27002_5_07 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Informatie en analyses over dreigingen"@nl ;
    rdfs:comment "Informatie met betrekking tot informatiebeveiligingsdreigingen behoort te worden verzameld en geanalyseerd om informatie en analyses over dreigingen te produceren."@nl ;
    bio:bioControlNummer "5.07" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasVerantwoordelijke "Secretaris/Algemeen directeur\nProceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_07 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.08: Informatiebeveiliging in projectmanagement ──
bio:ISO27002_5_08 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Informatiebeveiliging in projectmanagement"@nl ;
    rdfs:comment "Informatiebeveiliging behoort te worden geïntegreerd in projectmanagement."@nl ;
    bio:bioControlNummer "5.08" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasVerantwoordelijke "Proceseigenaar" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_08 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_08_1 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_08_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.08.1"@nl ;
    bio:bioMaatregelNummer "5.08.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Bij nieuwe informatiesystemen en bij wijzigingen op bestaande informatiesystemen moet een expliciete risicoafweging worden uitgevoerd ten behoeve van het vaststellen van de beveiligingseisen, uitgaande van de BIO." ;
    bio:implementsControl bio:ISO27002_5_08 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.09: Inventarisatie van informatie en andere gerelateerde be ──
bio:ISO27002_5_09 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Inventarisatie van informatie en andere gerelateerde bedrijfsmiddelen"@nl ;
    rdfs:comment "Er behoort een inventarislijst van informatie en andere gerelateerde bedrijfsmiddelen, met inbegrip van de eigenaren, te worden opgesteld en onderhouden."@nl ;
    bio:bioControlNummer "5.09" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_09 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.1: Aanvaard gebruik van informatie en andere gerelateerde  ──
bio:ISO27002_5_10 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Aanvaard gebruik van informatie en andere gerelateerde bedrijfsmiddelen"@nl ;
    rdfs:comment "Regels voor het aanvaardbaar gebruik van en procedures voor het omgaan met informatie en andere gerelateerde bedrijfsmiddelen behoren te worden geïdentificeerd, gedocumenteerd en geïmplementeerd."@nl ;
    bio:bioControlNummer "5.1" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Secretaris/Algemeen directeur\nProceseigenaar" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_01 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_10_1 , bio:BIO2_5_10_2 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_10_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.10.1"@nl ;
    bio:bioMaatregelNummer "5.10.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Alle medewerkers zijn aantoonbaar gewezen op de gedragsregels voor het gebruik van bedrijfsmiddelen." ;
    bio:implementsControl bio:ISO27002_5_10 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_10_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.10.2"@nl ;
    bio:bioMaatregelNummer "5.10.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "De gedragsregels voor het gebruik van bedrijfsmiddelen zijn voor extern personeel in het contract vastgelegd overeenkomstig de huisregels of gedragsregels." ;
    bio:implementsControl bio:ISO27002_5_10 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.11: Retourneren van bedrijfsmiddelen ──
bio:ISO27002_5_11 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Retourneren van bedrijfsmiddelen"@nl ;
    rdfs:comment "Personeel en andere belanghebbenden, al naargelang de situatie, behoren alle bedrijfsmiddelen van de organisatie die ze in hun bezit hebben bij beëindiging van hun dienstverband, contract of overeenkomst te retourneren."@nl ;
    bio:bioControlNummer "5.11" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Secretaris/Algemeen directeur" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_11 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.12: Classificeren van informatie ──
bio:ISO27002_5_12 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Classificeren van informatie"@nl ;
    rdfs:comment "Informatie behoort te worden geclassificeerd volgens de informatiebeveiligingsbehoeften van de organisatie, op basis van de eisen voor vertrouwelijkheid, integriteit, beschikbaarheid en relevante eisen van belanghebbenden."@nl ;
    bio:bioControlNummer "5.12" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_12 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_12_1 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_12_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.12.1"@nl ;
    bio:bioMaatregelNummer "5.12.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "De informatie in alle informatiesystemen is door middel van een expliciete risicoafweging geclassificeerd, zodat duidelijk is welke bescherming nodig is." ;
    bio:implementsControl bio:ISO27002_5_12 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.13: Labelen van informatie ──
bio:ISO27002_5_13 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Labelen van informatie"@nl ;
    rdfs:comment "Om informatie te labelen, behoort een passende reeks procedures te worden ontwikkeld en geïmplementeerd in overeenstemming met het informatieclassificatieschema dat is vastgesteld door de organisatie."@nl ;
    bio:bioControlNummer "5.13" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_13 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.14: Overdragen van informatie ──
bio:ISO27002_5_14 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Overdragen van informatie"@nl ;
    rdfs:comment "Er behoren regels, procedures of overeenkomsten voor informatieoverdracht te zijn ingesteld voor alle soorten van communicatiefaciliteiten binnen de organisatie en tussen de organisatie en andere partijen."@nl ;
    bio:bioControlNummer "5.14" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_14 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_14_1 , bio:BIO2_5_14_2 , bio:BIO2_5_14_3 , bio:BIO2_5_14_4 , bio:BIO2_5_14_5 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_14_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.14.1"@nl ;
    bio:bioMaatregelNummer "5.14.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Voor de beveiliging van elektronische (e-mail)berichten gelden de vastgestelde open standaarden tegen phishing en afluisteren op de ‘pas toe of leg uit’-lijst van het Forum Standaardisatie. Voor beveiliging van websiteverkeer gelden de open standaarden tegen afluisteren op de ‘pas toe of leg uit’-lijst van het Forum Standaardisatie." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_14_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.14.2"@nl ;
    bio:bioMaatregelNummer "5.14.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Voor veilige berichtenuitwisseling met basisregistraties wordt, conform de ‘pas toe of leg uit’-lijst van het Forum Standaardisatie, gebruik gemaakt van de actuele versie van Digikoppeling." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_14_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.14.3"@nl ;
    bio:bioMaatregelNummer "5.14.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Maak bij openbaar webverkeer van gevoelige gegevens gebruik van ten minste publiek vertrouwde Organization Validated-certificaten. Maak bij intern webverkeer voor gevoelige gegevens gebruik van ten minste publieke vertrouwde OV-certificaten of private PKIo-certificaten. Hogere eisen aan certificaten kunnen voortvloeien uit een risicoanalyse, aansluitvoorwaarden of wetgeving." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_14_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.14.4"@nl ;
    bio:bioMaatregelNummer "5.14.4" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Verzend gevoelige gegevens via e-mail alleen over onvertrouwde netwerken als de keten tussen verzender en ontvanger voldoende beveiligd is, zoals door het toepassen van maatregel 5.14.1." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_14_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.14.5"@nl ;
    bio:bioMaatregelNummer "5.14.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Om zekerheid te bieden over de integriteit van het elektronische bericht, wordt voor elektronische handtekeningen gebruik gemaakt van de AdES Baseline Profile standaard." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.15: Toegangsbeveiliging ──
bio:ISO27002_5_15 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Toegangsbeveiliging"@nl ;
    rdfs:comment "Er behoren regels op basis van bedrijfs- en informatiebeveiligingseisen te worden vastgesteld en geïmplementeerd om de fysieke en logische toegang tot informatie en andere gerelateerde bedrijfsmiddelen te beheersen."@nl ;
    bio:bioControlNummer "5.15" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_15 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_15_1 , bio:BIO2_5_15_2 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_15_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.15.1"@nl ;
    bio:bioMaatregelNummer "5.15.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Alleen geauthentiseerde apparatuur kan toegang krijgen tot een vertrouwde zone." ;
    bio:implementsControl bio:ISO27002_5_15 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_15_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.15.2"@nl ;
    bio:bioMaatregelNummer "5.15.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Gebruikers met eigen of ongeauthentiseerde apparatuur (Bring Your Own Device) krijgen alleen toegang tot een onvertrouwde zone." ;
    bio:implementsControl bio:ISO27002_5_15 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.16: Identiteitsbeheer ──
bio:ISO27002_5_16 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Identiteitsbeheer"@nl ;
    rdfs:comment "De volledige levenscyclus van identiteiten behoort te worden beheerd."@nl ;
    bio:bioControlNummer "5.16" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_16 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_16_1 , bio:BIO2_5_16_2 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_16_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.16.1"@nl ;
    bio:bioMaatregelNummer "5.16.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Er is een sluitende formele registratie- en afmeldprocedure voor het beheren van gebruikersidentificaties." ;
    bio:implementsControl bio:ISO27002_5_16 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_16_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.16.2"@nl ;
    bio:bioMaatregelNummer "5.16.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Het gebruiken van groepsaccounts is niet toegestaan, tenzij dit wordt gemotiveerd en vastgelegd door de proceseigenaar." ;
    bio:implementsControl bio:ISO27002_5_16 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.17: Authenticatie-informatie ──
bio:ISO27002_5_17 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Authenticatie-informatie"@nl ;
    rdfs:comment "De toewijzing en het beheer van authenticatie-informatie behoort te worden beheerst door middel van een beheerproces waarvan het adviseren van het personeel over de juiste manier van omgaan met authenticatie-informatie deel uitmaakt."@nl ;
    bio:bioControlNummer "5.17" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_17 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_17_1 , bio:BIO2_5_17_2 , bio:BIO2_5_17_3 , bio:BIO2_5_17_4 , bio:BIO2_5_17_5 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_17_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.17.1"@nl ;
    bio:bioMaatregelNummer "5.17.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Bij het aanloggen op een vertrouwde zone:\n(a) is het gebruik van tweefactor-authenticatie altijd verplicht;\n(b) is de minimale wachtwoordlengte 12 posities en wordt het wachtwoord minimaal halfjaarlijks vernieuwd als geen tweefactor-authenticatie mogelijk is (zie ook 8.5.1);\n(c) mogen wachtwoorden niet worden hergebruikt;\n(d) zijn de tekens van een wachtwoord zo willekeurig mogelijk gekozen dat individuele tekens of combinaties van tekens geen voorspellende waarde hebben voor de rest van het" ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_17_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.17.2"@nl ;
    bio:bioMaatregelNummer "5.17.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Medewerkers worden ondersteund in het beheren van hun wachtwoorden door het beschikbaar stellen van een wachtwoordmanager of een vergelijkbaar systeem." ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_17_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.17.3"@nl ;
    bio:bioMaatregelNummer "5.17.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Een wachtwoordmanager is in staat om een waarschuwing te geven als de combinatie van account en wachtwoord voorkomt op lijsten met gecompromitteerde wachtwoorden of het vermoeden bestaat dat het wachtwoord gecompromitteerd is. In dat geval moet het wachtwoord worden gewijzigd." ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_17_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.17.4"@nl ;
    bio:bioMaatregelNummer "5.17.4" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "De eisen aan wachtwoorden moeten geautomatiseerd worden afgedwongen." ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_17_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.17.5"@nl ;
    bio:bioMaatregelNummer "5.17.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Van initiële wachtwoorden en wachtwoorden die gereset zijn, wordt automatisch afgedwongen dat deze bij het eerste gebruik worden gewijzigd." ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.18: Toegangsrechten ──
bio:ISO27002_5_18 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Toegangsrechten"@nl ;
    rdfs:comment "Toegangsrechten voor informatie en andere gerelateerde bedrijfsmiddelen behoren te worden verstrekt, beoordeeld, aangepast en verwijderd overeenkomstig het onderwerpspecifieke beleid en de regels inzake toegangsbeveiliging van de organisatie."@nl ;
    bio:bioControlNummer "5.18" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_18 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_18_1 , bio:BIO2_5_18_2 , bio:BIO2_5_18_4 , bio:BIO2_5_18_6 , bio:BIO2_5_18_3 , bio:BIO2_5_18_5 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_18_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.18.1"@nl ;
    bio:bioMaatregelNummer "5.18.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Er is uitsluitend toegang verleend tot informatiesystemen na autorisatie door een bevoegde functionaris." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_18_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.18.2"@nl ;
    bio:bioMaatregelNummer "5.18.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Op basis van een risicoafweging is bepaald waar en op welke wijze functiescheiding wordt toegepast en welke toegangsrechten worden gegeven." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_18_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.18.4"@nl ;
    bio:bioMaatregelNummer "5.18.4" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Alle uitgegeven toegangsrechten worden minimaal eenmaal per jaar beoordeeld." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_18_6 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.18.6"@nl ;
    bio:bioMaatregelNummer "5.18.6" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Ongeautoriseerde afwijkingen op of ongeautoriseerde aanpassingen aan uitgegeven toegangsrechten worden beschouwd als beveiligingsgebeurtenis en als zodanig vastgelegd en afgehandeld." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_18_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.18.3"@nl ;
    bio:bioMaatregelNummer "5.18.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Er is een actueel mandaatregister of er zijn functieprofielen waaruit blijkt welke personen bevoegdheden hebben voor het verlenen van toegangsrechten." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_18_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.18.5"@nl ;
    bio:bioMaatregelNummer "5.18.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Alle uitgegeven toegangsrechten worden minimaal eenmaal per halfjaar beoordeeld." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.19: Informatiebeveiliging in leveranciersrelaties ──
bio:ISO27002_5_19 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Informatiebeveiliging in leveranciersrelaties"@nl ;
    rdfs:comment "Er behoren processen en procedures te worden vastgesteld en geïmplementeerd om de informatiebeveiligingsrisico’s in verband met het gebruik van producten of diensten van de leverancier te beheersen."@nl ;
    bio:bioControlNummer "5.19" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Secretaris/Algemeen directeur\nProceseigenaar" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_19 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_19_1 , bio:BIO2_5_19_2 , bio:BIO2_5_19_3 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_19_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.19.1"@nl ;
    bio:bioMaatregelNummer "5.19.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Bij offerteaanvragen waar informatie(voorziening) een rol speelt, worden inkoopeisen ten aanzien van informatiebeveiliging (beschikbaarheid, integriteit en vertrouwelijkheid) benoemd. Deze eisen zijn gebaseerd op een expliciete risicoafweging. Bijvoorbeeld kan gebruik gemaakt worden van de maatregelset uit de Inkoopeisen Cybersecurity Overheid (ICO)." ;
    bio:implementsControl bio:ISO27002_5_19 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_19_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.19.2"@nl ;
    bio:bioMaatregelNummer "5.19.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Op basis van een expliciete risicoafweging worden de beheersmaatregelen met betrekking tot leverancierstoegang tot bedrijfsinformatie vastgesteld." ;
    bio:implementsControl bio:ISO27002_5_19 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_19_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.19.3"@nl ;
    bio:bioMaatregelNummer "5.19.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Met alle leveranciers die als verwerker voor of namens de organisatie persoonsgegevens verwerken, worden verwerkersovereenkomsten gesloten waarin alle wettelijk vereiste afspraken zijn vastgesteld." ;
    bio:implementsControl bio:ISO27002_5_19 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.2: Adresseren van informatiebeveiliging in leveranciersove ──
bio:ISO27002_5_20 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Adresseren van informatiebeveiliging in leveranciersovereenkomsten"@nl ;
    rdfs:comment "Relevante informatiebeveiligingseisen behoren te worden vastgesteld en met elke leverancier op basis van het type leveranciersrelatie te worden overeengekomen."@nl ;
    bio:bioControlNummer "5.2" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_02 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_20_1 , bio:BIO2_5_20_2 , bio:BIO2_5_20_3 , bio:BIO2_5_20_4 , bio:BIO2_5_20_5 , bio:BIO2_5_20_6 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_20_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.20.1"@nl ;
    bio:bioMaatregelNummer "5.20.1" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "De beveiligingseisen uit de offerteaanvraag worden expliciet opgenomen in de (inkoop)contracten waar de verwerking van informatie een rol speelt." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_20_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.20.2"@nl ;
    bio:bioMaatregelNummer "5.20.2" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "In de inkoopcontracten worden expliciet prestatie-indicatoren en de bijbehorende verantwoordingsrapportages opgenomen." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_20_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.20.3"@nl ;
    bio:bioMaatregelNummer "5.20.3" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "In situaties waarin contractvoorwaarden worden opgelegd door leveranciers, is voorafgaand aan het tekenen van het contract met een risicoafweging helder gemaakt wat de consequenties hiervan zijn voor de organisatie. Expliciet is gemaakt welke consequenties geaccepteerd worden, welke gemitigeerd moeten zijn en welke voorwaarden niet of nooit geaccepteerd mogen worden bij het aangaan van de overeenkomst." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_20_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.20.4"@nl ;
    bio:bioMaatregelNummer "5.20.4" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasMaatregel "Ter waarborging van vertrouwelijkheid of geheimhouding worden bij IT-inkopen standaardvoorwaarden voor inkoop gehanteerd." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_20_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.20.5"@nl ;
    bio:bioMaatregelNummer "5.20.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Voordat een contract wordt afgesloten, wordt in een risicoafweging bepaald of de afhankelijkheid van een leverancier beheersbaar is. Een vast onderdeel van het contract is een expliciete uitwerking van de exit-strategie." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_20_6 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.20.6"@nl ;
    bio:bioMaatregelNummer "5.20.6" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "In inkoopcontracten wordt expliciet de mogelijkheid van een externe audit opgenomen waarmee de betrouwbaarheid van de geleverde dienst kan worden getoetst. Een audit is niet nodig als de contractant door middel van certificering aantoont dat de gewenste betrouwbaarheid van de dienst is geborgd." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.21: Beheren van informatiebeveiliging in de ICT-toelevering ──
bio:ISO27002_5_21 rdf:type bio:BIOControl , owl:NamedIndividual ;
    rdfs:label "Beheren van informatiebeveiliging in de ICT-toeleveringsketen"@nl ;
    rdfs:comment "Er behoren processen en procedures te worden bepaald en geïmplementeerd om de informatiebeveiligingsrisico’s in verband met de toeleveringsketen van ICT-producten en -diensten te beheersen."@nl ;
    bio:bioControlNummer "5.21" ;
    bio:hasControlType "Organisatorisch" ;
    ext:hasHandreikingBBN 1 ;
    bio:hasVerantwoordelijke "Proceseigenaar\nDienstenleverancier" ;
    bio:hasIBEigenschap "#Vertrouwelijkheid\n#Integriteit\n#Beschikbaarheid" ;
    bio:correspondsToISO ctrl:ISO27002_5_21 ;
    bio:hasOverheidsMaatregel bio:BIO2_5_21_1 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_5_21_1 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 5.21.1"@nl ;
    bio:bioMaatregelNummer "5.21.1" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Leveranciers moeten gedurende de looptijd van het contract:\n(a) hun keten van toeleveranciers bekendmaken;\n(b) transparant zijn over de maatregelen die zij genomen hebben om de aan hen opgelegde eisen ook door te vertalen naar hun toeleveranciers;\n(c) transparant zijn over de resultaten van de controle bij toeleveranciers over de aan hen opgelegde maatregelen, zie ook paragraaf 4.4;\n(d) risico's terugmelden." ;
    bio:implementsControl bio:ISO27002_5_21 ;
    ctrl:definedInFramework fw:BIO_2_0 .

# ── 5.22: Monitoren, beoordelen en het beheren van wijzigingen va ──
