    bio:bioMaatregelNummer "7.07.1" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Een onbemenste werkplek is altijd vergrendeld." ;
    bio:implementsControl bio:ISO27002_7_07 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_07_2 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.07.2"@nl ;
    bio:bioMaatregelNummer "7.07.2" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Informatie wordt automatisch ontoegankelijk gemaakt met bijvoorbeeld een screensaver na een inactiviteit van maximaal 15 minuten." ;
    bio:implementsControl bio:ISO27002_7_07 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_07_3 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.07.3"@nl ;
    bio:bioMaatregelNummer "7.07.3" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Sessies op remote desktops worden op het remote platform vergrendeld na een vastgestelde periode." ;
    bio:implementsControl bio:ISO27002_7_07 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_07_4 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.07.4"@nl ;
    bio:bioMaatregelNummer "7.07.4" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Het overnemen van sessies op remote werkplekken op een andere werkplek is alleen mogelijk via dezelfde beveiligde loginprocedure als waarmee de sessie is gecreëerd. Na een expliciete risicoafweging mag hiervan worden afgeweken." ;
    bio:implementsControl bio:ISO27002_7_07 ;
    ctrl:definedInFramework fw:BIO_2_0 .

bio:BIO2_7_07_5 rdf:type bio:OverheidsMaatregel , owl:NamedIndividual ;
    rdfs:label "BIO2 Maatregel 7.07.5"@nl ;
    bio:bioMaatregelNummer "7.07.5" ;
    ext:hasHandreikingBBN 2 ;
    bio:hasMaatregel "Bij het gebruik van een chipcardtoken voor toegang tot systemen wordt bij het verwijderen van het token de toegangsbeveiligingsvergrendeling automatisch geactiveerd." ;
    bio:implementsControl bio:ISO27002_7_07 ;
    ctrl:definedInFramework fw:BIO_2_0 .

