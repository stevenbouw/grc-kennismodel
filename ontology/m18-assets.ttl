@prefix fw:      <https://grc.example.org/framework/> .
@prefix ctrl:    <https://grc.example.org/control/> .
@prefix risk:    <https://grc.example.org/risk/> .
@prefix roles:   <https://grc.example.org/roles/> .
@prefix compl:   <https://grc.example.org/compliance/> .
@prefix isms:    <https://grc.example.org/isms/> .
@prefix biz:     <https://grc.example.org/business/> .
@prefix bio:     <https://grc.example.org/bio/> .
@prefix ext:     <https://grc.example.org/extended/> .
@prefix asset:   <https://grc.example.org/asset/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

# =============================================================================
# GRC Ontologie — Module M18: Asset (geconsolideerd)
# Versie: 4.2.1 | Datum: 2026-04-13 | Profiel: OWL 2 DL
# =============================================================================
#
# CONSOLIDATIE-RATIONALE (v4.2.1, 13 april 2026)
# Tijdens de M18-ontwikkeling (april 2026) ontstonden organisch vijf
# afzonderlijke bestanden door splitsingen in de uitvoering die niet via
# de masterchat-besluitvorming liepen. Bij de v4.2.0-oplevering werd dit
# door de masterchat opgemerkt en gecorrigeerd. v4.2.1 voert de
# oorspronkelijke afspraak alsnog door (één M18-module, één bestand),
# zonder semantische wijzigingen.
#
# Dit bestand bevat nu:
#   SECTIE 1 — TBox: hoofdklassen, sub-taxonomie, properties, SKOS-mappings
#   SECTIE 2 — Mappings: ISO 27002:2022 → asset-type (128 triples)
#   SECTIE 3 — Mappings: BIO 2.0 ISO27002-controls (inferentie-strategie)
#   SECTIE 4 — Mappings: BIO 2.0 Overheidsmaatregelen → asset-type (300 triples)
#   APPENDIX A — Patroon-statistieken voor overheidsmaatregelen (P1/P2/P3/P4)
#   APPENDIX B — Overrides-log
#
# M18 SHACL-shapes zijn gemigreerd naar grc-shacl.ttl (v4.2.1) als
# expliciet gelabelde post-inferentie sectie.
# =============================================================================
#
# Architecturale asset-typologie voor het GRC Kennismodel.
# Framework-neutraal (D9): basisstructuur uit ISO 27005:2024,
# aangevuld vanuit BVA-stelsel art. 1k, VIRBI 2025 en Besluit CIO-stelsel 2026.
#
# Masterchat-beslissingen (13 april 2026):
#   - D-M18-1: Namespace asset: https://grc.example.org/asset/ (akkoord)
#   - D-M18-2: appliesToAssetType in asset:-namespace (Optie 2b)
#   - D-M18-3: M06-stubs blijven; link via rdfs:seeAlso (Optie 3b)
#   - D-M18-4: BVA TBB als skos:Concept in M01 (separate patch)
#   - D-M18-5: Mens-systeem-relatie via asset:isOperatedBy (Optie A)
#
# Scope: Spoor A (TBox + klasse-niveau SKOS); geen instances.
# =============================================================================

<https://grc.example.org/ontology/m18-assets>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M18 — Asset"@nl ,
               "GRC Ontology Module M18 — Asset"@en ;
    rdfs:comment "Architecturale asset-typologie op basis van ISO 27005:2024, aangevuld met overheid-specifieke aspecten uit BVA-stelsel art. 1k (Te Beschermen Belangen), VIRBI 2025 en Besluit CIO-stelsel 2026 art. 1o. Onafhankelijk van de ISMS-administratieve asset-stubs in M06 (zie rdfs:seeAlso-relaties)."@nl ,
                 "Architectural asset typology based on ISO 27005:2024, supplemented with government-specific aspects from the BVA-stelsel art. 1k (Te Beschermen Belangen), VIRBI 2025 and Besluit CIO-stelsel 2026 art. 1o. Independent from the ISMS administrative asset stubs in M06 (see rdfs:seeAlso relations)."@en ;
    dcterms:created "2026-04-13"^^xsd:date ;
    owl:versionInfo "4.2.1" ;
    owl:imports <https://grc.example.org/ontology/> .

# =============================================================================
# 1. TOPLAAG — Asset en AssetComponent
# =============================================================================

asset:Asset
    rdf:type owl:Class ;
    rdfs:label "Asset"@en , "Bedrijfsmiddel"@nl ;
    rdfs:comment "Top-level class for any asset that has value to the organisation and requires protection. Framework-neutral root (D9). Subclasses cover the seven BVA Te Beschermen Belangen (BVA-stelsel 2021 art. 1k) and the ISO 27005:2024 asset categorisation."@en ,
                 "Topklasse voor elk bedrijfsmiddel dat waarde heeft voor de organisatie en bescherming vereist. Framework-neutrale basis (D9). Subklassen dekken de zeven BVA Te Beschermen Belangen (BVA-stelsel 2021 art. 1k) en de ISO 27005:2024-asset-categorisering."@nl ;
    dcterms:source "ISO/IEC 27005:2024; BVA-stelsel Rijksdienst 2021 art. 1k" ;
    rdfs:seeAlso isms:InformationAsset .

asset:AssetComponent
    rdf:type owl:Class ;
    rdfs:label "Asset Component"@en , "Bedrijfsmiddelcomponent"@nl ;
    rdfs:comment "A constituent part of an asset. Used as range (together with asset:Asset) for mereological relations (asset:hasComponent) and for control-applicability (asset:appliesToAssetType). Components are typed per asset subclass — see CIO-stelsel art. 1o for the canonical InformationSystem components."@en ,
                 "Een samenstellend onderdeel van een bedrijfsmiddel. Gebruikt als range (samen met asset:Asset) voor mereologische relaties (asset:hasComponent) en voor maatregeltoepasbaarheid (asset:appliesToAssetType). Componenten worden per asset-subklasse getypeerd — zie CIO-stelsel art. 1o voor de canonieke InformationSystem-componenten."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

# =============================================================================
# 2. VIJF HOOFDKLASSEN ASSET
# =============================================================================

# -----------------------------------------------------------------------------
# 2.1 InformationAsset
# -----------------------------------------------------------------------------

asset:InformationAsset
    rdf:type owl:Class ;
    rdfs:subClassOf asset:Asset ;
    rdfs:label "Information Asset"@en , "Informatiebedrijfsmiddel"@nl ;
    rdfs:comment "Information as a standalone asset: data, documents, knowledge. Includes classified information under VIRBI 2025. Distinct from asset:InformationSystem (which is the composite processing environment)."@en ,
                 "Informatie als zelfstandig bedrijfsmiddel: data, documenten, kennis. Omvat gerubriceerde informatie onder VIRBI 2025. Onderscheiden van asset:InformationSystem (dat de samengestelde verwerkingsomgeving is)."@nl ;
    dcterms:source "ISO/IEC 27005:2024; BVA-stelsel 2021 art. 1k (informatie); VIRBI 2025" ;
    rdfs:seeAlso isms:InformationAsset .
    # WAARSCHUWING: isms:InformationAsset (M06) is een ISMS-administratieve stub,
    # niet de architecturale asset-klasse. De rdfs:seeAlso is bewust een zachte
    # verwijzing; geen owl:equivalentClass (zou M06 formeel wijzigen).

# -----------------------------------------------------------------------------
# 2.2 InformationSystem
# -----------------------------------------------------------------------------

asset:InformationSystem
    rdf:type owl:Class ;
    rdfs:subClassOf asset:Asset ;
    rdfs:label "Information System"@en , "Informatiesysteem"@nl ;
    rdfs:comment "A composite asset consisting of data collections, procedures, processes, software and facilities for storage, processing and communication. Per Besluit CIO-stelsel Rijksdienst 2026 art. 1o. Components are linked via asset:hasComponent. Persons who operate the system are linked via asset:isOperatedBy — NOT via asset:hasComponent (masterchat decision D-M18-5: CIO-stelsel primary source, not VIRBI 2025 / VIR 2007 which do include 'personen' in the informatiesysteem definition)."@en ,
                 "Een samengesteld bedrijfsmiddel bestaande uit gegevensverzamelingen, procedures, processen, programmatuur en voorzieningen voor opslag, verwerking en communicatie. Conform Besluit CIO-stelsel Rijksdienst 2026 art. 1o. Componenten via asset:hasComponent. Personen die het systeem bedienen via asset:isOperatedBy — NIET via asset:hasComponent (masterchat-besluit D-M18-5: CIO-stelsel als primaire bron, niet VIRBI 2025 / VIR 2007 die 'personen' wel in de informatiesysteem-definitie opnemen)."@nl ;
    dcterms:source "ISO/IEC 27005:2024; Besluit CIO-stelsel Rijksdienst 2026 art. 1o; BVA-stelsel 2021 art. 1k (informatiesystemen)" .

# -----------------------------------------------------------------------------
# 2.3 PhysicalAsset + sub-klassen (BVA-splitsing)
# -----------------------------------------------------------------------------

asset:PhysicalAsset
    rdf:type owl:Class ;
    rdfs:subClassOf asset:Asset ;
    rdfs:label "Physical Asset"@en , "Fysiek bedrijfsmiddel"@nl ;
    rdfs:comment "Tangible assets: buildings, hardware, equipment, goods, objects. Sub-classed to align with the BVA-stelsel 2021 art. 1k distinction between materieel, goederen and objecten."@en ,
                 "Tastbare bedrijfsmiddelen: gebouwen, hardware, materieel, goederen, objecten. Subklassen volgen het onderscheid uit BVA-stelsel 2021 art. 1k tussen materieel, goederen en objecten."@nl ;
    dcterms:source "ISO/IEC 27005:2024; BVA-stelsel 2021 art. 1k" .

asset:Equipment
    rdf:type owl:Class ;
    rdfs:subClassOf asset:PhysicalAsset ;
    rdfs:label "Equipment"@en , "Materieel"@nl ;
    rdfs:comment "Equipment: durable operational resources such as hardware, tools, vehicles, specialised instruments. Corresponds to BVA-stelsel 2021 art. 1k 'materieel'."@en ,
                 "Materieel: duurzame operationele middelen zoals hardware, gereedschap, voertuigen, specialistische instrumenten. Correspondeert met BVA-stelsel 2021 art. 1k 'materieel'."@nl ;
    dcterms:source "BVA-stelsel Rijksdienst 2021 art. 1k" .

asset:TangibleGoods
    rdf:type owl:Class ;
    rdfs:subClassOf asset:PhysicalAsset ;
    rdfs:label "Tangible Goods"@en , "Goederen"@nl ;
    rdfs:comment "Consumable or inventoried tangible goods. Corresponds to BVA-stelsel 2021 art. 1k 'goederen'. Distinct from Equipment (durable) and PhysicalObject (other protectable objects)."@en ,
                 "Verbruiksgoederen of inventarisgoederen. Correspondeert met BVA-stelsel 2021 art. 1k 'goederen'. Onderscheiden van Materieel (duurzaam) en PhysicalObject (overige beschermwaardige objecten)."@nl ;
    dcterms:source "BVA-stelsel Rijksdienst 2021 art. 1k" .

asset:PhysicalObject
    rdf:type owl:Class ;
    rdfs:subClassOf asset:PhysicalAsset ;
    rdfs:label "Physical Object"@en , "Fysiek object"@nl ;
    rdfs:comment "Protectable physical objects not covered by Equipment or TangibleGoods — e.g. buildings, secure rooms, facilities. Corresponds to BVA-stelsel 2021 art. 1k 'objecten'."@en ,
                 "Beschermwaardige fysieke objecten die niet onder Materieel of Goederen vallen — bijv. gebouwen, beveiligde ruimten, voorzieningen. Correspondeert met BVA-stelsel 2021 art. 1k 'objecten'."@nl ;
    dcterms:source "BVA-stelsel Rijksdienst 2021 art. 1k" .
    # WAARSCHUWING: naam 'PhysicalObject' i.p.v. 'Object' gekozen om verwarring
    # met het generieke begrip 'object' (OWL/RDF) te voorkomen.

# -----------------------------------------------------------------------------
# 2.4 HumanAsset
# -----------------------------------------------------------------------------

asset:HumanAsset
    rdf:type owl:Class ;
    rdfs:subClassOf asset:Asset ;
    rdfs:label "Human Asset"@en , "Personeel bedrijfsmiddel"@nl ;
    rdfs:comment "Persons as protectable assets: employees, external staff, role-holders. Per masterchat-decision D-M18-5, persons are NOT modelled as components of InformationSystem (Option A). The operator-relation is expressed via asset:isOperatedBy. Role-assignment is handled by the M04 roles-module."@en ,
                 "Personen als beschermwaardige bedrijfsmiddelen: medewerkers, externen, rolhouders. Conform masterchat-besluit D-M18-5 worden personen NIET als component van InformationSystem gemodelleerd (Optie A). De bedienings-relatie wordt uitgedrukt via asset:isOperatedBy. Rolkoppeling valt onder M04 rollen-module."@nl ;
    dcterms:source "ISO/IEC 27005:2024; BVA-stelsel 2021 art. 1k (personen)" ;
    rdfs:seeAlso roles:Role .

# -----------------------------------------------------------------------------
# 2.5 IntangibleAsset
# -----------------------------------------------------------------------------

asset:IntangibleAsset
    rdf:type owl:Class ;
    rdfs:subClassOf asset:Asset ;
    rdfs:label "Intangible Asset"@en , "Immaterieel bedrijfsmiddel"@nl ;
    rdfs:comment "Intangible assets: reputation, image, trust. Added beyond ISO 27005:2024 to cover BVA-stelsel 2021 art. 1k 'imago'. Has no physical components but can be affected by incidents involving other asset-types."@en ,
                 "Immateriële bedrijfsmiddelen: reputatie, imago, vertrouwen. Toegevoegd bovenop ISO 27005:2024 om BVA-stelsel 2021 art. 1k 'imago' te dekken. Heeft geen fysieke componenten maar kan worden geraakt door incidenten bij andere asset-types."@nl ;
    dcterms:source "BVA-stelsel Rijksdienst 2021 art. 1k (imago); aanvulling op ISO/IEC 27005:2024" .

# =============================================================================
# 3. COMPONENT-KLASSEN (per CIO-stelsel 2026 art. 1o)
# =============================================================================
# De onderstaande klassen typeren de componenten van asset:InformationSystem.
# Voor andere asset-types (PhysicalAsset → ruimtes; HumanAsset → vetting-status)
# worden componenten pas in latere iteraties toegevoegd.

asset:DataCollection
    rdf:type owl:Class ;
    rdfs:subClassOf asset:AssetComponent ;
    rdfs:label "Data Collection"@en , "Gegevensverzameling"@nl ;
    rdfs:comment "A structured or unstructured collection of data that is part of an information system. Per CIO-stelsel 2026 art. 1o 'gegevensverzameling'."@en ,
                 "Een gestructureerde of ongestructureerde verzameling gegevens die deel uitmaakt van een informatiesysteem. Per CIO-stelsel 2026 art. 1o 'gegevensverzameling'."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

asset:Procedure
    rdf:type owl:Class ;
    rdfs:subClassOf asset:AssetComponent ;
    rdfs:label "Procedure (system component)"@en , "Procedure (systeemcomponent)"@nl ;
    rdfs:comment "An operational procedure that forms part of an information system (e.g. operational runbooks, administration procedures). Per CIO-stelsel 2026 art. 1o 'procedure'. Distinct from isms:Procedure (M06) which is an ISMS-documentation artefact, not a system component."@en ,
                 "Een operationele procedure die deel uitmaakt van een informatiesysteem (bijv. operationele runbooks, beheerprocedures). Per CIO-stelsel 2026 art. 1o 'procedure'. Onderscheiden van isms:Procedure (M06) dat een ISMS-documentatie-artefact is, geen systeemcomponent."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" ;
    rdfs:seeAlso isms:Procedure .

asset:SystemProcess
    rdf:type owl:Class ;
    rdfs:subClassOf asset:AssetComponent ;
    rdfs:label "System Process"@en , "Systeemproces"@nl ;
    rdfs:comment "A process executing within an information system. Per CIO-stelsel 2026 art. 1o 'proces'. Naming 'SystemProcess' (not 'Process') to avoid ambiguity with business-processes (biz:) or risk-processes (risk:)."@en ,
                 "Een proces dat binnen een informatiesysteem wordt uitgevoerd. Per CIO-stelsel 2026 art. 1o 'proces'. Naamgeving 'SystemProcess' (niet 'Process') om verwarring met bedrijfsprocessen (biz:) of risicoprocessen (risk:) te voorkomen."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

asset:Software
    rdf:type owl:Class ;
    rdfs:subClassOf asset:AssetComponent ;
    rdfs:label "Software"@en , "Programmatuur"@nl ;
    rdfs:comment "Software components of an information system: applications, services, libraries, firmware. Per CIO-stelsel 2026 art. 1o 'programmatuur'."@en ,
                 "Programmatuur-componenten van een informatiesysteem: applicaties, diensten, libraries, firmware. Per CIO-stelsel 2026 art. 1o 'programmatuur'."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

asset:Facility
    rdf:type owl:Class ;
    rdfs:subClassOf asset:AssetComponent ;
    rdfs:label "Facility (system component)"@en , "Voorziening (systeemcomponent)"@nl ;
    rdfs:comment "A facility that supports an information system: storage, processing or communication. Per CIO-stelsel 2026 art. 1o 'voorzieningen voor opslag, verwerking en communicatie'. Subclassed into StorageFacility, ProcessingFacility and CommunicationFacility."@en ,
                 "Een voorziening die een informatiesysteem ondersteunt: opslag, verwerking of communicatie. Per CIO-stelsel 2026 art. 1o 'voorzieningen voor opslag, verwerking en communicatie'. Gesubklasseerd in StorageFacility, ProcessingFacility en CommunicationFacility."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

asset:StorageFacility
    rdf:type owl:Class ;
    rdfs:subClassOf asset:Facility ;
    rdfs:label "Storage Facility"@en , "Opslagvoorziening"@nl ;
    rdfs:comment "Storage facility component of an information system (e.g. storage arrays, databases at infrastructure level, archive systems)."@en ,
                 "Opslagvoorzieningscomponent van een informatiesysteem (bijv. storage arrays, databases op infrastructuurniveau, archiefsystemen)."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

asset:ProcessingFacility
    rdf:type owl:Class ;
    rdfs:subClassOf asset:Facility ;
    rdfs:label "Processing Facility"@en , "Verwerkingsvoorziening"@nl ;
    rdfs:comment "Processing facility component of an information system (e.g. compute clusters, application servers, container platforms)."@en ,
                 "Verwerkingsvoorzieningscomponent van een informatiesysteem (bijv. compute clusters, applicatieservers, containerplatforms)."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

asset:CommunicationFacility
    rdf:type owl:Class ;
    rdfs:subClassOf asset:Facility ;
    rdfs:label "Communication Facility"@en , "Communicatievoorziening"@nl ;
    rdfs:comment "Communication facility component of an information system (e.g. networks, VPN, message brokers, APIs at infrastructure level)."@en ,
                 "Communicatievoorzieningscomponent van een informatiesysteem (bijv. netwerken, VPN, message brokers, API's op infrastructuurniveau)."@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

# =============================================================================
# 4. OBJECT PROPERTIES
# =============================================================================

# -----------------------------------------------------------------------------
# 4.1 Mereologie — hasComponent / isComponentOf
# -----------------------------------------------------------------------------

asset:hasComponent
    rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain asset:Asset ;
    rdfs:range asset:AssetComponent ;
    owl:inverseOf asset:isComponentOf ;
    rdfs:label "has component"@en , "heeft component"@nl ;
    rdfs:comment "Mereological part-whole relation: the subject-asset has the object as a constituent component. Transitive: if A hasComponent B and B hasComponent C, then A hasComponent C. Usage varies per asset-subclass; for InformationSystem, components are typed per CIO-stelsel 2026 art. 1o."@en ,
                 "Mereologische deel-geheel-relatie: het subject-bedrijfsmiddel heeft het object als samenstellende component. Transitief: als A hasComponent B en B hasComponent C, dan A hasComponent C. Gebruik varieert per asset-subklasse; voor InformationSystem worden componenten getypeerd per CIO-stelsel 2026 art. 1o."@nl ;
    dcterms:source "Masterchat-besluit A4.3 (13 april 2026)" .

asset:isComponentOf
    rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain asset:AssetComponent ;
    rdfs:range asset:Asset ;
    owl:inverseOf asset:hasComponent ;
    rdfs:label "is component of"@en , "is component van"@nl ;
    rdfs:comment "Inverse of asset:hasComponent. Transitive."@en ,
                 "Inverse van asset:hasComponent. Transitief."@nl .

# -----------------------------------------------------------------------------
# 4.2 Mens-systeem-relatie — isOperatedBy
# -----------------------------------------------------------------------------

asset:isOperatedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain asset:InformationSystem ;
    rdfs:range asset:HumanAsset ;
    rdfs:label "is operated by"@en , "wordt bediend door"@nl ;
    rdfs:comment "Relates an information system to the persons who operate it. Distinct from asset:hasComponent (masterchat-decision D-M18-5, Option A): persons are not mereological parts of a system. Note: VIR 2007 art. 1b, VIRBI 2025 art. 1 and BIO 2.0 DO include 'personen' in their information-system definition; this model follows Besluit CIO-stelsel 2026 art. 1o as primary source for architectural cleanliness."@en ,
                 "Koppelt een informatiesysteem aan de personen die het bedienen. Onderscheiden van asset:hasComponent (masterchat-besluit D-M18-5, Optie A): personen zijn geen mereologische delen van een systeem. Noot: VIR 2007 art. 1b, VIRBI 2025 art. 1 en BIO 2.0 noemen 'personen' WEL in hun informatiesysteem-definitie; dit model volgt Besluit CIO-stelsel 2026 art. 1o als primaire bron voor architecturale zuiverheid."@nl ;
    dcterms:source "Masterchat-besluit D-M18-5 (13 april 2026); Besluit CIO-stelsel Rijksdienst 2026 art. 1o" .

asset:operates
    rdf:type owl:ObjectProperty ;
    rdfs:domain asset:HumanAsset ;
    rdfs:range asset:InformationSystem ;
    owl:inverseOf asset:isOperatedBy ;
    rdfs:label "operates"@en , "bedient"@nl ;
    rdfs:comment "Inverse of asset:isOperatedBy. Relates a person-asset to information systems they operate."@en ,
                 "Inverse van asset:isOperatedBy. Koppelt een persoons-bedrijfsmiddel aan de informatiesystemen die zij bedient."@nl .

# -----------------------------------------------------------------------------
# 4.3 Control-toepasbaarheid — appliesToAssetType
# -----------------------------------------------------------------------------

asset:AssetOrComponent
    rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf ( asset:Asset asset:AssetComponent )
    ] ;
    rdfs:label "Asset or Component"@en , "Bedrijfsmiddel of component"@nl ;
    rdfs:comment "Union class of asset:Asset and asset:AssetComponent. Used as rdfs:range for asset:appliesToAssetType. Masterchat-decision A4.4: one property with union-range rather than two separate properties."@en ,
                 "Unieklasse van asset:Asset en asset:AssetComponent. Gebruikt als rdfs:range voor asset:appliesToAssetType. Masterchat-besluit A4.4: één property met union-range in plaats van twee aparte properties."@nl ;
    dcterms:source "Masterchat-besluit A4.4 (13 april 2026)" .

asset:appliesToAssetType
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range asset:AssetOrComponent ;
    rdfs:label "applies to asset type"@en , "is van toepassing op bedrijfsmiddeltype"@nl ;
    rdfs:comment "Relates a control to the asset type(s) — asset-class or component-class — for which it is relevant. Class-level property (Spoor A): the object is an asset-class, not an instance. Instance-level applicability (Spoor B) follows once the asset inventory is populated. Placed in asset:-namespace per masterchat-decision D-M18-2 (Option 2b) to respect the no-changes-to-M02 constraint (DEEL 7.3 of M18 chatstarter)."@en ,
                 "Koppelt een beheersmaatregel aan het asset-type (of component-type) waarvoor deze relevant is. Klasse-niveau-property (Spoor A): het object is een asset-klasse, geen instance. Instance-niveau-toepasbaarheid (Spoor B) volgt zodra de asset-inventaris is gevuld. Geplaatst in asset:-namespace per masterchat-besluit D-M18-2 (Optie 2b) om de geen-wijzigingen-in-M02-constraint te respecteren (DEEL 7.3 van M18 chatstarter)."@nl ;
    dcterms:source "Masterchat-besluiten A4.4 en D-M18-2 (13 april 2026)" .

asset:hasApplicableControl
    rdf:type owl:ObjectProperty ;
    rdfs:domain asset:AssetOrComponent ;
    rdfs:range ctrl:Control ;
    owl:inverseOf asset:appliesToAssetType ;
    rdfs:label "has applicable control"@en , "heeft toepasselijke beheersmaatregel"@nl ;
    rdfs:comment "Inverse of asset:appliesToAssetType. Enables two-way querying: given an asset-type, find all applicable controls."@en ,
                 "Inverse van asset:appliesToAssetType. Maakt tweezijdige bevraging mogelijk: gegeven een asset-type, vind alle toepasselijke beheersmaatregelen."@nl .

# =============================================================================
# 5. SKOS-MAPPINGS — BVA Te Beschermen Belangen → M18-klassen
# =============================================================================
# Zeven Te Beschermen Belangen uit BVA-stelsel Rijksdienst 2021 art. 1k:
#   personen, informatie, informatiesystemen, materieel, goederen, imago, objecten
#
# De skos:Concept-individuals worden geleverd in de M01-patch (zie
# m01-patch-bva-tbb.ttl). Onderstaande mappings leggen hun relatie met de
# M18-klassen vast.
# =============================================================================

fw:TBB_Personen skos:exactMatch asset:HumanAsset .
asset:HumanAsset skos:exactMatch fw:TBB_Personen .

fw:TBB_Informatie skos:exactMatch asset:InformationAsset .
asset:InformationAsset skos:exactMatch fw:TBB_Informatie .

fw:TBB_Informatiesystemen skos:exactMatch asset:InformationSystem .
asset:InformationSystem skos:exactMatch fw:TBB_Informatiesystemen .

fw:TBB_Materieel skos:exactMatch asset:Equipment .
asset:Equipment skos:exactMatch fw:TBB_Materieel .

fw:TBB_Goederen skos:exactMatch asset:TangibleGoods .
asset:TangibleGoods skos:exactMatch fw:TBB_Goederen .

fw:TBB_Objecten skos:exactMatch asset:PhysicalObject .
asset:PhysicalObject skos:exactMatch fw:TBB_Objecten .

fw:TBB_Imago skos:exactMatch asset:IntangibleAsset .
asset:IntangibleAsset skos:exactMatch fw:TBB_Imago .


# =============================================================================
# SECTIE 2 — MAPPINGS: ISO 27002:2022 CONTROLS → ASSET-TYPE
# =============================================================================
# 93 ISO 27002:2022-controls gekoppeld aan asset-types via
# asset:appliesToAssetType (klasse-niveau, Spoor A).
#
# Mapping-conventies V1-V8 vastgesteld door masterchat (13 april 2026):
#   V1  elke asset-rakende control krijgt één of meer triples
#   V2  mapping op klasse-niveau (Spoor A), geen instances
#   V3  meest specifieke subklasse waar de control direct relevant is
#   V4  meerdere asset-types = meerdere triples (geen unieklasse)
#   V5  component-specifieke controls wijzen naar component-klasse;
#       niet-exclusief met V4 (een control kan zowel component-specifieke
#       als asset-niveau triples hebben als beide direct relevant zijn)
#   V6a governance-controls → asset:Asset (toplaag) + WAARSCHUWING-tag
#   V7a proces-controls (over informatie) → asset:InformationAsset + tag
#   V8  multi-laag: meerdere klassen op verschillende lagen, maar nooit
#       tussenlagen waar geen directe maatregel landt (niet naar "vehikels")
#
# WAARSCHUWING-tags (compact): [V6-governance], [V7-proces], [BCM-raakvlak],
# [utilities], [privacy], [VIRBI]
# =============================================================================
# =============================================================================
# GRC Ontologie — M18 Mappings: ISO 27002:2022 → asset-type
# Versie: 4.2.0 | Datum: 2026-04-13 | Profiel: OWL 2 DL
# =============================================================================
#
# 93 ISO 27002:2022-controls gekoppeld aan asset-types via
# asset:appliesToAssetType (klasse-niveau, Spoor A).
#
# Mapping-conventies V1-V8 vastgesteld door masterchat (13 april 2026):
#   V1  elke asset-rakende control krijgt één of meer triples
#   V2  mapping op klasse-niveau (Spoor A), geen instances
#   V3  meest specifieke subklasse waar de control direct relevant is
#   V4  meerdere asset-types = meerdere triples (geen unieklasse)
#   V5  component-specifieke controls wijzen naar component-klasse;
#       niet-exclusief met V4 (een control kan zowel component-specifieke
#       als asset-niveau triples hebben als beide direct relevant zijn)
#   V6a governance-controls → asset:Asset (toplaag) + WAARSCHUWING-tag
#   V7a proces-controls (over informatie) → asset:InformationAsset + tag
#   V8  multi-laag: meerdere klassen op verschillende lagen, maar nooit
#       tussenlagen waar geen directe maatregel landt (niet naar "vehikels")
#
# WAARSCHUWING-tags (compact): [V6-governance], [V7-proces], [BCM-raakvlak],
# [utilities], [privacy]. Uitleg onder elke sectie-header.
#
# NIET-GEBRUIKTE M18-KLASSEN IN DEZE FILE (bewust):
#   asset:DataCollection, asset:SystemProcess, asset:StorageFacility,
#   asset:Facility (toplaag).
# ISO 27002 landt geen directe maatregelen op deze component-types.
# Deze klassen worden relevant bij BIO-overheidsmaatregelen (Stap 4) en
# instance-niveau (Spoor B). Afwezigheid hier is geen gat in het model.
# =============================================================================




# =============================================================================
# Clause 5 — Organisational controls (37 controls)
# =============================================================================

# 5.01 "Beleidsregels voor informatiebeveiliging"
# [V6-governance] Raakt geen specifiek asset-type; mapping naar asset:Asset (toplaag) per mapping-conventie V6a.
ctrl:ISO27002_5_01 asset:appliesToAssetType asset:Asset .

# 5.02 "Rollen en verantwoordelijkheden bij informatiebeveiliging"
ctrl:ISO27002_5_02 asset:appliesToAssetType asset:HumanAsset .

# 5.03 "Functiescheiding"
