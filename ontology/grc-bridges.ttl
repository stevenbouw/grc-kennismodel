# =============================================================================
# GRC Ontologie — Cross-Module Bridges
# owl:sameAs asserties voor namespace-bruggen:
#   - D5 (v4.0.0): ctrl: ↔ bio: brug, 93 asserties
#   - D11 (v4.3.0): asset: ↔ risk: ↔ isms: asset-convergentie, 5 asserties
# Versie: 4.3.0 | Datum: 2026-04-13
# =============================================================================

<https://grc.example.org/ontology/grc-bridges>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie — Cross-Module Bridges"@nl ,
               "GRC Ontology — Cross-Module Bridges"@en ;
    rdfs:comment "owl:sameAs asserties voor namespace-bruggen. D5 (v4.0.0): 93 ctrl:↔bio: brug-triples voor ISO 27002-controls. D11 (v4.3.0): 5 asset-convergentie-bruggen tussen asset: (M18), risk: (M03) en isms: (M06). Beide bruggen vereisen OWL RL of sterker voor inferentie."@nl ,
                 "owl:sameAs assertions for namespace bridges. D5 (v4.0.0): 93 ctrl:↔bio: bridge triples for ISO 27002 controls. D11 (v4.3.0): 5 asset convergence bridges between asset: (M18), risk: (M03) and isms: (M06). Both bridges require OWL RL or stronger for inference."@en ;
    owl:imports <https://grc.example.org/ontology/> .

