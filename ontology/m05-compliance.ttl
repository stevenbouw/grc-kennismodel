@prefix fw:      <https://grc.example.org/framework/> .
@prefix ctrl:    <https://grc.example.org/control/> .
@prefix risk:    <https://grc.example.org/risk/> .
@prefix roles:   <https://grc.example.org/roles/> .
@prefix compl:   <https://grc.example.org/compliance/> .
@prefix isms:    <https://grc.example.org/isms/> .
@prefix biz:     <https://grc.example.org/business/> .
@prefix bio:     <https://grc.example.org/bio/> .
@prefix ext:     <https://grc.example.org/extended/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

# =============================================================================
# GRC Ontologie — Module M5: Compliance
# Versie: 4.0.0-alpha | Datum: 2026-03-19 | Profiel: OWL 2 DL
# =============================================================================

<https://grc.example.org/ontology/m05-compliance>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M5 — Compliance"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

compl:Obligation
    rdf:type owl:Class ;
    rdfs:label "Obligation"@en , "Verplichting"@nl ;
    rdfs:comment
        "A duty imposed on the organisation by a legal instrument, regulation, standard or contract."@en ,
        "Een plicht opgelegd aan de organisatie door een wettelijk instrument, regelgeving, norm of contract."@nl .

compl:LegalObligation
    rdf:type owl:Class ;
    rdfs:subClassOf compl:Obligation ;
    rdfs:label "Legal Obligation"@en , "Wettelijke verplichting"@nl ;
    rdfs:comment "An obligation arising directly from national or EU law or regulation."@en ,
                 "Een verplichting die rechtstreeks voortvloeit uit nationale of EU-wet- of regelgeving."@nl ,
                 "D12 obligation-laag (v4.3.3): juridische groepering onder artikel-niveau, via compl:derivedFrom-keten gekoppeld aan compl:RegulatoryObligation (wettelijke laag) en aan framework-specifieke compl:ComplianceRequirement-subklassen (requirement-laag)."@nl ,
                 "D12 obligation layer (v4.3.3): legal grouping below article level, linked via compl:derivedFrom chain to compl:RegulatoryObligation (legal layer) and to framework-specific compl:ComplianceRequirement subclasses (requirement layer)."@en .

compl:RegulatoryObligation
    rdf:type owl:Class ;
    rdfs:subClassOf compl:LegalObligation ;
    rdfs:label "Regulatory Obligation"@en , "Regelgevingsverplichting"@nl ;
    rdfs:comment "An obligation from a sector regulator or supervisory authority."@en ,
                 "Een verplichting van een sectorale toezichthouder of bevoegde autoriteit."@nl ,
                 "D12 wettelijke laag (v4.3.3): concrete juridische verplichting op artikel-niveau, typisch met dubbele compl:derivedFrom naar EU-directive + NL-transpositiewet. Masterchat-bevestigde typerings-correlatie: dubbele derivedFrom ⇒ RegulatoryObligation; enkelvoudige derivedFrom (EU only) ⇒ plain compl:ComplianceRequirement-subklasse."@nl ,
                 "D12 legal layer (v4.3.3): concrete legal obligation at article level, typically with dual compl:derivedFrom to EU directive + NL transposition law. Masterchat-confirmed typing correlation: dual derivedFrom ⇒ RegulatoryObligation; single derivedFrom (EU only) ⇒ plain compl:ComplianceRequirement subclass."@en .

compl:StandardsObligation
    rdf:type owl:Class ;
    rdfs:subClassOf compl:Obligation ;
    rdfs:label "Standards Obligation"@en , "Normverplichting"@nl ;
    rdfs:comment "A 'shall' requirement from a normative standard (ISO, NEN)."@en ,
                 "Een 'shall'-eis uit een normatieve norm (ISO, NEN)."@nl .

compl:PolicyObligation
    rdf:type owl:Class ;
    rdfs:subClassOf compl:Obligation ;
    rdfs:label "Policy Obligation"@en , "Beleidsverplichting"@nl ;
    rdfs:comment "An obligation from an internal policy, BIO 2.0 government measure, or VIR directive."@en ,
                 "Een verplichting uit een intern beleid, BIO 2.0 overheidsmaatregel of VIR-voorschrift."@nl .

compl:ContractualObligation
    rdf:type owl:Class ;
    rdfs:subClassOf compl:Obligation ;
    rdfs:label "Contractual Obligation"@en , "Contractuele verplichting"@nl ;
    rdfs:comment "An obligation arising from a contract, SLA or processor agreement."@en ,
                 "Een verplichting uit een contract, SLA of verwerkersovereenkomst."@nl .

# --- v4.4.0 Stap 2.2 — Leveranciers-uitsluitings-besluit (Cbb art. 18) ---
# Bewust NIET opgenomen in onderstaande AllDisjointClasses-set: SupplierExclusionOrder
# is geen vijfde categorische tak van Obligation (Contractual/Legal/Policy/Standards),
# maar een ministerieel instrument dat in samenwerking met andere obligation-vormen
# kan voorkomen. In v4.4.0 alleen TBox-declaratie; ABox-instances zijn Spoor B.

compl:SupplierExclusionOrder
    rdf:type owl:Class ;
    rdfs:subClassOf compl:Obligation ;
    rdfs:label "leveranciers-uitsluitings-besluit"@nl , "supplier exclusion order"@en ;
    rdfs:comment "Een ministerieel besluit op grond van Cbb art. 18 dat een essentiële of belangrijke entiteit verplicht in aangewezen netwerk- en informatiesystemen géén gebruik te maken van producten of diensten van specifieke partijen, wanneer dat noodzakelijk is om risico's voor de nationale veiligheid te beheersen. ABox-populatie is Spoor B (afhankelijk van werkelijke ministeriële besluiten)."@nl ,
                 "A ministerial decision under Cbb art. 18 that obliges an essential or important entity not to use products or services from specified parties in designated network and information systems, where necessary to manage national security risks. ABox population is Spoor B (dependent on actual ministerial decisions)."@en .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( compl:LegalObligation compl:StandardsObligation compl:PolicyObligation compl:ContractualObligation ) .

# -----------------------------------------------------------------------------
# 1.2 Compliancevereiste / ComplianceRequirement
# -----------------------------------------------------------------------------

compl:ComplianceRequirement
    rdf:type owl:Class ;
    rdfs:label "Compliance Requirement"@en , "Compliancevereiste"@nl ;
    rdfs:comment
        "A specific, testable requirement derived from an obligation. One obligation may generate multiple requirements."@en ,
        "Een specifieke, toetsbare vereiste afgeleid van een verplichting. Één verplichting kan meerdere vereisten genereren."@nl .

# -----------------------------------------------------------------------------
# 1.3 Compliance Status
# -----------------------------------------------------------------------------

compl:ComplianceStatus
    rdf:type owl:Class ;
    rdfs:label "Compliance Status"@en , "Compliancestatus"@nl ;
    rdfs:comment "The assessed status of a compliance requirement at a point in time."@en ,
                 "De beoordeelde status van een compliancevereiste op een bepaald tijdstip."@nl .

# -----------------------------------------------------------------------------
# 1.4 Audit & Bevinding
# -----------------------------------------------------------------------------

compl:AuditProgram
    rdf:type owl:Class ;
    rdfs:label "Audit Programme"@en , "Auditprogramma"@nl ;
    rdfs:comment "A set of planned audits covering a defined scope and time period."@en ,
                 "Een reeks geplande audits die een gedefinieerd toepassingsgebied en tijdsperiode bestrijken."@nl .

compl:Audit
    rdf:type owl:Class ;
    rdfs:label "Audit"@en , "Audit"@nl ;
    rdfs:comment "A systematic, independent examination to determine whether activities comply with requirements."@en ,
                 "Een systematisch, onafhankelijk onderzoek om vast te stellen of activiteiten aan vereisten voldoen."@nl .

compl:AuditFinding
    rdf:type owl:Class ;
    rdfs:label "Audit Finding"@en , "Auditbevinding"@nl ;
    rdfs:comment "A result of evaluating collected audit evidence against audit criteria."@en ,
                 "Een resultaat van het beoordelen van verzameld auditmateriaal aan de hand van auditcriteria."@nl .

compl:NonConformity
    rdf:type owl:Class ;
    rdfs:subClassOf compl:AuditFinding ;
    rdfs:label "Nonconformity"@en , "Non-conformiteit"@nl ;
    rdfs:comment "Non-fulfilment of a requirement. [ISO 9000:2015]"@en ,
                 "Niet-vervulling van een vereiste. [ISO 9000:2015]"@nl .

compl:MajorNonConformity
    rdf:type owl:Class ;
    rdfs:subClassOf compl:NonConformity ;
    rdfs:label "Major Nonconformity"@en , "Majeure non-conformiteit"@nl ;
    rdfs:comment "A nonconformity that affects the capability of the ISMS to achieve intended results or violates a legal obligation."@en ,
                 "Een non-conformiteit die het vermogen van het ISMS aantast om beoogde resultaten te bereiken, of die een wettelijke verplichting schendt."@nl .

compl:MinorNonConformity
    rdf:type owl:Class ;
    rdfs:subClassOf compl:NonConformity ;
    rdfs:label "Minor Nonconformity"@en , "Mineure non-conformiteit"@nl ;
    rdfs:comment "An isolated failure to meet a requirement, with limited impact on ISMS effectiveness."@en ,
                 "Een geïsoleerde tekortkoming in het voldoen aan een vereiste, met beperkte impact op de ISMS-effectiviteit."@nl .

compl:Observation
    rdf:type owl:Class ;
    rdfs:subClassOf compl:AuditFinding ;
    rdfs:label "Observation / Opportunity for Improvement"@en , "Observatie / verbetermogelijkheid"@nl ;
    rdfs:comment "A finding that is not a nonconformity but indicates a potential improvement area."@en ,
                 "Een bevinding die geen non-conformiteit is maar een potentieel verbeterpunt aangeeft."@nl .

compl:PositiveFinding
    rdf:type owl:Class ;
    rdfs:subClassOf compl:AuditFinding ;
    rdfs:label "Positive Finding"@en , "Positieve bevinding"@nl ;
    rdfs:comment "An audit finding confirming that a requirement is effectively met."@en ,
                 "Een auditbevinding die bevestigt dat een vereiste effectief wordt nageleefd."@nl .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( compl:NonConformity compl:Observation compl:PositiveFinding ) .

# -----------------------------------------------------------------------------
# 1.5 Corrigerende maatregel / Corrective Action
# -----------------------------------------------------------------------------

compl:CorrectiveAction
    rdf:type owl:Class ;
    rdfs:label "Corrective Action"@en , "Corrigerende maatregel"@nl ;
    rdfs:comment "Action to eliminate the cause of a nonconformity and to prevent recurrence. [ISO 9000]"@en ,
                 "Maatregel om de oorzaak van een non-conformiteit weg te nemen en herhaling te voorkomen. [ISO 9000]"@nl .

compl:RemediationPlan
    rdf:type owl:Class ;
    rdfs:label "Remediation Plan"@en , "Verbeterplan"@nl ;
    rdfs:comment "A documented plan describing corrective actions, owners, timelines and success criteria."@en ,
                 "Een gedocumenteerd plan met corrigerende maatregelen, eigenaren, tijdlijnen en succescriteria."@nl .

# -----------------------------------------------------------------------------
# 1.6 Compliancedomeinen (taxonomie)
# -----------------------------------------------------------------------------

compl:ComplianceDomain
    rdf:type owl:Class ;
    rdfs:label "Compliance Domain"@en , "Compliancedomein"@nl ;
    rdfs:comment "A thematic area under which obligations are grouped (e.g. risk management, incident reporting)."@en ,
                 "Een thematisch gebied waaronder verplichtingen worden gegroepeerd."@nl .

# =============================================================================
# SECTIE 2 – OBJECT PROPERTIES
# =============================================================================

compl:derivedFrom
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range compl:Obligation ;
    rdfs:label "derived from"@en , "afgeleid van"@nl ;
    rdfs:comment "Links a specific requirement to the source obligation (article, clause)."@en ,
                 "Koppelt een specifieke vereiste aan de bronverplichting (artikel, clausule)."@nl .

compl:sourcedFromFramework
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "sourced from framework"@en , "afkomstig uit kaderwerk"@nl .

compl:satisfiedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range ctrl:Control ;
    rdfs:label "satisfied by"@en , "ingevuld door"@nl ;
    rdfs:comment "A compliance requirement is satisfied by one or more controls."@en ,
                 "Een compliancevereiste wordt ingevuld door een of meer beheersmaatregelen."@nl .

compl:hasStatus
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range compl:ComplianceStatus ;
    rdfs:label "has compliance status"@en , "heeft compliancestatus"@nl .

compl:belongsToDomain
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range compl:ComplianceDomain ;
    rdfs:label "belongs to domain"@en , "behoort tot domein"@nl .

compl:assessedIn
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range compl:Audit ;
    rdfs:label "assessed in audit"@en , "beoordeeld in audit"@nl .

compl:partOfProgram
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:Audit ;
    rdfs:range compl:AuditProgram ;
    rdfs:label "part of programme"@en , "deel van programma"@nl .

compl:producedFinding
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:Audit ;
    rdfs:range compl:AuditFinding ;
    rdfs:label "produced finding"@en , "heeft bevinding geproduceerd"@nl .

compl:relatesToRequirement
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:AuditFinding ;
    rdfs:range compl:ComplianceRequirement ;
    rdfs:label "relates to requirement"@en , "heeft betrekking op vereiste"@nl .

compl:addressedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:NonConformity ;
    rdfs:range compl:CorrectiveAction ;
    rdfs:label "addressed by"@en , "opgepakt door"@nl .

compl:partOfPlan
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:CorrectiveAction ;
    rdfs:range compl:RemediationPlan ;
    rdfs:label "part of remediation plan"@en , "onderdeel van verbeterplan"@nl .

compl:ownedByRole
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:CorrectiveAction ;
    rdfs:range roles:Role ;
    rdfs:label "owned by role"@en , "eigendom van rol"@nl .

compl:evidencedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range rdfs:Resource ;
    rdfs:label "evidenced by"@en , "bewezen door"@nl ;
    rdfs:comment "Links a requirement to documentary evidence of compliance."@en ,
                 "Koppelt een vereiste aan documentair bewijs van naleving."@nl .

compl:accountableRole
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range roles:Role ;
    rdfs:label "accountable role"@en , "eindverantwoordelijke rol"@nl ;
    rdfs:comment "The role ultimately accountable for this obligation."@en ,
                 "De rol die eindverantwoordelijk is voor deze verplichting."@nl .

compl:responsibleRole
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range roles:Role ;
    rdfs:label "responsible role"@en , "uitvoerend verantwoordelijke rol"@nl .

compl:mitigatesRisk
    rdf:type owl:ObjectProperty ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range risk:Risk ;
    rdfs:label "mitigates risk"@en , "mitigeert risico"@nl .

# =============================================================================
# SECTIE 3 – DATA PROPERTIES
# =============================================================================

compl:hasObligationID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range xsd:string ;
    rdfs:label "has obligation ID"@en , "heeft verplichtings-ID"@nl .

compl:hasObligationTitle
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has obligation title"@en , "heeft verplichtingstitel"@nl .

compl:hasArticleReference
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has article reference"@en , "heeft artikelreferentie"@nl ;
    rdfs:comment "The article or clause number in the source instrument (e.g. 'Art. 21 NIS2')."@en ,
                 "Het artikel- of clausulenummer in het broninstrument (bijv. 'Art. 21 NIS2')."@nl .

compl:articleRef
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range xsd:string ;
    rdfs:label "article reference"@en , "artikelreferentie"@nl ;
    rdfs:comment "Short article reference (e.g. 'Art. 32'). Equivalent in intent to compl:hasArticleReference; retained for backward compatibility with v3 obligations."@en ,
                 "Korte artikelreferentie (bijv. 'Art. 32'). Equivalent in bedoeling aan compl:hasArticleReference; behouden voor compatibiliteit met v3-verplichtingen."@nl .

compl:hasDeadline
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range xsd:string ;
    rdfs:label "has deadline / frequency"@en , "heeft deadline / frequentie"@nl .

compl:isMandatory
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:Obligation ;
    rdfs:range xsd:boolean ;
    rdfs:label "is mandatory"@en , "is verplicht"@nl .

compl:requirementID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "requirement ID"@en , "vereiste-ID"@nl .

compl:requirementText
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range rdfs:Literal ;
    rdfs:label "requirement text"@en , "tekst van de vereiste"@nl .

compl:findingID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:AuditFinding ;
    rdfs:range xsd:string ;
    rdfs:label "finding ID"@en , "bevindingen-ID"@nl .

compl:findingDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:AuditFinding ;
    rdfs:range rdfs:Literal ;
    rdfs:label "finding description"@en , "beschrijving bevinding"@nl .

compl:findingDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:AuditFinding ;
    rdfs:range xsd:date ;
    rdfs:label "finding date"@en , "datum bevinding"@nl .

compl:targetResolutionDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:CorrectiveAction ;
    rdfs:range xsd:date ;
    rdfs:label "target resolution date"@en , "streefdatum afhandeling"@nl .

compl:actionDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:domain compl:CorrectiveAction ;
    rdfs:range rdfs:Literal ;
    rdfs:label "action description"@en , "beschrijving maatregel"@nl .

# =============================================================================
# SECTIE 4 – ABOX: COMPLIANCE STATUSSEN
# =============================================================================

compl:CS_Compliant
    rdf:type compl:ComplianceStatus ;
    rdfs:label "Compliant"@en , "Conform"@nl ;
    rdfs:comment "The requirement is fully met with evidence."@en ,
                 "De vereiste wordt volledig nageleefd met bewijs."@nl .

compl:CS_PartiallyCompliant
    rdf:type compl:ComplianceStatus ;
    rdfs:label "Partially Compliant"@en , "Gedeeltelijk conform"@nl ;
    rdfs:comment "The requirement is met in part; gaps remain."@en ,
                 "De vereiste wordt gedeeltelijk nageleefd; er bestaan nog lacunes."@nl .

compl:CS_NonCompliant
    rdf:type compl:ComplianceStatus ;
    rdfs:label "Non-Compliant"@en , "Niet conform"@nl ;
    rdfs:comment "The requirement is not met."@en , "De vereiste wordt niet nageleefd."@nl .

compl:CS_NotAssessed
    rdf:type compl:ComplianceStatus ;
    rdfs:label "Not Yet Assessed"@en , "Nog niet beoordeeld"@nl .

compl:CS_NotApplicable
    rdf:type compl:ComplianceStatus ;
    rdfs:label "Not Applicable"@en , "Niet van toepassing"@nl .

# =============================================================================
# SECTIE 5 – ABOX: COMPLIANCEDOMEINEN
# =============================================================================

compl:CD_RiskManagement
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Risk Management"@en , "Risicobeheer"@nl .

compl:CD_IncidentManagement
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Incident Management & Reporting"@en , "Incidentbeheer en -melding"@nl .

compl:CD_SupplyChainSecurity
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Supply Chain Security"@en , "Leveranciersketenbeveiliging"@nl .

compl:CD_AccessControl
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Access Control & Identity Management"@en , "Toegangsbeveiliging en identiteitsbeheer"@nl .

compl:CD_ContinuityResilience
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Business Continuity & Resilience"@en , "Bedrijfscontinuïteit en veerkracht"@nl .

compl:CD_AssetManagement
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Asset Management"@en , "Bedrijfsmiddelenbeheer"@nl .

compl:CD_CryptographyKeyMgmt
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Cryptography & Key Management"@en , "Cryptografie en sleutelbeheer"@nl .

compl:CD_VulnerabilityMgmt
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Vulnerability Management"@en , "Kwetsbaarhedenbeheer"@nl .

compl:CD_GovernanceOversight
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Governance & Oversight"@en , "Governance en toezicht"@nl .

compl:CD_PrivacyDataProtection
    rdf:type compl:ComplianceDomain ;
    rdfs:label "Privacy & Data Protection"@en , "Privacy en gegevensbescherming"@nl .

# =============================================================================
# SECTIE 6 – ABOX: NIS2 VERPLICHTINGEN (Richtlijn 2022/2555)
# =============================================================================

# --- NIS2 Art. 20 – Bestuursverantwoordelijkheid ----------------------------

compl:OBL_NIS2_Art20
    rdf:type compl:LegalObligation ;
    compl:hasObligationID "NIS2-ART20" ;
    compl:hasObligationTitle "Board accountability for cybersecurity"@en ;
    compl:hasObligationTitle "Bestuursverantwoordelijkheid voor cyberbeveiliging"@nl ;
    compl:hasArticleReference "Art. 20 NIS2 Directive (EU) 2022/2555" ;
    compl:isMandatory "true"^^xsd:boolean ;
    compl:hasDeadline "Continu / Ongoing" ;
    compl:sourcedFromFramework fw:NIS2_Directive ;
    compl:belongsToDomain compl:CD_GovernanceOversight ;
    compl:accountableRole roles:R_Bestuur ;
    compl:responsibleRole roles:R_CISO .

compl:REQ_NIS2_Art20_1
    rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "Requirement: NIS2 art. 20 lid 1 — goedkeuring en toezicht bestuursorgaan"@nl ;
    rdfs:label "Requirement: NIS2 Art. 20(1) — management body approval and supervision"@en ;
    compl:requirementID "NIS2-ART20-R1" ;
    compl:requirementText "Management bodies of essential and important entities shall approve cybersecurity risk management measures and oversee their implementation."@en ;
    compl:requirementText "Bestuursorganen van essentiële en belangrijke entiteiten keuren maatregelen voor cyberbeveiligingsrisicobeheer goed en houden toezicht op de uitvoering ervan."@nl ;
    compl:derivedFrom compl:OBL_NIS2_Art20 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:satisfiedBy ctrl:ISO27002_5_01 , ctrl:ISO27002_5_04 ;
    compl:accountableRole roles:R_Bestuur .

compl:REQ_NIS2_Art20_2
    rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "Requirement: NIS2 art. 20 lid 2 — cyberbeveiligingstraining bestuur"@nl ;
    rdfs:label "Requirement: NIS2 Art. 20(2) — management body cybersecurity training"@en ;
    compl:requirementID "NIS2-ART20-R2" ;
    compl:requirementText "Members of management bodies shall follow training on cybersecurity."@en ;
    compl:requirementText "Leden van bestuursorganen volgen training op het gebied van cyberbeveiliging."@nl ;
    compl:derivedFrom compl:OBL_NIS2_Art20 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:satisfiedBy ctrl:ISO27002_6_03 ;
    compl:accountableRole roles:R_SecretarisDirecteur .

# --- NIS2 Art. 21 – Beveiligingsmaatregelen ----------------------------------

compl:OBL_NIS2_Art21
    rdf:type compl:LegalObligation ;
    compl:hasObligationID "NIS2-ART21" ;
    compl:hasObligationTitle "Cybersecurity risk management measures"@en ;
    compl:hasObligationTitle "Maatregelen voor cyberbeveiligingsrisicobeheer"@nl ;
