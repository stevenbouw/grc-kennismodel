# =============================================================================
# EINDE MODULE M5

# --- Wettelijke verplichtingen (oorspronkelijk FIX 3) ---
# ── VIR 2007 wettelijke verplichtingen als compl:LegalObligation ─────────────

compl:VIR_Art2_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "VIR 2007 Art. 2 — Plaatsbepaling en reikwijdte"@nl ,
               "VIR 2007 Art. 2 — Scope and applicability"@en ;
    rdfs:comment "Het VIR geldt voor de gehele Rijksdienst, het gehele proces van informatievoorziening en de gehele levenscyclus van informatiesystemen, ongeacht technologie of karakter van de informatie. Informatiebeveiliging is een lijnverantwoordelijkheid en onderdeel van kwaliteitszorg (VIR 2007, art. 2)."@nl ;
    compl:derivedFrom fw:VIR_2007 ;
    compl:articleRef "art. 2"^^xsd:string .

compl:VIR_Art3_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "VIR 2007 Art. 3 — Informatiebeveiligingsbeleid"@nl ,
               "VIR 2007 Art. 3 — Information security policy"@en ;
    rdfs:comment "De SG stelt het informatiebeveiligingsbeleid vast, draagt dit uit en legt verantwoording af. Het beleid omvat minimaal: strategische uitgangspunten, organisatie van de IB-functie, toewijzing ketenverantwoordelijkheden, betrouwbaarheidseisen/normen, evaluatiefrequentie, en bevordering beveiligingsbewustzijn (VIR 2007, art. 3)."@nl ;
    compl:derivedFrom fw:VIR_2007 ;
    compl:articleRef "art. 3"^^xsd:string ;
    compl:responsibleRole roles:R_SecretarisDirecteur .

compl:VIR_Art4_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "VIR 2007 Art. 4 — Verantwoordelijkheden lijnmanagement"@nl ,
               "VIR 2007 Art. 4 — Line management responsibilities"@en ;
    rdfs:comment "Het lijnmanagement is verantwoordelijk voor de beveiliging van zijn informatiesystemen: (a) stelt betrouwbaarheidseisen vast op basis van risicoafweging, (b) kiest en implementeert maatregelen, (c) stelt vast dat maatregelen overeenstemmen met eisen en worden nageleefd, (d) evalueert periodiek en stelt bij (VIR 2007, art. 4)."@nl ;
    compl:derivedFrom fw:VIR_2007 ;
    compl:articleRef "art. 4"^^xsd:string .

# --- Gecorrigeerd 2026-03-26: oorspronkelijk foutief als VIR 2007 art. 5 gemodelleerd ---
# De BVA-verplichting komt uit het Besluit BVA-stelsel, niet uit VIR 2007.
compl:VIR_Art5_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Besluit BVA-stelsel Art. 3 — BVA-stelsel verplicht"@nl ,
               "BVA Decree Art. 3 — BVA system mandatory"@en ;
    rdfs:comment "De minister draagt zorg voor de aanstelling van een BVA met een kaderstellende, adviserende en toezichthoudende rol over de integrale beveiliging. De SG is eindverantwoordelijk voor de integrale beveiliging en stelt het departementale beveiligingsbeleid vast (Besluit BVA-stelsel Rijksdienst 2021, art. 3). Oorspronkelijk foutief als VIR 2007 art. 5 gemodelleerd — gecorrigeerd 2026-03-26."@nl ;
    compl:derivedFrom fw:BesluitBVAStelsel ;
    compl:articleRef "art. 3"^^xsd:string ;
    compl:responsibleRole roles:R_BVA .

# --- Gecorrigeerd 2026-03-26: oorspronkelijk foutief als VIR 2007 art. 9 gemodelleerd ---
# De periodieke rapportageverplichting komt uit Besluit BVA-stelsel art. 4 lid 7.
compl:VIR_Art9_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Besluit BVA-stelsel Art. 4 lid 7 — Periodieke IB-rapportage"@nl ,
               "BVA Decree Art. 4(7) — Periodic security reporting"@en ;
    rdfs:comment "De BVA rapporteert periodiek (schriftelijk) over de stand van de integrale beveiliging aan de ambtelijke leiding en informeert de BVA Rijk hierover (Besluit BVA-stelsel Rijksdienst 2021, art. 4 lid 7). Oorspronkelijk foutief als VIR 2007 art. 9 gemodelleerd — gecorrigeerd 2026-03-26."@nl ;
    compl:derivedFrom fw:BesluitBVAStelsel ;
    compl:articleRef "art. 4 lid 7"^^xsd:string ;
    compl:responsibleRole roles:R_BVA .

# ── VIRBI 2025 wettelijke verplichtingen ─────────────────────────────────────

compl:VIRBI_Art6_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "VIRBI 2025 Art.6 — Aanwijzing BVC"@nl ;
    rdfs:comment "Het hoofd van een dienstonderdeel wijst een Beveiligingscoördinator (BVC) aan (VIRBI 2025, art.6)."@nl ;
    compl:derivedFrom fw:VIRBI_2025 ;
    compl:articleRef "art. 6"^^xsd:string ;
    compl:responsibleRole roles:R_BVC .

compl:VIRBI_Art10_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "VIRBI 2025 Art.10 — Driejaarlijkse evaluatie"@nl ;
    rdfs:comment "Driejaarlijkse evaluatie van de beveiliging van bijzondere informatie (VIRBI 2025, art.10)."@nl ;
    compl:derivedFrom fw:VIRBI_2025 ;
    compl:articleRef "art. 10"^^xsd:string ;
    compl:responsibleRole roles:R_BVA .

# ── Besluit BVA-stelsel verplichtingen ───────────────────────────────────────

compl:BesluitBVA_Art3_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Besluit BVA-stelsel 2021 Art.3 — BVA-aanstelling"@nl ;
    rdfs:comment "De Minister stelt een BVA aan die belast is met de beveiliging van gerubriceerde informatie (Besluit BVA-stelsel, art.3)."@nl ;
    compl:derivedFrom fw:BesluitBVAStelsel ;
    compl:articleRef "art. 3"^^xsd:string ;
    compl:responsibleRole roles:R_BVA .

compl:BesluitBVA_Art6_Verplichting rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Besluit BVA-stelsel 2021 Art.6 — BVC-aanwijzing"@nl ;
    rdfs:comment "Het hoofd van een dienstonderdeel wijst een BVC aan (Besluit BVA-stelsel, art.6). Grondslag voor de BVC-rol."@nl ;
    compl:derivedFrom fw:BesluitBVAStelsel ;
    compl:articleRef "art. 6"^^xsd:string ;
    compl:responsibleRole roles:R_BVC .


# ══════════════════════════════════════════════════════════════════════


# =============================================================================
# v4.4.0 Stap 4 — Cbb-laag-content (addendum 2 §4)
# Datum: 2026-05-13
# =============================================================================
# 14 inhoudelijke zorgplichtartikelen uit Cbb hoofdstuk 4 (Zorgplicht):
# art. 6 t/m 19 inclusief. Art. 5 is een verwijzings-artikel (geen zelfstandige
# zorgplicht) en wordt NIET als individual opgenomen — kort vermeld in
# rdfs:comment op compl:Cbb_Art6_Verplichting.
#
# Art. 18 (supplier-exclusion-order) krijgt zowel een gewone
# compl:LegalObligation-individual als kruisverwijzing naar de aparte
# compl:SupplierExclusionOrder-klasse (Stap 2.2, ABox-instances zijn Spoor B).
#
# Patroon (per inventarisatie 1.5):
#   compl:LegalObligation + owl:NamedIndividual
#   rdfs:label @nl + @en
#   rdfs:comment @nl (volledige artikeltekst uit Cbb-PDF)
#   compl:articleRef "Art. N"^^xsd:string
#   compl:sourcedFromFramework fw:Cbb

compl:Cbb_Art6_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 6 — beleid over beveiliging van netwerk- en informatiesystemen"@nl ,
                "Cbb art. 6 — policy on network and information system security"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft vastgesteld beleid over de beveiliging van haar 
netwerk- en informatiesystemen. De entiteit legt dat beleid schriftelijk vast en past dat beleid 
aantoonbaar toe. 
2. De essentiële entiteit of belangrijke entiteit stelt in het kader van de toepassing van het beleid, 
bedoeld in het eerste lid, de rollen, verantwoordelijkheden en bevoegdheden in relatie tot de 
beveiliging van haar netwerk- en informatiesystemen vast. De entiteit zorgt er zoveel mogelijk 
voor dat conflicterende rollen, verantwoordelijkheden en bevoegdheden gescheiden worden.
3. De essentiële entiteit of belangrijke entiteit verlangt van haar personeel en andere binnen de 
entiteit werkzame personen dat zij de beveiliging van haar netwerk- en informatiesystemen 
toepassen overeenkomstig het beleid, bedoeld in het eerste lid.
4. De essentiële entiteit of belangrijke entiteit hanteert een managementsystematiek voor de 
beveiliging van haar netwerk- en informatiesystemen om aantoonbaar te kunnen voldoen aan het 
bepaalde bij of krachtens artikel 21 van de wet."""@nl ,
                  """Conform Cbb art. 5: "Ter uitvoering van artikel 21 van de wet neemt de essentiële entiteit of belangrijke entiteit ten minste de maatregelen, bedoeld in de artikelen 6 tot en met 19." Art. 5 is een verwijzings-artikel zonder zelfstandige zorgplicht en wordt daarom niet als aparte compl:LegalObligation-individual gemodelleerd; het juridisch-bindende geheel bestaat uit art. 6 t/m 19."""@nl ;
    compl:articleRef "Art. 6"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art7_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 7 — beleid over risicomanagement"@nl ,
                "Cbb art. 7 — risk management policy"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft vastgesteld beleid over risicomanagement 
voor de beveiliging van haar netwerk- en informatiesystemen. De entiteit legt dat beleid schriftelijk 
vast en past dat beleid aantoonbaar toe. 
2. Het beleid, bedoeld in het eerste lid, omvat ten minste:
a. een risicomanagementmethodiek; en
b. criteria voor risicoacceptatie. 
3. De essentiële entiteit of belangrijke entiteit stelt in het kader van de toepassing van het beleid, 
bedoeld in het eerste lid, processen en procedures vast voor risicoanalyse, risicobeoordeling en 
risicobehandeling. De entiteit past deze processen en procedures aantoonbaar toe.
4. De essentiële entiteit of belangrijke entiteit maakt op basis van de uitgevoerde risicoanalyse een 
overzicht van de risico’s met betrekking tot de beveiliging van haar netwerk- en 
informatiesystemen. 
5. De essentiële entiteit of belangrijke entiteit stelt op basis van het overzicht van de risico’s, 
bedoeld in het vierde lid, eisen met betrekking tot de beveiliging van haar netwerk- en 
informatiesystemen. Indien de risicoanalyse hiertoe aanleiding geeft, neemt de entiteit
maatregelen om de beveiliging van haar netwerk- en informatiesystemen op structurele en 
aantoonbare wijze te borgen. VERSIE T.B.V. VERZENDING AAN TWEEDE KAMER"""@nl ;
    compl:articleRef "Art. 7"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art8_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 8 — incidentenbehandeling"@nl ,
                "Cbb art. 8 — incident handling"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft vastgesteld beleid over incidentenbehandeling. 
De entiteit legt dat beleid schriftelijk vast en past dat beleid aantoonbaar toe.
2. De essentiële entiteit of belangrijke entiteit stelt in het kader van de toepassing van het beleid, 
bedoeld in het eerste lid, de rollen, verantwoordelijkheden en bevoegdheden vast voor: 
a. het tijdig detecteren van incidenten;
b. het analyseren en beoordelen van incidenten;
c. het reageren op, beperken van de gevolgen van, wegnemen van de oorzaak van en herstellen
van incidenten; 
d. het documenteren van incidenten;
e. het rapporteren van incidenten; en
f. het leren van incidenten.
3. De essentiële entiteit of belangrijke entiteit stelt in het kader van de toepassing van het beleid, 
bedoeld in het eerste lid, processen en procedures vast om relevante gebeurtenissen in haar 
netwerk- en informatiesystemen te monitoren teneinde incidenten te detecteren, analyseren en 
classificeren. De entiteit past deze processen en procedures aantoonbaar toe.
4. De essentiële entiteit of belangrijke entiteit stelt in het kader van de toepassing van het beleid, 
bedoeld in het eerste lid, processen en procedures vast voor: 
a. het tijdig detecteren van incidenten;
b. het analyseren en beoordelen van incidenten;
c. het reageren op, beperken van de gevolgen van, wegnemen van de oorzaak van en herstellen 
van incidenten;
d. het documenteren van incidenten;
e. het rapporteren van incidenten; en
f. het leren van incidenten. 
5. De essentiële entiteit of belangrijke entiteit past de processen en procedures, bedoeld in het 
vierde lid, aantoonbaar toe.
6. De essentiële entiteit of belangrijke entiteit logt de voor de beveiliging van haar netwerk- en 
informatiesystemen relevante gebeurtenissen in haar netwerk- en informatiesystemen. De entiteit 
houdt gedurende een vooraf bepaalde periode deze logbestanden bij en beschermt deze tegen 
ongeautoriseerde wijzigingen."""@nl ;
    compl:articleRef "Art. 8"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art9_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 9 — bedrijfscontinuïteit en crisisbeheer"@nl ,
                "Cbb art. 9 — business continuity and crisis management"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft vastgesteld bedrijfscontinuïteitsbeleid met 
betrekking tot haar netwerk- en informatiesystemen. De entiteit legt dat beleid schriftelijk vast en 
past dat beleid aantoonbaar toe.
2. De essentiële entiteit of belangrijke entiteit stelt in het kader van de toepassing van het beleid, 
bedoeld in het eerste lid, processen en procedures vast voor het borgen van haar 
bedrijfscontinuïteit, waaronder in ieder geval processen en procedures voor het herstellen van haar 
netwerk- en informatiesystemen en voor het maken en periodiek verifiëren van de 
betrouwbaarheid van back-ups van software en gegevens. De entiteit past deze processen en 
procedures aantoonbaar toe en test deze periodiek.
3. De essentiële entiteit of belangrijke entiteit heeft een vastgesteld bedrijfscontinuïteitsplan met 
betrekking tot haar netwerk- en informatiesystemen. De entiteit legt dat plan schriftelijk vast, past 
dat plan toe in geval van een incident die de bedrijfscontinuïteit in gevaar brengt, en test dit plan 
periodiek. 
4. De essentiële entiteit of belangrijke entiteit heeft een herstelplan. De entiteit legt dat plan 
schriftelijk vast, past dat plan toe in geval van een incident en test dit plan periodiek. 
5. De essentiële entiteit of belangrijke entiteit heeft een plan voor crisisbeheer, legt dit plan 
schriftelijk vast, past dat plan toe in geval van een crisis en test en beoefent dit plan periodiek. Het 
plan bevat ten minste:VERSIE T.B.V. VERZENDING AAN TWEEDE KAMER
a. de taken, verantwoordelijkheden en bevoegdheden ten tijde van crisis voor het personeel en 
andere binnen de entiteit werkzame personen; 
b. een beschrijving van de communicatiemiddelen ten tijde van crisis; en 
c. wanneer passend, een beschrijving van de beschikbare noodvoorzieningen, waaronder het 
gebruik van beveiligde noodcommunicatiesystemen ten tijde van crisis."""@nl ;
    compl:articleRef "Art. 9"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art10_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 10 — beveiliging van de toeleveringsketen"@nl ,
                "Cbb art. 10 — supply chain security"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft vastgesteld beleid over de beveiliging van de 
toeleveringsketen. De entiteit bepaalt in dat beleid haar omgang met afhankelijkheden van de 
producten en diensten van haar leveranciers en dienstverleners die invloed kunnen hebben op de 
beveiliging van haar netwerk- en informatiesystemen. De entiteit legt dat beleid schriftelijk vast en 
past dat beleid aantoonbaar toe.
2. De essentiële entiteit of belangrijke entiteit toetst of haar rechtstreekse leveranciers en 
rechtstreekse dienstverleners, bedoeld in het eerste lid, voldoen aan de beveiligingseisen, bedoeld 
in artikel 7, vijfde lid. De entiteit controleert dit periodiek."""@nl ;
    compl:articleRef "Art. 10"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art11_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 11 — beveiliging bij het verwerven, ontwikkelen en onderhouden van netwerk- en informatiesystemen"@nl ,
                "Cbb art. 11 — security in acquisition, development and maintenance of network and information systems"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft op basis van de beveiligingseisen, bedoeld in 
artikel 7, vijfde lid, vastgesteld beleid voor het mitigeren en beheersen van risico’s die voortvloeien 
uit het verwerven van software, hardware of diensten die betrekking hebben op haar netwerk- en 
informatiesystemen. De entiteit legt dat beleid schriftelijk vast en past dat beleid aantoonbaar toe. 
2. Indien van toepassing stelt de essentiële entiteit of belangrijke entiteit processen en procedures 
vast voor de veilige ontwikkeling van haar netwerk- en informatiesystemen. De entiteit past deze 
processen en procedures aantoonbaar toe. Deze processen en procedures hebben betrekking op 
alle ontwikkelingsfasen van de netwerk- en informatiesystemen van de entiteit. 
3. De essentiële entiteit of belangrijke entiteit stelt processen en procedures vast voor het 
onderhoud en beheer van haar netwerk- en informatiesystemen. De entiteit past deze processen 
en procedures aantoonbaar toe. Deze processen en procedures hebben ten minste betrekking op 
het configuratiebeheer en het wijzigingsbeheer van de netwerk- en informatiesystemen van de 
entiteit."""@nl ;
    compl:articleRef "Art. 11"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art12_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 12 — basispraktijken op het gebied van cyberhygiëne en opleiding op het gebied van cyberbeveiliging"@nl ,
                "Cbb art. 12 — basic cyber hygiene practices and cybersecurity training"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit zorgt ervoor dat haar personeel en andere binnen 
de entiteit werkzame personen, voor zover relevant voor hun functie: 
a. bewust zijn van de risico’s met betrekking tot de netwerk- en informatiesystemen van de 
entiteit; en
b. praktijken op het gebied van cyberhygiëne toepassen. 
2. De essentiële entiteit of belangrijke entiteit wijst het personeel en andere binnen de entiteit 
werkzame personen aan waarvan de rollen, verantwoordelijkheden en bevoegdheden
vaardigheden en deskundigheid vereisen op het gebied van de beveiliging van netwerk- en 
informatiesystemen en zorgt ervoor dat zij regelmatig opleiding krijgen over de beveiliging van 
netwerk- en informatiesystemen."""@nl ;
    compl:articleRef "Art. 12"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art13_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 13 — beleid over het gebruik van cryptografie"@nl ,
                "Cbb art. 13 — cryptography policy"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft vastgesteld beleid over het gebruik van 
cryptografie. De entiteit legt dat beleid schriftelijk vast en past dat beleid aantoonbaar toe.
2. De essentiële entiteit of belangrijke entiteit stelt in het kader van de toepassing van het beleid, 
bedoeld in het eerste lid, processen en procedures vast over het gebruik van cryptografie. De 
entiteit past deze processen en procedures aantoonbaar toe.
3. In het beleid en de processen en procedures, bedoeld in het eerste en tweede lid, worden in 
ieder geval uitgewerkt:VERSIE T.B.V. VERZENDING AAN TWEEDE KAMER
a. in welke gevallen cryptografie ingezet wordt;
b. in voorkomende gevallen, welke typen encryptie worden gebruikt en de wijze waarop deze 
worden toegepast;
c. wie binnen de entiteit verantwoordelijk zijn voor de implementatie van cryptografie; en
d. wie binnen de entiteit verantwoordelijk zijn voor het sleutelbeheer."""@nl ;
    compl:articleRef "Art. 13"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art14_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 14 — beveiligingsaspecten ten aanzien van personeel"@nl ,
                "Cbb art. 14 — personnel security aspects"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit wijst het personeel en andere binnen de entiteit 
werkzame personen aan die worden belast met rollen, verantwoordelijkheden en bevoegdheden
met betrekking tot de beveiliging van haar netwerk- en informatiesystemen. 
2. De essentiële entiteit of belangrijke entiteit evalueert periodiek de aanwijzing, bedoeld in het 
eerste lid, en werkt deze aanwijzing indien nodig bij. 
3. De essentiële entiteit of belangrijke entiteit stelt betrouwbaarheidseisen op waaraan haar 
personeel en andere binnen de entiteit werkzame personen moeten voldoen, voor zover deze 
passend en noodzakelijk zijn voor hun taakuitoefening met betrekking tot de beveiliging van de 
netwerk- en informatiesystemen van de entiteit."""@nl ;
    compl:articleRef "Art. 14"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art15_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 15 — beveiligingsaspecten ten aanzien van toegangsbeleid"@nl ,
                "Cbb art. 15 — access control security aspects"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft vastgesteld beleid over de logische en fysieke 
toegang tot haar netwerk- en informatiesystemen. De entiteit legt dat beleid schriftelijk vast en 
past dat beleid aantoonbaar toe.
2. Het beleid, bedoeld in het eerste lid, omvat in ieder geval het uitgeven, monitoren, gebruiken, 
wijzigen en intrekken van identiteiten en autorisaties, en het beheer van identiteiten en 
autorisaties. 
3. De essentiële entiteit of belangrijke entiteit controleert identiteiten, authenticatiemiddelen en 
autorisaties periodiek op de noodzakelijkheid, juistheid en actualiteit en voert indien nodig 
wijzigingen door in de identiteiten, authenticatiemiddelen en autorisaties."""@nl ;
    compl:articleRef "Art. 15"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art16_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 16 — beveiligingsaspecten ten aanzien van beheer van assets"@nl ,
                "Cbb art. 16 — asset management security aspects"@en ;
    rdfs:comment """1. De essentiële entiteit of belangrijke entiteit heeft vastgesteld beleid voor het beheer van haar 
assets die zij voor haar werkzaamheden of voor het verlenen van haar diensten gebruikt. De 
entiteit legt dat beleid schriftelijk vast en past dat beleid aantoonbaar toe.
2. Het beleid, bedoeld in het eerste lid, omvat in ieder geval:
a. een systeem om assets op verschillende niveaus te kunnen classificeren, indien van toepassing
op basis van de eisen voor vertrouwelijkheid, integriteit en beschikbaarheid; en
b. regels voor het aanvaardbaar gebruik van haar assets. 
3. De essentiële entiteit of belangrijke entiteit stelt in het kader van de toepassing van het beleid, 
bedoeld in het eerste lid, processen en procedures vast voor het beheer van haar assets. De 
entiteit past deze processen en procedures aantoonbaar toe. 
4. De essentiële entiteit of belangrijke entiteit heeft een volledige en actuele inventaris van haar 
assets, en houdt deze bij."""@nl ;
    compl:articleRef "Art. 16"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art17_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 17 — attenderingen, adviezen en informatie"@nl ,
                "Cbb art. 17 — notifications, advisories and information"@en ;
    rdfs:comment """Indien de essentiële entiteit of belangrijke entiteit door relevante partijen, waaronder CSIRT’s, 
bevoegde autoriteiten, andere betrokken overheidsinstanties of rechtstreekse leveranciers of 
dienstverleners, gericht wordt geattendeerd op de voor de beveiliging van haar netwerk- en 
informatiesystemen relevante kwetsbaarheden of cyberdreigingen, of van die partijen gerichte
beveiligingsadviezen of dreigingsinformatie ontvangt die relevant zijn voor de beveiliging van haar 
netwerk- en informatiesystemen, beoordeelt zij of op basis daarvan aanpassingen of aanvullingen 
nodig zijn van de maatregelen die nodig zijn ter uitvoering van artikel 21 van de wet. De entiteit 
legt de uitkomsten van die beoordeling schriftelijk vast.VERSIE T.B.V. VERZENDING AAN TWEEDE KAMER"""@nl ;
    compl:articleRef "Art. 17"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art18_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 18 — weren producten en diensten van leveranciers"@nl ,
                "Cbb art. 18 — supplier exclusion of products and services"@en ;
    rdfs:comment """1. Indien dat naar het oordeel van Onze Minister die het aangaat noodzakelijk is om risico’s voor 
de beveiliging van netwerk- en informatiesystemen die de nationale veiligheid raken te beheersen
of om incidenten die de nationale veiligheid raken te voorkomen, legt hij in overeenstemming met 
Onze Minister een essentiële entiteit of een belangrijke entiteit de verplichting op om in de daarbij 
aangewezen onderdelen van haar netwerk- en informatiesystemen uitsluitend gebruik te maken 
van producten of diensten van anderen dan de daarbij door Onze Minister die het aangaat 
genoemde partij die:
a. een staat, entiteit of persoon is waarvan bekend is of waarvoor gronden zijn te vermoeden dat 
deze de intentie heeft om de beveiliging van de netwerk- en informatiesystemen van de essentiële 
entiteit of belangrijke entiteit aan te tasten of om incidenten bij de essentiële entiteit of belangrijke 
entiteit te veroorzaken; of 
b. nauwe banden heeft met of onder invloed staat van een staat, entiteit of persoon als bedoeld in 
onderdeel a, of een entiteit of persoon is ten aanzien van wie er gronden zijn om dergelijke 
banden of invloed te vermoeden.
2. Indien de verplichting, bedoeld in het eerste lid, betrekking heeft op reeds in gebruik zijnde 
producten en diensten ten behoeve van de daarbij aangewezen onderdelen, stelt Onze Minister die 
het aangaat in het belang van de continuïteit van de dienstverlening een termijn vast voor het 
vervangen respectievelijk beëindigen van de betreffende producten en diensten.
3. Het eerste lid is niet van toepassing ten aanzien van essentiële entiteiten en belangrijke 
entiteiten die aanbieders van openbare elektronische communicatienetwerken of aanbieders van 
openbare elektronische communicatiediensten zijn."""@nl ,
                  """Cross-reference: art. 18 instelt de bevoegdheid van Onze Minister om in een ministerieel besluit producten of diensten van specifieke leveranciers te verbieden in aangewezen netwerk- en informatiesystemen. De TBox-klasse compl:SupplierExclusionOrder vertegenwoordigt het juridische instrument-type; concrete ministeriële besluiten worden in Spoor B (organisatie-specifieke invulling) als compl:SupplierExclusionOrder-individuals opgenomen. In v4.4.0 zijn geen ABox-instances van die klasse aangelegd."""@nl ;
    compl:articleRef "Art. 18"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

compl:Cbb_Art19_Verplichting
    rdf:type compl:LegalObligation , owl:NamedIndividual ;
    rdfs:label "Cbb art. 19 — evaluatie"@nl ,
                "Cbb art. 19 — evaluation"@en ;
    rdfs:comment """De essentiële entiteit of belangrijke entiteit evalueert periodiek de doeltreffendheid van de 
maatregelen die zij heeft genomen op grond van artikel 21, eerste lid, van de wet en de effecten 
ervan in de praktijk, en legt het resultaat daarvan schriftelijk vast. De entiteit past naar aanleiding 
van de uitkomst van die evaluaties de maatregelen waar nodig aan.
Artikel 20 (nadere regels)
Bij regeling van Onze Minister die het aangaat, na overleg met Onze Minister, kunnen nadere 
regels worden gesteld over de maatregelen, bedoeld in artikel 21, eerste lid, van de wet, waarbij 
onderscheid kan worden gemaakt tussen sectoren, subsectoren, soorten entiteiten en entiteiten."""@nl ;
    compl:articleRef "Art. 19"^^xsd:string ;
    compl:sourcedFromFramework fw:Cbb .

# Einde Stap 4 — v4.4.0 Fase 2
