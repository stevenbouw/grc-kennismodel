compl:OBL_VIR_Classificatie
    rdf:type compl:PolicyObligation ;
    compl:hasObligationID "VIR-CLASS" ;
    compl:hasObligationTitle "VIR 2007 – Informatieclassificatie rijksoverheidsinformatie"@nl ;
    compl:hasObligationTitle "VIR 2007 – Information classification for central government"@en ;
    compl:hasArticleReference "VIR 2007 Art. 4" ;
    rdfs:comment "Het lijnmanagement stelt betrouwbaarheidseisen vast op basis van een expliciete risicoafweging (VIR 2007, art. 4). Gecorrigeerd 2026-03-26: was 'Art. 5-7' maar VIR 2007 heeft slechts 5 artikelen (art. 5 = Slotbepaling)."@nl ;
    compl:isMandatory "true"^^xsd:boolean ;
    compl:sourcedFromFramework fw:VIR_2007 ;
    compl:belongsToDomain compl:CD_AssetManagement ;
    compl:accountableRole roles:R_SecretarisDirecteur .

