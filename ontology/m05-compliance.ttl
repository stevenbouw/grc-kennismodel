# --- NIS2 Art. 23 – Meldplicht incidenten ------------------------------------

compl:OBL_NIS2_Art23
    rdf:type compl:LegalObligation ;
    compl:hasObligationID "NIS2-ART23" ;
    compl:hasObligationTitle "Reporting obligations for significant incidents"@en ;
    compl:hasObligationTitle "Meldingsverplichtingen voor significante incidenten"@nl ;
    compl:hasArticleReference "Art. 23 NIS2 Directive (EU) 2022/2555" ;
    compl:isMandatory "true"^^xsd:boolean ;
    compl:hasDeadline "24h (early warning) / 72h (notification) / 1 month (final report)" ;
    compl:sourcedFromFramework fw:NIS2_Directive ;
    compl:belongsToDomain compl:CD_IncidentManagement ;
    compl:accountableRole roles:R_SecretarisDirecteur ;
    compl:responsibleRole roles:R_CISO .

compl:REQ_NIS2_Art23_1
    rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "Requirement: NIS2 art. 23 — vroege waarschuwing binnen 24 uur"@nl ;
    rdfs:label "Requirement: NIS2 Art. 23 — early warning within 24 hours"@en ;
    compl:requirementID "NIS2-ART23-R1" ;
    compl:requirementText "Submit an early warning to the competent authority or CSIRT without undue delay and in any event within 24 hours of becoming aware of a significant incident."@en ;
    compl:requirementText "Dien een vroege waarschuwing in bij de bevoegde autoriteit of CSIRT zonder onnodige vertraging en in ieder geval binnen 24 uur na het bewust worden van een significant incident."@nl ;
    compl:derivedFrom compl:OBL_NIS2_Art23 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:hasDeadline "24 uur" .

compl:REQ_NIS2_Art23_2
    rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "Requirement: NIS2 art. 23 — incidentmelding binnen 72 uur"@nl ;
    rdfs:label "Requirement: NIS2 Art. 23 — incident notification within 72 hours"@en ;
    compl:requirementID "NIS2-ART23-R2" ;
    compl:requirementText "Submit an incident notification within 72 hours of becoming aware of the significant incident."@en ;
    compl:requirementText "Dien een incidentmelding in binnen 72 uur na het bewust worden van het significante incident."@nl ;
    compl:derivedFrom compl:OBL_NIS2_Art23 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:hasDeadline "72 uur" .

compl:REQ_NIS2_Art23_3
    rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "Requirement: NIS2 art. 23 — eindrapportage binnen één maand"@nl ;
    rdfs:label "Requirement: NIS2 Art. 23 — final report within one month"@en ;
    compl:requirementID "NIS2-ART23-R3" ;
    compl:requirementText "Submit a final report no later than one month after submission of the incident notification."@en ;
    compl:requirementText "Dien uiterlijk één maand na de incidentmelding een eindrapportage in."@nl ;
    compl:derivedFrom compl:OBL_NIS2_Art23 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:hasDeadline "1 maand" .

