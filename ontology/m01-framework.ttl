# --- FIND-04 FIX: statusmarkering "in voorbereiding" toegevoegd ---
# --- BUG-01 FIX (2026-03-19): fw:CyberBeveiligingswet geconsolideerd naar fw:CBW ---
# --- ACTIE C (2026-04-10): owl:sameAs alias verwijderd; naamvariant via skos:altLabel ---

fw:CBW
    rdf:type fw:NationalLaw ;
    rdfs:label "Cyberbeveiligingswet (CBW)"@nl ,
               "Cyber Security Act (CBW)"@en ;
    skos:altLabel "Cyberbeveiligingswet"@nl ;
    rdfs:comment
        "Beoogde Nederlandse implementatiewet van de NIS2-richtlijn (EU 2022/2555). Stelt eisen aan essentiële en belangrijke entiteiten m.b.t. cyberveiligheid, meldplichten en toezicht. Stand maart 2026: nog niet van kracht."@nl ,
        "Intended Dutch transposition of the NIS2 Directive (EU 2022/2555). Sets requirements for essential and important entities regarding cybersecurity, incident reporting and supervision. Status March 2026: not yet in force."@en ;
    fw:hasIdentifier "NL-CBW" ;
    fw:status "in voorbereiding"@nl , "in preparation"@en ;
    fw:isMandatoryForDutchGovernment "true"^^xsd:boolean ;
    fw:issuedBy fw:DutchCentral ;
    fw:appliesInJurisdiction fw:JurisdictionNL ;
    fw:hasDomain fw:DomainCybersecurity ;
    fw:isTranspositieVan fw:NIS2_Directive ;
    fw:uitgewerktIn fw:Cbb ;
    prov:wasDerivedFrom fw:NIS2_Directive .

# --- v4.4.0 Stap 4 — Cyberbeveiligingsbesluit (Cbb) framework-individual ---

fw:Cbb
    rdf:type fw:NationalLaw , owl:NamedIndividual ;
    rdfs:label "Cyberbeveiligingsbesluit (Cbb)"@nl ,
               "Cyberbeveiligingsbesluit (Cybersecurity Decree)"@en ;
    skos:altLabel "Cyberbeveiligingsbesluit"@nl ;
    rdfs:comment
        "Algemene maatregel van bestuur (AMvB) ter uitvoering van de Cyberbeveiligingswet (CBW). Bevat onder hoofdstuk 4 (Zorgplicht) 14 inhoudelijke zorgplichtartikelen (art. 6 t/m 19) die de NIS2-art. 21-maatregelen operationeel uitwerken voor essentiële en belangrijke entiteiten. Art. 18 bevat een aparte ministeriële bevoegdheid (supplier-exclusion-order). Stand mei 2026: concept t.b.v. Tweede Kamer, nog niet vastgesteld; inwerkingtreding bij koninklijk besluit."@nl ,
        "General administrative order (AMvB) implementing the Cyberbeveiligingswet (CBW). Chapter 4 (Duty of Care) contains 14 substantive duty-of-care articles (art. 6 to 19) that operationally elaborate the NIS2 art. 21 measures for essential and important entities. Art. 18 contains a separate ministerial competence (supplier exclusion order). Status May 2026: concept for the House of Representatives, not yet adopted; entry into force by royal decree."@en ;
    fw:hasIdentifier "NL-Cbb" ;
    fw:status "concept t.b.v. Tweede Kamer, nog niet vastgesteld"@nl ,
              "concept for the House of Representatives, not yet adopted"@en ;
    fw:isMandatoryForDutchGovernment "true"^^xsd:boolean ;
    fw:issuedBy fw:DutchCentral ;
    fw:appliesInJurisdiction fw:JurisdictionNL ;
    fw:hasDomain fw:DomainCybersecurity ;
    fw:werktUit fw:CBW ;
    prov:wasDerivedFrom fw:CBW .

