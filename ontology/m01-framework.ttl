# --- fw:ISO_IEC_27005_2024 (FIND-02, FIND-06, FIND-07, FIND-08 gecorrigeerd) ---
# FIND-02: rdf:type fw:Standard → fw:InternationalStandard
# FIND-06: fw:hasVersion (ObjectProperty misuse) → fw:hasVersionLabel
# FIND-07: fw:appliesInJurisdiction string literal → fw:JurisdictionInternational
# FIND-08: skos:exactMatch fw:ISO_IEC_27001_2022 → skos:closeMatch (27005 ≠ 27001)

fw:ISO_IEC_27005_2024
    rdf:type fw:InternationalStandard ;
    rdfs:label "ISO/IEC 27005:2024"@nl ,
               "ISO/IEC 27005:2024"@en ;
    rdfs:comment
        "Internationale norm voor risicobeheer informatiebeveiliging. Editie 2024. Sluit aan op ISO 27001:2022 cl.6.1.2-6.1.3 en ISO 31000:2018."@nl ,
        "International standard for information security risk management. 2024 edition. Aligned with ISO 27001:2022 cl.6.1.2-6.1.3 and ISO 31000:2018."@en ;
    fw:hasIdentifier "ISO-IEC-27005-2024" ;
    fw:hasVersionLabel "2024" ;
    fw:issuedBy fw:ISO_IEC_JTC1 ;
    fw:appliesInJurisdiction fw:JurisdictionInternational ;
    fw:hasDomain fw:DomainRiskManagement , fw:DomainInformationSecurity ;
    fw:alignsWith fw:ISO_IEC_27001_2022 ;
    fw:alignsWith fw:ISO_31000_2018 ;
    fw:supersedes fw:ISO_IEC_27005_2022 ;
    skos:closeMatch fw:ISO_IEC_27001_2022 .

# --- fw:CBW duplicate verwijderd (BUG-01) ---
# De geconsolideerde fw:CBW definitie staat in de sectie NEDERLANDSE WET- EN REGELGEVING hierboven.
# fw:CyberBeveiligingswet owl:sameAs fw:CBW is daar als redirect opgenomen.

# =============================================================================
# EINDE MODULE M1
# =============================================================================

# --- v4.5.0 Fase 3 — NIST CSF 2.0 framework-individual ---

fw:NIST_CSF_2_0
    rdf:type fw:GRCFramework , owl:NamedIndividual ;
    rdfs:label "NIST Cybersecurity Framework 2.0"@nl ,
               "NIST Cybersecurity Framework 2.0"@en ;
    fw:hasIdentifier "NIST_CSF_2_0" ;
    fw:hasVersionLabel "2.0" ;
    fw:hasPublicationDate "2024-02-26"^^xsd:date ;
    fw:isMandatoryForDutchGovernment "false"^^xsd:boolean ;
    fw:officialURL "https://www.nist.gov/cyberframework"^^xsd:anyURI ;
    fw:status "vastgesteld"@nl , "established"@en ;
    fw:issuedBy fw:NIST ;
    fw:appliesInJurisdiction fw:JurisdictionInternational ;
    fw:hasScope "Gemapt referentiekader voor cybersecurity-risicobeheer. Niet wettelijk verplicht; ondersteunend voor bestuurscommunicatie en supply-chain. Bevat 6 Functions, 22 Categories, 106 Subcategories met SKOS-mappings naar ISO 27001/27002, NIST SP 800-53 en BIO 2.0."@nl ,
                "Mapped reference framework for cybersecurity risk management. Not legally required; supportive for executive communication and supply chain. Contains 6 Functions, 22 Categories, 106 Subcategories with SKOS mappings to ISO 27001/27002, NIST SP 800-53 and BIO 2.0."@en .

# =============================================================================
# v4.6.0 Fase 4 — Stap 5: fw:ENSIA framework-individual + SourceAttribution
# Datum: 2026-05-21
# Architectuur-keuzes masterchat A3+B3+C2:
#   A3: behoud bestaande 3 issuers (DutchCentral, NOREA, VNG); geen Logius als issuer
#       (Logius = beheerder, niet uitgever — semantiek-discipline; zie patch-rapport §8)
#   B3: hybride-locatie — kerndeclaratie in m01, m15 behoudt audit-domains + NB-comment + skos:relatedMatch
#   C2: alleen fw:toetst fw:BIO_2_0 (ISO is referentieel, blijft skos:relatedMatch in m15)
# =============================================================================

ext:Attr_ENSIA_Logius_2024
    rdf:type ext:SourceAttribution , owl:NamedIndividual ;
    rdfs:label "NOREA Handreiking ENSIA 2024 — Bronvermelding"@nl ,
               "NOREA ENSIA Guidance 2024 — Attribution"@en ;
    ext:hasLicense "Vrij gebruik en distributie met bronvermelding" ;
    ext:hasLicenseURL "https://www.norea.nl"^^xsd:anyURI ;
    ext:hasAttributionText "ENSIA-context en publicatie-coördinatie: Logius (beheerder van www.ensia.nl) en NOREA (Handreiking ENSIA voor IT-auditors, versie 1.0, 19 december 2024). Toelaat gebruik en distributie mits met bronvermelding."@nl ,
                            "ENSIA context and publication coordination: Logius (operator of www.ensia.nl) and NOREA (ENSIA Guidance for IT auditors, version 1.0, 19 December 2024). Permits use and distribution with attribution."@en ;
    ext:hasSourcePublicationDate "2024-12-19"^^xsd:date ;
    ext:hasSourceVersion "NOREA Handreiking ENSIA v1.0 (verantwoordingsjaar 2024)" .

fw:ENSIA
    rdf:type fw:GRCFramework , owl:NamedIndividual ;
    rdfs:label "ENSIA — Eenduidige Normatiek Single Information Audit"@nl ,
               "ENSIA — Single Normative Information Audit"@en ;
    rdfs:comment "Auditkader voor informatiebeveiliging bij de Nederlandse (lokale) overheid. ENSIA integreert de verantwoording over informatiebeveiliging (BIO) en domeinspecifieke aspecten in één systematiek. Gestart 1 juli 2017. Gezamenlijk initiatief van BZK, gemeenten, SZW en VNG."@nl ,
                 "Audit framework for information security in Dutch (local) government. ENSIA integrates accountability for information security (BIO) and domain-specific aspects into a single audit approach. Started July 1, 2017. Joint initiative of BZK, municipalities, SZW and VNG."@en ;
    fw:hasIdentifier "ENSIA" ;
    fw:hasVersionLabel "Verantwoordingsjaar 2024" ;
    fw:status "vastgesteld"@nl , "established"@en ;
    fw:hasPublicationDate "2024-12-19"^^xsd:date ;
    fw:isMandatoryForDutchGovernment "true"^^xsd:boolean ;
    fw:issuedBy fw:DutchCentral , fw:NOREA , fw:VNG ;
    fw:appliesInJurisdiction fw:JurisdictionNL ;
    fw:hasDomain fw:DomainCompliance , fw:DomainInformationSecurity ;
    fw:officialURL "https://www.ensia.nl"^^xsd:anyURI ;
    ext:sourceAttribution ext:Attr_ENSIA_Logius_2024 ;
    fw:toetst fw:BIO_2_0 .
