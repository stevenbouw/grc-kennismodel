@prefix fw:      <https://grc.example.org/framework/> .
@prefix ctrl:    <https://grc.example.org/control/> .
@prefix risk:    <https://grc.example.org/risk/> .
@prefix roles:   <https://grc.example.org/roles/> .
@prefix compl:   <https://grc.example.org/compliance/> .
@prefix isms:    <https://grc.example.org/isms/> .
@prefix biz:     <https://grc.example.org/business/> .
@prefix bio:     <https://grc.example.org/bio/> .
@prefix ext:     <https://grc.example.org/extended/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

# =============================================================================
# GRC Ontologie — Module M1: Framework
# Versie: 4.0.0-alpha | Datum: 2026-03-19 | Profiel: OWL 2 DL
# =============================================================================

<https://grc.example.org/ontology/m01-framework>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M1 — Framework"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

fw:GRCFramework
    rdf:type owl:Class ;
    rdfs:label "GRC Framework"@en , "GRC-kaderwerk"@nl ;
    rdfs:comment
        "The top-level class for all governance, risk and compliance frameworks, regulations, standards, guidelines and best practices."@en ,
        "De bovenliggende klasse voor alle governance-, risk- en compliance-kaderwerken, wet- en regelgeving, normen, richtlijnen en best practices."@nl .

# -----------------------------------------------------------------------------
# 1.2 Subklassen van GRCFramework
# -----------------------------------------------------------------------------

fw:Regulation
    rdf:type owl:Class ;
    rdfs:subClassOf fw:GRCFramework ;
    rdfs:label "Regulation"@en , "Wet- en regelgeving"@nl ;
    rdfs:comment
        "A legally binding instrument issued by a governmental or supranational authority."@en ,
        "Een juridisch bindend instrument, uitgevaardigd door een overheids- of supranationaal gezag."@nl ;
    owl:disjointWith fw:Standard , fw:Guideline , fw:BestPractice .

fw:Standard
    rdf:type owl:Class ;
    rdfs:subClassOf fw:GRCFramework ;
    rdfs:label "Standard"@en , "Norm"@nl ;
    rdfs:comment
        "A normative document published by a recognised standards body (e.g. ISO, NEN, NIST)."@en ,
        "Een normatief document, gepubliceerd door een erkend normalisatie-instituut (bijv. ISO, NEN, NIST)."@nl ;
    owl:disjointWith fw:Regulation , fw:Guideline , fw:BestPractice .

fw:Guideline
    rdf:type owl:Class ;
    rdfs:subClassOf fw:GRCFramework ;
    rdfs:label "Guideline"@en , "Richtlijn"@nl ;
    rdfs:comment
        "A non-binding document providing guidance on implementation of controls or requirements."@en ,
        "Een niet-bindend document dat begeleiding biedt bij de implementatie van maatregelen of eisen."@nl ;
    owl:disjointWith fw:Regulation , fw:Standard , fw:BestPractice .

fw:BestPractice
    rdf:type owl:Class ;
    rdfs:subClassOf fw:GRCFramework ;
    rdfs:label "Best Practice"@en , "Best practice"@nl ;
    rdfs:comment
        "A framework or methodology representing industry-accepted good practice, not formally standardised."@en ,
        "Een kaderwerk of methodologie die algemeen aanvaarde branchepraktijken vertegenwoordigt, zonder formele normstatus."@nl ;
    owl:disjointWith fw:Regulation , fw:Standard , fw:Guideline .

# -----------------------------------------------------------------------------
# 1.3 Specifieke subklassen voor juridische instrumenten
# -----------------------------------------------------------------------------

fw:EURegulation
    rdf:type owl:Class ;
    rdfs:subClassOf fw:Regulation ;
    rdfs:label "EU Regulation"@en , "EU-verordening"@nl ;
    rdfs:comment
        "An EU regulation directly applicable in all Member States without transposition."@en ,
        "Een EU-verordening die rechtstreeks van toepassing is in alle lidstaten zonder omzetting."@nl .

fw:EUDirective
    rdf:type owl:Class ;
    rdfs:subClassOf fw:Regulation ;
    rdfs:label "EU Directive"@en , "EU-richtlijn"@nl ;
    rdfs:comment
        "An EU directive requiring transposition into national law by Member States."@en ,
        "Een EU-richtlijn die door lidstaten in nationale wetgeving moet worden omgezet."@nl .

fw:NationalLaw
    rdf:type owl:Class ;
    rdfs:subClassOf fw:Regulation ;
    rdfs:label "National Law"@en , "Nationale wet- en regelgeving"@nl ;
    rdfs:comment
        "A law, decree or policy instrument issued by the Dutch national government."@en ,
        "Een wet, besluit of beleidsinstrument uitgevaardigd door de Nederlandse rijksoverheid."@nl .

fw:InternationalStandard
    rdf:type owl:Class ;
    rdfs:subClassOf fw:Standard ;
    rdfs:label "International Standard"@en , "Internationale norm"@nl ;
    rdfs:comment
        "A standard published by an international body such as ISO or IEC."@en ,
        "Een norm gepubliceerd door een internationale instantie zoals ISO of IEC."@nl .

fw:NationalStandard
    rdf:type owl:Class ;
    rdfs:subClassOf fw:Standard ;
    rdfs:label "National Standard"@en , "Nationale norm"@nl ;
    rdfs:comment
        "A standard issued by a national standards body such as NEN or NIST."@en ,
        "Een norm uitgevaardigd door een nationaal normalisatie-instituut zoals NEN of NIST."@nl .

fw:GovernmentBaseline
    rdf:type owl:Class ;
    rdfs:subClassOf fw:NationalStandard ;
    rdfs:label "Government Security Baseline"@en , "Overheidsbaseline beveiliging"@nl ;
    rdfs:comment
        "A mandatory minimum security baseline mandated for a government sector."@en ,
        "Een verplichte minimale beveiligingsbaseline, voorgeschreven voor een overheidssector."@nl .

# -----------------------------------------------------------------------------
# 1.4 Aanvullende klassen voor structuur binnen een kaderwerk
# -----------------------------------------------------------------------------

fw:FrameworkVersion
    rdf:type owl:Class ;
    rdfs:label "Framework Version"@en , "Kaderwerkversie"@nl ;
    rdfs:comment
        "A specific published version of a GRC framework (e.g. ISO/IEC 27001:2022)."@en ,
        "Een specifieke gepubliceerde versie van een GRC-kaderwerk (bijv. ISO/IEC 27001:2022)."@nl .

fw:FrameworkDomain
    rdf:type owl:Class ;
    rdfs:label "Framework Domain"@en , "Kaderwerkdomein"@nl ;
    rdfs:comment
        "A thematic domain or subject area within a framework (e.g. Access Control, Risk Management)."@en ,
        "Een thematisch domein of onderwerp binnen een kaderwerk (bijv. Toegangsbeveiliging, Risicobeheer)."@nl .

fw:IssuingBody
    rdf:type owl:Class ;
    rdfs:label "Issuing Body"@en , "Uitgevende instantie"@nl ;
    rdfs:comment
        "An organisation responsible for publishing or maintaining a GRC framework."@en ,
        "Een organisatie die verantwoordelijk is voor het publiceren of beheren van een GRC-kaderwerk."@nl .

fw:Jurisdiction
    rdf:type owl:Class ;
    rdfs:label "Jurisdiction"@en , "Rechtsgebied"@nl ;
    rdfs:comment
        "The legal or geographic scope within which a regulation or standard applies."@en ,
        "Het juridische of geografische toepassingsgebied van een wet of norm."@nl .

# =============================================================================
# SECTIE 2 – OBJECT PROPERTIES
# =============================================================================

fw:hasVersion
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:FrameworkVersion ;
    rdfs:label "has version"@en , "heeft versie"@nl ;
    rdfs:comment "Links a framework to one of its published versions."@en ,
                 "Koppelt een kaderwerk aan een van zijn gepubliceerde versies."@nl .

fw:issuedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:IssuingBody ;
    rdfs:label "issued by"@en , "uitgegeven door"@nl ;
    rdfs:comment "Links a framework to its issuing body."@en ,
                 "Koppelt een kaderwerk aan de uitgevende instantie."@nl .

fw:appliesInJurisdiction
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:Jurisdiction ;
    rdfs:label "applies in jurisdiction"@en , "van toepassing in rechtsgebied"@nl ;
    rdfs:comment "Specifies the jurisdiction(s) in which a framework is applicable or binding."@en ,
                 "Specificeert de rechtsgebieden waarbinnen een kaderwerk van toepassing of bindend is."@nl .

fw:hasDomain
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:FrameworkDomain ;
    rdfs:label "has domain"@en , "heeft domein"@nl ;
    rdfs:comment "Associates a framework with one or more thematic domains."@en ,
                 "Koppelt een kaderwerk aan een of meer thematische domeinen."@nl .

fw:transposedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:EUDirective ;
    rdfs:range fw:NationalLaw ;
    rdfs:label "transposed by"@en , "omgezet door"@nl ;
    rdfs:comment "Links an EU Directive to the national law(s) that transpose it."@en ,
                 "Koppelt een EU-richtlijn aan de nationale wet(ten) die haar omzetten."@nl .

fw:isTranspositieVan
    rdf:type owl:ObjectProperty ;
    owl:inverseOf fw:transposedBy ;
    rdfs:domain fw:NationalLaw ;
    rdfs:range fw:EUDirective ;
    rdfs:label "is transposition of"@en , "is omzetting van"@nl ;
    rdfs:comment "Links a national law to the EU Directive it transposes. Inverse of fw:transposedBy."@en ,
                 "Koppelt een nationale wet aan de EU-richtlijn die zij omzet. Inverse van fw:transposedBy."@nl .

# --- v4.4.0 Stap 2.3 — Wet-AMvB-uitwerking-relatie (inverse-paar) ---

fw:uitgewerktIn
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:NationalLaw ;
    rdfs:range fw:NationalLaw ;
    rdfs:label "uitgewerkt in"@nl , "elaborated in"@en ;
    rdfs:comment "Koppelt een wet aan een algemene maatregel van bestuur (AMvB) die haar uitwerkt. Voorbeeld v4.4.0: fw:CBW fw:uitgewerktIn fw:Cbb. Domain en range zijn beide fw:NationalLaw conform precedent (BesluitCIOStelsel, BesluitBVAStelsel en VIR/VIRBI zijn ook gewone fw:NationalLaw-individuals zonder AMvB-subklasse)."@nl ,
                 "Links a national law to a general administrative order (AMvB) that elaborates it. Example v4.4.0: fw:CBW fw:uitgewerktIn fw:Cbb. Domain and range are both fw:NationalLaw following precedent (BesluitCIOStelsel, BesluitBVAStelsel and VIR/VIRBI are also plain fw:NationalLaw individuals without an AMvB subclass)."@en .

fw:werktUit
    rdf:type owl:ObjectProperty ;
    owl:inverseOf fw:uitgewerktIn ;
    rdfs:domain fw:NationalLaw ;
    rdfs:range fw:NationalLaw ;
    rdfs:label "werkt uit"@nl , "elaborates"@en ;
    rdfs:comment "Koppelt een AMvB aan de wet die zij uitwerkt. Inverse van fw:uitgewerktIn."@nl ,
                 "Links a general administrative order to the law it elaborates. Inverse of fw:uitgewerktIn."@en .

fw:supersedes
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "supersedes"@en , "vervangt"@nl ;
    rdfs:comment "Indicates that this framework version supersedes an earlier version."@en ,
                 "Geeft aan dat dit kaderwerk een eerdere versie vervangt."@nl .

fw:relatedTo
    rdf:type owl:ObjectProperty ;
    rdf:type owl:SymmetricProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "related to"@en , "gerelateerd aan"@nl ;
    rdfs:comment "A symmetric property linking related frameworks (e.g. ISO 27001 and ISO 27002)."@en ,
                 "Een symmetrische eigenschap die gerelateerde kaderwerken koppelt (bijv. ISO 27001 en ISO 27002)."@nl .

fw:alignsWith
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "aligns with"@en , "sluit aan op"@nl ;
    rdfs:comment "Indicates partial or full alignment between two frameworks."@en ,
                 "Geeft gedeeltelijke of volledige afstemming tussen twee kaderwerken aan."@nl .

fw:dektAf
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "covers requirements of"@en , "dekt eisen af van"@nl ;
    rdfs:comment
        "Indicates that compliance with the subject framework substantially covers the requirements of the object framework. This is a directional, non-symmetric relationship: A fw:dektAf B means implementing A satisfies (most of) B's requirements."@en ,
        "Geeft aan dat naleving van het subject-framework in hoge mate de eisen van het object-framework afdekt. Dit is een directionele, niet-symmetrische relatie: A fw:dektAf B betekent dat implementatie van A (het merendeel van) B's eisen vervult."@nl .

fw:toetst
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "audits"@en , "toetst"@nl ;
    rdfs:comment
        "Indicates that the subject framework serves as an audit or assessment instrument for the object framework. E.g. ENSIA fw:toetst BIO 2.0."@en ,
        "Geeft aan dat het subject-framework als audit- of toetsingsinstrument dient voor het object-framework. Bijv. ENSIA fw:toetst BIO 2.0."@nl .

fw:geeftRichtlijnenVoor
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "provides implementation guidance for"@en , "geeft implementatierichtlijnen voor"@nl ;
    rdfs:comment
        "Indicates that a standard provides implementation guidance for the controls of another standard. Specifically: ISO 27002 provides guidance for the implementation of ISO 27001 Annex A controls."@en ,
        "Geeft aan dat een norm implementatierichtlijnen biedt voor de controls uit een andere norm. Specifiek: ISO 27002 geeft richtlijnen voor de implementatie van ISO 27001 Bijlage A controls."@nl .

fw:stelVerplicht
    rdf:type owl:ObjectProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "mandates"@en , "stelt verplicht"@nl ;
    rdfs:comment
        "Indicates that the subject framework legally mandates the implementation of the object framework. E.g. VIR 2007 mandates BIO 2.0 for the Dutch central government."@en ,
        "Geeft aan dat het subject-framework het object-framework wettelijk verplicht stelt. Bijv. VIR 2007 stelt BIO 2.0 verplicht voor de Rijksdienst."@nl .

# =============================================================================
# SECTIE 3 – DATA PROPERTIES
# =============================================================================

fw:hasIdentifier
    rdf:type owl:DatatypeProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:string ;
    rdfs:label "has identifier"@en , "heeft identificatiecode"@nl ;
    rdfs:comment "A short unique identifier for the framework (e.g. 'ISO-27001-2022')."@en ,
                 "Een korte unieke identificatiecode voor het kaderwerk (bijv. 'ISO-27001-2022')."@nl .

fw:hasVersionLabel
    rdf:type owl:DatatypeProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:string ;
    rdfs:label "has version label"@en , "heeft versielabel"@nl ;
    rdfs:comment "The version string of the framework (e.g. '2022', 'Rev.5', 'v2.0')."@en ,
                 "De versieaanduiding van het kaderwerk (bijv. '2022', 'Rev.5', 'v2.0')."@nl .

fw:hasPublicationDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:date ;
    rdfs:label "has publication date"@en , "heeft publicatiedatum"@nl ;
    rdfs:comment "The official publication date of the framework or its version."@en ,
                 "De officiële publicatiedatum van het kaderwerk of zijn versie."@nl .

fw:hasScope
    rdf:type owl:DatatypeProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has scope"@en , "heeft toepassingsgebied"@nl ;
    rdfs:comment "A textual description of the scope of the framework."@en ,
                 "Een tekstuele beschrijving van het toepassingsgebied van het kaderwerk."@nl .

fw:isMandatoryForDutchGovernment
    rdf:type owl:DatatypeProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:boolean ;
    rdfs:label "is mandatory for Dutch government"@en , "verplicht voor Nederlandse overheid"@nl ;
    rdfs:comment "Indicates whether compliance with this framework is legally mandatory for Dutch government entities."@en ,
                 "Geeft aan of naleving van dit kaderwerk wettelijk verplicht is voor Nederlandse overheidsorganisaties."@nl .

fw:officialURL
    rdf:type owl:DatatypeProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:anyURI ;
    rdfs:label "official URL"@en , "officiële URL"@nl ;
    rdfs:comment "The official web location where the framework can be accessed."@en ,
                 "De officiële weblocatie waar het kaderwerk kan worden geraadpleegd."@nl .

fw:status
    rdf:type owl:DatatypeProperty ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range rdfs:Literal ;
    rdfs:label "status"@en , "status"@nl ;
    rdfs:comment "The current legal or publication status of a framework (e.g. 'in force', 'in preparation', 'superseded')."@en ,
                 "De huidige juridische of publicatiestatus van een kaderwerk (bijv. 'van kracht', 'in voorbereiding', 'vervangen')."@nl .

# =============================================================================
# SECTIE 4 – ABOX: NAMED INDIVIDUALS (Kaderwerken)
# =============================================================================

# --- Uitgevende instanties ---------------------------------------------------

fw:ISO
    rdf:type fw:IssuingBody ;
    rdfs:label "International Organization for Standardization"@en ,
               "Internationale Organisatie voor Standaardisatie"@nl ;
    foaf:name "ISO" .

fw:IEC
    rdf:type fw:IssuingBody ;
    rdfs:label "International Electrotechnical Commission"@en ,
               "Internationale Elektrotechnische Commissie"@nl ;
    foaf:name "IEC" .

fw:NEN
    rdf:type fw:IssuingBody ;
    rdfs:label "Royal Netherlands Standardisation Institute"@en ,
               "Nederlands Normalisatie Instituut"@nl ;
    foaf:name "NEN" .

fw:NIST
    rdf:type fw:IssuingBody ;
    rdfs:label "National Institute of Standards and Technology"@en ,
               "Nationaal Instituut voor Normen en Technologie (VS)"@nl ;
    foaf:name "NIST" .

fw:EuropeanCommission
    rdf:type fw:IssuingBody ;
    rdfs:label "European Commission"@en , "Europese Commissie"@nl ;
    foaf:name "European Commission" .

fw:ISACA
    rdf:type fw:IssuingBody ;
    rdfs:label "ISACA"@en , "ISACA"@nl ;
    foaf:name "ISACA" .

fw:DutchCentral
    rdf:type fw:IssuingBody ;
    rdfs:label "Dutch Central Government (Rijksoverheid)"@en ,
               "Nederlandse Rijksoverheid"@nl ;
    foaf:name "Rijksoverheid" .

fw:NCSC_NL
    rdf:type fw:IssuingBody ;
    rdfs:label "National Cyber Security Centre Netherlands"@en ,
               "Nationaal Cyber Security Centrum"@nl ;
    foaf:name "NCSC-NL" .

# --- Rechtsgebieden ----------------------------------------------------------

fw:JurisdictionEU
    rdf:type fw:Jurisdiction ;
    rdfs:label "European Union"@en , "Europese Unie"@nl ;
    fw:hasIdentifier "EU" .

fw:JurisdictionNL
    rdf:type fw:Jurisdiction ;
    rdfs:label "The Netherlands"@en , "Nederland"@nl ;
    fw:hasIdentifier "NL" .

fw:JurisdictionInternational
    rdf:type fw:Jurisdiction ;
    rdfs:label "International"@en , "Internationaal"@nl ;
    fw:hasIdentifier "INT" .

fw:JurisdictionUS
    rdf:type fw:Jurisdiction ;
    rdfs:label "United States of America"@en , "Verenigde Staten van Amerika"@nl ;
    fw:hasIdentifier "US" .

# --- Domeinen ----------------------------------------------------------------

fw:DomainRiskManagement
    rdf:type fw:FrameworkDomain ;
    rdfs:label "Risk Management"@en , "Risicobeheer"@nl .

fw:DomainInformationSecurity
    rdf:type fw:FrameworkDomain ;
    rdfs:label "Information Security"@en , "Informatiebeveiliging"@nl .

fw:DomainBusinessContinuity
    rdf:type fw:FrameworkDomain ;
    rdfs:label "Business Continuity"@en , "Bedrijfscontinuïteit"@nl .

fw:DomainITGovernance
    rdf:type fw:FrameworkDomain ;
    rdfs:label "IT Governance"@en , "IT-governance"@nl .

fw:DomainCybersecurity
    rdf:type fw:FrameworkDomain ;
    rdfs:label "Cybersecurity"@en , "Cyberbeveiliging"@nl .

fw:DomainPrivacy
    rdf:type fw:FrameworkDomain ;
    rdfs:label "Privacy"@en , "Privacy"@nl .

fw:DomainCompliance
    rdf:type fw:FrameworkDomain ;
    rdfs:label "Compliance"@en , "Compliance"@nl .

fw:DomainICTServiceManagement
    rdf:type fw:FrameworkDomain ;
    rdfs:label "ICT Service Management"@en , "ICT-dienstbeheer"@nl .

# =============================================================================
# INFORMATIENORMEN (ISO/IEC)
# =============================================================================

fw:ISO_IEC_27001_2022
    rdf:type fw:InternationalStandard ;
    rdfs:label "ISO/IEC 27001:2022"@en , "ISO/IEC 27001:2022"@nl ;
    rdfs:comment
        "Requirements for an Information Security Management System (ISMS)."@en ,
        "Eisen voor een managementsysteem voor informatiebeveiliging (ISMS)."@nl ;
    fw:hasIdentifier "ISO-IEC-27001-2022" ;
    fw:hasVersionLabel "2022" ;
    fw:hasPublicationDate "2022-10-01"^^xsd:date ;
    fw:hasScope "ISMS requirements – applicable to all types and sizes of organisations."@en ;
    fw:isMandatoryForDutchGovernment "true"^^xsd:boolean ;
    fw:issuedBy fw:ISO , fw:IEC ;
    fw:appliesInJurisdiction fw:JurisdictionInternational , fw:JurisdictionNL ;
    fw:hasDomain fw:DomainInformationSecurity ;
    fw:relatedTo fw:ISO_IEC_27002_2022 ;
    fw:officialURL "https://www.iso.org/standard/27001"^^xsd:anyURI ;
    prov:wasDerivedFrom fw:ISO_IEC_27001_2013 .

fw:ISO_IEC_27001_2013
    rdf:type fw:InternationalStandard ;
    rdfs:label "ISO/IEC 27001:2013"@en , "ISO/IEC 27001:2013"@nl ;
    rdfs:comment "Superseded version of the ISMS requirements standard."@en ,
                 "Vervangen versie van de ISMS-eisennorm."@nl ;
    fw:hasIdentifier "ISO-IEC-27001-2013" ;
    fw:hasVersionLabel "2013" .

fw:ISO_IEC_27002_2022
    rdf:type fw:InternationalStandard ;
    rdfs:label "ISO/IEC 27002:2022"@en , "ISO/IEC 27002:2022"@nl ;
    rdfs:comment
        "ISO/IEC 27002:2022 contains the same 93 controls as ISO 27001:2022 Annex A, but with detailed implementation guidance, examples and considerations. It is not a separate set of controls but a guidance document for the same set. Controls are modelled in the ctrl: namespace."@en ,
        "ISO/IEC 27002:2022 bevat dezelfde 93 beheersmaatregelen als ISO 27001:2022 Bijlage A, maar voorzien van gedetailleerde implementatierichtlijnen, voorbeelden en overwegingen. Het is geen apart set maatregelen maar een handleiding bij dezelfde set. De controls worden in dit model gemodelleerd in de ctrl:-namespace."@nl ;
    fw:hasIdentifier "ISO-IEC-27002-2022" ;
    fw:hasVersionLabel "2022" ;
    fw:hasPublicationDate "2022-02-15"^^xsd:date ;
    fw:isMandatoryForDutchGovernment "true"^^xsd:boolean ;
    fw:issuedBy fw:ISO , fw:IEC ;
    fw:appliesInJurisdiction fw:JurisdictionInternational , fw:JurisdictionNL ;
    fw:hasDomain fw:DomainInformationSecurity ;
    fw:relatedTo fw:ISO_IEC_27001_2022 ;
    fw:geeftRichtlijnenVoor fw:ISO_IEC_27001_2022 ;
    fw:officialURL "https://www.iso.org/standard/75652.html"^^xsd:anyURI .

fw:ISO_IEC_27005_2022
    rdf:type fw:InternationalStandard ;
    rdfs:label "ISO/IEC 27005:2022"@en , "ISO/IEC 27005:2022"@nl ;
    rdfs:comment
