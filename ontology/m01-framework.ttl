# =============================================================================
# BVA TE BESCHERMEN BELANGEN (geïntegreerd uit m01-patch-bva-tbb.ttl, 2026-04-13)
# =============================================================================
#
# Bron: Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k — Te Beschermen
# Belangen (TBB): "personen, informatie, informatiesystemen, materieel,
# goederen, imago en objecten, waarbij in geval van compromittering, of de
# mogelijkheid van compromittering, nadelige gevolgen, of een risico daarop,
# kan ontstaan voor de vertrouwelijkheid, beschikbaarheid en integriteit van
# de primaire processen van de rijksoverheid, delen daarvan of voor andere
# belangen van de Staat, van zijn bondgenoten of van één of meer ministeries."
#
# Deze zeven concepten worden hier als skos:Concept gemodelleerd en
# georganiseerd in een skos:ConceptScheme. De mapping naar M18 asset-klassen
# is in m18-assets.ttl vastgelegd (skos:exactMatch).
#
# Masterchat-besluit D-M18-4 (13 april 2026): BVA TBB-concepten horen in M01
# (framework-content), niet in M18 (mapping-laag). M18 bevat uitsluitend de
# skos:exactMatch-relaties.
# =============================================================================

# ConceptScheme — groepeert de zeven Te Beschermen Belangen
fw:BVATeBeschermenBelangen
    rdf:type skos:ConceptScheme ;
    rdfs:label "BVA Te Beschermen Belangen"@nl ,
               "BVA Protected Interests"@en ;
    rdfs:comment "Conceptschema van de zeven Te Beschermen Belangen uit Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k."@nl ,
                 "Concept scheme of the seven Protected Interests from Besluit BVA-stelsel Rijksdienst 2021 art. 1 paragraph k."@en ;
    skos:prefLabel "Te Beschermen Belangen"@nl ,
                   "Protected Interests"@en ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    dcterms:isPartOf fw:BesluitBVAStelsel .

# Zeven skos:Concept-individuals
fw:TBB_Personen
    rdf:type skos:Concept ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "personen"@nl , "persons"@en ;
    skos:definition "Natuurlijke personen als beschermwaardig belang binnen de Rijksdienst."@nl ,
                    "Natural persons as a protected interest within the central government."@en ;
    rdfs:label "TBB Personen"@nl , "TBB Persons"@en ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" .

fw:TBB_Informatie
    rdf:type skos:Concept ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "informatie"@nl , "information"@en ;
    skos:definition "Informatie als beschermwaardig belang binnen de Rijksdienst, ongeacht drager of vorm."@nl ,
                    "Information as a protected interest within the central government, regardless of medium or form."@en ;
    rdfs:label "TBB Informatie"@nl , "TBB Information"@en ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" .

fw:TBB_Informatiesystemen
    rdf:type skos:Concept ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "informatiesystemen"@nl , "information systems"@en ;
    skos:definition "Informatiesystemen als beschermwaardig belang binnen de Rijksdienst."@nl ,
                    "Information systems as a protected interest within the central government."@en ;
    rdfs:label "TBB Informatiesystemen"@nl , "TBB Information Systems"@en ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" .

fw:TBB_Materieel
    rdf:type skos:Concept ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "materieel"@nl , "equipment"@en ;
    skos:definition "Duurzame operationele middelen als beschermwaardig belang binnen de Rijksdienst."@nl ,
                    "Durable operational resources as a protected interest within the central government."@en ;
    rdfs:label "TBB Materieel"@nl , "TBB Equipment"@en ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" .

fw:TBB_Goederen
    rdf:type skos:Concept ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "goederen"@nl , "tangible goods"@en ;
    skos:definition "Tastbare verbruiks- of inventarisgoederen als beschermwaardig belang binnen de Rijksdienst."@nl ,
                    "Tangible consumable or inventoried goods as a protected interest within the central government."@en ;
    rdfs:label "TBB Goederen"@nl , "TBB Tangible Goods"@en ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" .

fw:TBB_Imago
    rdf:type skos:Concept ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "imago"@nl , "image"@en ;
    skos:definition "Imago en reputatie als beschermwaardig belang binnen de Rijksdienst."@nl ,
                    "Image and reputation as a protected interest within the central government."@en ;
    rdfs:label "TBB Imago"@nl , "TBB Image"@en ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" .

fw:TBB_Objecten
    rdf:type skos:Concept ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "objecten"@nl , "objects"@en ;
    skos:definition "Fysieke objecten (zoals gebouwen en beveiligde ruimten) als beschermwaardig belang binnen de Rijksdienst, voor zover niet vallend onder materieel of goederen."@nl ,
                    "Physical objects (such as buildings and secure rooms) as a protected interest within the central government, insofar as not covered by equipment or tangible goods."@en ;
    rdfs:label "TBB Objecten"@nl , "TBB Objects"@en ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" .

