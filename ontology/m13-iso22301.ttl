@prefix fw:      <https://grc.example.org/framework/> .
@prefix ctrl:    <https://grc.example.org/control/> .
@prefix risk:    <https://grc.example.org/risk/> .
@prefix roles:   <https://grc.example.org/roles/> .
@prefix compl:   <https://grc.example.org/compliance/> .
@prefix isms:    <https://grc.example.org/isms/> .
@prefix biz:     <https://grc.example.org/business/> .
@prefix bio:     <https://grc.example.org/bio/> .
@prefix ext:     <https://grc.example.org/extended/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

# =============================================================================
# GRC Ontologie — Module M13: ISO 22301:2019 BCM
# Versie: 4.0.0-alpha | Datum: 2026-03-19 | Profiel: OWL 2 DL
# =============================================================================

<https://grc.example.org/ontology/m13-iso22301>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M13 — ISO 22301:2019 BCM"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

# === M13: ISO 22301:2019 BCM ===

ext:ISO22301_4_1 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 4.1: Inzicht in de organisatie en haar context"@nl ;
    rdfs:label "ISO 22301 4.1: Understanding the organization and its context"@en ;
    ext:clauseNumber "4.1" ;
    compl:requirementText "De organisatie moet externe en interne kwesties bepalen die relevant zijn voor haar doel en haar vermogen om de beoogde resultaten van haar BCMS te bereiken."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_4_2 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 4.2: Inzicht in de behoeften van belanghebbenden"@nl ;
    rdfs:label "ISO 22301 4.2: Understanding needs of interested parties"@en ;
    ext:clauseNumber "4.2" ;
    compl:requirementText "De organisatie moet de relevante belanghebbenden bepalen die relevant zijn voor het BCMS en hun relevante eisen en wettelijke verplichtingen."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_4_3 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 4.3: Toepassingsgebied van het BCMS"@nl ;
    rdfs:label "ISO 22301 4.3: Scope of the BCMS"@en ;
    ext:clauseNumber "4.3" ;
    compl:requirementText "De organisatie moet de grenzen en toepasselijkheid van het BCMS bepalen."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_5_1 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 5.1: Leiderschap en betrokkenheid"@nl ;
    rdfs:label "ISO 22301 5.1: Leadership and commitment"@en ;
    ext:clauseNumber "5.1" ;
    compl:requirementText "Het topmanagement moet blijk geven van leiderschap en betrokkenheid met betrekking tot het BCMS."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_5_2 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 5.2: Beleid"@nl ;
    rdfs:label "ISO 22301 5.2: Policy"@en ;
    ext:clauseNumber "5.2" ;
    compl:requirementText "Het topmanagement moet een BCM-beleid vaststellen dat past bij het doel van de organisatie."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_6_1 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 6.1: Maatregelen voor risicos en kansen"@nl ;
    rdfs:label "ISO 22301 6.1: Actions to address risks and opportunities"@en ;
    ext:clauseNumber "6.1" ;
    compl:requirementText "De organisatie moet risicos en kansen bepalen die moeten worden behandeld om de beoogde resultaten te bereiken."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_6_2 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 6.2: Doelstellingen voor bedrijfscontinuiteit"@nl ;
    rdfs:label "ISO 22301 6.2: Business continuity objectives"@en ;
    ext:clauseNumber "6.2" ;
    compl:requirementText "De organisatie moet BCM-doelstellingen vaststellen voor relevante functies en niveaus."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_8_1 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 8.1: Operationele planning en beheersing"@nl ;
    rdfs:label "ISO 22301 8.1: Operational planning and control"@en ;
    ext:clauseNumber "8.1" ;
    compl:requirementText "De organisatie moet processen plannen implementeren beheersen en controleren om aan de eisen te voldoen."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_8_2 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 8.2: Analyse van zakelijke impact en risicobeoordeling"@nl ;
    rdfs:label "ISO 22301 8.2: Business impact analysis and risk assessment"@en ;
    ext:clauseNumber "8.2" ;
    compl:requirementText "De organisatie moet een formeel gedocumenteerd proces voor BIA en risicobeoordeling implementeren en onderhouden."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_8_3 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 8.3: Strategieen en oplossingen voor bedrijfscontinuiteit"@nl ;
    rdfs:label "ISO 22301 8.3: Business continuity strategies and solutions"@en ;
    ext:clauseNumber "8.3" ;
    compl:requirementText "De organisatie moet geschikte strategieen en oplossingen bepalen op basis van de BIA en risicobeoordeling."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_8_4 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 8.4: Plannen en procedures voor bedrijfscontinuiteit"@nl ;
    rdfs:label "ISO 22301 8.4: Business continuity plans and procedures"@en ;
    ext:clauseNumber "8.4" ;
    compl:requirementText "De organisatie moet plannen en procedures documenteren om de respons op verstoringen te begeleiden."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_8_5 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 8.5: Oefenprogramma"@nl ;
    rdfs:label "ISO 22301 8.5: Exercise programme"@en ;
    ext:clauseNumber "8.5" ;
    compl:requirementText "De organisatie moet testen en oefeningen uitvoeren om de BCM-plannen en -procedures te valideren en te verbeteren."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_9_1 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 9.1: Bewaking meting analyse en evaluatie"@nl ;
    rdfs:label "ISO 22301 9.1: Monitoring measurement analysis and evaluation"@en ;
    ext:clauseNumber "9.1" ;
    compl:requirementText "De organisatie moet de geschiktheid en doeltreffendheid van het BCMS bewaken meten analyseren en evalueren."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_9_2 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 9.2: Interne audit"@nl ;
    rdfs:label "ISO 22301 9.2: Internal audit"@en ;
    ext:clauseNumber "9.2" ;
    compl:requirementText "De organisatie moet interne audits uitvoeren om vast te stellen of het BCMS conform is en doeltreffend wordt geimplementeerd."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_9_3 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 9.3: Directiebeoordeling"@nl ;
    rdfs:label "ISO 22301 9.3: Management review"@en ;
    ext:clauseNumber "9.3" ;
    compl:requirementText "Het topmanagement moet het BCMS beoordelen om de voortdurende geschiktheid toereikendheid en doeltreffendheid te waarborgen."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_10_1 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 10.1: Afwijking en corrigerende maatregel"@nl ;
    rdfs:label "ISO 22301 10.1: Nonconformity and corrective action"@en ;
    ext:clauseNumber "10.1" ;
    compl:requirementText "Als er een afwijking optreedt moet de organisatie reageren corrigerende maatregelen nemen en de doeltreffendheid evalueren."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

ext:ISO22301_10_2 rdf:type ext:BCMRequirement , owl:NamedIndividual ;
    rdfs:label "ISO 22301 10.2: Voortdurende verbetering"@nl ;
    rdfs:label "ISO 22301 10.2: Continual improvement"@en ;
    ext:clauseNumber "10.2" ;
    compl:requirementText "De organisatie moet continu de geschiktheid toereikendheid en doeltreffendheid van het BCMS verbeteren."@nl ;
    compl:derivedFrom fw:ISO_22301_2019 .

# ISO 22301 -> ISO 27002 koppelingen

ext:ISO22301_8_2 compl:satisfiedBy ctrl:ISO27002_5_29 , ctrl:ISO27002_5_07 .

ext:ISO22301_8_3 compl:satisfiedBy ctrl:ISO27002_5_29 , ctrl:ISO27002_5_30 .

ext:ISO22301_8_4 compl:satisfiedBy ctrl:ISO27002_5_29 .

ext:ISO22301_9_2 compl:satisfiedBy ctrl:ISO27002_5_35 .


