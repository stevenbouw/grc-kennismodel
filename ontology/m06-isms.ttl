# -----------------------------------------------------------------------------
# 4.1 Applicability Decisions & Implementation Statuses
# -----------------------------------------------------------------------------

isms:AD_Included
    rdf:type isms:ApplicabilityDecision ;
    rdfs:label "Included"@en , "Opgenomen"@nl ;
    rdfs:comment "Control is applicable and included in the SoA."@en ,
                 "Beheersmaatregel is van toepassing en opgenomen in de VvT."@nl .

isms:AD_Excluded
    rdf:type isms:ApplicabilityDecision ;
    rdfs:label "Excluded"@en , "Uitgesloten"@nl ;
    rdfs:comment "Control is not applicable; documented justification required."@en ,
                 "Beheersmaatregel is niet van toepassing; gedocumenteerde motivatie vereist."@nl .

isms:IS_NotStarted
    rdf:type isms:ImplementationStatus ;
    rdfs:label "Not Started"@en , "Nog niet gestart"@nl .

isms:IS_InProgress
    rdf:type isms:ImplementationStatus ;
    rdfs:label "In Progress"@en , "In uitvoering"@nl .

isms:IS_PartiallyImplemented
    rdf:type isms:ImplementationStatus ;
    rdfs:label "Partially Implemented"@en , "Gedeeltelijk geïmplementeerd"@nl .

isms:IS_FullyImplemented
    rdf:type isms:ImplementationStatus ;
    rdfs:label "Fully Implemented"@en , "Volledig geïmplementeerd"@nl .

isms:IS_Compensating
    rdf:type isms:ImplementationStatus ;
    rdfs:label "Compensating Control in Place"@en , "Compenserende maatregel aanwezig"@nl .

# -----------------------------------------------------------------------------
# 4.2 Informatieclassificatieniveaus (VIR 2007 / VIRBI 2025 schema)
# -----------------------------------------------------------------------------

isms:CL_Openbaar
    rdf:type isms:InformationClassificationLevel ;
    rdfs:label "Openbaar"@nl , "Public"@en ;
    rdfs:comment "Informatie die zonder beperking gepubliceerd mag worden. VIR 2007."@nl , "Information that may be published without restriction. VIR 2007."@en .

isms:CL_Intern
    rdf:type isms:InformationClassificationLevel ;
    rdfs:label "Intern"@nl , "Internal"@en ;
    rdfs:comment "Informatie voor intern gebruik; niet bedoeld voor externe verspreiding. VIR 2007."@nl , "Information for internal use; not intended for external distribution. VIR 2007."@en .

isms:CL_Vertrouwelijk
    rdf:type isms:InformationClassificationLevel ;
    rdfs:label "Vertrouwelijk"@nl , "Confidential"@en ;
    rdfs:comment "Gevoelige informatie; openbaarmaking kan schade toebrengen. VIR 2007."@nl , "Sensitive information; disclosure may cause damage. VIR 2007."@en .

isms:CL_GeheimDep
    rdf:type isms:InformationClassificationLevel ;
    rdfs:label "Departementaal Vertrouwelijk (Dep.V)"@nl , "Departmentally Confidential"@en ;
    rdfs:comment "Gerubriceerde informatie conform VIRBI 2025 – niveau 1. Beperkte verspreiding binnen het departement."@nl , "Classified information per VIRBI 2025 – level 1. Limited distribution within the department."@en .

isms:CL_Confidentieel
    rdf:type isms:InformationClassificationLevel ;
    rdfs:label "Confidentieel (Conf.)"@nl , "Confidential (Classified)"@en ;
    rdfs:comment "Gerubriceerde informatie conform VIRBI 2025 – niveau 2. Openbaarmaking kan schade aan belangen van de staat veroorzaken."@nl , "Classified information per VIRBI 2025 – level 2. Disclosure may cause damage to state interests."@en .

isms:CL_Geheim
    rdf:type isms:InformationClassificationLevel ;
    rdfs:label "Geheim"@nl , "Secret"@en ;
    rdfs:comment "Gerubriceerde informatie conform VIRBI 2025 – niveau 3. Ernstige schade aan belangen van de staat."@nl , "Classified information per VIRBI 2025 – level 3. Severe damage to state interests."@en .

isms:CL_ZeerGeheim
    rdf:type isms:InformationClassificationLevel ;
    rdfs:label "Zeer Geheim (STG-ZG)"@nl , "Top Secret"@en ;
    rdfs:comment "Gerubriceerde informatie conform VIRBI 2025 – niveau 4 (hoogste). Uitzonderlijk ernstige schade."@nl , "Classified information per VIRBI 2025 – level 4 (highest). Exceptionally severe damage."@en .

# -----------------------------------------------------------------------------
# 4.3 De ISMS-instantie
# -----------------------------------------------------------------------------

isms:ISMS_HoofdOrganisatie
    rdf:type isms:ISMS ;
    isms:hasISMSID "ISMS-NL-GOV-001" ;
    rdfs:label "ISMS Hoofdorganisatie"@nl ;
    rdfs:label "Main Organisation ISMS"@en ;
    rdfs:comment "Het primaire ISMS van de organisatie, gecertificeerd conform ISO/IEC 27001:2022, mede dekkend BIO 2.0 en NIS2/CBW-verplichtingen."@nl , "The organisation's primary ISMS, certified per ISO/IEC 27001:2022, also covering BIO 2.0 and NIS2/CBW obligations."@en ;
    isms:hasScope isms:SCOPE_Hoofdorganisatie ;
    isms:hasSoA isms:SoA_2026 ;
    isms:governedBy roles:R_CISO ;
    isms:addressesObligation compl:OBL_NIS2_Art21 ;
    isms:addressesObligation compl:OBL_NIS2_Art20 ;
    isms:addressesObligation compl:OBL_BIO2_Governance ;
    isms:addressesObligation compl:OBL_ISO27001_Cl6_1 .

isms:SCOPE_Hoofdorganisatie
    rdf:type isms:ISMSScope ;
    rdfs:label "ISMS-toepassingsgebied – Hoofdorganisatie"@nl , "ISMS Scope – Main Organisation"@en ;
    isms:hasScopeDescription "Alle informatiesystemen, processen, locaties en personeel van de organisatie die betrokken zijn bij de verwerking, opslag en transmissie van informatie geclassificeerd als Intern of hoger, inclusief beheerde cloud- en uitbestedingsdiensten."@nl ;
    isms:hasExclusion "Persoonlijk eigendom van medewerkers; derde partij systemen die uitsluitend door externe partijen worden beheerd zonder toegang tot organisatie-informatie."@nl .

# -----------------------------------------------------------------------------
# 4.4 Verklaring van Toepasselijkheid — GESANEERD in v4.2.2 (13 april 2026)
# Route A canonisering: isms:SOA_v1 + 15 isms:SOA_* verwijderd; canoniek is nu
# isms:SoA_2026 + 93 isms:SoAEntry_* (zie SECTIE hieronder en boven).
# ISMS_HoofdOrganisatie isms:hasSoA wijst nu naar isms:SoA_2026 (canoniseringsspiegel).
# Zie grc-core.ttl versiehistorie v4.2.2 en patch-rapport-v4.2.2-soa-opschoning.md.
# -----------------------------------------------------------------------------


