isms:PDCA_2026
    rdf:type isms:PDCACycle ;
    rdfs:label "ISMS PDCA-cyclus 2026"@nl , "ISMS PDCA Cycle 2026"@en ;
    isms:followsPhase isms:PDCA_Plan_2026 , isms:PDCA_Do_2026 , isms:PDCA_Check_2026 , isms:PDCA_Act_2026 .

isms:PDCA_Plan_2026   rdf:type isms:PlanPhase ;
    rdfs:label "Plan 2026: Risicobeoordeling, SoA-update, beleidsherstel"@nl , "Plan 2026: Risk assessment, SoA update, policy remediation"@en .
isms:PDCA_Do_2026     rdf:type isms:DoPhase ;
    rdfs:label "Do 2026: Implementatie incidentprocedure, MFA-uitrol, leveranciersbeleid"@nl , "Do 2026: Incident procedure implementation, MFA rollout, supplier policy"@en .
isms:PDCA_Check_2026  rdf:type isms:CheckPhase ;
    rdfs:label "Check 2026: Interne audit Q3, directiebeoordeling Q4"@nl , "Check 2026: Internal audit Q3, management review Q4"@en .
isms:PDCA_Act_2026    rdf:type isms:ActPhase ;
    rdfs:label "Act 2026: Verwerking auditbevindingen, corrigerende maatregelen"@nl , "Act 2026: Processing of audit findings, corrective actions"@en .

