@prefix fw:      <https://grc.example.org/framework/> .
@prefix ctrl:    <https://grc.example.org/control/> .
@prefix risk:    <https://grc.example.org/risk/> .
@prefix roles:   <https://grc.example.org/roles/> .
@prefix compl:   <https://grc.example.org/compliance/> .
@prefix isms:    <https://grc.example.org/isms/> .
@prefix biz:     <https://grc.example.org/business/> .
@prefix bio:     <https://grc.example.org/bio/> .
@prefix ext:     <https://grc.example.org/extended/> .
@prefix asset:   <https://grc.example.org/asset/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

# =============================================================================
# GRC Ontologie — Module M6: ISMS
# Versie: 4.0.0-alpha | Datum: 2026-03-19 | Profiel: OWL 2 DL
#
# v4.2.2 (13 april 2026):
# Route A — SOA-opschoning. isms:SOA_v1 + 15 isms:SOA_* entries verwijderd.
# Reden: onbedoelde duplicatie met isms:SoA_2026 + 93 isms:SoAEntry_* (G9-diagnostiek).
# Canoniseringsspiegel: isms:ISMS_HoofdOrganisatie isms:hasSoA wijst nu naar
# isms:SoA_2026 i.p.v. isms:SOA_v1. Alle 93 ISO 27002-controls blijven gedekt
# door SoAEntry_*.
#
# v4.3.0 (13 april 2026):
# G2 — isms:forRisk ObjectProperty toegevoegd (domain isms:SoAEntry,
# range risk:Risk). Optioneel (0..*). Directe traceerbaarheid SoA-entry ↔ Risk
# conform ISO 27001:2022 §6.1.3.c/d/e. Zie patch-rapport-v4.3.0.md.
# =============================================================================

<https://grc.example.org/ontology/m06-isms>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M6 — ISMS"@nl , "GRC Ontology Module M6 — ISMS"@en ;
    owl:imports <https://grc.example.org/ontology/> .

isms:ISMS
    rdf:type owl:Class ;
    rdfs:label "Information Security Management System (ISMS)"@en ,
               "Managementsysteem voor informatiebeveiliging (ISMS)"@nl ;
    rdfs:comment
        "The overall management system, based on a business risk approach, to establish, implement, operate, monitor, review, maintain and improve information security. [ISO/IEC 27001:2022]"@en ,
        "Het overkoepelende managementsysteem, gebaseerd op een zakelijke risicoaanpak, om informatiebeveiliging te vestigen, implementeren, exploiteren, monitoren, beoordelen, onderhouden en verbeteren. [ISO/IEC 27001:2022]"@nl .

isms:ISMSScope
    rdf:type owl:Class ;
    rdfs:label "ISMS Scope"@en , "ISMS-toepassingsgebied"@nl ;
    rdfs:comment
        "The boundaries and applicability of the ISMS as required by ISO/IEC 27001:2022 Clause 4.3. Defines the organisational units, locations, processes and technologies covered."@en ,
        "De grenzen en toepasselijkheid van het ISMS conform ISO/IEC 27001:2022 Clausule 4.3. Definieert de organisatorische eenheden, locaties, processen en technologieën die zijn opgenomen."@nl .

isms:ISMSContext
    rdf:type owl:Class ;
    rdfs:label "ISMS Context"@en , "ISMS-context"@nl ;
    rdfs:comment "Internal and external issues relevant to the ISMS. [ISO/IEC 27001:2022 Clause 4.1]"@en ,
                 "Interne en externe onderwerpen die relevant zijn voor het ISMS. [ISO/IEC 27001:2022 Clausule 4.1]"@nl .

isms:InterestedParty
    rdf:type owl:Class ;
    rdfs:label "Interested Party / Stakeholder"@en , "Belanghebbende"@nl ;
    rdfs:comment "Person or organisation that can affect, be affected by, or perceive itself to be affected by the ISMS. [ISO/IEC 27001:2022 Clause 4.2]"@en ,
                 "Persoon of organisatie die het ISMS kan beïnvloeden, erdoor beïnvloed kan worden, of zichzelf als beïnvloed beschouwt. [ISO/IEC 27001:2022 Clausule 4.2]"@nl .

# -----------------------------------------------------------------------------
# 1.2 Beleidsdocumentenhiërarchie
# -----------------------------------------------------------------------------

isms:ISMSDocument
    rdf:type owl:Class ;
    rdfs:label "ISMS Document"@en , "ISMS-document"@nl ;
    rdfs:comment "Any documented information required or maintained within the ISMS."@en ,
                 "Elk gedocumenteerde informatie die vereist of bijgehouden wordt binnen het ISMS."@nl .

isms:Policy
    rdf:type owl:Class ;
    rdfs:subClassOf isms:ISMSDocument ;
    rdfs:label "Policy"@en , "Beleidsdocument"@nl ;
    rdfs:comment "A high-level management direction document. Mandatory for ISO 27001:2022 Clause 5.2."@en ,
                 "Een hoog-niveau managementrichtlijn. Verplicht conform ISO 27001:2022 Clausule 5.2."@nl .

isms:TopLevelPolicy
    rdf:type owl:Class ;
    rdfs:subClassOf isms:Policy ;
    rdfs:label "Top-Level Information Security Policy"@en ,
               "Overkoepelend informatiebeveiligingsbeleid"@nl ;
    rdfs:comment "The single top-level IB policy approved by senior management. [ISO 27001:2022 Cl.5.2 / ISO 27002:2022 §5.1]"@en ,
                 "Het overkoepelende IB-beleid goedgekeurd door het topmanagement. [ISO 27001:2022 Cl.5.2 / ISO 27002:2022 §5.1]"@nl .

isms:TopicSpecificPolicy
    rdf:type owl:Class ;
    rdfs:subClassOf isms:Policy ;
    rdfs:label "Topic-Specific Policy"@en , "Onderwerpspecifiek beleid"@nl ;
    rdfs:comment "A subordinate policy covering a specific security topic (e.g. access control, cryptography). [ISO 27002:2022 §5.1]"@en ,
                 "Een onderliggend beleid voor een specifiek beveiligingsonderwerp (bijv. toegangsbeveiliging, cryptografie). [ISO 27002:2022 §5.1]"@nl .

isms:Procedure
    rdf:type owl:Class ;
    rdfs:subClassOf isms:ISMSDocument ;
    rdfs:label "Procedure"@en , "Procedure"@nl ;
    rdfs:seeAlso asset:Procedure ;
    rdfs:comment
        "ISMS administrative stub for procedures. Architectural component modeling resides in M18 (asset:Procedure)."@en ,
        "ISMS-administratieve stub voor procedures. Architecturale component-modellering staat in M18 (asset:Procedure)."@nl .

isms:Guideline
    rdf:type owl:Class ;
    rdfs:subClassOf isms:ISMSDocument ;
    rdfs:label "Guideline"@en , "Richtlijn"@nl ;
    rdfs:comment "Advisory document providing recommended approaches (not mandatory)."@en ,
                 "Advisdocument met aanbevolen benaderingen (niet verplicht)."@nl .

isms:WorkInstruction
    rdf:type owl:Class ;
    rdfs:subClassOf isms:ISMSDocument ;
    rdfs:label "Work Instruction"@en , "Werkinstructie"@nl ;
    rdfs:comment "Detailed step-by-step instructions for a specific task."@en ,
                 "Gedetailleerde stap-voor-stap instructies voor een specifieke taak."@nl .

isms:Record
    rdf:type owl:Class ;
    rdfs:subClassOf isms:ISMSDocument ;
    rdfs:label "Record (Documented Evidence)"@en , "Registratie (gedocumenteerd bewijs)"@nl ;
    rdfs:comment "Evidence of activities performed, retained as documented information."@en ,
                 "Bewijs van uitgevoerde activiteiten, bewaard als gedocumenteerde informatie."@nl .

# Disjointness between document types
[] rdf:type owl:AllDisjointClasses ;
   owl:members ( isms:Policy isms:Procedure isms:Guideline isms:WorkInstruction isms:Record ) .

# -----------------------------------------------------------------------------
# 1.3 Verklaring van Toepasselijkheid (SoA)
# -----------------------------------------------------------------------------

isms:StatementOfApplicability
    rdf:type owl:Class ;
    rdfs:label "Statement of Applicability (SoA)"@en ,
               "Verklaring van Toepasselijkheid (VvT)"@nl ;
    rdfs:comment
        "A document required by ISO/IEC 27001:2022 Clause 6.1.3(d) listing all Annex A controls with applicability decisions, implementation status and justifications."@en ,
        "Een document vereist door ISO/IEC 27001:2022 Clausule 6.1.3(d) met alle Annex A-beheersmaatregelen, toepasselijkheidsbesluiten, implementatiestatus en motivaties."@nl .

isms:SoAEntry
    rdf:type owl:Class ;
    rdfs:label "SoA Entry"@en , "VvT-invoer"@nl ;
    rdfs:comment
        "A single row in the Statement of Applicability, corresponding to one ISO/IEC 27001:2022 Annex A control (= ISO/IEC 27002:2022 control). Contains: control reference, applicability decision, implementation status, justification."@en ,
        "Een enkele rij in de Verklaring van Toepasselijkheid, overeenkomend met één ISO/IEC 27001:2022 Bijlage A-beheersmaatregel. Bevat: controlreferentie, toepasselijkheidsbeslissing, implementatiestatus, motivatie."@nl .

isms:ApplicabilityDecision
    rdf:type owl:Class ;
    rdfs:label "Applicability Decision"@en , "Toepasselijkheidsbeslissing"@nl ;
    rdfs:comment "Whether an Annex A control is included or excluded in the SoA."@en ,
                 "Of een Bijlage A-beheersmaatregel is opgenomen of uitgesloten in de VvT."@nl .

isms:ImplementationStatus
    rdf:type owl:Class ;
    rdfs:label "Implementation Status"@en , "Implementatiestatus"@nl ;
    rdfs:comment "The current implementation state of a control within the ISMS scope."@en ,
                 "De huidige implementatiestatus van een beheersmaatregel binnen het ISMS-toepassingsgebied."@nl .

# -----------------------------------------------------------------------------
# 1.4 Informatiebedrijfsmiddelen
# -----------------------------------------------------------------------------

isms:InformationAsset
    rdf:type owl:Class ;
    rdfs:label "Information Asset"@en , "Informatiebedrijfsmiddel"@nl ;
    rdfs:seeAlso asset:InformationAsset ;
    rdfs:comment
        "ISMS administrative stub for information assets. The architectural typology of information assets resides in M18 (asset:InformationAsset). This class remains for ISMS administration and SoA work; M18 provides the architectural taxonomy."@en ,
        "ISMS-administratieve stub voor information assets. De architecturale typologie van information assets staat in M18 (asset:InformationAsset). Deze klasse blijft voor ISMS-administratie en SoA-werk; M18 levert de architecturale taxonomie."@nl .

isms:PrimaryAsset
    rdf:type owl:Class ;
    rdfs:subClassOf isms:InformationAsset ;
    rdfs:label "Primary Asset"@en , "Primair bedrijfsmiddel"@nl ;
    rdfs:comment "Business processes and information that are the primary objects of protection. [ISO/IEC 27005:2022]"@en ,
                 "Bedrijfsprocessen en informatie die het primaire object van bescherming zijn. [ISO/IEC 27005:2022]"@nl .

isms:SupportingAsset
    rdf:type owl:Class ;
    rdfs:subClassOf isms:InformationAsset ;
    rdfs:label "Supporting Asset"@en , "Ondersteunend bedrijfsmiddel"@nl ;
    rdfs:comment "Hardware, software, network, personnel or site assets that support primary assets. [ISO/IEC 27005:2022]"@en ,
                 "Hardware-, software-, netwerk-, personeel- of locatiebedrijfsmiddelen die primaire bedrijfsmiddelen ondersteunen. [ISO/IEC 27005:2022]"@nl .

isms:InformationClassificationLevel
    rdf:type owl:Class ;
    rdfs:label "Information Classification Level"@en , "Informatieclassificatieniveau"@nl ;
    rdfs:comment "A named confidentiality level applied to information assets. Aligned with VIR 2007 and VIRBI 2025 classification scheme."@en ,
                 "Een benoemd vertrouwelijkheidsniveau toegepast op informatiebedrijfsmiddelen. Afgestemd op het VIR 2007 en VIRBI 2025 classificatieschema."@nl .

# -----------------------------------------------------------------------------
# 1.5 PDCA-cyclus klassen
# -----------------------------------------------------------------------------

isms:PDCACycle
    rdf:type owl:Class ;
    rdfs:label "PDCA Cycle"@en , "PDCA-cyclus"@nl ;
    rdfs:comment "An instance of the Plan-Do-Check-Act improvement cycle as applied to the ISMS."@en ,
                 "Een instantie van de Plan-Do-Check-Act-verbeteringscyclus zoals toegepast op het ISMS."@nl .

isms:PDCAPhase
    rdf:type owl:Class ;
    rdfs:label "PDCA Phase"@en , "PDCA-fase"@nl .

isms:PlanPhase    rdf:type owl:Class ; rdfs:subClassOf isms:PDCAPhase ;
    rdfs:label "Plan Phase"@en , "Plan-fase"@nl ;
    rdfs:comment "Establish ISMS scope, policy, risk assessment, risk treatment, SoA. [ISO 27001:2022 Clauses 4–6]"@en ,
                 "Stel ISMS-toepassingsgebied, beleid, risicobeoordeling, risicobehandeling, VvT vast. [ISO 27001:2022 Clausules 4–6]"@nl .

isms:DoPhase      rdf:type owl:Class ; rdfs:subClassOf isms:PDCAPhase ;
    rdfs:label "Do Phase"@en , "Do-fase"@nl ;
    rdfs:comment "Implement and operate controls, processes and procedures. [ISO 27001:2022 Clause 8]"@en ,
                 "Implementeer en beheer beheersmaatregelen, processen en procedures. [ISO 27001:2022 Clausule 8]"@nl .

isms:CheckPhase   rdf:type owl:Class ; rdfs:subClassOf isms:PDCAPhase ;
    rdfs:label "Check Phase"@en , "Check-fase"@nl ;
    rdfs:comment "Monitor, measure, audit and review ISMS performance. [ISO 27001:2022 Clause 9]"@en ,
                 "Monitor, meet, audit en beoordeel ISMS-prestaties. [ISO 27001:2022 Clausule 9]"@nl .

isms:ActPhase     rdf:type owl:Class ; rdfs:subClassOf isms:PDCAPhase ;
    rdfs:label "Act Phase"@en , "Act-fase"@nl ;
    rdfs:comment "Take corrective actions and continually improve the ISMS. [ISO 27001:2022 Clause 10]"@en ,
                 "Neem corrigerende maatregelen en verbeter het ISMS continu. [ISO 27001:2022 Clausule 10]"@nl .

# -----------------------------------------------------------------------------
# 1.6 Procesklassen
# -----------------------------------------------------------------------------

isms:ISMSProcess
    rdf:type owl:Class ;
    rdfs:label "ISMS Process"@en , "ISMS-proces"@nl ;
    rdfs:comment "A defined, repeatable activity that contributes to the operation of the ISMS."@en ,
                 "Een gedefinieerde, herhaalbare activiteit die bijdraagt aan de werking van het ISMS."@nl .

isms:ControlObjective
    rdf:type owl:Class ;
    rdfs:label "Control Objective"@en , "Beheersdoelstelling"@nl ;
    rdfs:comment "A statement of intent describing what is to be achieved by implementing controls in a given area."@en ,
                 "Een intentieformulering die beschrijft wat beoogd wordt te bereiken door het implementeren van beheersmaatregelen in een bepaald gebied."@nl .

# =============================================================================
# SECTIE 2 – OBJECT PROPERTIES
# =============================================================================

# --- ISMS structuur ----------------------------------------------------------

isms:hasScope
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:ISMS ;
    rdfs:range isms:ISMSScope ;
    rdfs:label "has scope"@en , "heeft toepassingsgebied"@nl .

isms:hasContext
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:ISMS ;
    rdfs:range isms:ISMSContext ;
    rdfs:label "has context"@en , "heeft context"@nl .

isms:hasInterestedParty
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:ISMS ;
    rdfs:range isms:InterestedParty ;
    rdfs:label "has interested party"@en , "heeft belanghebbende"@nl .

isms:governedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:ISMS ;
    rdfs:range roles:Role ;
    rdfs:label "governed by"@en , "bestuurd door"@nl .

isms:hasSoA
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:ISMS ;
    rdfs:range isms:StatementOfApplicability ;
    rdfs:label "has Statement of Applicability"@en , "heeft Verklaring van Toepasselijkheid"@nl .

isms:documentedIn
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:ISMSProcess ;
    rdfs:range isms:ISMSDocument ;
    rdfs:label "documented in"@en , "gedocumenteerd in"@nl .

isms:implementsControl
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range ctrl:Control ;
    rdfs:label "implements control"@en , "implementeert beheersmaatregel"@nl .

isms:hasApplicabilityDecision
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range isms:ApplicabilityDecision ;
    rdfs:label "has applicability decision"@en , "heeft toepasselijkheidsbeslissing"@nl .

isms:hasImplementationStatus
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range isms:ImplementationStatus ;
    rdfs:label "has implementation status"@en , "heeft implementatiestatus"@nl .

isms:containsEntry
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:StatementOfApplicability ;
    rdfs:range isms:SoAEntry ;
    owl:inverseOf isms:forSoA ;
    rdfs:label "contains SoA entry"@en , "bevat VvT-invoer"@nl ;
    rdfs:comment "Links a Statement of Applicability to one of its entries. Inverse of isms:forSoA."@en ,
                 "Koppelt een Statement of Applicability aan een van zijn entries. Inverse van isms:forSoA."@nl .

isms:forRisk
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range risk:Risk ;
    rdfs:label "for risk"@en , "voor risico"@nl ;
    rdfs:comment "Links SoA entry to the justifying risk per ISO 27001:2022 §6.1.3.c/d/e."@en ,
                 "Koppelt VvT-invoer aan rechtvaardigend risico conform ISO 27001:2022 §6.1.3.c/d/e."@nl ;
    rdfs:isDefinedBy <https://grc.example.org/isms/> .

# --- Bedrijfsmiddelen --------------------------------------------------------

isms:inScopeOf
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range isms:ISMSScope ;
    rdfs:label "in scope of"@en , "valt binnen toepassingsgebied van"@nl .

isms:hasClassification
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range isms:InformationClassificationLevel ;
    rdfs:label "has classification"@en , "heeft classificatie"@nl .

isms:ownedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range roles:Role ;
    rdfs:label "owned by"@en , "eigendom van"@nl .

isms:supports
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:SupportingAsset ;
    rdfs:range isms:PrimaryAsset ;
    rdfs:label "supports"@en , "ondersteunt"@nl .

# --- Compliance / Risk verbindingen ------------------------------------------

isms:addressesObligation
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:ISMS ;
    rdfs:range compl:Obligation ;
    rdfs:label "addresses obligation"@en , "adresseert verplichting"@nl .

isms:linkedToRisk
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range risk:Risk ;
    rdfs:label "linked to risk"@en , "gekoppeld aan risico"@nl .

isms:supportedByProcess
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:ISMSProcess ;
    rdfs:range isms:ISMSProcess ;
    rdfs:label "supported by process"@en , "ondersteund door proces"@nl .

isms:hasControlObjective
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range isms:ControlObjective ;
    rdfs:label "has control objective"@en , "heeft beheersdoelstelling"@nl .

isms:satisfiesRequirement
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range compl:ComplianceRequirement ;
    rdfs:label "satisfies requirement"@en , "vervult vereiste"@nl .

# --- Beleidshiërarchie -------------------------------------------------------

isms:subordinateTo
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    rdfs:domain isms:TopicSpecificPolicy ;
    rdfs:range isms:TopLevelPolicy ;
    rdfs:label "subordinate to"@en , "onderliggend aan"@nl .

isms:implementedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:Policy ;
    rdfs:range isms:Procedure ;
    rdfs:label "implemented by procedure"@en , "geïmplementeerd door procedure"@nl .

# --- PDCA -------------------------------------------------------------------

isms:followsPhase
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:PDCACycle ;
    rdfs:range isms:PDCAPhase ;
    rdfs:label "follows phase"@en , "volgt fase"@nl .

isms:forSoA
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range isms:StatementOfApplicability ;
    rdfs:label "for SoA"@en , "behoort bij SoA"@nl ;
    rdfs:comment "Links a Statement of Applicability entry to the SoA it belongs to."@en ,
                 "Koppelt een SoA-entry aan de Statement of Applicability waartoe deze behoort."@nl .

# =============================================================================
# SECTIE 3 – DATA PROPERTIES
# =============================================================================

isms:controlDomain
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range rdfs:Literal ;
    rdfs:label "control domain"@en , "beheersmaatregeldomein"@nl ;
    rdfs:comment "The thematic domain of the control in the SoA context (e.g. 'Organisatorisch', 'Technologisch')."@en ,
                 "Het thematisch domein van de beheersmaatregel in de SoA-context (bijv. 'Organisatorisch', 'Technologisch')."@nl .

isms:hasSoAVersion
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:StatementOfApplicability ;
    rdfs:range xsd:string ;
    rdfs:label "has SoA version"@en , "heeft SoA-versie"@nl ;
    rdfs:comment "Version identifier for the Statement of Applicability."@en ,
                 "Versieaanduiding van de Statement of Applicability."@nl .

isms:hasISMSID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:ISMS ;
    rdfs:range xsd:string ;
    rdfs:label "has ISMS ID"@en , "heeft ISMS-ID"@nl .

isms:hasScopeDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:ISMSScope ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has scope description"@en , "heeft toepassingsgebiedbeschrijving"@nl .

isms:hasExclusion
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:ISMSScope ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has exclusion"@en , "heeft uitsluiting"@nl .

isms:documentID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range xsd:string ;
    rdfs:label "document ID"@en , "document-ID"@nl .

isms:documentTitle
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range rdfs:Literal ;
    rdfs:label "document title"@en , "documenttitel"@nl .

isms:documentVersion
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range xsd:string ;
    rdfs:label "document version"@en , "documentversie"@nl .

isms:approvedDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range xsd:date ;
    rdfs:label "approved date"@en , "goedkeuringsdatum"@nl .

isms:reviewDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range xsd:date ;
    rdfs:label "review date"@en , "herzieningsdatum"@nl .

isms:soaVersion
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:StatementOfApplicability ;
    rdfs:range xsd:string ;
    rdfs:label "SoA version"@en , "VvT-versie"@nl .

isms:soaApprovalDate
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:StatementOfApplicability ;
    rdfs:range xsd:date ;
    rdfs:label "SoA approval date"@en , "goedkeuringsdatum VvT"@nl .

isms:justification
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range rdfs:Literal ;
    rdfs:label "justification"@en , "motivatie"@nl .

isms:assetID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range xsd:string ;
    rdfs:label "asset ID"@en , "bedrijfsmiddel-ID"@nl .

isms:assetName
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range rdfs:Literal ;
    rdfs:label "asset name"@en , "naam bedrijfsmiddel"@nl .

isms:confidentialityValue
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range xsd:integer ;
    rdfs:label "confidentiality value (1-3)"@en , "vertrouwelijkheidswaarde (1-3)"@nl .

isms:integrityValue
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range xsd:integer ;
    rdfs:label "integrity value (1-3)"@en , "integriteitswaarde (1-3)"@nl .

isms:availabilityValue
    rdf:type owl:DatatypeProperty ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range xsd:integer ;
    rdfs:label "availability value (1-3)"@en , "beschikbaarheidswaarde (1-3)"@nl .

