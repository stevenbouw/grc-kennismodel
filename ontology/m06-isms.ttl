    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen structureel logmanagement aanwezig; logbestanden worden niet centraal opgeslagen, geanalyseerd of opgevolgd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_04_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_04 — Niveau 2"@nl , "Cap_Cbw_04 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_04 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Enkele loggegevens worden verzameld, maar analyse en opvolging vinden slechts incidenteel en handmatig plaats."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_04_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_04 — Niveau 3"@nl , "Cap_Cbw_04 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_04 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Logmanagement is aantoonbaar ingericht en gericht op het detecteren, analyseren en opvolgen van relevante gebeurtenissen. Procedures en verantwoordelijkheden zijn vastgelegd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_04_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_04 — Niveau 4"@nl , "Cap_Cbw_04 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_04 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Logmanagement is effectief: logging vindt plaats op kritieke systemen, gebeurtenissen worden geanalyseerd, afwijkingen worden opgevolgd en de werking wordt periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_04_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_04 — Niveau 5"@nl , "Cap_Cbw_04 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_04 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Logmanagement is geautomatiseerd, risicogebaseerd ingericht, en continue analyse leidt tot proactieve opsporing en structurele verbetering van beveiligingsmaatregelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_05
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Bedrijfscontinuïteit"@nl ,
               "Business continuity"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_05_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_05 — Niveau 1"@nl , "Cap_Cbw_05 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_05 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er zijn geen maatregelen getroffen voor bedrijfscontinuïteit. Er is geen herstelplan, geen herstelprocedures en geen bijbehorend beleid beschikbaar."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_05_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_05 — Niveau 2"@nl , "Cap_Cbw_05 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_05 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er bestaan enkele ongedocumenteerde maatregelen voor bedrijfscontinuïteit. Een herstelplan of herstelprocedures zijn deels aanwezig, maar niet vastgelegd in beleid of getest."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_05_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_05 — Niveau 3"@nl , "Cap_Cbw_05 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_05 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is beleid vastgesteld waarin maatregelen voor bedrijfscontinuïteit en een herstelplan met herstelprocedures zijn opgenomen. Deze documenten zijn beschikbaar en bekend binnen de organisatie. Het herstelplan en de herstelprocedures zijn aantoonbaar getest."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_05_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_05 — Niveau 4"@nl , "Cap_Cbw_05 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_05 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het beleid voor bedrijfscontinuïteit en herstel is afgestemd op de organisatiecontext en wordt periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_05_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_05 — Niveau 5"@nl , "Cap_Cbw_05 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_05 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het beleid, het herstelplan en de herstelprocedures voor bedrijfscontinuïteit zijn volledig geïntegreerd in de bedrijfsvoering. Ze worden cyclisch getest, geëvalueerd en verbeterd op basis van risicoanalyses en lessons learned."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_06
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Crisisbeheer"@nl ,
               "Crisis management"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_06_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_06 — Niveau 1"@nl , "Cap_Cbw_06 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_06 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er zijn geen formele maatregelen of beleid voor crisisbeheer. Er zijn geen afspraken over communicatie of coördinatie bij ernstige verstoringen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_06_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_06 — Niveau 2"@nl , "Cap_Cbw_06 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_06 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er zijn informele afspraken voor crisisbeheer, maar deze zijn niet vastgelegd in beleid. Communicatie en coördinatie gebeuren reactief en op basis van individuele kennis of ervaring."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_06_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_06 — Niveau 3"@nl , "Cap_Cbw_06 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_06 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is vastgesteld beleid voor crisisbeheer waarin aantoonbaar procedures, rollen en verantwoordelijkheden zijn opgenomen, inclusief afspraken over communicatie en coördinatie bij verstoringen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_06_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_06 — Niveau 4"@nl , "Cap_Cbw_06 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_06 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het beleid voor crisisbeheer is in werking en wordt periodiek geoefend of getest. Communicatie en coördinatie verlopen via vastgestelde protocollen, en evaluaties worden uitgevoerd na crisissituaties."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_06_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_06 — Niveau 5"@nl , "Cap_Cbw_06 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_06 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Crisisbeheer is geïntegreerd in de governance- en risicostructuur van de organisatie. Beleidsdocumenten, communicatieprotocollen en coördinatiemechanismen worden continu verbeterd op basis van oefeningen, evaluaties en externe dreigingsontwikkelingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_07
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Beleid over de toeleveringsketen"@nl ,
               "Supply chain policy"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_07_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_07 — Niveau 1"@nl , "Cap_Cbw_07 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_07 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen vastgesteld beleid met betrekking tot de beveiliging van de toeleveringsketen. Afhankelijkheden van leveranciers worden ad hoc benaderd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_07_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_07 — Niveau 2"@nl , "Cap_Cbw_07 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_07 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er is een conceptbeleid opgesteld over toeleveringsketenbeveiliging, maar dit is nog niet vastgesteld of organisatiebreed toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_07_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_07 — Niveau 3"@nl , "Cap_Cbw_07 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_07 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is vastgesteld beleid over de toeleveringsketen en afhankelijkheden worden geïnventariseerd. Toepassing vindt aantoonbaar plaats, maar zonder structurele borging of aantoonbaarheid"@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_07_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_07 — Niveau 4"@nl , "Cap_Cbw_07 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_07 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het beleid is vastgesteld, breed gecommuniceerd en wordt toegepast binnen relevante processen. Afhankelijkheden worden periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_07_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_07 — Niveau 5"@nl , "Cap_Cbw_07 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_07 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het beleid is volledig geïntegreerd in governance en risicomanagement. Evaluatie en bijstelling vinden cyclisch plaats op basis van risico’s en leveranciersontwikkeling. Er is continue monitoring van naleving."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_08
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Cyberbeveiligingseisen toeleveringsketen"@nl ,
               "Supply chain cybersecurity requirements"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_08_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_08 — Niveau 1"@nl , "Cap_Cbw_08 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_08 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er worden geen of slechts incidenteel afspraken gemaakt over cyberbeveiliging met leveranciers."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_08_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_08 — Niveau 2"@nl , "Cap_Cbw_08 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_08 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er zijn enkele schriftelijke afspraken gemaakt met leveranciers, maar deze zijn niet gebaseerd op uniform beleid. Naleving wordt niet actief bewaakt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_08_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_08 — Niveau 3"@nl , "Cap_Cbw_08 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_08 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Schriftelijke afspraken over beveiliging worden systematisch gemaakt voor nieuwe contracten, gebaseerd op het beleid. Naleving wordt aantoonbaar reactief gemonitord."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_08_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_08 — Niveau 4"@nl , "Cap_Cbw_08 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_08 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Er is een standaard raamwerk voor beveiligingseisen in contracten. Naleving wordt actief en regelmatig gecontroleerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_08_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_08 — Niveau 5"@nl , "Cap_Cbw_08 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_08 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Cyberbeveiligingseisen zijn onderdeel van alle leveranciersrelaties. Er vindt gestructureerde toetsing en auditing plaats. Er is een escalatiemechanisme bij niet-naleving."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_09
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Overzicht van de toeleveringsketen"@nl ,
               "Supply chain overview"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_09_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_09 — Niveau 1"@nl , "Cap_Cbw_09 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_09 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen centraal of actueel overzicht van leveranciers en bijbehorende afspraken."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_09_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_09 — Niveau 2"@nl , "Cap_Cbw_09 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_09 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Een overzicht wordt handmatig en beperkt bijgehouden, maar is incompleet of verouderd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_09_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_09 — Niveau 3"@nl , "Cap_Cbw_09 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_09 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is een actueel overzicht van leveranciers, producten/diensten en afspraken. Dit wordt periodiek handmatig bijgewerkt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_09_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_09 — Niveau 4"@nl , "Cap_Cbw_09 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_09 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het leveranciersoverzicht is volledig, digitaal toegankelijk en geïntegreerd in de beheersprocessen. Wijzigingen worden systematisch verwerkt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_09_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_09 — Niveau 5"@nl , "Cap_Cbw_09 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_09 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het overzicht is realtime, gekoppeld aan contractbeheer en risicobeoordeling. Er is inzicht in ketenafhankelijkheden, risico's en beveiligingsafspraken per leverancier."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_10
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Ontwikkelen en onderhouden van informatiesystemen"@nl ,
               "Development and maintenance of information systems"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_10_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_10 — Niveau 1"@nl , "Cap_Cbw_10 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_10 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er zijn geen maatregelen of beleid voor veilige ontwikkeling en onderhoud van informatiesystemen. Kwetsbaarheden worden niet systematisch beheerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_10_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_10 — Niveau 2"@nl , "Cap_Cbw_10 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_10 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er zijn enkele ontwikkel- en onderhoudsactiviteiten, maar zonder formeel beleid of vastgelegde procedures. Beveiligingsmaatregelen worden incidenteel toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_10_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_10 — Niveau 3"@nl , "Cap_Cbw_10 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_10 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is vastgesteld beleid waarin maatregelen zijn opgenomen voor veilige ontwikkeling en onderhoud van informatiesystemen, inclusief rollen, verantwoordelijkheden en basismaatregelen voor het omgaan met kwetsbaarheden. De maatregelen uit het beleid worden aantoonbaar toegepast tijdens ontwikkeling en onderhoud."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_10_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_10 — Niveau 4"@nl , "Cap_Cbw_10 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_10 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Er is structurele aandacht voor kwetsbaarheden, en updates en patches worden volgens vaste processen uitgevoerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_10_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_10 — Niveau 5"@nl , "Cap_Cbw_10 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_10 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Beveiliging is geïntegreerd in de gehele levenscyclus van informatiesystemen. Beleid wordt periodiek aangepast op basis van nieuwe kwetsbaarheden, dreigingen en technologische ontwikkelingen. Verbeteringen worden systematisch doorgevoerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_11
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Cyberhygiëne en opleidingen (algemeen)"@nl ,
               "Cyber hygiene and training (general)"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_11_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_11 — Niveau 1"@nl , "Cap_Cbw_11 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_11 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen structurele aandacht voor bewustwording of cyberhygiëne. Medewerkers worden niet geïnformeerd over risico’s of goed gedrag."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_11_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_11 — Niveau 2"@nl , "Cap_Cbw_11 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_11 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er zijn incidentele communicatie- of bewustwordingsacties, zoals een nieuwsbrief of eenmalige campagne. Er is geen structuur of borging."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_11_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_11 — Niveau 3"@nl , "Cap_Cbw_11 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_11 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is een basisbewustwordingsprogramma actief. Medewerkers ontvangen informatie en er is aantoonbaar aandacht voor goede cyberhygiëne. Deelname wordt beperkt gemonitord."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_11_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_11 — Niveau 4"@nl , "Cap_Cbw_11 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_11 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Cyberbewustwording is geïntegreerd in het onboardingproces, periodieke trainingen en communicatie. Deelname en gedragsverandering worden actief gemeten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_11_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_11 — Niveau 5"@nl , "Cap_Cbw_11 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_11 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Er is een doorlopend en aangepast bewustwordingsprogramma, gebaseerd op gedragsonderzoek en risicoanalyses. Medewerkers worden actief betrokken en getraind op rol-specifieke risico’s. Cyberhygiëne is onderdeel van de organisatiecultuur."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_12
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Cyberhygiëne en opleidingen (specifieke verantwoordelijken)"@nl ,
               "Cyber hygiene and training (specific responsibilities)"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_12_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_12 — Niveau 1"@nl , "Cap_Cbw_12 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_12 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Rollen met cybersecurityverantwoordelijkheden zijn niet expliciet toegewezen. Er worden geen gerichte opleidingen gegeven."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_12_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_12 — Niveau 2"@nl , "Cap_Cbw_12 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_12 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Enkele rollen zijn benoemd, maar niet organisatiebreed. Opleidingen zijn incidenteel en niet afgestemd op taken of verantwoordelijkheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_12_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_12 — Niveau 3"@nl , "Cap_Cbw_12 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_12 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Relevante rollen en verantwoordelijkheden zijn benoemd. Medewerkers met die rollen volgen periodiek basisopleidingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_12_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_12 — Niveau 4"@nl , "Cap_Cbw_12 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_12 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Rollen zijn formeel vastgelegd. Er is een opleidingsplan met inhoud afgestemd op specifieke taken en risicoprofielen. Voortgang wordt gevolgd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_12_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_12 — Niveau 5"@nl , "Cap_Cbw_12 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_12 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Rollen en vaardigheden zijn gekoppeld aan competentieprofielen en functiebeschrijvingen. Er is een gestructureerd leerprogramma met certificering, regelmatige bijscholing en evaluatie van effectiviteit. Ontwikkeling wordt continu bijgehouden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_13
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Beleid over cryptografie"@nl ,
               "Cryptography policy"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_13_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_13 — Niveau 1"@nl , "Cap_Cbw_13 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_13 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen beleid voor het gebruik van cryptografie. Toepassing ervan gebeurt willekeurig of ontbreekt volledig, zonder aandacht voor doel, algoritmes of sleutelbeheer."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_13_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_13 — Niveau 2"@nl , "Cap_Cbw_13 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_13 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Cryptografie wordt op onderdelen toegepast, maar zonder vastgesteld beleid. Keuze van algoritmes en omgang met sleutels is niet uniform of onderbouwd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_13_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_13 — Niveau 3"@nl , "Cap_Cbw_13 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_13 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit heeft beleid vastgesteld voor het gebruik van cryptografie, waarin het doel (zoals vertrouwelijkheid, integriteit en authenticatie) en basisprincipes van sleutelbeheer zijn opgenomen. Toepassing en sleutelbeheer zijn aantoonbaar afgestemd op risico’s"@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_13_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_13 — Niveau 4"@nl , "Cap_Cbw_13 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_13 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het beleid voor cryptografie is geïmplementeerd binnen relevante processen. Toepassing en sleutelbeheer zijn aantoonbaar afgestemd op risico’s en worden periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_13_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_13 — Niveau 5"@nl , "Cap_Cbw_13 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_13 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het cryptografiebeleid wordt continu geoptimaliseerd op basis van technologische ontwikkelingen, cryptografische standaarden en dreigingen. Cryptografisch gebruik en sleutelbeheer zijn volledig afgestemd op beveiligingsdoelstellingen en zijn aantoonbaar effectief."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_14
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Beveiligingsaspecten t.a.v. personeel"@nl ,
               "Personnel security aspects"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_14_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_14 — Niveau 1"@nl , "Cap_Cbw_14 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_14 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen formele aanwijzing van personeel of andere werkzame personen met betrekking tot de beveiliging van de netwerk- en informatiesystemen. Er zijn geen betrouwbaarheidseisen vastgesteld."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_14_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_14 — Niveau 2"@nl , "Cap_Cbw_14 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_14 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Enkele personen worden ad hoc betrokken bij activiteiten met betrekking tot de beveiliging van netwerk- en informatiesystemen, maar zonder formele vastlegging van rollen, verantwoordelijkheden of bevoegdheden. Betrouwbaarheidseisen worden niet of incidenteel toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_14_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_14 — Niveau 3"@nl , "Cap_Cbw_14 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_14 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit heeft beleid waarin zij personeel en andere werkzame personen formeel aanwijst met specifieke rollen, verantwoordelijkheden en bevoegdheden met betrekking tot de beveiliging van haar netwerk- en informatiesystemen. Passende betrouwbaarheidseisen zijn vastgesteld voor relevante functies."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_14_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_14 — Niveau 4"@nl , "Cap_Cbw_14 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_14 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "De aanwijzing van personeel en andere werkzame personen met betrekking tot de beveiliging van netwerk- en informatiesystemen wordt periodiek geëvalueerd en geactualiseerd. De toepassing van betrouwbaarheidseisen is aantoonbaar ingebed in HR-processen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_14_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_14 — Niveau 5"@nl , "Cap_Cbw_14 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_14 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De entiteit stemt de aanwijzing van personeel en werkzame personen, inclusief hun verantwoordelijkheden en bevoegdheden, systematisch af op actuele risico’s. Betrouwbaarheidseisen worden risicogebaseerd beheerd en continu verbeterd, met periodieke effectiviteitsmetingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_15
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Beveiligingsaspecten t.a.v. toegangsbeleid"@nl ,
               "Access control security aspects"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_15_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_15 — Niveau 1"@nl , "Cap_Cbw_15 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_15 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen schriftelijk toegangsbeveiligingsbeleid voor logische of fysieke toegang. Identiteiten, authenticaties, autorisaties en logbestanden worden niet of slechts incidenteel beheerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_15_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_15 — Niveau 2"@nl , "Cap_Cbw_15 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_15 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Toegang wordt deels beheerd op basis van informele afspraken. Uitgifte en intrekking van rechten vinden plaats, maar zonder eenduidig beleid. Logbestanden worden beperkt of niet structureel beheerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_15_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_15 — Niveau 3"@nl , "Cap_Cbw_15 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_15 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit beschikt over schriftelijk vastgesteld beleid voor logische en fysieke toegangsbeveiliging. Het beleid beschrijft het uitgeven, monitoren, gebruiken en intrekken van identiteiten, authenticaties en autorisaties, evenals het beheer van logbestanden en dit beleid wordt aantoonbaar toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_15_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_15 — Niveau 4"@nl , "Cap_Cbw_15 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_15 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het toegangsbeveiligingsbeleid wordt aantoonbaar toegepast. Toegang wordt structureel beheerd en gelogd. Periodieke beoordeling van identiteiten, authenticaties en autorisaties op noodzakelijkheid, juistheid en actualiteit is ingebed in de processen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_15_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_15 — Niveau 5"@nl , "Cap_Cbw_15 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_15 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Toegangsbeheer is volledig geïntegreerd in de beveiligingsstrategie. Het beleid wordt continu verbeterd op basis van risicoanalyses, incidenten en technologische ontwikkelingen. Periodieke evaluaties leiden aantoonbaar tot optimalisaties van toegangsrechten en logbeheer."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_16
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Beveiligingsaspecten t.a.v. beheer van assets"@nl ,
               "Asset management security aspects"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_16_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_16 — Niveau 1"@nl , "Cap_Cbw_16 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_16 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen vastgesteld beleid voor configuratiebeheer. Netwerk- en informatiesystemen worden ongecoördineerd ingericht en aangepast. Er is geen systeem voor classificatie van systemen op basis van vertrouwelijkheid, integriteit en beschikbaarheid (CIA). Regels voor gebruik zijn niet gedefinieerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_16_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_16 — Niveau 2"@nl , "Cap_Cbw_16 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_16 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er zijn beperkte richtlijnen voor configuratiebeheer, maar deze zijn niet formeel vastgesteld of consistent toegepast. Classificatie van systemen gebeurt incidenteel, zonder uniform kader. Regels voor gebruik bestaan deels, maar zijn niet breed bekend of toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_16_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_16 — Niveau 3"@nl , "Cap_Cbw_16 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_16 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is formeel beleid voor configuratiebeheer. Netwerk- en informatiesystemen worden systematisch geregistreerd en beheerd, inclusief een basale classificatie op CIA-criteria. Regels voor aanvaardbaar gebruik zijn vastgelegd en worden gecommuniceerd aan medewerkers. Toepassing wordt aantoonbaar gemonitord."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_16_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_16 — Niveau 4"@nl , "Cap_Cbw_16 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_16 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Configuratiebeheer is integraal onderdeel van IT-beheerprocessen. Alle relevante systemen zijn geclassificeerd volgens een vastgesteld model (CIA), en deze classificatie beïnvloedt de inrichting en beveiligingsmaatregelen. Regels voor gebruik zijn breed bekend, ingebed in processen en er vindt handhaving plaats. Naleving is aantoonbaar via logging, controles en audits."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_16_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_16 — Niveau 5"@nl , "Cap_Cbw_16 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_16 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Configuratiebeheer is geautomatiseerd en geïntegreerd met risicomanagement, incidentrespons en compliance. Classificatie van systemen vindt dynamisch plaats, wordt periodiek herzien en is gekoppeld aan autorisatie-, back-up- en monitoringstrategieën. Regels voor gebruik en omgang zijn verankerd in cultuur en tooling (bijv. automatische waarschuwingen of blokkades bij ongewenst gedrag). Beleid wordt continu verbeterd op basis van evaluaties, dreigingen en technologische ontwikkelingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_17
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Asset inventaris"@nl ,
               "Asset inventory"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_17_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_17 — Niveau 1"@nl , "Cap_Cbw_17 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_17 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen inventaris van informatie of netwerk- en informatiesystemen beschikbaar. Inzicht in aanwezige assets ontbreekt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_17_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_17 — Niveau 2"@nl , "Cap_Cbw_17 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_17 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Een gedeeltelijke inventaris is aanwezig, gebaseerd op losse overzichten of spreadsheets. De volledigheid en actualiteit zijn beperkt, en er is geen formeel proces voor onderhoud."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_17_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_17 — Niveau 3"@nl , "Cap_Cbw_17 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_17 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is een formeel proces en format vastgesteld voor het bijhouden van een inventaris van informatie en netwerk- en informatiesystemen. De inventaris is grotendeels volledig en wordt periodiek geactualiseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_17_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_17 — Niveau 4"@nl , "Cap_Cbw_17 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_17 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "De inventaris is volledig en actueel en wordt aantoonbaar bijgehouden volgens een vastgesteld proces. Nieuwe of gewijzigde assets worden structureel toegevoegd of aangepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_17_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_17 — Niveau 5"@nl , "Cap_Cbw_17 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_17 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De inventaris is geïntegreerd in geautomatiseerde beheerprocessen en tooling. Volledigheid en actualiteit worden real-time of near real-time bewaakt. De inventaris ondersteunt risicobeheer en beveiligingsmaatregelen effectief."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_18
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Attendering advies en informatie"@nl ,
               "Alerts, advice and information"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_18_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_18 — Niveau 1"@nl , "Cap_Cbw_18 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_18 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "De entiteit ontvangt zelden of niet actief dreigingsinformatie. Er is geen vastgesteld proces voor beoordeling of opvolging van beveiligingsadviezen. Vastlegging van eventuele acties ontbreekt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_18_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_18 — Niveau 2"@nl , "Cap_Cbw_18 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_18 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Informatie van CSIRT’s, leveranciers of andere bronnen wordt incidenteel verwerkt. Beoordelingen vinden ongestructureerd plaats. Soms wordt actie ondernomen, maar dit is niet vastgelegd of aantoonbaar."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_18_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_18 — Niveau 3"@nl , "Cap_Cbw_18 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_18 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit ontvangt regelmatig relevante dreigingsinformatie via ingestelde kanalen. Er is een intern proces voor beoordeling en eventuele aanpassing van maatregelen. Vastlegging gebeurt aantoonbaar."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_18_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_18 — Niveau 4"@nl , "Cap_Cbw_18 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_18 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Dreigingsinformatie wordt systematisch verzameld via erkende bronnen (bijv. NCSC, CSIRT, leveranciers). Beoordeling vindt plaats op basis van vastgestelde criteria. Besluiten over aanvullende maatregelen worden schriftelijk vastgelegd en gecommuniceerd naar betrokken teams."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_18_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_18 — Niveau 5"@nl , "Cap_Cbw_18 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_18 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De verwerking van dreigingsinformatie is geïntegreerd in risicobeheer- en wijzigingsprocessen. De entiteit monitort actief relevante bronnen, voert risico-impactanalyses uit, en past maatregelen structureel aan. De evaluatie en opvolging worden intern geaudit. Lessen uit eerdere dreigingen worden meegenomen in beleid en bewustwording."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_19
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Training 1"@nl ,
               "Training 1"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_19_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_19 — Niveau 1"@nl , "Cap_Cbw_19 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_19 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Bestuurders ontvangen geen training of bewustwording over cybersecurityrisico’s. Er is geen kennis aanwezig over risico’s of risicobeheersing."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_19_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_19 — Niveau 2"@nl , "Cap_Cbw_19 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_19 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Bestuurders zijn geïnformeerd over basisprincipes van cyberrisico’s, vaak via een eenmalige sessie. Risico’s en maatregelen worden niet systematisch begrepen of beoordeeld."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_19_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_19 — Niveau 3"@nl , "Cap_Cbw_19 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_19 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Bestuurders hebben aantoonbaar een training gevolgd die de risico’s en risicobeheersing op hoofdlijnen behandelt. Ze kunnen risico’s benoemen en inschatten op abstract niveau. Training is niet afgestemd op wettelijke eisen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_19_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_19 — Niveau 4"@nl , "Cap_Cbw_19 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_19 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Bestuurders hebben aantoonbaar een training gevolgd die voldoet aan de eisen uit de wet. Ze kunnen risico’s herkennen, doorvertalen naar de eigen organisatie en beoordelen welke maatregelen passend zijn."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_19_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_19 — Niveau 5"@nl , "Cap_Cbw_19 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_19 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Bestuurders zijn aantoonbaar strategisch vaardig in het inschatten van risico’s en beoordelen van gevolgen. Training is cyclisch, gecertificeerd en gekoppeld aan governanceprocessen. Cyberrisico’s worden structureel besproken in bestuursbesluiten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_20
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Training 2"@nl ,
               "Training 2"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_20_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_20 — Niveau 1"@nl , "Cap_Cbw_20 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_20 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er zijn geen afspraken over training voor bestuursleden. Deelname is vrijblijvend. Kennis wordt niet onderhouden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_20_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_20 — Niveau 2"@nl , "Cap_Cbw_20 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_20 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er is het voornemen om training te volgen, maar er is geen planning of borging dat alle leden binnen 2 jaar voldoen. Actualisatie vindt ad hoc plaats."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_20_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_20 — Niveau 3"@nl , "Cap_Cbw_20 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_20 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Alle bestuursleden voldoen aantoonbaar binnen 2 jaar aan de wettelijke trainingseisen. Actualiseren van kennis is nog niet structureel ingericht."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_20_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_20 — Niveau 4"@nl , "Cap_Cbw_20 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_20 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Alle bestuursleden voldoen aantoonbaar binnen 2 jaar aan de wettelijke trainingseisen. Actualisering vindt minimaal eens per 2 jaar plaats via een update- of herhalingstraining. Certificaten worden geregistreerd en geverifieerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_20_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_20 — Niveau 5"@nl , "Cap_Cbw_20 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_20 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De organisatie borgt structureel dat bestuursleden altijd over actuele kennis beschikken. Training wordt cyclisch herhaald, inhoud wordt aangepast op nieuwe dreigingen en wetgeving. Interne of externe toetsing op kennisniveau is onderdeel van governance."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_21
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Meldplicht significante incidenten"@nl ,
               "Significant incident notification obligation"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_21_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_21 — Niveau 1"@nl , "Cap_Cbw_21 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_21 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen beleid of procedure voor het melden van significante incidenten. Meldingen aan CSIRT of autoriteit vinden niet of alleen op ad-hocbasis plaats. Criteria voor “significant” zijn onbekend of ongedefinieerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_21_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_21 — Niveau 2"@nl , "Cap_Cbw_21 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_21 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "De entiteit onderkent het belang van melding, maar handelt reactief. Enkele meldingen zijn gedaan, zonder vastgelegde criteria of processen. Vrijwillige melding wordt niet benut."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_21_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_21 — Niveau 3"@nl , "Cap_Cbw_21 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_21 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit beschikt over een aantoonbare procedure voor het melden van significante incidenten aan CSIRT en bevoegde autoriteit. Criteria voor wat als significant geldt zijn vastgelegd. Vrijwillige meldingsoptie is bekend en kan worden toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_21_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_21 — Niveau 4"@nl , "Cap_Cbw_21 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_21 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Significante incidenten worden tijdig, correct en aantoonbaar gemeld. Criteria en processen zijn ingebed in incidentmanagement. Er wordt actief overwogen om ook vrijwillig meldingen te doen van relevante (bijna-)incidenten of cyberdreigingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_21_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_21 — Niveau 5"@nl , "Cap_Cbw_21 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_21 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De meldingsprocedure wordt regelmatig geëvalueerd en verbeterd. De entiteit maakt strategisch gebruik van vrijwillige meldingen om het eigen en ketenbewustzijn te versterken. Samenwerking met CSIRT en autoriteit verloopt actief en constructief."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_22
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Rapportages en tijdslijnen"@nl ,
               "Reports and timelines"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_22_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_22 — Niveau 1"@nl , "Cap_Cbw_22 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_22 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen vastgesteld proces voor het tijdig melden van significante incidenten in drie fasen. Rapportages worden onvolledig of niet binnen de voorgeschreven termijnen aangeleverd. Inhoudelijke vereisten zijn onbekend."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_22_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_22 — Niveau 2"@nl , "Cap_Cbw_22 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_22 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er is enige kennis van de rapportageplicht en termijnen. De entiteit probeert meldingen te doen, maar volgt de drie fasen niet consistent of mist vereiste informatie. Er is geen formeel proces of sjabloon voor rapportage."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_22_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_22 — Niveau 3"@nl , "Cap_Cbw_22 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_22 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit beschikt over een formeel proces voor meldingen in drie fasen met duidelijke termijnen en inhoudsvereisten. Eerste meldingen, updates en eindverslagen worden aantoonbaar tijdig en met de juiste informatie ingediend."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_22_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_22 — Niveau 4"@nl , "Cap_Cbw_22 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_22 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "De entiteit meldt alle significante incidenten aantoonbaar tijdig in de drie fasen. Rapportages bevatten consistent de voorgeschreven gegevens. Inhoud en tijdigheid worden structureel gemonitord en verantwoord."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_22_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_22 — Niveau 5"@nl , "Cap_Cbw_22 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_22 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De meldprocedure is volledig ingebed in incidentresponsprocessen. Rapportages worden automatisch ondersteund (bijv. via workflows of tooling). De inhoud wordt vooraf getoetst op volledigheid. Lessons learned uit eerdere meldingen leiden tot continue verbetering van kwaliteit en snelheid van rapportages."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_23
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Informeren van ontvangers en diensten"@nl ,
               "Informing recipients and services"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_23_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_23 — Niveau 1"@nl , "Cap_Cbw_23 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_23 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "De entiteit informeert de ontvangers van haar diensten niet of slechts ad hoc bij een significant incident. Er worden geen maatregelen gedeeld die deze ontvangers kunnen nemen in reactie op de dreiging."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_23_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_23 — Niveau 2"@nl , "Cap_Cbw_23 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_23 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "De entiteit informeert incidenteel en zonder vaste werkwijze de ontvangers van haar diensten bij een significant incident. Informatie over maatregelen die deze ontvangers kunnen nemen in reactie op de dreiging is beperkt of ontbreekt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_23_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_23 — Niveau 3"@nl , "Cap_Cbw_23 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_23 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit beschikt over een vastgelegd proces om de ontvangers aantoonbaar van haar diensten onverwijld in kennis te stellen bij een significant incident dat een nadelige invloed kan hebben op de verlening van hun diensten. Daarbij worden ook maatregelen gedeeld die deze ontvangers kunnen nemen in reactie op de dreiging."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_23_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_23 — Niveau 4"@nl , "Cap_Cbw_23 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_23 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "De entiteit informeert aantoonbaar en onverwijld alle relevante ontvangers van haar diensten bij een significant incident met mogelijke nadelige invloed op hun dienstverlening. Daarbij worden concrete en passende maatregelen gedeeld die deze ontvangers kunnen nemen in reactie op de dreiging. De toepassing en werking van het proces wordt periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_23_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_23 — Niveau 5"@nl , "Cap_Cbw_23 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_23 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De entiteit hanteert een volledig geïntegreerd en aantoonbaar effectief proces om bij ieder significant incident de relevante ontvangers van haar diensten onverwijld te informeren. Daarbij worden afgestemde maatregelen gedeeld die deze ontvangers kunnen nemen in reactie op de dreiging. Het proces wordt structureel verbeterd op basis van terugkoppeling en ervaringen uit eerdere incidenten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


# --- Blok 2: 9 ISMS-clausule-capabilities (ISMS_01..09) ---

isms:Cap_ISMS_01
    rdf:type isms:ISMSCapability , owl:NamedIndividual ;
    rdfs:label "Context"@nl ,
               "Context"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_ISMS_01_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_01 — Niveau 1"@nl , "Cap_ISMS_01 — Level 1"@en ;
    isms:forCapability isms:Cap_ISMS_01 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "De entiteit heeft geen inzicht in de eigen organisatie en is zich niet bewust van de context waarin zij haar processen en diensten  heeft ingericht. Er is geen besef van de toepasbaarheid van wet- en regelgeving binnen de organisatie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_01_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_01 — Niveau 2"@nl , "Cap_ISMS_01 — Level 2"@en ;
    isms:forCapability isms:Cap_ISMS_01 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "De entiteit heeft een beperkt inzicht in de eigen organisatie en is zich in beperkte mate bewust van de context waarin zij haar processen en diensten heeft ingericht. Er is enige bewustwording van de toepasbaarheid van wet- en regelgeving, maar dit is nog niet consistent binnen de organisatie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_01_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_01 — Niveau 3"@nl , "Cap_ISMS_01 — Level 3"@en ;
    isms:forCapability isms:Cap_ISMS_01 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit heeft een duidelijk inzicht in de eigen organisatie en begrijpt de context waarin zij haar processen en diensten heeft ingericht. De toepasbaarheid van wet- en regelgeving is bekend en wordt consistent toegepast binnen de organisatie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_01_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_01 — Niveau 4"@nl , "Cap_ISMS_01 — Level 4"@en ;
    isms:forCapability isms:Cap_ISMS_01 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "De entiteit heeft een diepgaand inzicht in de eigen organisatie en de context waarin zij haar processen en diensten heeft ingericht. De toepasbaarheid van wet- en regelgeving wordt actief gemonitord en beheerd, en er zijn meetbare indicatoren om de naleving te beoordelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_01_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_01 — Niveau 5"@nl , "Cap_ISMS_01 — Level 5"@en ;
    isms:forCapability isms:Cap_ISMS_01 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De entiteit heeft een geïntegreerd en proactief inzicht in de eigen organisatie en de context waarin zij haar processen en diensten heeft ingericht. De toepasbaarheid van wet- en regelgeving wordt continu geëvalueerd en verbeterd, met een focus op innovatie en aanpassing aan veranderende omstandigheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_ISMS_02
    rdf:type isms:ISMSCapability , owl:NamedIndividual ;
    rdfs:label "Leiderschap"@nl ,
               "Leadership"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_ISMS_02_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_02 — Niveau 1"@nl , "Cap_ISMS_02 — Level 1"@en ;
    isms:forCapability isms:Cap_ISMS_02 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Het bestuur toont geen leiderschap of betrokkenheid met betrekking tot het Informatiebeveiligingsbeleid. Er is geen formele toewijzing van eigenaarschap, rollen, verantwoordelijkheden of aansprakelijkheid op dit gebied."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_02_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_02 — Niveau 2"@nl , "Cap_ISMS_02 — Level 2"@en ;
    isms:forCapability isms:Cap_ISMS_02 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Het bestuur toont enige betrokkenheid bij het Informatiebeveiligingsbeleid, maar deze betrokkenheid is informeel en inconsistent. Eigenaarschap, rollen, verantwoordelijkheden en aansprakelijkheid zijn benoemd, maar worden niet systematisch toegepast of geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_02_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_02 — Niveau 3"@nl , "Cap_ISMS_02 — Level 3"@en ;
    isms:forCapability isms:Cap_ISMS_02 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Het bestuur toont formeel leiderschap en betrokkenheid bij het Informatiebeveiligingsbeleid. Eigenaarschap, rollen, verantwoordelijkheden en aansprakelijkheid zijn duidelijk toegewezen en worden consistent toegepast. Er is een formele intentieverklaring  die de doelen en uitgangspunten van informatiebeveiliging ondersteunt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_02_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_02 — Niveau 4"@nl , "Cap_ISMS_02 — Level 4"@en ;
    isms:forCapability isms:Cap_ISMS_02 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het bestuur toont actief leiderschap en betrokkenheid bij het Informatiebeveiligingsbeleid. Eigenaarschap, rollen, verantwoordelijkheden en aansprakelijkheid zijn ingebed in het juiste managementniveau en worden periodiek geëvalueerd. Er is een formele risicobereidheid vastgesteld voor informatierisico’s en de acceptatie van restrisico’s."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_02_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_02 — Niveau 5"@nl , "Cap_ISMS_02 — Level 5"@en ;
    isms:forCapability isms:Cap_ISMS_02 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het bestuur toont proactief leiderschap en betrokkenheid bij het Informatiebeveiligingsbeleid. Eigenaarschap, rollen, verantwoordelijkheden en aansprakelijkheid worden continu geëvalueerd en verbeterd. Er is een cultuur van continue verbetering, waarbij het bestuur actief betrokken is bij het beoordelen en aanpassen van de informatiebeveiligingsstrategie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_ISMS_03
    rdf:type isms:ISMSCapability , owl:NamedIndividual ;
    rdfs:label "Planning"@nl ,
               "Planning"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_ISMS_03_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_03 — Niveau 1"@nl , "Cap_ISMS_03 — Level 1"@en ;
    isms:forCapability isms:Cap_ISMS_03 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "De entiteit heeft geen algemeen informatiebeveiligingsplan. Er is geen vertaling van organisatiedoelen, risico's of compliance-eisen naar informatiebeveiliging. De IT-infrastructuur en veiligheidscultuur worden niet meegenomen in de planning."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_03_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_03 — Niveau 2"@nl , "Cap_ISMS_03 — Level 2"@en ;
    isms:forCapability isms:Cap_ISMS_03 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er is een informeel informatiebeveiligingsplan aanwezig. Organisatiedoelen, risico's en compliance-eisen worden op een ad-hoc basis vertaald naar het plan. De IT-infrastructuur en veiligheidscultuur worden beperkt meegenomen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_03_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_03 — Niveau 3"@nl , "Cap_ISMS_03 — Level 3"@en ;
    isms:forCapability isms:Cap_ISMS_03 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Het informatiebeveiligingsplan is formeel vastgesteld. Organisatiedoelen, risico's en compliance-eisen worden systematisch vertaald naar het plan. De IT-infrastructuur en veiligheidscultuur worden meegenomen in de planning."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_03_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_03 — Niveau 4"@nl , "Cap_ISMS_03 — Level 4"@en ;
    isms:forCapability isms:Cap_ISMS_03 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het informatiebeveiligingsplan is geïntegreerd in de bedrijfsvoering. Organisatiedoelen, risico's en compliance-eisen worden continu gemonitord en geëvalueerd. De IT-infrastructuur en veiligheidscultuur worden actief beheerd en geoptimaliseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_03_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_03 — Niveau 5"@nl , "Cap_ISMS_03 — Level 5"@en ;
    isms:forCapability isms:Cap_ISMS_03 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het informatiebeveiligingsplan is een dynamisch document dat continu wordt aangepast aan veranderende omstandigheden. Organisatiedoelen, risico's en compliance-eisen worden proactief geïdentificeerd en geïntegreerd. De IT-infrastructuur en veiligheidscultuur worden voortdurend verbeterd op basis van feedback en evaluaties."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_ISMS_04
    rdf:type isms:ISMSCapability , owl:NamedIndividual ;
    rdfs:label "Ondersteuning"@nl ,
               "Support"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_ISMS_04_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_04 — Niveau 1"@nl , "Cap_ISMS_04 — Level 1"@en ;
    isms:forCapability isms:Cap_ISMS_04 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "De entiteit heeft geen inzicht in de benodigde middelen voor informatiebeveiliging. Er is geen systematische aanpak voor het inrichten, implementeren, onderhouden of verbeteren van informatiebeveiliging."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_04_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_04 — Niveau 2"@nl , "Cap_ISMS_04 — Level 2"@en ;
    isms:forCapability isms:Cap_ISMS_04 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "De entiteit heeft een beperkt inzicht in de benodigde middelen voor informatiebeveiliging. Er worden incidentele maatregelen getroffen om informatiebeveiliging in te richten en te implementeren, maar er is geen structurele aanpak voor onderhoud en verbetering."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_04_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_04 — Niveau 3"@nl , "Cap_ISMS_04 — Level 3"@en ;
    isms:forCapability isms:Cap_ISMS_04 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit heeft vastgesteld welke middelen nodig zijn voor informatiebeveiliging en stelt deze beschikbaar. Er is een gestructureerde aanpak voor het inrichten, implementeren, onderhouden en verbeteren van informatiebeveiliging, met duidelijke processen en verantwoordelijkheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_04_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_04 — Niveau 4"@nl , "Cap_ISMS_04 — Level 4"@en ;
    isms:forCapability isms:Cap_ISMS_04 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "De entiteit heeft een geïntegreerde benadering voor informatiebeveiliging, waarbij middelen effectief worden ingezet en beheerd. Er is een systematische evaluatie van de effectiviteit van maatregelen, en verbeteringen worden doorgevoerd op basis van meetbare resultaten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_04_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_04 — Niveau 5"@nl , "Cap_ISMS_04 — Level 5"@en ;
    isms:forCapability isms:Cap_ISMS_04 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De entiteit heeft een cultuur van continue verbetering op het gebied van informatiebeveiliging. Middelen worden proactief aangepast en geoptimaliseerd op basis van evaluaties, feedback en veranderende omstandigheden, met als doel een hoog niveau van informatiebeveiliging te waarborgen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_ISMS_05
    rdf:type isms:ISMSCapability , owl:NamedIndividual ;
    rdfs:label "Beleid"@nl ,
               "Policy"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_ISMS_05_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_05 — Niveau 1"@nl , "Cap_ISMS_05 — Level 1"@en ;
    isms:forCapability isms:Cap_ISMS_05 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "De entiteit heeft geen vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Er is geen schriftelijke vastlegging van dit beleid, en het wordt niet aantoonbaar toegepast. Er is geen aansturing van personeel of andere werkzame personen met betrekking tot de naleving van dit beleid. Het beleid wordt niet periodiek geactualiseerd, geëvalueerd of goedgekeurd door het bestuur."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_05_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_05 — Niveau 2"@nl , "Cap_ISMS_05 — Level 2"@en ;
    isms:forCapability isms:Cap_ISMS_05 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "De entiteit heeft een informeel vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Dit beleid is gedeeltelijk schriftelijk vastgelegd en wordt op inconsistente wijze toegepast. Er is enige aansturing van personeel of andere werkzame personen met betrekking tot de naleving van dit beleid, maar dit gebeurt niet systematisch. Het beleid wordt niet periodiek geactualiseerd, geëvalueerd of goedgekeurd door het bestuur."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_05_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_05 — Niveau 3"@nl , "Cap_ISMS_05 — Level 3"@en ;
    isms:forCapability isms:Cap_ISMS_05 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Dit beleid is schriftelijk vastgelegd en wordt op gestructureerde en geformaliseerde wijze toegepast. Er is aantoonbare aansturing van personeel en andere werkzame personen met betrekking tot de naleving van dit beleid. Het beleid wordt periodiek geactualiseerd, geëvalueerd en goedgekeurd door het bestuur."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_05_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_05 — Niveau 4"@nl , "Cap_ISMS_05 — Level 4"@en ;
    isms:forCapability isms:Cap_ISMS_05 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Dit beleid is schriftelijk vastgelegd en wordt op gestructureerde en geformaliseerde wijze toegepast. Er is aantoonbare aansturing van personeel en andere werkzame personen met betrekking tot de naleving van dit beleid. Het beleid wordt periodiek geactualiseerd, geëvalueerd en goedgekeurd door het bestuur. De effectiviteit van het beleid wordt periodiek geëvalueerd en verbeterd op basis van meetbare resultaten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_05_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_05 — Niveau 5"@nl , "Cap_ISMS_05 — Level 5"@en ;
    isms:forCapability isms:Cap_ISMS_05 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Dit beleid is schriftelijk vastgelegd en wordt op gestructureerde en geformaliseerde wijze toegepast. Er is aantoonbare aansturing van personeel en andere werkzame personen met betrekking tot de naleving van dit beleid. Het beleid wordt periodiek geactualiseerd, geëvalueerd en goedgekeurd door het bestuur. De effectiviteit van het beleid wordt continu geëvalueerd en verbeterd op basis van meetbare resultaten en feedback."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_ISMS_06
    rdf:type isms:ISMSCapability , owl:NamedIndividual ;
    rdfs:label "Uitvoering"@nl ,
               "Operation"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_ISMS_06_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_06 — Niveau 1"@nl , "Cap_ISMS_06 — Level 1"@en ;
    isms:forCapability isms:Cap_ISMS_06 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "De entiteit heeft geen vastgesteld informatiebeveiligingsplan. Er is geen formele uitvoering of naleving van doelen en eisen met betrekking tot informatiebeveiliging. Er is geen aansturing of toezicht op de naleving van informatiebeveiligingsmaatregelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_06_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_06 — Niveau 2"@nl , "Cap_ISMS_06 — Level 2"@en ;
    isms:forCapability isms:Cap_ISMS_06 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "De entiteit heeft een informeel informatiebeveiligingsplan. Er worden enkele doelen en eisen uitgevoerd, maar deze zijn niet consistent of systematisch. Er is beperkte aansturing en toezicht op de naleving van informatiebeveiligingsmaatregelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_06_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_06 — Niveau 3"@nl , "Cap_ISMS_06 — Level 3"@en ;
    isms:forCapability isms:Cap_ISMS_06 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld informatiebeveiligingsplan. Doelen en eisen worden systematisch uitgevoerd en nageleefd. Er is duidelijke aansturing en toezicht op de naleving van informatiebeveiligingsmaatregelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_06_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_06 — Niveau 4"@nl , "Cap_ISMS_06 — Level 4"@en ;
    isms:forCapability isms:Cap_ISMS_06 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld informatiebeveiligingsplan. Doelen en eisen worden effectief uitgevoerd en nageleefd. Er is gestructureerde aansturing en toezicht op de naleving van informatiebeveiligingsmaatregelen. De effectiviteit van de uitvoering wordt periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_06_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_06 — Niveau 5"@nl , "Cap_ISMS_06 — Level 5"@en ;
    isms:forCapability isms:Cap_ISMS_06 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld informatiebeveiligingsplan. Doelen en eisen worden proactief uitgevoerd en nageleefd. Er is continue aansturing en toezicht op de naleving van informatiebeveiligingsmaatregelen. De effectiviteit van de uitvoering wordt continu geëvalueerd en verbeterd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_ISMS_07
    rdf:type isms:ISMSCapability , owl:NamedIndividual ;
    rdfs:label "Evaluaties en prestaties"@nl ,
               "Performance evaluation"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_ISMS_07_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_07 — Niveau 1"@nl , "Cap_ISMS_07 — Level 1"@en ;
    isms:forCapability isms:Cap_ISMS_07 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen formeel proces voor het periodiek evalueren van de doeltreffendheid van genomen maatregelen met betrekking tot het mitigeren van risico’s voor de beveiliging van netwerk- en informatiesystemen. Evaluaties worden niet systematisch uitgevoerd en zijn afhankelijk van incidenten of ad-hoc verzoeken."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_07_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_07 — Niveau 2"@nl , "Cap_ISMS_07 — Level 2"@en ;
    isms:forCapability isms:Cap_ISMS_07 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er zijn informele procedures voor het evalueren van de doeltreffendheid van maatregelen. Evaluaties worden uitgevoerd, maar zijn niet consistent of gedocumenteerd. Er is beperkte betrokkenheid van relevante stakeholders en de resultaten worden niet systematisch gebruikt om verbeteringen door te voeren."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_07_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_07 — Niveau 3"@nl , "Cap_ISMS_07 — Level 3"@en ;
    isms:forCapability isms:Cap_ISMS_07 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Het proces voor het periodiek evalueren van de doeltreffendheid van maatregelen is formeel gedefinieerd en gedocumenteerd. Evaluaties worden systematisch uitgevoerd met betrokkenheid van relevante stakeholders. De resultaten worden geanalyseerd en gebruikt om verbetermaatregelen te identificeren en door te voeren."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_07_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_07 — Niveau 4"@nl , "Cap_ISMS_07 — Level 4"@en ;
    isms:forCapability isms:Cap_ISMS_07 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het evaluatieproces is geïntegreerd in het bredere risicomanagement- en kwaliteitsmanagementsysteem. Evaluaties worden periodiek uitgevoerd volgens een vastgesteld schema en methodologie. De effectiviteit van genomen maatregelen wordt gemeten en gerapporteerd aan het management. Corrigerende en preventieve maatregelen worden geïdentificeerd en geïmplementeerd op basis van evaluatieresultaten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_07_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_07 — Niveau 5"@nl , "Cap_ISMS_07 — Level 5"@en ;
    isms:forCapability isms:Cap_ISMS_07 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het evaluatieproces is volledig geïntegreerd in de organisatiecultuur. Er wordt actief gezocht naar kansen voor verbetering, zowel reactief als proactief. Evaluaties worden continu uitgevoerd en leiden tot voortdurende optimalisatie van maatregelen. Innovaties en best practices worden geïdentificeerd en geïmplementeerd, en de effectiviteit van maatregelen wordt continu gemonitord en geoptimaliseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_ISMS_08
    rdf:type isms:ISMSCapability , owl:NamedIndividual ;
    rdfs:label "Verbetering"@nl ,
               "Improvement"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_ISMS_08_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_08 — Niveau 1"@nl , "Cap_ISMS_08 — Level 1"@en ;
    isms:forCapability isms:Cap_ISMS_08 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen formeel vastgelegde procedure voor het verbeteren van de geschiktheid, toereikendheid en doeltreffendheid van het managementsysteem voor informatiebeveiliging. Verbeteringen worden ad hoc uitgevoerd, afhankelijk van incidenten of individuele initiatieven."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_08_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_ISMS_08 — Niveau 2"@nl , "Cap_ISMS_08 — Level 2"@en ;
    isms:forCapability isms:Cap_ISMS_08 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Er zijn informele procedures en richtlijnen aanwezig voor het verbeteren van het managementsysteem. Verbeteringen worden op consistente wijze uitgevoerd, maar zijn niet formeel gedocumenteerd of geïntegreerd in het bredere managementsysteem."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_ISMS_08_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
