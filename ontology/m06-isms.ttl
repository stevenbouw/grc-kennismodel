# =============================================================================
# v4.6.0 Fase 4 — Stap 2: Volwassenheidsmodel TBox-uitbreidingen
# Datum: 2026-05-21
# Architectuur-keuzes masterchat:
#   - V1-keuze: nieuwe isms-cluster naast biz (biz blijft ongewijzigd voor GRCDomain-dashboard)
#   - Subklassen-onderscheid: isms:CbwCapability (23) + isms:ISMSCapability (9)
#   - Qualified-relation: 5 Levels (globaal) + 160 LevelDescriptions (item-specifiek)
# =============================================================================

# --- 5 nieuwe klassen ---

isms:MaturityCapability
    rdf:type owl:Class ;
    rdfs:label  "Volwassenheidscapability"@nl ,
                "Maturity Capability"@en ;
    rdfs:comment "Abstract parent voor evaluatiebare control-capabilities met niveau-progressie. Basis voor zowel Cbw-zorgplicht-thema's als ISMS-clausules."@nl ,
                 "Abstract parent for assessable control capabilities with level progression. Basis for both Cbw duty-of-care topics and ISMS clauses."@en .

isms:CbwCapability
    rdf:type owl:Class ;
    rdfs:subClassOf isms:MaturityCapability ;
    rdfs:label "Cbw-zorgplicht-capability"@nl , "Cbw Duty-of-Care Capability"@en ;
    rdfs:comment "Een evaluatiebare capability voor één van de 23 zorgplicht-thema's uit het Cbw-volwassenheidsmodel."@nl ,
                 "An assessable capability for one of the 23 duty-of-care topics in the Cbw maturity model."@en .

isms:ISMSCapability
    rdf:type owl:Class ;
    rdfs:subClassOf isms:MaturityCapability ;
    rdfs:label "ISMS-clausule-capability"@nl , "ISMS Clause Capability"@en ;
    rdfs:comment "Een evaluatiebare capability voor één van de 9 ISMS-clausules (ISO 27001 hoofdstuk 4-10)."@nl ,
                 "An assessable capability for one of the 9 ISMS clauses (ISO 27001 chapters 4-10)."@en .

isms:MaturityCapabilityLevel
    rdf:type owl:Class ;
    rdfs:label "Volwassenheidsniveau"@nl , "Maturity Capability Level"@en ;
    rdfs:comment "Niveau (1-5) in de NBA-LIO/NOREA volwassenheidsschaal: ad-hoc → informeel → vastgesteld → geëvalueerd → geïntegreerd."@nl ,
                 "Level (1-5) on the NBA-LIO/NOREA maturity scale: ad-hoc → informal → established → evaluated → integrated."@en .

isms:CapabilityLevelDescription
    rdf:type owl:Class ;
    rdfs:label "Beschrijving capability-niveau"@nl , "Capability Level Description"@en ;
    rdfs:comment "Item-specifieke beschrijving van wat een specifiek niveau betekent voor een specifieke MaturityCapability. Qualified-relation tussen capability en niveau."@nl ,
                 "Item-specific description of what a specific level means for a specific MaturityCapability. Qualified relation between capability and level."@en .

# --- 3 nieuwe ObjectProperties ---

isms:hasLevelDescription
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:MaturityCapability ;
    rdfs:range isms:CapabilityLevelDescription ;
    owl:inverseOf isms:forCapability ;
    rdfs:label "heeft niveau-beschrijving"@nl , "has level description"@en ;
    rdfs:comment "Koppelt een MaturityCapability aan zijn item-specifieke niveau-beschrijvingen (typisch 5)."@nl ,
                 "Links a MaturityCapability to its item-specific level descriptions (typically 5)."@en .

isms:forCapability
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:CapabilityLevelDescription ;
    rdfs:range isms:MaturityCapability ;
    owl:inverseOf isms:hasLevelDescription ;
    rdfs:label "voor capability"@nl , "for capability"@en ;
    rdfs:comment "Inverse van isms:hasLevelDescription. Wijst van een LevelDescription terug naar de Capability."@nl ,
                 "Inverse of isms:hasLevelDescription. Points from a LevelDescription back to the Capability."@en .

isms:atMaturityLevel
    rdf:type owl:ObjectProperty ;
    rdfs:domain isms:CapabilityLevelDescription ;
    rdfs:range isms:MaturityCapabilityLevel ;
    rdfs:label "op niveau"@nl , "at level"@en ;
    rdfs:comment "Geeft aan op welk van de 5 globale MaturityCapabilityLevels een LevelDescription betrekking heeft."@nl ,
                 "Indicates which of the 5 global MaturityCapabilityLevels a LevelDescription pertains to."@en .

# --- SourceAttribution voor volwassenheidsmodel-content ---

ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026
    rdf:type ext:SourceAttribution , owl:NamedIndividual ;
    rdfs:label "NBA-LIO/NOREA Volwassenheidsmodel (via CBW-Excel)"@nl ,
               "NBA-LIO/NOREA Maturity Model (via CBW-Excel)"@en ;
    ext:hasLicense "CC-BY 4.0 (CBW-Excel)" ;
    ext:hasLicenseURL "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
    ext:hasAttributionText "Volwassenheidsmodel-niveaubeschrijvingen afkomstig van NBA-LIO/NOREA, toegeleverd via CBW-Excel sheet 'Volwassenheid beheersmaatregel' (ADR/NOREA, versie 1.0 van 30 september 2025, CC-BY 4.0). Originele methodologie: NBA-LIO/NOREA Volwassenheidsmodel. SHA256 CBW-Excel: 52472ddb28eb0ddc81b06ded72d071bbe42f644b0ab3b6d93338315fce03d23b"@nl ,
                            "Maturity model level descriptions from NBA-LIO/NOREA, delivered via CBW-Excel sheet 'Volwassenheid beheersmaatregel' (ADR/NOREA, version 1.0 dated 30 September 2025, CC-BY 4.0). Original methodology: NBA-LIO/NOREA Maturity Model. SHA256 CBW-Excel: 52472ddb28eb0ddc81b06ded72d071bbe42f644b0ab3b6d93338315fce03d23b"@en ;
    ext:hasSourcePublicationDate "2025-09-30"^^xsd:date ;
