    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Incidenten worden geregistreerd of gemeld, maar zonder formele procedures voor opvolging of evaluatie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_03_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_03 — Niveau 3"@nl , "Cap_Cbw_03 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_03 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is een formeel aantoonbaar incident managementproces waarin het melden, registreren, opvolgen en evalueren van ICT-incidenten is beschreven."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_03_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_03 — Niveau 4"@nl , "Cap_Cbw_03 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_03 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het incidentproces is in werking, incidentgegevens worden geanalyseerd en lessen worden gedocumenteerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_03_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_03 — Niveau 5"@nl , "Cap_Cbw_03 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_03 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het incidentproces wordt continu verbeterd op basis van trendanalyse, periodieke oefeningen en integratie met bredere risicobeheersing."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


