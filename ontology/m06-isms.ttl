# =============================================================================
# v4.6.0 Fase 4 — Stap 3: 5 MaturityCapabilityLevel-individuals
# Bron: NBA-LIO/NOREA Volwassenheidsmodel (via CBW-Excel sheet 'Volwassenheid beheersmaatregel')
# Niveau-progressie: ad-hoc → informeel → vastgesteld → geëvalueerd → geïntegreerd
# =============================================================================

isms:Level_1
    rdf:type isms:MaturityCapabilityLevel , owl:NamedIndividual ;
    rdfs:label "Niveau 1 — Ad-hoc"@nl , "Level 1 — Ad-hoc"@en ;
    rdfs:comment "Beleid of activiteit is niet vastgelegd; verantwoordelijkheden zijn niet formeel belegd."@nl ,
                 "Policy or activity is not documented; responsibilities are not formally assigned."@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:Level_2
    rdf:type isms:MaturityCapabilityLevel , owl:NamedIndividual ;
    rdfs:label "Niveau 2 — Informeel"@nl , "Level 2 — Informal"@en ;
    rdfs:comment "Beleid is deels aanwezig maar niet schriftelijk vastgelegd; verantwoordelijkheden informeel belegd."@nl ,
                 "Policy is partially present but not formally documented; responsibilities are informally assigned."@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:Level_3
    rdf:type isms:MaturityCapabilityLevel , owl:NamedIndividual ;
    rdfs:label "Niveau 3 — Vastgesteld"@nl , "Level 3 — Established"@en ;
    rdfs:comment "Beleid of activiteit is aantoonbaar schriftelijk vastgesteld met expliciet benoemde verantwoordelijkheden, rollen en bevoegdheden."@nl ,
                 "Policy or activity is demonstrably documented with explicitly assigned responsibilities, roles, and authorities."@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:Level_4
    rdf:type isms:MaturityCapabilityLevel , owl:NamedIndividual ;
    rdfs:label "Niveau 4 — Geëvalueerd"@nl , "Level 4 — Evaluated"@en ;
    rdfs:comment "Beleid is formeel goedgekeurd, gedeeld met stakeholders en wordt periodiek beoordeeld op actualiteit en volledigheid."@nl ,
                 "Policy is formally approved, shared with stakeholders, and periodically reviewed for currency and completeness."@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:Level_5
    rdf:type isms:MaturityCapabilityLevel , owl:NamedIndividual ;
    rdfs:label "Niveau 5 — Geïntegreerd"@nl , "Level 5 — Integrated"@en ;
    rdfs:comment "Beleid is volledig geïntegreerd in governance-processen; rollen en bevoegdheden worden structureel geëvalueerd en geoptimaliseerd."@nl ,
                 "Policy is fully integrated into governance processes; roles and authorities are structurally evaluated and optimised."@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

# =============================================================================
# v4.6.0 Fase 4 — Stap 4: 32 Capabilities + 160 LevelDescriptions
# Datum: 2026-05-21
# Bron: NBA-LIO/NOREA Volwassenheidsmodel (via CBW-Excel sheet 'Volwassenheid beheersmaatregel')
# Bron-attribuering: ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 (CC-BY 4.0)
# 
# Typo-correcties masterchat-GO op 4 NL-item-labels (alleen rdfs:label, niet comment):
#   Cbw_05: 'Bedrijfscontinuiteit' → 'Bedrijfscontinuïteit'
#   Cbw_11: 'Cyberhygiene...' → 'Cyberhygiëne...'
#   Cbw_12: 'Cyberhygiene + specieke' → 'Cyberhygiëne + specifieke'
#   Cbw_14: 'tav' → 't.a.v.'
# Niveau-beschrijvingen (160 × rdfs:comment) blijven bron-getrouw uit CBW-Excel.
# =============================================================================

# --- Blok 1: 23 Cbw-zorgplicht-capabilities (Cbw_01..23) ---

isms:Cap_Cbw_01
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Vastgesteld beleid over netwerk en informatiesystemen"@nl ,
               "Established policy on network and information systems"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_01_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_01 — Niveau 1"@nl , "Cap_Cbw_01 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_01 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen schriftelijk beleid beschikbaar voor netwerk- en informatiesystemen; verantwoordelijkheden, rollen en bevoegdheden zijn niet formeel vastgelegd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_01_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_01 — Niveau 2"@nl , "Cap_Cbw_01 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_01 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Beleid is deels aanwezig, maar niet schriftelijk vastgelegd of organisatiebreed gecommuniceerd; verantwoordelijkheden zijn informeel belegd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_01_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_01 — Niveau 3"@nl , "Cap_Cbw_01 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_01 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is een aantoonbaar schriftelijk vastgesteld beleid waarin verantwoordelijkheden, rollen en bevoegdheden expliciet zijn benoemd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_01_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_01 — Niveau 4"@nl , "Cap_Cbw_01 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_01 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het beleid is formeel goedgekeurd, gedeeld met relevante stakeholders, en wordt periodiek beoordeeld op actualiteit en volledigheid van verantwoordelijkheden en bevoegdheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_01_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_01 — Niveau 5"@nl , "Cap_Cbw_01 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_01 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het beleid is volledig geïntegreerd in governanceprocessen; rollen, verantwoordelijkheden en bevoegdheden worden structureel geëvalueerd en geoptimaliseerd op basis van organisatorische en technologische ontwikkelingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_02
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Beleid over risicomanagement"@nl ,
               "Risk management policy"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_02_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_02 — Niveau 1"@nl , "Cap_Cbw_02 — Level 1"@en ;
    isms:forCapability isms:Cap_Cbw_02 ;
    isms:atMaturityLevel isms:Level_1 ;
    rdfs:comment "Er is geen formeel risicobeheerproces; risico’s worden niet systematisch vastgesteld, beoordeeld of gemitigeerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_02_Level_2
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_02 — Niveau 2"@nl , "Cap_Cbw_02 — Level 2"@en ;
    isms:forCapability isms:Cap_Cbw_02 ;
    isms:atMaturityLevel isms:Level_2 ;
    rdfs:comment "Risico’s worden incidenteel vastgesteld of gemitigeerd, maar zonder vastgelegde structuur of systematiek."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_02_Level_3
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_02 — Niveau 3"@nl , "Cap_Cbw_02 — Level 3"@en ;
    isms:forCapability isms:Cap_Cbw_02 ;
    isms:atMaturityLevel isms:Level_3 ;
    rdfs:comment "Er is een schriftelijk vastgesteld proces waarin aantoonbaar wordt beschreven hoe risico’s op netwerk- en informatiesystemen worden vastgesteld, beoordeeld en gemitigeerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_02_Level_4
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_02 — Niveau 4"@nl , "Cap_Cbw_02 — Level 4"@en ;
    isms:forCapability isms:Cap_Cbw_02 ;
    isms:atMaturityLevel isms:Level_4 ;
    rdfs:comment "Het proces is operationeel, de resultaten worden gedocumenteerd, en risicobeoordelingen worden periodiek uitgevoerd en geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:CapLevel_Cbw_02_Level_5
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
    rdfs:label "Cap_Cbw_02 — Niveau 5"@nl , "Cap_Cbw_02 — Level 5"@en ;
    isms:forCapability isms:Cap_Cbw_02 ;
    isms:atMaturityLevel isms:Level_5 ;
    rdfs:comment "Het proces is volledig geïntegreerd in de strategische besluitvorming en wordt continu verbeterd op basis van incidenten, audits en dreigingsanalyses."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:Cap_Cbw_03
    rdf:type isms:CbwCapability , owl:NamedIndividual ;
    rdfs:label "Incidentenbehandeling"@nl ,
               "Incident handling"@en ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .


isms:CapLevel_Cbw_03_Level_1
    rdf:type isms:CapabilityLevelDescription , owl:NamedIndividual ;
