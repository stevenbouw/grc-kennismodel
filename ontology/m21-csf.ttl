    csf:exemplifies csf:ID_IM_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_02_Ex5
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-02.Ex5"@nl , "ID.IM-02.Ex5"@en ;
    rdfs:comment "Exercise contingency plans for responding to and recovering from the discovery that products or services did not originate with the contracted supplier or partner or were altered before receipt"@en ;
    csf:csfIdentifier "ID.IM-02.Ex5" ;
    csf:exemplifies csf:ID_IM_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_02_Ex6
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-02.Ex6"@nl , "ID.IM-02.Ex6"@en ;
    rdfs:comment "Collect and analyze performance metrics using security tools and services to inform improvements to the cybersecurity program"@en ;
    csf:csfIdentifier "ID.IM-02.Ex6" ;
    csf:exemplifies csf:ID_IM_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_03_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-03.Ex1"@nl , "ID.IM-03.Ex1"@en ;
    rdfs:comment "Conduct collaborative lessons learned sessions with suppliers"@en ;
    csf:csfIdentifier "ID.IM-03.Ex1" ;
    csf:exemplifies csf:ID_IM_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_03_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-03.Ex2"@nl , "ID.IM-03.Ex2"@en ;
    rdfs:comment "Annually review cybersecurity policies, processes, and procedures to take lessons learned into account"@en ;
    csf:csfIdentifier "ID.IM-03.Ex2" ;
    csf:exemplifies csf:ID_IM_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_03_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-03.Ex3"@nl , "ID.IM-03.Ex3"@en ;
    rdfs:comment "Use metrics to assess operational cybersecurity performance over time"@en ;
    csf:csfIdentifier "ID.IM-03.Ex3" ;
    csf:exemplifies csf:ID_IM_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_04_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-04.Ex1"@nl , "ID.IM-04.Ex1"@en ;
    rdfs:comment "Establish contingency plans (e.g., incident response, business continuity, disaster recovery) for responding to and recovering from adverse events that can interfere with operations, expose confidential information, or otherwise endanger the organization’s mission and viability"@en ;
    csf:csfIdentifier "ID.IM-04.Ex1" ;
    csf:exemplifies csf:ID_IM_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_04_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-04.Ex2"@nl , "ID.IM-04.Ex2"@en ;
    rdfs:comment "Include contact and communication information, processes for handling common scenarios, and criteria for prioritization, escalation, and elevation in all contingency plans"@en ;
    csf:csfIdentifier "ID.IM-04.Ex2" ;
    csf:exemplifies csf:ID_IM_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_04_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-04.Ex3"@nl , "ID.IM-04.Ex3"@en ;
    rdfs:comment "Create a vulnerability management plan to identify and assess all types of vulnerabilities and to prioritize, test, and implement risk responses"@en ;
    csf:csfIdentifier "ID.IM-04.Ex3" ;
    csf:exemplifies csf:ID_IM_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_04_Ex4
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-04.Ex4"@nl , "ID.IM-04.Ex4"@en ;
    rdfs:comment "Communicate cybersecurity plans (including updates) to those responsible for carrying them out and to affected parties"@en ;
    csf:csfIdentifier "ID.IM-04.Ex4" ;
    csf:exemplifies csf:ID_IM_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_IM_04_Ex5
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "ID.IM-04.Ex5"@nl , "ID.IM-04.Ex5"@en ;
    rdfs:comment "Review and update all cybersecurity plans annually or when a need for significant improvements is identified"@en ;
    csf:csfIdentifier "ID.IM-04.Ex5" ;
    csf:exemplifies csf:ID_IM_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_01_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-01.Ex1"@nl , "PR.AA-01.Ex1"@en ;
    rdfs:comment "Initiate requests for new access or additional access for employees, contractors, and others, and track, review, and fulfill the requests, with permission from system or data owners when needed"@en ;
    csf:csfIdentifier "PR.AA-01.Ex1" ;
    csf:exemplifies csf:PR_AA_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_01_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-01.Ex2"@nl , "PR.AA-01.Ex2"@en ;
    rdfs:comment "Issue, manage, and revoke cryptographic certificates and identity tokens, cryptographic keys (i.e., key management), and other credentials"@en ;
    csf:csfIdentifier "PR.AA-01.Ex2" ;
    csf:exemplifies csf:PR_AA_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_01_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-01.Ex3"@nl , "PR.AA-01.Ex3"@en ;
    rdfs:comment "Select a unique identifier for each device from immutable hardware characteristics or an identifier securely provisioned to the device"@en ;
    csf:csfIdentifier "PR.AA-01.Ex3" ;
    csf:exemplifies csf:PR_AA_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_01_Ex4
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-01.Ex4"@nl , "PR.AA-01.Ex4"@en ;
    rdfs:comment "Physically label authorized hardware with an identifier for inventory and servicing purposes"@en ;
    csf:csfIdentifier "PR.AA-01.Ex4" ;
    csf:exemplifies csf:PR_AA_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_02_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-02.Ex1"@nl , "PR.AA-02.Ex1"@en ;
    rdfs:comment "Verify a person’s claimed identity at enrollment time using government-issued identity credentials (e.g., passport, visa, driver’s license)"@en ;
    csf:csfIdentifier "PR.AA-02.Ex1" ;
    csf:exemplifies csf:PR_AA_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_02_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-02.Ex2"@nl , "PR.AA-02.Ex2"@en ;
    rdfs:comment "Issue a different credential for each person (i.e., no credential sharing)"@en ;
    csf:csfIdentifier "PR.AA-02.Ex2" ;
    csf:exemplifies csf:PR_AA_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_03_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-03.Ex1"@nl , "PR.AA-03.Ex1"@en ;
    rdfs:comment "Require multifactor authentication"@en ;
    csf:csfIdentifier "PR.AA-03.Ex1" ;
    csf:exemplifies csf:PR_AA_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_03_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-03.Ex2"@nl , "PR.AA-03.Ex2"@en ;
    rdfs:comment "Enforce policies for the minimum strength of passwords, PINs, and similar authenticators"@en ;
    csf:csfIdentifier "PR.AA-03.Ex2" ;
    csf:exemplifies csf:PR_AA_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_03_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-03.Ex3"@nl , "PR.AA-03.Ex3"@en ;
    rdfs:comment "Periodically reauthenticate users, services, and hardware based on risk (e.g., in zero trust architectures)"@en ;
    csf:csfIdentifier "PR.AA-03.Ex3" ;
    csf:exemplifies csf:PR_AA_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_03_Ex4
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-03.Ex4"@nl , "PR.AA-03.Ex4"@en ;
    rdfs:comment "Ensure that authorized personnel can access accounts essential for protecting safety under emergency conditions"@en ;
    csf:csfIdentifier "PR.AA-03.Ex4" ;
    csf:exemplifies csf:PR_AA_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_04_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-04.Ex1"@nl , "PR.AA-04.Ex1"@en ;
    rdfs:comment "Protect identity assertions that are used to convey authentication and user information through single sign-on systems"@en ;
    csf:csfIdentifier "PR.AA-04.Ex1" ;
    csf:exemplifies csf:PR_AA_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_04_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-04.Ex2"@nl , "PR.AA-04.Ex2"@en ;
    rdfs:comment "Protect identity assertions that are used to convey authentication and user information between federated systems"@en ;
    csf:csfIdentifier "PR.AA-04.Ex2" ;
    csf:exemplifies csf:PR_AA_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_04_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-04.Ex3"@nl , "PR.AA-04.Ex3"@en ;
    rdfs:comment "Implement standards-based approaches for identity assertions in all contexts, and follow all guidance for the generation (e.g., data models, metadata), protection (e.g., digital signing, encryption), and verification (e.g., signature validation) of identity assertions"@en ;
    csf:csfIdentifier "PR.AA-04.Ex3" ;
    csf:exemplifies csf:PR_AA_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_05_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-05.Ex1"@nl , "PR.AA-05.Ex1"@en ;
    rdfs:comment "Review logical and physical access privileges periodically and whenever someone changes roles or leaves the organization, and promptly rescind privileges that are no longer needed"@en ;
    csf:csfIdentifier "PR.AA-05.Ex1" ;
    csf:exemplifies csf:PR_AA_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_05_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-05.Ex2"@nl , "PR.AA-05.Ex2"@en ;
    rdfs:comment "Take attributes of the requester and the requested resource into account for authorization decisions (e.g., geolocation, day/time, requester endpoint’s cyber health)"@en ;
    csf:csfIdentifier "PR.AA-05.Ex2" ;
    csf:exemplifies csf:PR_AA_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_05_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-05.Ex3"@nl , "PR.AA-05.Ex3"@en ;
    rdfs:comment "Restrict access and privileges to the minimum necessary (e.g., zero trust architecture)"@en ;
    csf:csfIdentifier "PR.AA-05.Ex3" ;
    csf:exemplifies csf:PR_AA_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_05_Ex4
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-05.Ex4"@nl , "PR.AA-05.Ex4"@en ;
    rdfs:comment "Periodically review the privileges associated with critical business functions to confirm proper separation of duties"@en ;
    csf:csfIdentifier "PR.AA-05.Ex4" ;
    csf:exemplifies csf:PR_AA_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_06_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-06.Ex1"@nl , "PR.AA-06.Ex1"@en ;
    rdfs:comment "Use security guards, security cameras, locked entrances, alarm systems, and other physical controls to monitor facilities and restrict access"@en ;
    csf:csfIdentifier "PR.AA-06.Ex1" ;
    csf:exemplifies csf:PR_AA_06 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_06_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-06.Ex2"@nl , "PR.AA-06.Ex2"@en ;
    rdfs:comment "Employ additional physical security controls for areas that contain high-risk assets"@en ;
    csf:csfIdentifier "PR.AA-06.Ex2" ;
    csf:exemplifies csf:PR_AA_06 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AA_06_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AA-06.Ex3"@nl , "PR.AA-06.Ex3"@en ;
    rdfs:comment "Escort guests, vendors, and other third parties within areas that contain business-critical assets"@en ;
    csf:csfIdentifier "PR.AA-06.Ex3" ;
    csf:exemplifies csf:PR_AA_06 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_01_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-01.Ex1"@nl , "PR.AT-01.Ex1"@en ;
    rdfs:comment "Provide basic cybersecurity awareness and training to employees, contractors, partners, suppliers, and all other users of the organization’s non-public resources"@en ;
    csf:csfIdentifier "PR.AT-01.Ex1" ;
    csf:exemplifies csf:PR_AT_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_01_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-01.Ex2"@nl , "PR.AT-01.Ex2"@en ;
    rdfs:comment "Train personnel to recognize social engineering attempts and other common attacks, report attacks and suspicious activity, comply with acceptable use policies, and perform basic cyber hygiene tasks (e.g., patching software, choosing passwords, protecting credentials)"@en ;
    csf:csfIdentifier "PR.AT-01.Ex2" ;
    csf:exemplifies csf:PR_AT_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_01_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-01.Ex3"@nl , "PR.AT-01.Ex3"@en ;
    rdfs:comment "Explain the consequences of cybersecurity policy violations, both to individual users and the organization as a whole"@en ;
    csf:csfIdentifier "PR.AT-01.Ex3" ;
    csf:exemplifies csf:PR_AT_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_01_Ex4
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-01.Ex4"@nl , "PR.AT-01.Ex4"@en ;
    rdfs:comment "Periodically assess or test users on their understanding of basic cybersecurity practices"@en ;
    csf:csfIdentifier "PR.AT-01.Ex4" ;
    csf:exemplifies csf:PR_AT_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_01_Ex5
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-01.Ex5"@nl , "PR.AT-01.Ex5"@en ;
    rdfs:comment "Require annual refreshers to reinforce existing practices and introduce new practices"@en ;
    csf:csfIdentifier "PR.AT-01.Ex5" ;
    csf:exemplifies csf:PR_AT_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_02_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-02.Ex1"@nl , "PR.AT-02.Ex1"@en ;
    rdfs:comment "Identify the specialized roles within the organization that require additional cybersecurity training, such as physical and cybersecurity personnel, finance personnel, senior leadership, and anyone with access to business-critical data"@en ;
    csf:csfIdentifier "PR.AT-02.Ex1" ;
    csf:exemplifies csf:PR_AT_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_02_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-02.Ex2"@nl , "PR.AT-02.Ex2"@en ;
    rdfs:comment "Provide role-based cybersecurity awareness and training to all those in specialized roles, including contractors, partners, suppliers, and other third parties"@en ;
    csf:csfIdentifier "PR.AT-02.Ex2" ;
    csf:exemplifies csf:PR_AT_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_02_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-02.Ex3"@nl , "PR.AT-02.Ex3"@en ;
    rdfs:comment "Periodically assess or test users on their understanding of cybersecurity practices for their specialized roles"@en ;
    csf:csfIdentifier "PR.AT-02.Ex3" ;
    csf:exemplifies csf:PR_AT_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AT_02_Ex4
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.AT-02.Ex4"@nl , "PR.AT-02.Ex4"@en ;
    rdfs:comment "Require annual refreshers to reinforce existing practices and introduce new practices"@en ;
    csf:csfIdentifier "PR.AT-02.Ex4" ;
    csf:exemplifies csf:PR_AT_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_DS_01_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-01.Ex1"@nl , "PR.DS-01.Ex1"@en ;
    rdfs:comment "Use encryption, digital signatures, and cryptographic hashes to protect the confidentiality and integrity of stored data in files, databases, virtual machine disk images, container images, and other resources"@en ;
    csf:csfIdentifier "PR.DS-01.Ex1" ;
    csf:exemplifies csf:PR_DS_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_DS_01_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-01.Ex2"@nl , "PR.DS-01.Ex2"@en ;
    rdfs:comment "Use full disk encryption to protect data stored on user endpoints"@en ;
    csf:csfIdentifier "PR.DS-01.Ex2" ;
    csf:exemplifies csf:PR_DS_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_DS_01_Ex3
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-01.Ex3"@nl , "PR.DS-01.Ex3"@en ;
    rdfs:comment "Confirm the integrity of software by validating signatures"@en ;
    csf:csfIdentifier "PR.DS-01.Ex3" ;
    csf:exemplifies csf:PR_DS_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_DS_01_Ex4
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-01.Ex4"@nl , "PR.DS-01.Ex4"@en ;
    rdfs:comment "Restrict the use of removable media to prevent data exfiltration"@en ;
    csf:csfIdentifier "PR.DS-01.Ex4" ;
    csf:exemplifies csf:PR_DS_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_DS_01_Ex5
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-01.Ex5"@nl , "PR.DS-01.Ex5"@en ;
    rdfs:comment "Physically secure removable media containing unencrypted sensitive information, such as within locked offices or file cabinets"@en ;
    csf:csfIdentifier "PR.DS-01.Ex5" ;
    csf:exemplifies csf:PR_DS_01 ;
