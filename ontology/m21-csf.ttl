    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-10.Ex1"@nl , "PR.DS-10.Ex1"@en ;
    rdfs:comment "Remove data that must remain confidential (e.g., from processors and memory) as soon as it is no longer needed"@en ;
