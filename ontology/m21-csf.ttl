    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-02.Ex3"@nl , "PR.DS-02.Ex3"@en ;
    rdfs:comment "Block access to personal email, file sharing, file storage services, and other personal communications applications and services from organizational systems and networks"@en ;
    csf:csfIdentifier "PR.DS-02.Ex3" ;
    csf:exemplifies csf:PR_DS_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_DS_02_Ex4
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-02.Ex4"@nl , "PR.DS-02.Ex4"@en ;
    rdfs:comment "Prevent reuse of sensitive data from production environments (e.g., customer records) in development, testing, and other non-production environments"@en ;
    csf:csfIdentifier "PR.DS-02.Ex4" ;
    csf:exemplifies csf:PR_DS_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

