# =============================================================================
# v4.6.0 Fase 4 — Stap 2: CSF Tier-klasse + properties
# Datum: 2026-05-21
# Naamkeuze: 'CSFTier' expliciet i.v.m. naamcollision met risk:RiskManagementTier
# (m03 NIST SP 800-39 organisational tiers, 3 levels — semantisch ander concept)
# =============================================================================

csf:CSFTier
    rdf:type owl:Class ;
    rdfs:subClassOf ext:FrameworkComponent ;
    rdfs:label "CSF Tier"@nl , "CSF Tier"@en ;
    rdfs:comment "NIST Cybersecurity Framework 2.0 Tier (4 levels: Partial, Risk Informed, Repeatable, Adaptive). Karakteriseert organizational profile. Naam expliciet 'CSFTier' om naamcollision met risk:RiskManagementTier (NIST SP 800-39 organisational tiers, 3 levels) te voorkomen."@nl ,
                 "NIST Cybersecurity Framework 2.0 Tier (4 levels: Partial, Risk Informed, Repeatable, Adaptive). Characterizes organizational profile. Name explicit 'CSFTier' to prevent naming collision with risk:RiskManagementTier (NIST SP 800-39 organisational tiers, 3 levels)."@en .

csf:riskGovernanceDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:domain csf:CSFTier ;
    rdfs:range xsd:string ;
    rdfs:label "beschrijving risk governance-dimensie"@nl , "risk governance dimension description"@en ;
    rdfs:comment "Tekst-beschrijving van de Cybersecurity Risk Governance-dimensie voor een specifieke Tier (uit CSWP 29 Appendix B Table 2)."@nl ,
                 "Text description of the Cybersecurity Risk Governance dimension for a specific Tier (from CSWP 29 Appendix B Table 2)."@en .

csf:riskManagementDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:domain csf:CSFTier ;
    rdfs:range xsd:string ;
    rdfs:label "beschrijving risk management-dimensie"@nl , "risk management dimension description"@en ;
    rdfs:comment "Tekst-beschrijving van de Cybersecurity Risk Management-dimensie voor een specifieke Tier (uit CSWP 29 Appendix B Table 2)."@nl ,
                 "Text description of the Cybersecurity Risk Management dimension for a specific Tier (from CSWP 29 Appendix B Table 2)."@en .

# =============================================================================
# v4.6.0 Fase 4 — Stap 3.4.2: 4 CSF Tier-individuals (Optie C masterchat-GO)
# Datum: 2026-05-21
# Bron-tekst: NIST CSWP 29 Appendix B Table 2 (pages 29-30), letterlijk overgenomen
# Optie C: rdfs:label bilinguaal; csf:csfIdentifier zonder language-tag;
#          csf:riskGovernanceDescription + csf:riskManagementDescription @en-only
#          (lange normatieve tekst zonder gezaghebbende NL-bron; D6-symmetrische toepassing).
# =============================================================================

csf:Tier_1_Partial
    rdf:type csf:CSFTier , owl:NamedIndividual ;
    rdfs:label "Tier 1 — Gedeeltelijk"@nl , "Tier 1 — Partial"@en ;
    csf:csfIdentifier "Tier 1: Partial" ;
    csf:riskGovernanceDescription "Application of the organizational cybersecurity risk strategy is managed in an ad hoc manner. Prioritization is ad hoc and not formally based on objectives or threat environment."@en ;
    csf:riskManagementDescription "There is limited awareness of cybersecurity risks at the organizational level. The organization implements cybersecurity risk management on an irregular, case-by-case basis. The organization may not have processes that enable cybersecurity information to be shared within the organization. The organization is generally unaware of the cybersecurity risks associated with its suppliers and the products and services it acquires and uses."@en ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:Tier_2_RiskInformed
    rdf:type csf:CSFTier , owl:NamedIndividual ;
    rdfs:label "Tier 2 — Risico-geïnformeerd"@nl , "Tier 2 — Risk Informed"@en ;
    csf:csfIdentifier "Tier 2: Risk Informed" ;
    csf:riskGovernanceDescription "Risk management practices are approved by management but may not be established as organization-wide policy. The prioritization of cybersecurity activities and protection needs is directly informed by organizational risk objectives, the threat environment, or business/mission requirements."@en ;
    csf:riskManagementDescription "There is an awareness of cybersecurity risks at the organizational level, but an organization-wide approach to managing cybersecurity risks has not been established. Consideration of cybersecurity in organizational objectives and programs may occur at some but not all levels of the organization. Cyber risk assessment of organizational and external assets occurs but is not typically repeatable or reoccurring. Cybersecurity information is shared within the organization on an informal basis. The organization is aware of the cybersecurity risks associated with its suppliers and the products and services it acquires and uses, but it does not act consistently or formally in response to those risks."@en ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:Tier_3_Repeatable
    rdf:type csf:CSFTier , owl:NamedIndividual ;
    rdfs:label "Tier 3 — Herhaalbaar"@nl , "Tier 3 — Repeatable"@en ;
    csf:csfIdentifier "Tier 3: Repeatable" ;
    csf:riskGovernanceDescription "The organization's risk management practices are formally approved and expressed as policy. Risk-informed policies, processes, and procedures are defined, implemented as intended, and reviewed. Organizational cybersecurity practices are regularly updated based on the application of risk management processes to changes in business/mission requirements, threats, and technological landscape."@en ;
    csf:riskManagementDescription "There is an organization-wide approach to managing cybersecurity risks. Cybersecurity information is routinely shared throughout the organization. Consistent methods are in place to respond effectively to changes in risk. Personnel possess the knowledge and skills to perform their appointed roles and responsibilities. The organization consistently and accurately monitors the cybersecurity risks of assets. Senior cybersecurity and non-cybersecurity executives communicate regularly regarding cybersecurity risks. Executives ensure that cybersecurity is considered through all lines of operation in the organization. The organization risk strategy is informed by the cybersecurity risks associated with its suppliers and the products and services it acquires and uses. Personnel formally act upon those risks through mechanisms such as written agreements to communicate baseline requirements, governance structures (e.g., risk councils), and policy implementation and monitoring. These actions are implemented consistently and as intended and are continuously monitored and reviewed."@en ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:Tier_4_Adaptive
    rdf:type csf:CSFTier , owl:NamedIndividual ;
    rdfs:label "Tier 4 — Adaptief"@nl , "Tier 4 — Adaptive"@en ;
    csf:csfIdentifier "Tier 4: Adaptive" ;
    csf:riskGovernanceDescription "There is an organization-wide approach to managing cybersecurity risks that uses risk-informed policies, processes, and procedures to address potential cybersecurity events. The relationship between cybersecurity risks and organizational objectives is clearly understood and considered when making decisions. Executives monitor cybersecurity risks in the same context as financial and other organizational risks. The organizational budget is based on an understanding of the current and predicted risk environment and risk tolerance. Business units implement executive vision and analyze system-level risks in the context of the organizational risk tolerances. Cybersecurity risk management is part of the organizational culture. It evolves from an awareness of previous activities and continuous awareness of activities on organizational systems and networks. The organization can quickly and efficiently account for changes to business/mission objectives in how risk is approached and communicated."@en ;
    csf:riskManagementDescription "The organization adapts its cybersecurity practices based on previous and current cybersecurity activities, including lessons learned and predictive indicators. Through a process of continuous improvement that incorporates advanced cybersecurity technologies and practices, the organization actively adapts to a changing technological landscape and responds in a timely and effective manner to evolving, sophisticated threats. The organization uses real-time or near real-time information to understand and consistently act upon the cybersecurity risks associated with its suppliers and the products and services it acquires and uses. Cybersecurity information is constantly shared throughout the organization and with authorized third parties."@en ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

# =============================================================================
# v4.6.0 Fase 4 — Stap 6: SKOS-mappings CSF Tier ↔ MaturityCapabilityLevel
# Datum: 2026-05-21
# Match-type: skos:relatedMatch (conceptuele aligning, geen exact-equivalentie)
# Eén richting: csf:Tier → isms:Level (analoog v4.5.0 Stap 7 GV→COSO/COBIT)
# Locatie: m21-csf.ttl (target-module-precedent v4.5.0)
#
# Paar-rationale (volgens instructie §7 conceptuele alignment):
#   Tier_1_Partial      ↔ Level_1 (Ad-hoc):       beide karakteriseren ongestructureerde respons
#   Tier_2_RiskInformed ↔ Level_2 (Informeel):    beide reflect risico-bewustzijn zonder org-brede verankering
#   Tier_3_Repeatable   ↔ Level_4 (Geëvalueerd):  beide hebben formele policy + periodieke review
#   Tier_4_Adaptive     ↔ Level_5 (Geïntegreerd): beide bereiken volledige org-cultuur-integratie + continue verbetering
#
# isms:Level_3 (Vastgesteld) krijgt geen Tier-equivalent: CSF heeft 4 Tiers, NBA-LIO/NOREA 5 Levels.
# Mapping Level_3 → tussen Tier_2 en Tier_3 zou geforceerd zijn (G1-discipline).
# =============================================================================

csf:Tier_1_Partial      skos:relatedMatch isms:Level_1 .
csf:Tier_2_RiskInformed skos:relatedMatch isms:Level_2 .
csf:Tier_3_Repeatable   skos:relatedMatch isms:Level_4 .
csf:Tier_4_Adaptive     skos:relatedMatch isms:Level_5 .
