# =============================================================================
# v4.5.0 Fase 3 — Stap 4: Implementation Examples
# Datum: 2026-05-19
# =============================================================================
# 363 Implementation Examples uit CSF_2_0-Implementation_Examples.xlsx Sheet1.
# Daadwerkelijk geparsed: 363 (XLSX bevat 386 rijen; 22 zijn Function/Category-
# headers zonder Example-data; 1 is column-header).
#
# Per IE-individual:
#   - rdf:type csf:ImplementationExample, owl:NamedIndividual
#   - rdfs:label "<Subcat>.Ex<N>"@nl/@en (taal-neutrale ID-form)
#   - rdfs:comment @en (letterlijke Example-tekst uit NIST CSF 2.0 — geen NL-vertaling
#     conform D6 vertaling-scope-uitbreiding: lange normatieve tekst @en-only)
#   - csf:csfIdentifier "<Subcat>.Ex<N>" (bv. GV.OC-01.Ex1)
#   - csf:exemplifies <Subcategory-individual>
#   - ext:isComponentOf fw:NIST_CSF_2_0
#   - ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024
#
# IRI-conventie: csf:<FUNC>_<CAT>_<NN>_Ex<N> — geen zfill op N (max=10 voor GV.SC-05).


# --- 363 Implementation Examples ---

csf:GV_OC_01_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "GV.OC-01.Ex1"@nl , "GV.OC-01.Ex1"@en ;
    rdfs:comment "Share the organization’s mission (e.g., through vision and mission statements, marketing, and service strategies) to provide a basis for identifying risks that may impede that mission"@en ;
    csf:csfIdentifier "GV.OC-01.Ex1" ;
    csf:exemplifies csf:GV_OC_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_02_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "GV.OC-02.Ex1"@nl , "GV.OC-02.Ex1"@en ;
    rdfs:comment "Identify relevant internal stakeholders and their cybersecurity-related expectations (e.g., performance and risk expectations of officers, directors, and advisors; cultural expectations of employees)"@en ;
    csf:csfIdentifier "GV.OC-02.Ex1" ;
    csf:exemplifies csf:GV_OC_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_02_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "GV.OC-02.Ex2"@nl , "GV.OC-02.Ex2"@en ;
    rdfs:comment "Identify relevant external stakeholders and their cybersecurity-related expectations (e.g., privacy expectations of customers, business expectations of partnerships, compliance expectations of regulators, ethics expectations of society)"@en ;
    csf:csfIdentifier "GV.OC-02.Ex2" ;
    csf:exemplifies csf:GV_OC_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_03_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "GV.OC-03.Ex1"@nl , "GV.OC-03.Ex1"@en ;
    rdfs:comment "Determine a process to track and manage legal and regulatory requirements regarding protection of individuals’ information (e.g., Health Insurance Portability and Accountability Act, California Consumer Privacy Act, General Data Protection Regulation)"@en ;
    csf:csfIdentifier "GV.OC-03.Ex1" ;
    csf:exemplifies csf:GV_OC_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_03_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "GV.OC-03.Ex2"@nl , "GV.OC-03.Ex2"@en ;
    rdfs:comment "Determine a process to track and manage contractual requirements for cybersecurity management of supplier, customer, and partner information"@en ;
