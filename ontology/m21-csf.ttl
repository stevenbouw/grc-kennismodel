    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-11.Ex3"@nl , "PR.DS-11.Ex3"@en ;
    rdfs:comment "Securely store some backups offline and offsite so that an incident or disaster will not damage them"@en ;
    csf:csfIdentifier "PR.DS-11.Ex3" ;
    csf:exemplifies csf:PR_DS_11 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
