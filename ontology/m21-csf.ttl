csf:PR_DS_02_Ex1
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-02.Ex1"@nl , "PR.DS-02.Ex1"@en ;
    rdfs:comment "Use encryption, digital signatures, and cryptographic hashes to protect the confidentiality and integrity of network communications"@en ;
