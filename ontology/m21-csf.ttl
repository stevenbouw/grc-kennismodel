@prefix ctrl:  <https://grc.example.org/control/> .
@prefix risk:  <https://grc.example.org/risk/> .
@prefix roles: <https://grc.example.org/roles/> .
@prefix compl: <https://grc.example.org/compliance/> .
@prefix isms:  <https://grc.example.org/isms/> .
@prefix biz:   <https://grc.example.org/business/> .
@prefix bio:   <https://grc.example.org/bio/> .
@prefix ext:   <https://grc.example.org/extended/> .
@prefix asset: <https://grc.example.org/asset/> .
@prefix csf:   <https://grc.example.org/csf/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

<https://grc.example.org/ontology/m21-csf>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M21 — NIST CSF 2.0"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

# =============================================================================
# v4.5.0 Fase 3 — M21 NIST Cybersecurity Framework 2.0
# Datum: 2026-05-19
# =============================================================================
# Bevat:
#   - 2 SourceAttribution-individuals (NIST CSF Core + NIST OLIR snapshot)
#   - 6 Functions, 22 Categories, 106 Subcategories (Stap 3 — volgt)
#   - ~385 Implementation Examples (Stap 4 — volgt)
#   - Sheet 8 mappings CSF ↔ ISO 27001/BIO (Stap 5 — volgt)
# IR-mappings naar SP 800-53 + ISO 27001 zitten in m11 + m09 (Stap 6).
# GOVERN-overlap COSO/COBIT zit in m17 + hier (Stap 7).
#
# Conform Optie B (gemapt referentiekader): CSF 2.0 is geen wettelijk verplicht
# kader voor de Rijksoverheid, maar ondersteunend voor bestuurscommunicatie en
# supply-chain via SKOS-mappings naar bestaande frameworks.

# --- SourceAttribution-individuals ---

ext:Attr_NIST_CSF_2_0_Core_2024
    rdf:type ext:SourceAttribution , owl:NamedIndividual ;
    rdfs:label "NIST CSF 2.0 Core — Publiek domein"@nl ,
               "NIST CSF 2.0 Core — Public Domain"@en ;
    ext:hasLicense "Public Domain (US Government Work)" ;
    ext:hasLicenseURL "https://www.nist.gov/oism/copyrights"^^xsd:anyURI ;
    ext:hasAttributionText "NIST Cybersecurity Framework 2.0, NIST CSWP 29 (26 februari 2024). Publiek domein als werk van de Amerikaanse federale overheid. Bevat: 6 Functions, 22 Categories, 106 Subcategories, ~385 Implementation Examples."@nl ,
                           "NIST Cybersecurity Framework 2.0, NIST CSWP 29 (26 February 2024). Public domain as US Federal Government work. Contains: 6 Functions, 22 Categories, 106 Subcategories, ~385 Implementation Examples."@en ;
    ext:hasSourcePublicationDate "2024-02-26"^^xsd:date ;
    ext:hasSourceVersion "2.0" .

ext:Attr_NIST_CSF_2_0_Reference_Tool_2026
    rdf:type ext:SourceAttribution , owl:NamedIndividual ;
    rdfs:label "NIST CSF 2.0 Reference Tool — Publiek domein"@nl ,
               "NIST CSF 2.0 Reference Tool — Public Domain"@en ;
    ext:hasLicense "Public Domain (US Government Work)" ;
    ext:hasLicenseURL "https://www.nist.gov/oism/copyrights"^^xsd:anyURI ;
    ext:hasAttributionText "NIST CSF 2.0 Reference Tool export (csf2.xlsx, 5 mei 2026 generated), bevat Informative References uit 23 framework-bronnen op CSF Function/Category/Subcategory-niveau. Per sub-keuze C1 v4.5.0 alleen SP 800-53 Rev 5.2.0 (746 refs), ISO/IEC 27001:2022 Annex A Controls (301 refs) en ISO/IEC 27001:2022 Mandatory Clause (188 refs) opgenomen. 20 overige source-prefixes (NICE Framework, CCMv4.0, PCI DSS, etc.) niet opgenomen — buiten C1-scope. Publiek domein. NOOT: dit is geen OLIR-snapshot-XLSX (geen expliciete equivalent/subset/intersects-relationship-types); alle mappings als skos:closeMatch geconverteerd."@nl ,
                           "NIST CSF 2.0 Reference Tool export (csf2.xlsx, generated 19 May 2026), contains Informative References from 23 framework sources at CSF Function/Category/Subcategory level. Per sub-choice C1 v4.5.0 only SP 800-53 Rev 5.2.0 (746 refs), ISO/IEC 27001:2022 Annex A Controls (301 refs) and ISO/IEC 27001:2022 Mandatory Clause (188 refs) included. 20 other source-prefixes (NICE Framework, CCMv4.0, PCI DSS, etc.) not included — out of C1 scope. Public domain. NOTE: this is not an OLIR-snapshot XLSX (no explicit equivalent/subset/intersects relationship types); all mappings converted as skos:closeMatch."@en ;
    ext:hasSourcePublicationDate "2026-05-19"^^xsd:date ;
    ext:hasSourceVersion "CSF Reference Tool export 2026-05-19 (SHA256: 425aae640e1062f296966eda7d09de3f0bd9e5a34a71061ed762012a56e4ca9b)" .

# === Einde Stap 2 — CSF Core + IE + mappings volgen in Stappen 3-7 ===

# =============================================================================
# v4.5.0 Fase 3 — Stap 3: CSF Core Individuals
# Datum: 2026-05-19
# =============================================================================
# 6 Functions + 22 Categories + 106 Subcategories als csf:-individuals.
# Alle individuals:
#   - rdf:type (Function|Category|Subcategory), owl:NamedIndividual
#   - rdfs:label (bilingual NL/EN voor Function+Category; ID-form @en voor Subcategory)
#   - rdfs:comment @en (NIST CSWP 29 normative statement)
#   - csf:csfIdentifier (originele ID met punt/dash-conventie)
#   - ext:isComponentOf fw:NIST_CSF_2_0 (D-decision Optie A — bestaande precedent uit m17)
#   - ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024
#   - csf:partOfFunction (Categories) / csf:partOfCategory (Subcategories)

# --- 6 Functions ---

csf:GOVERN
    rdf:type csf:Function , owl:NamedIndividual ;
    rdfs:label "Sturen"@nl , "GOVERN"@en ;
    rdfs:comment "The organization’s cybersecurity risk management strategy, expectations, and policy are established, communicated, and monitored"@en ;
    csf:csfIdentifier "GV" ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:IDENTIFY
    rdf:type csf:Function , owl:NamedIndividual ;
    rdfs:label "Identificeren"@nl , "IDENTIFY"@en ;
    rdfs:comment "The organization’s current cybersecurity risks are understood"@en ;
    csf:csfIdentifier "ID" ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PROTECT
    rdf:type csf:Function , owl:NamedIndividual ;
    rdfs:label "Beschermen"@nl , "PROTECT"@en ;
    rdfs:comment "Safeguards to manage the organization’s cybersecurity risks are used"@en ;
    csf:csfIdentifier "PR" ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:DETECT
    rdf:type csf:Function , owl:NamedIndividual ;
    rdfs:label "Detecteren"@nl , "DETECT"@en ;
    rdfs:comment "Possible cybersecurity attacks and compromises are found and analyzed"@en ;
    csf:csfIdentifier "DE" ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RESPOND
    rdf:type csf:Function , owl:NamedIndividual ;
    rdfs:label "Reageren"@nl , "RESPOND"@en ;
    rdfs:comment "Actions regarding a detected cybersecurity incident are taken"@en ;
    csf:csfIdentifier "RS" ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RECOVER
    rdf:type csf:Function , owl:NamedIndividual ;
    rdfs:label "Herstellen"@nl , "RECOVER"@en ;
    rdfs:comment "Assets and operations affected by a cybersecurity incident are restored"@en ;
    csf:csfIdentifier "RC" ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .


# --- 22 Categories ---

csf:GV_OrganizationalContext
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Organisatorische context"@nl , "Organizational Context"@en ;
    rdfs:comment "The circumstances — mission, stakeholder expectations, dependencies, and legal, regulatory, and contractual requirements — surrounding the organization’s cybersecurity risk management decisions are understood"@en ;
    csf:csfIdentifier "GV.OC" ;
    csf:partOfFunction csf:GOVERN ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RiskManagementStrategy
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Risicobeheersstrategie"@nl , "Risk Management Strategy"@en ;
    rdfs:comment "The organization’s priorities, constraints, risk tolerance and appetite statements, and assumptions are established, communicated, and used to support operational risk decisions"@en ;
    csf:csfIdentifier "GV.RM" ;
    csf:partOfFunction csf:GOVERN ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RolesResponsibilitiesAndAuthorities
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Rollen, verantwoordelijkheden en bevoegdheden"@nl , "Roles, Responsibilities, and Authorities"@en ;
    rdfs:comment "Cybersecurity roles, responsibilities, and authorities to foster accountability, performance assessment, and continuous improvement are established and communicated"@en ;
    csf:csfIdentifier "GV.RR" ;
    csf:partOfFunction csf:GOVERN ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_Policy
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Beleid"@nl , "Policy"@en ;
    rdfs:comment "Organizational cybersecurity policy is established, communicated, and enforced"@en ;
    csf:csfIdentifier "GV.PO" ;
    csf:partOfFunction csf:GOVERN ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_Oversight
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Toezicht"@nl , "Oversight"@en ;
    rdfs:comment "Results of organization-wide cybersecurity risk management activities and performance are used to inform, improve, and adjust the risk management strategy"@en ;
    csf:csfIdentifier "GV.OV" ;
    csf:partOfFunction csf:GOVERN ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_CybersecuritySupplyChainRiskManagement
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Risicobeheer cybersecurity-toeleveringsketen"@nl , "Cybersecurity Supply Chain Risk Management"@en ;
    rdfs:comment "Cyber supply chain risk management processes are identified, established, managed, monitored, and improved by organizational stakeholders"@en ;
    csf:csfIdentifier "GV.SC" ;
    csf:partOfFunction csf:GOVERN ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_AssetManagement
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Activabeheer"@nl , "Asset Management"@en ;
    rdfs:comment "Assets (e.g., data, hardware, software, systems, facilities, services, people) that enable the organization to achieve business purposes are identified and managed consistent with their relative importance to organizational objectives and the organization’s risk strategy"@en ;
    csf:csfIdentifier "ID.AM" ;
    csf:partOfFunction csf:IDENTIFY ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_RiskAssessment
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Risicobeoordeling"@nl , "Risk Assessment"@en ;
    rdfs:comment "The cybersecurity risk to the organization, assets, and individuals is understood by the organization"@en ;
    csf:csfIdentifier "ID.RA" ;
    csf:partOfFunction csf:IDENTIFY ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_Improvement
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Verbetering"@nl , "Improvement"@en ;
    rdfs:comment "Improvements to organizational cybersecurity risk management processes, procedures and activities are identified across all CSF Functions"@en ;
    csf:csfIdentifier "ID.IM" ;
    csf:partOfFunction csf:IDENTIFY ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_IdentityManagementAuthenticationAndAccessControl
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Identiteitsbeheer, authenticatie en toegangscontrole"@nl , "Identity Management, Authentication, and Access Control"@en ;
    rdfs:comment "Access to physical and logical assets is limited to authorized users, services, and hardware and managed commensurate with the assessed risk of unauthorized access"@en ;
    csf:csfIdentifier "PR.AA" ;
    csf:partOfFunction csf:PROTECT ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_AwarenessAndTraining
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Bewustzijn en training"@nl , "Awareness and Training"@en ;
    rdfs:comment "The organization’s personnel are provided with cybersecurity awareness and training so that they can perform their cybersecurity-related tasks"@en ;
    csf:csfIdentifier "PR.AT" ;
    csf:partOfFunction csf:PROTECT ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_DataSecurity
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Gegevensbeveiliging"@nl , "Data Security"@en ;
    rdfs:comment "Data are managed consistent with the organization’s risk strategy to protect the confidentiality, integrity, and availability of information"@en ;
    csf:csfIdentifier "PR.DS" ;
    csf:partOfFunction csf:PROTECT ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_PlatformSecurity
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Platformbeveiliging"@nl , "Platform Security"@en ;
    rdfs:comment "The hardware, software (e.g., firmware, operating systems, applications), and services of physical and virtual platforms are managed consistent with the organization’s risk strategy to protect their confidentiality, integrity, and availability"@en ;
    csf:csfIdentifier "PR.PS" ;
    csf:partOfFunction csf:PROTECT ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_TechnologyInfrastructureResilience
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Weerbaarheid technologie-infrastructuur"@nl , "Technology Infrastructure Resilience"@en ;
    rdfs:comment "Security architectures are managed with the organization’s risk strategy to protect asset confidentiality, integrity, and availability, and organizational resilience"@en ;
    csf:csfIdentifier "PR.IR" ;
    csf:partOfFunction csf:PROTECT ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:DE_ContinuousMonitoring
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Continue monitoring"@nl , "Continuous Monitoring"@en ;
    rdfs:comment "Assets are monitored to find anomalies, indicators of compromise, and other potentially adverse events"@en ;
    csf:csfIdentifier "DE.CM" ;
    csf:partOfFunction csf:DETECT ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:DE_AdverseEventAnalysis
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Analyse van ongunstige gebeurtenissen"@nl , "Adverse Event Analysis"@en ;
    rdfs:comment "Anomalies, indicators of compromise, and other potentially adverse events are analyzed to characterize the events and detect cybersecurity incidents"@en ;
    csf:csfIdentifier "DE.AE" ;
    csf:partOfFunction csf:DETECT ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_IncidentManagement
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Incidentbeheer"@nl , "Incident Management"@en ;
    rdfs:comment "Responses to detected cybersecurity incidents are managed"@en ;
    csf:csfIdentifier "RS.MA" ;
    csf:partOfFunction csf:RESPOND ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_IncidentAnalysis
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Incidentanalyse"@nl , "Incident Analysis"@en ;
    rdfs:comment "Investigations are conducted to ensure effective response and support forensics and recovery activities"@en ;
    csf:csfIdentifier "RS.AN" ;
    csf:partOfFunction csf:RESPOND ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_IncidentResponseReportingAndCommunication
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Incidentrespons-rapportage en -communicatie"@nl , "Incident Response Reporting and Communication"@en ;
    rdfs:comment "Response activities are coordinated with internal and external stakeholders as required by laws, regulations, or policies"@en ;
    csf:csfIdentifier "RS.CO" ;
    csf:partOfFunction csf:RESPOND ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_IncidentMitigation
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Incidentmitigatie"@nl , "Incident Mitigation"@en ;
    rdfs:comment "Activities are performed to prevent expansion of an event and mitigate its effects"@en ;
    csf:csfIdentifier "RS.MI" ;
    csf:partOfFunction csf:RESPOND ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_IncidentRecoveryPlanExecution
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Uitvoering incidentherstelplan"@nl , "Incident Recovery Plan Execution"@en ;
    rdfs:comment "Restoration activities are performed to ensure operational availability of systems and services affected by cybersecurity incidents"@en ;
    csf:csfIdentifier "RC.RP" ;
    csf:partOfFunction csf:RECOVER ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_IncidentRecoveryCommunication
    rdf:type csf:Category , owl:NamedIndividual ;
    rdfs:label "Communicatie over incidentherstel"@nl , "Incident Recovery Communication"@en ;
    rdfs:comment "Restoration activities are coordinated with internal and external parties"@en ;
    csf:csfIdentifier "RC.CO" ;
    csf:partOfFunction csf:RECOVER ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .


# --- 106 Subcategories ---

csf:GV_OC_01
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.OC-01"@en ;
    rdfs:comment "The organizational mission is understood and informs cybersecurity risk management"@en ;
    csf:csfIdentifier "GV.OC-01" ;
    csf:partOfCategory csf:GV_OrganizationalContext ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_02
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.OC-02"@en ;
    rdfs:comment "Internal and external stakeholders are understood, and their needs and expectations regarding cybersecurity risk management are understood and considered"@en ;
    csf:csfIdentifier "GV.OC-02" ;
    csf:partOfCategory csf:GV_OrganizationalContext ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_03
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.OC-03"@en ;
    rdfs:comment "Legal, regulatory, and contractual requirements regarding cybersecurity — including privacy and civil liberties obligations — are understood and managed"@en ;
    csf:csfIdentifier "GV.OC-03" ;
    csf:partOfCategory csf:GV_OrganizationalContext ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_04
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.OC-04"@en ;
    rdfs:comment "Critical objectives, capabilities, and services that external stakeholders depend on or expect from the organization are understood and communicated"@en ;
    csf:csfIdentifier "GV.OC-04" ;
    csf:partOfCategory csf:GV_OrganizationalContext ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_05
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.OC-05"@en ;
    rdfs:comment "Outcomes, capabilities, and services that the organization depends on are understood and communicated"@en ;
    csf:csfIdentifier "GV.OC-05" ;
    csf:partOfCategory csf:GV_OrganizationalContext ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RM_01
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.RM-01"@en ;
    rdfs:comment "Risk management objectives are established and agreed to by organizational stakeholders"@en ;
    csf:csfIdentifier "GV.RM-01" ;
    csf:partOfCategory csf:GV_RiskManagementStrategy ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RM_02
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.RM-02"@en ;
    rdfs:comment "Risk appetite and risk tolerance statements are established, communicated, and maintained"@en ;
    csf:csfIdentifier "GV.RM-02" ;
    csf:partOfCategory csf:GV_RiskManagementStrategy ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RM_03
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.RM-03"@en ;
    rdfs:comment "Cybersecurity risk management activities and outcomes are included in enterprise risk management processes"@en ;
    csf:csfIdentifier "GV.RM-03" ;
    csf:partOfCategory csf:GV_RiskManagementStrategy ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RM_04
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.RM-04"@en ;
    rdfs:comment "Strategic direction that describes appropriate risk response options is established and communicated"@en ;
    csf:csfIdentifier "GV.RM-04" ;
    csf:partOfCategory csf:GV_RiskManagementStrategy ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RM_05
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.RM-05"@en ;
    rdfs:comment "Lines of communication across the organization are established for cybersecurity risks, including risks from suppliers and other third parties"@en ;
    csf:csfIdentifier "GV.RM-05" ;
    csf:partOfCategory csf:GV_RiskManagementStrategy ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RM_06
    rdf:type csf:Subcategory , owl:NamedIndividual ;
    rdfs:label "GV.RM-06"@en ;
    rdfs:comment "A standardized method for calculating, documenting, categorizing, and prioritizing cybersecurity risks is established and communicated"@en ;
    csf:csfIdentifier "GV.RM-06" ;
    csf:partOfCategory csf:GV_RiskManagementStrategy ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_RM_07
