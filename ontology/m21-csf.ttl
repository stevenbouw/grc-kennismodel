csf:PR_DS_02_Ex2
    rdf:type csf:ImplementationExample , owl:NamedIndividual ;
    rdfs:label "PR.DS-02.Ex2"@nl , "PR.DS-02.Ex2"@en ;
    rdfs:comment "Automatically encrypt or block outbound emails and other communications that contain sensitive data, depending on the data classification"@en ;
    csf:csfIdentifier "PR.DS-02.Ex2" ;
    csf:exemplifies csf:PR_DS_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

