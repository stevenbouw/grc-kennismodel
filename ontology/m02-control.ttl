ctrl:ISO27002_5_24 skos:relatedMatch ctrl:NIST_IR .   # Incidentbeheer plan → Incident Response
ctrl:ISO27002_5_26 skos:relatedMatch ctrl:NIST_IR .   # Reageren op incidenten → IR
ctrl:ISO27002_5_30 skos:relatedMatch ctrl:NIST_CP .   # ICT-gereedheid BCM → Contingency Planning
ctrl:ISO27002_8_07 skos:relatedMatch ctrl:NIST_SI .   # Malware → System Integrity
ctrl:ISO27002_8_08 skos:relatedMatch ctrl:NIST_RA .   # Kwetsbaarheidsbeheer → Risk Assessment
ctrl:ISO27002_8_09 skos:relatedMatch ctrl:NIST_CM .   # Configuratiebeheer → Config Management
ctrl:ISO27002_8_13 skos:relatedMatch ctrl:NIST_CP .   # Back-up → Contingency Planning
ctrl:ISO27002_8_15 skos:relatedMatch ctrl:NIST_AU .   # Logging → Audit & Accountability
ctrl:ISO27002_8_19 skos:relatedMatch ctrl:NIST_CM .   # Software installatie → Config Management
ctrl:ISO27002_5_19 skos:relatedMatch ctrl:NIST_SR .   # Leveranciersrelaties → Supply Chain RM
ctrl:ISO27002_5_21 skos:relatedMatch ctrl:NIST_SR .   # ICT-toeleveringsketen → SR
ctrl:ISO27002_7_01 skos:relatedMatch ctrl:NIST_PE .   # Fysieke zones → Physical Protection
ctrl:ISO27002_7_02 skos:relatedMatch ctrl:NIST_PE .   # Fysieke toegang → PE
