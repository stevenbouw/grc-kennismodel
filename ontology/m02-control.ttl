@prefix fw:      <https://grc.example.org/framework/> .
@prefix ctrl:    <https://grc.example.org/control/> .
@prefix risk:    <https://grc.example.org/risk/> .
@prefix roles:   <https://grc.example.org/roles/> .
@prefix compl:   <https://grc.example.org/compliance/> .
@prefix isms:    <https://grc.example.org/isms/> .
@prefix biz:     <https://grc.example.org/business/> .
@prefix bio:     <https://grc.example.org/bio/> .
@prefix ext:     <https://grc.example.org/extended/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

# =============================================================================
# GRC Ontologie — Module M2: Control
# Versie: 4.0.0-alpha | Datum: 2026-03-19 | Profiel: OWL 2 DL
# =============================================================================

<https://grc.example.org/ontology/m02-control>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M2 — Control"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

ctrl:Control
    rdf:type owl:Class ;
    rdfs:label "Control"@en , "Beheersmaatregel"@nl ;
    rdfs:comment
        "An information security control. Each control in this namespace is identical across ISO 27001:2022 Annex A (the requirement), ISO 27002:2022 (implementation guidance) and BIO 2.0 (mandatory baseline). The ctrl: namespace models the control itself; ISO 27002 provides additional implementation guidance; BIO 2.0 adds government-specific measures via bio:OverheidsMaatregel."@en ,
        "Een beheersmaatregel voor informatiebeveiliging. Elke control in deze namespace is identiek in ISO 27001:2022 Bijlage A (de eis), ISO 27002:2022 (de implementatierichtlijn) en BIO 2.0 (het verplichte kader). De ctrl:-namespace modelleert de control zelf; ISO 27002 biedt aanvullende implementatierichtlijnen; BIO 2.0 voegt overheidsspecifieke maatregelen toe via bio:OverheidsMaatregel."@nl .

ctrl:ControlFamily
    rdf:type owl:Class ;
    rdfs:label "Control Family"@en , "Beheersmaatregelfamilie"@nl ;
    rdfs:comment
        "A thematic grouping of related controls within a framework (e.g. NIST 800-53 control families)."@en ,
        "Een thematische groepering van gerelateerde beheersmaatregelen binnen een kaderwerk."@nl .

ctrl:ControlObjective
    rdf:type owl:Class ;
    rdfs:label "Control Objective"@en , "Beheersmaatregeldoelstelling"@nl ;
    rdfs:comment
        "The intended outcome or purpose a control is designed to achieve."@en ,
        "Het beoogde resultaat of doel dat een beheersmaatregel is ontworpen te bereiken."@nl .

ctrl:ControlDomain
    rdf:type owl:Class ;
    rdfs:label "Control Domain"@en , "Beheersmaatregeldomein"@nl ;
    rdfs:comment
        "A thematic domain or category within which controls are grouped (e.g. Access Control, Incident Management). Framework-neutral: applies to ISO 27002, NIST 800-53, COBIT and other control frameworks."@en ,
        "Een thematisch domein of categorie waarbinnen beheersmaatregelen zijn gegroepeerd (bijv. Toegangsbeveiliging, Incidentbeheer). Framework-neutraal: van toepassing op ISO 27002, NIST 800-53, COBIT en andere maatregelkaders."@nl .

ctrl:ISO27002Control
    rdf:type owl:Class ;
    rdfs:subClassOf ctrl:Control ;
    rdfs:label "ISO/IEC 27002:2022 Control"@en , "ISO/IEC 27002:2022 Beheersmaatregel"@nl ;
    rdfs:comment
        "A control defined in ISO/IEC 27002:2022, organised in four themes: Organisational, People, Physical, Technological."@en ,
        "Een beheersmaatregel gedefinieerd in ISO/IEC 27002:2022, georganiseerd in vier thema's: Organisatorisch, Mensgericht, Fysiek, Technologisch."@nl .

ctrl:NIST80053Control
    rdf:type owl:Class ;
    rdfs:subClassOf ctrl:Control ;
    rdfs:label "NIST SP 800-53 Rev.5 Control"@en , "NIST SP 800-53 Rev.5 Beheersmaatregel"@nl ;
    rdfs:comment
        "A security or privacy control defined in NIST SP 800-53 Revision 5."@en ,
        "Een beveiligings- of privacymaatregel gedefinieerd in NIST SP 800-53 Revisie 5."@nl .

ctrl:ControlTheme
    rdf:type owl:Class ;
    rdfs:label "Control Theme"@en , "Beheersmaatregelthema"@nl ;
    rdfs:comment
        "The ISO/IEC 27002:2022 thematic category of a control: Organisational, People, Physical or Technological."@en ,
        "De thematische categorie van een beheersmaatregel conform ISO/IEC 27002:2022: Organisatorisch, Mensgericht, Fysiek of Technologisch."@nl .

ctrl:ControlType
    rdf:type owl:Class ;
    rdfs:label "Control Type"@en , "Type beheersmaatregel"@nl ;
    rdfs:comment
        "The timing of control effect: Preventive, Detective, or Corrective."@en ,
        "Het tijdstip van werking van de beheersmaatregel: Preventief, Detectief of Corrigerend."@nl .

ctrl:SecurityProperty
    rdf:type owl:Class ;
    rdfs:label "Security Property"@en , "Informatiebeveiligingseigenschap"@nl ;
    rdfs:comment
        "CIA triad properties: Confidentiality, Integrity, Availability."@en ,
        "CIA-driehoek eigenschappen: Vertrouwelijkheid, Integriteit, Beschikbaarheid."@nl .

ctrl:CybersecurityConcept
    rdf:type owl:Class ;
    rdfs:label "Cybersecurity Concept"@en , "Cybersecurityconcept"@nl ;
    rdfs:comment
        "NIST CSF 2.0-aligned concept: Govern, Identify, Protect, Detect, Respond, Recover. Per CSF 2.0 (NIST CSWP 29, 26 februari 2024) is Govern toegevoegd t.o.v. v1.x."@en ,
        "NIST CSF 2.0-gebaseerd concept: Sturen, Identificeren, Beschermen, Detecteren, Reageren, Herstellen. Per CSF 2.0 (NIST CSWP 29, 26 februari 2024) is Sturen toegevoegd t.o.v. v1.x."@nl .

ctrl:OperationalCapability
    rdf:type owl:Class ;
    rdfs:label "Operational Capability"@en , "Operationele capaciteit"@nl ;
    rdfs:comment
        "ISO/IEC 27002:2022 attribute: the operational capability that a control supports (e.g. Governance, Asset Management, Identity and Access Management). 16 values defined."@en ,
        "ISO/IEC 27002:2022-attribuut: de operationele capaciteit die een beheersmaatregel ondersteunt (bijv. Governance, Bedrijfsmiddelenbeheer, Identiteits- en toegangsbeheer). 16 waarden gedefinieerd."@nl .

ctrl:SecurityDomain
    rdf:type owl:Class ;
    rdfs:label "Security Domain"@en , "Beveiligingsdomein"@nl ;
    rdfs:comment
        "ISO/IEC 27002:2022 attribute: the security domain a control belongs to. Four values: Governance & Ecosystem, Protection, Defence, Resilience."@en ,
        "ISO/IEC 27002:2022-attribuut: het beveiligingsdomein waartoe een beheersmaatregel behoort. Vier waarden: Governance & Ecosysteem, Bescherming, Verdediging, Veerkracht."@nl .

# --- Disjointness ---
[] rdf:type owl:AllDisjointClasses ;
   owl:members ( ctrl:ISO27002Control ctrl:NIST80053Control ) .

# =============================================================================
# SECTIE 2 – OBJECT PROPERTIES
# =============================================================================

ctrl:belongsToFramework
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "belongs to framework"@en , "behoort tot kaderwerk"@nl ;
    rdfs:comment "Links a control to the framework in which it is defined."@en ,
                 "Koppelt een beheersmaatregel aan het kaderwerk waarin deze is gedefinieerd."@nl .

ctrl:hasControlFamily
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:ControlFamily ;
    rdfs:label "has control family"@en , "heeft beheersmaatregelfamilie"@nl .

ctrl:hasControlObjective
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:ControlObjective ;
    rdfs:label "has control objective"@en , "heeft beheersmaatregeldoelstelling"@nl .

ctrl:hasTheme
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:ISO27002Control ;
    rdfs:range ctrl:ControlTheme ;
    rdfs:label "has theme"@en , "heeft thema"@nl ;
    rdfs:comment "The ISO 27002:2022 thematic category."@en ,
                 "De thematische categorie conform ISO 27002:2022."@nl .

ctrl:hasControlType
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:ControlType ;
    rdfs:label "has control type"@en , "heeft type beheersmaatregel"@nl .

ctrl:hasSecurityProperty
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:SecurityProperty ;
    rdfs:label "has security property"@en , "heeft informatiebeveiligingseigenschap"@nl .

ctrl:hasCybersecurityConcept
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:CybersecurityConcept ;
    rdfs:label "has cybersecurity concept"@en , "heeft cybersecurityconcept"@nl .

ctrl:hasOperationalCapability
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:OperationalCapability ;
    rdfs:label "has operational capability"@en , "heeft operationele capaciteit"@nl ;
    rdfs:comment
        "Links a control to the operational capability it supports. ISO/IEC 27002:2022 attribute. Multi-valued."@en ,
        "Koppelt een beheersmaatregel aan de operationele capaciteit die deze ondersteunt. ISO/IEC 27002:2022-attribuut. Meerwaardig."@nl .

ctrl:hasSecurityDomain
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:SecurityDomain ;
    rdfs:label "has security domain"@en , "heeft beveiligingsdomein"@nl ;
    rdfs:comment
        "Links a control to the security domain it belongs to. ISO/IEC 27002:2022 attribute. Multi-valued."@en ,
        "Koppelt een beheersmaatregel aan het beveiligingsdomein waartoe deze behoort. ISO/IEC 27002:2022-attribuut. Meerwaardig."@nl .

ctrl:relatedTo
    rdf:type owl:ObjectProperty ;
    rdf:type owl:SymmetricProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:Control ;
    rdfs:label "related to"@en , "gerelateerd aan"@nl .

ctrl:satisfies
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range owl:Thing ;
    rdfs:label "satisfies"@en , "voldoet aan"@nl ;
    rdfs:comment "Links a control to a regulatory obligation or requirement it helps satisfy."@en ,
                 "Koppelt een beheersmaatregel aan een wettelijke verplichting of eis die deze helpt te vervullen."@nl .

ctrl:crossMapsTo
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:Control ;
    rdfs:label "cross-maps to"@en , "cross-mapped aan"@nl ;
    rdfs:comment "Cross-framework mapping between equivalent or closely related controls."@en ,
                 "Cross-framework koppeling tussen equivalente of nauw verwante beheersmaatregelen."@nl .

ctrl:definedInFramework
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range fw:GRCFramework ;
    rdfs:label "defined in framework"@en , "gedefinieerd in kaderwerk"@nl ;
    rdfs:comment "Links a control to the framework in which it is defined or mandated."@en ,
                 "Koppelt een beheersmaatregel aan het kaderwerk waarin deze is gedefinieerd of verplicht gesteld."@nl .

ctrl:hasControlDomain
    rdf:type owl:ObjectProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:ControlDomain ;
    rdfs:label "has control domain"@en , "heeft beheersmaatregeldomein"@nl ;
    rdfs:comment "Links a control to the thematic domain it belongs to (e.g. Access Control, Incident Response)."@en ,
                 "Koppelt een beheersmaatregel aan het thematisch domein waartoe deze behoort."@nl .

# =============================================================================
# SECTIE 3 – DATA PROPERTIES
# =============================================================================

ctrl:hasControlID
    rdf:type owl:DatatypeProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range xsd:string ;
    rdfs:label "has control ID"@en , "heeft beheersmaatregel-ID"@nl .

ctrl:hasControlTitle
    rdf:type owl:DatatypeProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has control title"@en , "heeft beheersmaatregeltitel"@nl .

ctrl:hasControlText
    rdf:type owl:DatatypeProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range xsd:string ;
    rdfs:label "has control text"@en , "heeft beheersmaatregeltekst"@nl .

ctrl:isApplicableInBIO
    rdf:type owl:DatatypeProperty ;
    rdfs:domain ctrl:Control ;
    rdfs:range xsd:boolean ;
    rdfs:label "is applicable in BIO 2.0"@en , "van toepassing in BIO 2.0"@nl .

# =============================================================================
# SECTIE 4 – ABOX: CONTROL TYPE / THEME / PROPERTY INDIVIDUALS
# =============================================================================

# Control Types
ctrl:Preventief   rdf:type ctrl:ControlType ; rdfs:label "Preventive"@en , "Preventief"@nl .
ctrl:Detectief    rdf:type ctrl:ControlType ; rdfs:label "Detective"@en , "Detectief"@nl .
ctrl:Corrigerend  rdf:type ctrl:ControlType ; rdfs:label "Corrective"@en , "Corrigerend"@nl .

# Control Themes (ISO 27002:2022)
ctrl:Organisatorisch rdf:type ctrl:ControlTheme ; rdfs:label "Organisational"@en , "Organisatorisch"@nl .
ctrl:Mensgericht     rdf:type ctrl:ControlTheme ; rdfs:label "People"@en , "Mensgericht"@nl .
ctrl:Fysiek          rdf:type ctrl:ControlTheme ; rdfs:label "Physical"@en , "Fysiek"@nl .
ctrl:Technologisch   rdf:type ctrl:ControlTheme ; rdfs:label "Technological"@en , "Technologisch"@nl .

# Security Properties
ctrl:Vertrouwelijkheid rdf:type ctrl:SecurityProperty ; rdfs:label "Confidentiality"@en , "Vertrouwelijkheid"@nl .
ctrl:Integriteit       rdf:type ctrl:SecurityProperty ; rdfs:label "Integrity"@en , "Integriteit"@nl .
ctrl:Beschikbaarheid   rdf:type ctrl:SecurityProperty ; rdfs:label "Availability"@en , "Beschikbaarheid"@nl .

# Cybersecurity Concepts
ctrl:Identificeren rdf:type ctrl:CybersecurityConcept ; rdfs:label "Identify"@en , "Identificeren"@nl .
ctrl:Beschermen    rdf:type ctrl:CybersecurityConcept ; rdfs:label "Protect"@en , "Beschermen"@nl .
ctrl:Detecteren    rdf:type ctrl:CybersecurityConcept ; rdfs:label "Detect"@en , "Detecteren"@nl .
ctrl:Reageren      rdf:type ctrl:CybersecurityConcept ; rdfs:label "Respond"@en , "Reageren"@nl .
ctrl:Herstellen    rdf:type ctrl:CybersecurityConcept ; rdfs:label "Recover"@en , "Herstellen"@nl .

# BBN Levels (bron: Handreiking BIO2-opmaat v2.5, NIET BIO 2.0 — gecorrigeerd 2026-03-19, BUG-06)
# ctrl:BBN3 VERWIJDERD — BBN3 bestaat niet in de Handreiking BIO2-opmaat (BUG-06 fix, 2026-03-19)

# Operational Capabilities (ISO/IEC 27002:2022 — 16 waarden, stap 5 toevoeging 2026-03-19)
ctrl:OC_Governance                        rdf:type ctrl:OperationalCapability ; rdfs:label "Governance"@en , "Governance"@nl .
ctrl:OC_Bedrijfsmiddelenbeheer            rdf:type ctrl:OperationalCapability ; rdfs:label "Asset Management"@en , "Beheer van bedrijfsmiddelen"@nl .
ctrl:OC_Informatiebescherming             rdf:type ctrl:OperationalCapability ; rdfs:label "Information Protection"@en , "Informatiebescherming"@nl .
ctrl:OC_Personeelsbeveiliging             rdf:type ctrl:OperationalCapability ; rdfs:label "Human Resource Security"@en , "Personeelsbeveiliging"@nl .
ctrl:OC_FysiekeBeveiliging                rdf:type ctrl:OperationalCapability ; rdfs:label "Physical Security"@en , "Fysieke beveiliging"@nl .
ctrl:OC_SysteemNetwerkbeveiliging         rdf:type ctrl:OperationalCapability ; rdfs:label "System and Network Security"@en , "Systeem- en netwerkbeveiliging"@nl .
ctrl:OC_Toepassingsbeveiliging            rdf:type ctrl:OperationalCapability ; rdfs:label "Application Security"@en , "Toepassingsbeveiliging"@nl .
ctrl:OC_VeiligeConfiguratie               rdf:type ctrl:OperationalCapability ; rdfs:label "Secure Configuration"@en , "Veilige configuratie"@nl .
ctrl:OC_IdentiteitToegangsbeheer          rdf:type ctrl:OperationalCapability ; rdfs:label "Identity and Access Management"@en , "Identiteits- en toegangsbeheer"@nl .
ctrl:OC_BedreigingKwetsbaarhedenbeheer    rdf:type ctrl:OperationalCapability ; rdfs:label "Threat and Vulnerability Management"@en , "Beheer van bedreigingen en kwetsbaarheden"@nl .
ctrl:OC_Continuiteit                      rdf:type ctrl:OperationalCapability ; rdfs:label "Continuity"@en , "Continuïteit"@nl .
ctrl:OC_Leveranciersrelaties              rdf:type ctrl:OperationalCapability ; rdfs:label "Supplier Relationships Security"@en , "Beveiliging in leveranciersrelaties"@nl .
ctrl:OC_JuridischCompliance               rdf:type ctrl:OperationalCapability ; rdfs:label "Legal and Compliance"@en , "Juridisch en compliance"@nl .
ctrl:OC_BeveiligingsgebeurtenissenBeheer  rdf:type ctrl:OperationalCapability ; rdfs:label "Information Security Event Management"@en , "Beheer van informatiebeveiligingsgebeurtenissen"@nl .
ctrl:OC_BorgingInformatiebeveiliging      rdf:type ctrl:OperationalCapability ; rdfs:label "Information Security Assurance"@en , "Borging van informatiebeveiliging"@nl .
ctrl:OC_BeveiligingLeveranciersrelaties   rdf:type ctrl:OperationalCapability ; rdfs:label "Supplier Relationship Management"@en , "Leveranciersrelaties"@nl .

# Security Domains (ISO/IEC 27002:2022 — 4 waarden)
ctrl:SD_GovernanceEcosysteem  rdf:type ctrl:SecurityDomain ; rdfs:label "Governance and Ecosystem"@en , "Governance en Ecosysteem"@nl .
ctrl:SD_Bescherming           rdf:type ctrl:SecurityDomain ; rdfs:label "Protection"@en , "Bescherming"@nl .
ctrl:SD_Verdediging           rdf:type ctrl:SecurityDomain ; rdfs:label "Defence"@en , "Verdediging"@nl .
ctrl:SD_Veerkracht            rdf:type ctrl:SecurityDomain ; rdfs:label "Resilience"@en , "Veerkracht"@nl .

