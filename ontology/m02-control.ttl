ctrl:ISO27002_5_09
    rdf:type ctrl:ISO27002Control ;
    rdfs:label "Inventarisatie van informatie en andere gerelateerde bedrijfsmiddelen"@nl , "Inventory of information and other associated assets"@en ;
    ctrl:hasControlID "5.09" ;
