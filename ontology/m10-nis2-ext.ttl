               "NIS2 art.21(2)(c) — Business continuity, backup management and disaster recovery"@en ;
    compl:derivedFrom fw:NIS2_Directive ;
    compl:derivedFrom fw:CBW ;
    compl:articleRef "art. 21, lid 2, onderdeel c"^^xsd:string ;
    compl:responsibleRole roles:R_CISO .

compl:NIS2_Art21_d rdf:type compl:RegulatoryObligation , owl:NamedIndividual ;
    rdfs:label "NIS2 art.21(2)(d) — Beveiliging van de toeleveringsketen"@nl ,
               "NIS2 art.21(2)(d) — Supply chain security"@en ;
    compl:derivedFrom fw:NIS2_Directive ;
    compl:derivedFrom fw:CBW ;
    compl:articleRef "art. 21, lid 2, onderdeel d"^^xsd:string ;
