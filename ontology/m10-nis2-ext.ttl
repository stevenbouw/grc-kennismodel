compl:NIS2_Art21_g rdf:type compl:RegulatoryObligation , owl:NamedIndividual ;
    rdfs:label "NIS2 art.21(2)(g) — Cyberhygiënepraktijken en opleiding cyberbeveiliging"@nl ,
               "NIS2 art.21(2)(g) — Cyber hygiene practices and cybersecurity training"@en ;
    compl:derivedFrom fw:NIS2_Directive ;
    compl:derivedFrom fw:CBW ;
    compl:articleRef "art. 21, lid 2, onderdeel g"^^xsd:string ;
