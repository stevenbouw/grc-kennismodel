compl:NIS2_Art21_f rdf:type compl:RegulatoryObligation , owl:NamedIndividual ;
    rdfs:label "NIS2 art.21(2)(f) — Beoordeling doeltreffendheid cyberbeveiligingsmaatregelen"@nl ,
               "NIS2 art.21(2)(f) — Policies and procedures to assess effectiveness of measures"@en ;
    compl:derivedFrom fw:NIS2_Directive ;
