compl:NIS2_Art21_i rdf:type compl:RegulatoryObligation , owl:NamedIndividual ;
    rdfs:label "NIS2 art.21(2)(i) — Beveiliging personeel, toegangsbeleid en activabeheer"@nl ,
               "NIS2 art.21(2)(i) — Human resources security, access control and asset management"@en ;
    compl:derivedFrom fw:NIS2_Directive ;
    compl:derivedFrom fw:CBW ;
    compl:articleRef "art. 21, lid 2, onderdeel i"^^xsd:string ;
