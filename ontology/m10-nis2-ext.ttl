compl:NIS2_Art21_e rdf:type compl:RegulatoryObligation , owl:NamedIndividual ;
    rdfs:label "NIS2 art.21(2)(e) — Beveiliging verwerving, ontwikkeling en onderhoud systemen"@nl ,
               "NIS2 art.21(2)(e) — Security in acquisition, development and maintenance"@en ;
    compl:derivedFrom fw:NIS2_Directive ;
    compl:derivedFrom fw:CBW ;
    compl:articleRef "art. 21, lid 2, onderdeel e"^^xsd:string ;
