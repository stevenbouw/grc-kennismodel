# =============================================================================
# GRC Ontologie — Module M10: NIS2 Extended
# Versie: 4.0.0-alpha | Datum: 2026-03-19 | Profiel: OWL 2 DL
# =============================================================================

<https://grc.example.org/ontology/m10-nis2-ext>
    rdf:type owl:Ontology ;
    rdfs:label "GRC Ontologie Module M10 — NIS2 Extended"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

# =============================================================================
# v4.4.0 Stap 2.1 — CBW-control-klasse (TBox)
# =============================================================================
# Eerste TBox-declaratie in m10. Precedent voor module-eigen control-subklasse-
# declaratie: bio:BIOControl ⊑ ctrl:Control in m08-bio20.ttl (niet in m02).
# CBW-controls zijn geen wettelijk verplichte beheersmaatregelen, maar een
# ADR/NOREA-interpretatieve uitwerking op operationeel niveau (CBW/NIS2 Control
# Framework versie 1.0, 30 september 2025, CC-BY 4.0).

ctrl:CBWControl
    rdf:type owl:Class ;
    rdfs:subClassOf ctrl:Control ;
    rdfs:label "CBW-control"@nl , "CBW control"@en ;
    rdfs:comment "Control uit het CBW/NIS2 Control Framework (ADR & NOREA, versie 1.0, 30 september 2025). Geen wettelijk verplichte beheersmaatregel, maar een ADR/NOREA-interpretatieve uitwerking van CBW-zorgplichtartikelen op operationeel niveau."@nl ,
                 "Control from the CBW/NIS2 Control Framework (ADR & NOREA, version 1.0, 30 September 2025). Not a legally mandated security measure but an ADR/NOREA-interpretative elaboration of CBW duty-of-care articles at operational level."@en .

# === M10: NIS2 aanvullende artikelen ===

compl:NIS2_Art18 rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "NIS2 Artikel 18: Melding van significante cyberdreigingen"@nl ;
    rdfs:label "NIS2 Article 18: Reporting of significant cyber threats"@en ;
    compl:articleRef "art. 18" ;
    compl:requirementText "Essentiële en belangrijke entiteiten mogen de CSIRT of bevoegde autoriteit vrijwillig in kennis stellen van significante cyberdreigingen."@nl ;
    compl:requirementText "Essential and important entities may voluntarily notify the CSIRT or competent authority of significant cyber threats."@en ;
    compl:derivedFrom fw:NIS2_Directive .

compl:NIS2_Art19 rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "NIS2 Artikel 19: Europese cyberbeveiligingscertificering"@nl ;
    rdfs:label "NIS2 Article 19: European cybersecurity certification"@en ;
    compl:articleRef "art. 19" ;
    compl:requirementText "De Commissie kan vereisen dat entiteiten gecertificeerde ICT-producten diensten of processen gebruiken."@nl ;
    compl:requirementText "The Commission may require entities to use certified ICT products, services or processes."@en ;
    compl:derivedFrom fw:NIS2_Directive .

compl:NIS2_Art20 rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "NIS2 Artikel 20: Governance en bestuurlijke verantwoordelijkheid"@nl ;
    rdfs:label "NIS2 Article 20: Governance"@en ;
    compl:articleRef "art. 20" ;
    compl:requirementText "Bestuursorganen van essentiële en belangrijke entiteiten keuren maatregelen voor cyberbeveiligingsrisicobeheer goed en houden toezicht op de uitvoering ervan."@nl ;
    compl:requirementText "Management bodies of essential and important entities shall approve cybersecurity risk management measures and oversee their implementation."@en ;
    compl:derivedFrom fw:NIS2_Directive .

compl:NIS2_Art22 rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "NIS2 Artikel 22: Gecoordineerde risicobeoordeling toeleveringsketen"@nl ;
    rdfs:label "NIS2 Article 22: Coordinated supply chain risk assessment"@en ;
    compl:articleRef "art. 22" ;
    compl:requirementText "De samenwerkingsgroep kan gecoordineerde risicobeoordelingen uitvoeren van de beveiliging van kritieke toeleveringsketens."@nl ;
    compl:requirementText "The Cooperation Group may carry out coordinated security risk assessments of critical supply chains."@en ;
    compl:derivedFrom fw:NIS2_Directive .

compl:NIS2_Art23 rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "NIS2 Artikel 23: Meldingsverplichtingen"@nl ;
    rdfs:label "NIS2 Article 23: Reporting obligations"@en ;
    compl:articleRef "art. 23" ;
    compl:requirementText "Essentiële en belangrijke entiteiten melden incidenten met een aanzienlijke impact aan de CSIRT of bevoegde autoriteit."@nl ;
    compl:requirementText "Essential and important entities shall notify incidents with significant impact to the CSIRT or competent authority."@en ;
    compl:derivedFrom fw:NIS2_Directive .

compl:NIS2_Art24 rdf:type ext:NIS2Requirement , owl:NamedIndividual ;
    rdfs:label "NIS2 Artikel 24: Verplichtingen certificering essentiële entiteiten"@nl ;
    rdfs:label "NIS2 Article 24: Certification obligations essential entities"@en ;
    compl:articleRef "art. 24" ;
    compl:requirementText "Essentiële entiteiten moeten gecertificeerde ICT-producten diensten of processen gebruiken waar vereist."@nl ;
    compl:requirementText "Essential entities shall use certified ICT products, services or processes where required."@en ;
    compl:derivedFrom fw:NIS2_Directive .


# --- NIS2 art.21 individuals + SKOS mappings (oorspronkelijk FIX sectie) ---
# ── NIS2 art.21 artikel-individuals ─────────────────────────────────────

compl:NIS2_Art21_a rdf:type compl:RegulatoryObligation , owl:NamedIndividual ;
    rdfs:label "NIS2 art.21(2)(a) — Risicoanalyse en beveiliging informatiesystemen"@nl ,
               "NIS2 art.21(2)(a) — Risk analysis and information system security policies"@en ;
    compl:derivedFrom fw:NIS2_Directive ;
    compl:derivedFrom fw:CBW ;
    compl:articleRef "art. 21, lid 2, onderdeel a"^^xsd:string ;
    compl:responsibleRole roles:R_CISO .

compl:NIS2_Art21_b rdf:type compl:RegulatoryObligation , owl:NamedIndividual ;
