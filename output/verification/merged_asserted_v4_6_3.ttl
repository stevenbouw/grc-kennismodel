fw:COSO a fw:IssuingBody ;
    rdfs:label "COSO (Committee of Sponsoring Organizations of the Treadway Commission)"@en,
        "COSO (Committee of Sponsoring Organizations of the Treadway Commission)"@nl ;
    rdfs:comment "COSO is a joint initiative of five private-sector organisations dedicated to providing thought leadership through the development of comprehensive frameworks for enterprise risk management, internal control, and fraud deterrence."@en,
        "COSO is een gezamenlijk initiatief van vijf private-sector organisaties gericht op thought leadership door de ontwikkeling van frameworks voor enterprise risk management, interne beheersing en fraudepreventie."@nl ;
    foaf:name "COSO" .

fw:DomainBusinessContinuity a fw:FrameworkDomain ;
    rdfs:label "Business Continuity"@en,
        "Bedrijfscontinuïteit"@nl .

fw:DomainPrivacy a fw:FrameworkDomain ;
    rdfs:label "Privacy"@en,
        "Privacy"@nl .

fw:GovernmentBaseline a owl:Class ;
    rdfs:label "Government Security Baseline"@en,
        "Overheidsbaseline beveiliging"@nl ;
    rdfs:comment "A mandatory minimum security baseline mandated for a government sector."@en,
        "Een verplichte minimale beveiligingsbaseline, voorgeschreven voor een overheidssector."@nl ;
    rdfs:subClassOf fw:NationalStandard .

isms:ASSET_001 a isms:PrimaryAsset ;
    isms:assetID "AST-001" ;
    isms:assetName "Persoonsgegevens burgers (BSN-register)"@nl ;
    isms:availabilityValue 3 ;
    isms:confidentialityValue 3 ;
    isms:hasClassification isms:CL_Vertrouwelijk ;
    isms:inScopeOf isms:SCOPE_Hoofdorganisatie ;
    isms:integrityValue 3 ;
    isms:linkedToRisk risk:R_001,
        risk:R_003 ;
    isms:ownedBy roles:R_Proceseigenaar .

isms:ASSET_002 a isms:PrimaryAsset ;
    isms:assetID "AST-002" ;
    isms:assetName "Financiële administratiesystemen"@nl ;
    isms:availabilityValue 2 ;
    isms:confidentialityValue 3 ;
    isms:hasClassification isms:CL_Vertrouwelijk ;
    isms:inScopeOf isms:SCOPE_Hoofdorganisatie ;
    isms:integrityValue 3 ;
    isms:linkedToRisk risk:R_002 ;
    isms:ownedBy roles:R_Proceseigenaar .

isms:CL_Intern a isms:InformationClassificationLevel ;
    rdfs:label "Internal"@en,
        "Intern"@nl ;
    rdfs:comment "Information for internal use; not intended for external distribution. VIR 2007."@en,
        "Informatie voor intern gebruik; niet bedoeld voor externe verspreiding. VIR 2007."@nl .

isms:PDCACycle a owl:Class ;
    rdfs:label "PDCA Cycle"@en,
        "PDCA-cyclus"@nl ;
    rdfs:comment "An instance of the Plan-Do-Check-Act improvement cycle as applied to the ISMS."@en,
        "Een instantie van de Plan-Do-Check-Act-verbeteringscyclus zoals toegepast op het ISMS."@nl .

isms:TopLevelPolicy a owl:Class ;
    rdfs:label "Top-Level Information Security Policy"@en,
        "Overkoepelend informatiebeveiligingsbeleid"@nl ;
    rdfs:comment "The single top-level IB policy approved by senior management. [ISO 27001:2022 Cl.5.2 / ISO 27002:2022 §5.1]"@en,
        "Het overkoepelende IB-beleid goedgekeurd door het topmanagement. [ISO 27001:2022 Cl.5.2 / ISO 27002:2022 §5.1]"@nl ;
    rdfs:subClassOf isms:Policy .

risk:EnvironmentalThreatSource a owl:Class ;
    rdfs:label "Environmental Threat Source"@en,
        "Omgevingsdreigingsbron"@nl ;
    rdfs:comment "Threat source arising from natural disasters, infrastructure failures, or other environmental events."@en,
        "Dreigingsbron voortkomend uit natuurrampen, infrastructuurstoringen of andere omgevingsgebeurtenissen."@nl ;
    rdfs:subClassOf risk:ThreatSource .

risk:IC_Availability a risk:ImpactCategory ;
    rdfs:label "Availability impact"@en,
        "Beschikbaarheidsimpact"@nl .

risk:IC_Confidentiality a risk:ImpactCategory ;
    rdfs:label "Confidentiality impact"@en,
        "Vertrouwelijkheidsimpact"@nl .

risk:IC_Legal a risk:ImpactCategory ;
    rdfs:label "Legal / compliance impact"@en,
        "Juridische / compliance-impact"@nl .

risk:IC_Reputational a risk:ImpactCategory ;
    rdfs:label "Reputational impact"@en,
        "Reputatie-impact"@nl .

risk:TS_Negligent a risk:HumanThreatSource ;
    rdfs:label "Negligent employee"@en,
        "Nalatige medewerker"@nl .

risk:T_DataLeak a risk:Threat ;
    rdfs:label "Data leak / disclosure"@en,
        "Datalek / openbaarmaking"@nl ;
    risk:originatesFrom risk:TS_Cybercriminal,
        risk:TS_Insider,
        risk:TS_Negligent ;
    risk:threatens risk:InformationAsset .

risk:T_NaturalHazard a risk:Threat ;
    rdfs:label "Natural hazard (flood, fire, storm)"@en,
        "Natuurlijk gevaar (overstroming, brand, storm)"@nl ;
    risk:originatesFrom risk:TS_NaturalDisaster ;
    risk:threatens risk:PhysicalAsset,
        risk:SystemAsset .

risk:T_Phishing a risk:Threat ;
    rdfs:label "Phishing / social engineering"@en,
        "Phishing / social engineering"@nl ;
    risk:originatesFrom risk:TS_Cybercriminal,
        risk:TS_NationState ;
    risk:threatens risk:HumanAsset,
        risk:InformationAsset .

risk:TechnicalThreatSource a owl:Class ;
    rdfs:label "Technical Threat Source"@en,
        "Technische dreigingsbron"@nl ;
    rdfs:comment "Threat source arising from hardware or software failures, configuration errors or technical vulnerabilities."@en,
        "Dreigingsbron voortkomend uit hardware- of softwarefouten, configuratiefouten of technische kwetsbaarheden."@nl ;
    rdfs:subClassOf risk:ThreatSource .

risk:Tier2_MissionBusinessProcess a owl:NamedIndividual,
        risk:RiskManagementTier ;
    rdfs:label "Tier 2 — Mission/Business Process"@en,
        "Tier 2 — Missie/Bedrijfsproces"@nl ;
    rdfs:comment "Addresses risk from a mission/business process perspective. Focuses on enterprise architecture, information flows between systems, and the prioritisation of missions/business functions."@en,
        "Adresseert risico vanuit missie-/bedrijfsprocesperspectief. Richt zich op enterprise-architectuur, informatiestromen tussen systemen en prioritering van missies/bedrijfsfuncties."@nl .

risk:Tier3_InformationSystem a owl:NamedIndividual,
        risk:RiskManagementTier ;
    rdfs:label "Tier 3 — Information System"@en,
        "Tier 3 — Informatiesysteem"@nl ;
    rdfs:comment "Addresses risk from an information system perspective. Focuses on system-specific risk assessments, security categorisation, control selection and implementation."@en,
        "Adresseert risico vanuit informatiesysteemperspectief. Richt zich op systeemspecifieke risicobeoordelingen, beveiligingscategorisatie, controleselectie en -implementatie."@nl .

roles:R_BVC a owl:NamedIndividual,
        roles:BVC ;
    rdfs:label "Security Coordinator (BVC)"@en,
        "Beveiligingscoördinator (BVC)"@nl ;
    roles:hasRoleDescription "Coördineert en bewaakt de informatiebeveiliging binnen een dienstonderdeel. Rapporteert functioneel aan de BVA. Aanspreekpunt voor IB-zaken op dienst-niveau. Grondslag: Besluit BVA-stelsel Rijksdienst 2021, art. 6."@nl ;
    roles:hasRoleID "BVC-01" ;
    roles:hasRoleTitle "Security Coordinator (BVC)"@en,
        "Beveiligingscoördinator (BVC)"@nl ;
    roles:isConsultedFor "Risicobeoordelingen, incidentrespons, leveranciersbeoordeling"@nl ;
    roles:isInformedAbout "Strategisch IB-beleid, ISMS-scope, NIS2-meldingen"@nl ;
    roles:isMandatoryUnderDutchLaw true ;
    roles:isResponsibleFor "IB-beleid en maatregelen dienstonderdeel"@nl ;
    roles:mandatedBy fw:BesluitBVAStelsel ;
    roles:reportsTo roles:R_BVA .

roles:R_InternAuditor a roles:AuditRole ;
    skos:closeMatch fw:ISO_IEC_27001_2022 ;
    roles:hasRoleDescription "Uitvoering van interne audits op het ISMS conform ISO 27001:2022 §9.2. Functioneel onafhankelijk van de geauditeerde processen."@nl ;
