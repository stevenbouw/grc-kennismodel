    csf:exemplifies csf:RS_CO_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_CO_03_Ex3 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.CO-03.Ex3"@en,
        "RS.CO-03.Ex3"@nl ;
    rdfs:comment "Notify HR when malicious insider activity occurs"@en ;
    csf:csfIdentifier "RS.CO-03.Ex3" ;
    csf:exemplifies csf:RS_CO_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_CO_03_Ex4 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.CO-03.Ex4"@en,
        "RS.CO-03.Ex4"@nl ;
