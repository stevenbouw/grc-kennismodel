    bio:bioMaatregelNummer "5.34.2" ;
    bio:hasMaatregel "Organisaties controleren regelmatig de naleving van de privacyregels en informatieverwerking en -procedures binnen hun verantwoordelijkheidsgebied aan de hand van de desbetreffende beleidsregels, normen en andere eisen betreffende beveiliging." ;
    bio:implementsControl bio:ISO27002_5_34 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_35_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
