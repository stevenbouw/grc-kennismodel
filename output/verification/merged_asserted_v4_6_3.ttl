Dienstenleverancier""" ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasCbbArticle "art. 8" ;
    ext:hasCbwArticle "art. 21 lid b" ;
    ext:hasHandreikingBBN 1 .

ctrl:Technologisch a ctrl:ControlTheme ;
    rdfs:label "Technological"@en,
        "Technologisch"@nl .

risk:Risk a owl:Class ;
    rdfs:label "Risk"@en,
        "Risico"@nl ;
    rdfs:comment "The effect of uncertainty on objectives. A risk is characterised by its sources (threats/vulnerabilities), likelihood, and potential consequences (impact)."@en,
        "Het effect van onzekerheid op doelstellingen. Een risico wordt gekenmerkt door zijn bronnen (dreigingen/kwetsbaarheden), waarschijnlijkheid en mogelijke gevolgen (impact)."@nl ;
    skos:broadMatch fw:COSO_ERM,
        fw:ISO_31000_2018 ;
    prov:wasDerivedFrom fw:COSO_ERM,
        fw:ISO_31000_2018 .

bio:ISO27002_5_19 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Informatiebeveiliging in leveranciersrelaties"@nl ;
    rdfs:comment "Er behoren processen en procedures te worden vastgesteld en geïmplementeerd om de informatiebeveiligingsrisico’s in verband met het gebruik van producten of diensten van de leverancier te beheersen."@nl ;
