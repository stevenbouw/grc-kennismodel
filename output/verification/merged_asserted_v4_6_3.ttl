fw:Cbb a owl:NamedIndividual,
        fw:NationalLaw ;
    rdfs:label "Cyberbeveiligingsbesluit (Cybersecurity Decree)"@en,
        "Cyberbeveiligingsbesluit (Cbb)"@nl ;
    rdfs:comment "General administrative order (AMvB) implementing the Cyberbeveiligingswet (CBW). Chapter 4 (Duty of Care) contains 14 substantive duty-of-care articles (art. 6 to 19) that operationally elaborate the NIS2 art. 21 measures for essential and important entities. Art. 18 contains a separate ministerial competence (supplier exclusion order). Status May 2026: concept for the House of Representatives, not yet adopted; entry into force by royal decree."@en,
        "Algemene maatregel van bestuur (AMvB) ter uitvoering van de Cyberbeveiligingswet (CBW). Bevat onder hoofdstuk 4 (Zorgplicht) 14 inhoudelijke zorgplichtartikelen (art. 6 t/m 19) die de NIS2-art. 21-maatregelen operationeel uitwerken voor essentiële en belangrijke entiteiten. Art. 18 bevat een aparte ministeriële bevoegdheid (supplier-exclusion-order). Stand mei 2026: concept t.b.v. Tweede Kamer, nog niet vastgesteld; inwerkingtreding bij koninklijk besluit."@nl ;
    skos:altLabel "Cyberbeveiligingsbesluit"@nl ;
    prov:wasDerivedFrom fw:CBW ;
    fw:appliesInJurisdiction fw:JurisdictionNL ;
    fw:hasDomain fw:DomainCybersecurity ;
    fw:hasIdentifier "NL-Cbb" ;
    fw:isMandatoryForDutchGovernment true ;
    fw:issuedBy fw:DutchCentral ;
    fw:status "concept for the House of Representatives, not yet adopted"@en,
        "concept t.b.v. Tweede Kamer, nog niet vastgesteld"@nl ;
    fw:werktUit fw:CBW .

asset:Procedure a owl:Class ;
