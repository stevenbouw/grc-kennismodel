    csf:csfIdentifier "RS.AN-03.Ex2" ;
    csf:exemplifies csf:RS_AN_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_AN_03_Ex3 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.AN-03.Ex3"@en,
        "RS.AN-03.Ex3"@nl ;
