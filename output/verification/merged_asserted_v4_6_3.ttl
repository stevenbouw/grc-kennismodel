        asset:Procedure ;
    bio:bioMaatregelNummer "7.10.5" ;
    bio:hasMaatregel "Verwijdering vindt plaats op een veilige manier, bijvoorbeeld door verbranding of versnippering. Verwijdering van alleen gegevens is ook mogelijk door het wissen van de gegevens voordat de media worden gebruikt voor een andere toepassing in de organisatie." ;
    bio:implementsControl bio:ISO27002_7_10 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_7_10_6 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 7.10.6"@nl ;
    asset:appliesToAssetType asset:Equipment,
        asset:InformationAsset,
        asset:Procedure ;
    bio:bioMaatregelNummer "7.10.6" ;
    bio:hasMaatregel "Voor het wissen van alle data op het medium, wordt de data onherstelbaar verwijderd, bijvoorbeeld door minimaal twee keer te overschrijven met vaste data en één keer met random data. Er wordt gecontroleerd of alle data onherstelbaar verwijderd is en er wordt verslag van gemaakt." ;
    bio:implementsControl bio:ISO27002_7_10 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_7_14_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 7.14.1"@nl ;
    asset:appliesToAssetType asset:Equipment,
        asset:InformationAsset ;
    bio:bioMaatregelNummer "7.14.1" ;
    bio:hasMaatregel "Zie overheidsmaatregelen van 7.10 (7.10.2, 7.10.5 en 7.10.6)." ;
    bio:implementsControl bio:ISO27002_7_14 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_01_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.01.1"@nl ;
    asset:appliesToAssetType asset:Equipment,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.01.1" ;
    bio:hasMaatregel "Mobiele apparatuur is zo ingericht dat bedrijfsinformatie niet onbewust wordt opgeslagen (‘zero footprint’). Als zero footprint (nog) niet realiseerbaar is, biedt een mobiel apparaat (zoals een laptop, tablet en smartphone) de mogelijkheid om de toegang te beschermen door middel van een toegangsbeveiligingsmechanisme en, indien vertrouwelijke gegevens worden opgeslagen, versleuteling van die gegevens. In het geval van opslag van vertrouwelijke informatie moet op deze mobiele apparatuur ‘wissen o" ;
    bio:implementsControl bio:ISO27002_8_01 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_01_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.01.2"@nl ;
    asset:appliesToAssetType asset:Equipment,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.01.2" ;
    bio:hasMaatregel """Bij de inzet van mobiele apparatuur zijn minimaal de volgende aspecten geïmplementeerd:
(a) In bewustwordingsprogramma’s komen gedragsaspecten van veilig mobiel werken aan de orde. 
(b) Het apparaat maakt deel uit van patchmanagement en hardening.
(c) Er wordt gebruik gemaakt van Mobile Device Management (MDM) of van Mobile Application Management (MAM)-oplossingen. 
(d) Gebruikers tekenen een gebruikersovereenkomst voor mobiel werken, waarmee zij verklaren zich bewust te zijn van de gevaren """ ;
    bio:implementsControl bio:ISO27002_8_01 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_02_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.02.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.02.1" ;
    bio:hasMaatregel "De uitgegeven speciale bevoegdheden worden minimaal ieder kwartaal beoordeeld." ;
    bio:implementsControl bio:ISO27002_8_02 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_03_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.03.1"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.03.1" ;
    bio:hasMaatregel "Er zijn maatregelen genomen die het fysiek en/of logisch isoleren van informatie met specifiek belang waarborgen." ;
    bio:implementsControl bio:ISO27002_8_03 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_03_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.03.2"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.03.2" ;
    bio:hasMaatregel "Gebruikers kunnen alleen die informatie met specifiek belang inzien en verwerken die ze nodig hebben voor de uitoefening van hun taak." ;
    bio:implementsControl bio:ISO27002_8_03 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_05_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.05.1"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:HumanAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.05.1" ;
    bio:hasMaatregel "Als vanuit een onvertrouwde zone toegang wordt verleend naar een vertrouwde zone, gebeurt dit alleen op basis van minimaal tweefactor-authenticatie." ;
    bio:implementsControl bio:ISO27002_8_05 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_05_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.05.2"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.05.2" ;
    bio:hasMaatregel "Voor het verlenen van toegang tot het netwerk aan externe leveranciers wordt vooraf een risicoafweging gemaakt. De risicoafweging bepaalt onder welke voorwaarden de leveranciers toegang krijgen. Uit een registratie blijkt hoe de rechten zijn toegekend." ;
    bio:implementsControl bio:ISO27002_8_05 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_07_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.07.1"@nl ;
    asset:appliesToAssetType asset:InformationSystem ;
    bio:bioMaatregelNummer "8.07.1" ;
    bio:hasMaatregel "Het downloaden van bestanden is beheerst en beperkt op basis van risico en need-of-use." ;
    bio:implementsControl bio:ISO27002_8_07 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_07_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.07.2"@nl ;
    asset:appliesToAssetType asset:InformationSystem ;
    bio:bioMaatregelNummer "8.07.2" ;
    bio:hasMaatregel "Gebruikers zijn voorgelicht over de risico’s ten aanzien van surfgedrag en het klikken op onbekende links." ;
    bio:implementsControl bio:ISO27002_8_07 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_07_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.07.3"@nl ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.07.3" ;
    bio:hasMaatregel "De gebruikte antimalwaresoftware en bijbehorende herstelsoftware is actueel en wordt ondersteund door periodieke updates." ;
    bio:implementsControl bio:ISO27002_8_07 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_07_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.07.4"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.07.4" ;
    bio:hasMaatregel """De malwarescan wordt uitgevoerd op: 
(a) alle omgevingen, bijvoorbeeld op mailservers, (desktop)computers en bij de toegangsverlening tot het netwerk van de organisatie;
(b) alle gedownloade content voorafgaand aan executie of opslag;
(c) alle bestanden die via netwerken of via elke vorm van opslagmedium zijn ontvangen, vóór gebruik of opslag in de eigen omgeving.""" ;
    bio:implementsControl bio:ISO27002_8_07 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.08.1"@nl ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.1" ;
    bio:hasMaatregel "Als de kans op misbruik en de verwachte schade beide hoog zijn (bijvoorbeeld met de NCSC-Inschalingsmatrix beveiligingsadviezen of leveranciersbeveiligingsadviezen), worden passende mitigerende maatregelen zo snel mogelijk, maar uiterlijk binnen een week getroffen." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.08.2"@nl ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.2" ;
    bio:hasMaatregel "Op basis van een expliciete risicoafweging wordt bepaald op welke wijze mitigerende maatregelen getroffen worden." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.08.3"@nl ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.3" ;
    bio:hasMaatregel "In de tussentijd of als installatie binnen een week niet mogelijk is, worden op basis van een expliciete risicoafweging mitigerende maatregelen getroffen." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.08.4"@nl ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.4" ;
    bio:hasMaatregel "Informatiesystemen worden bij voorkeur jaarlijks gecontroleerd op technische naleving van beveiligingsnormen en risico’s ten aanzien van de feitelijke veiligheid. Dit kan bijvoorbeeld door (geautomatiseerde) kwetsbaarheidsanalyses, penetratietesten of red-teamingstesten." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.08.5"@nl ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.5" ;
    bio:hasMaatregel "Internetfacing-systemen hebben een verplichte (bij voorkeur geautomatiseerde) penetratietest bij iedere nieuwe release of major update. Als daar bevindingen met een hoog risico uitkomen, mag het systeem niet in productie." ;
    bio:implementsControl bio:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_13_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.13.1"@nl ;
    asset:appliesToAssetType asset:InformationAsset ;
    bio:bioMaatregelNummer "8.13.1" ;
    bio:hasMaatregel "Er is een back-upbeleid waarin de eisen voor het bewaren en beschermen zijn gedefinieerd en vastgesteld. Er moet speciale aandacht zijn voor het beschermen van de back-up tegen ransomware-aanvallen." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_13_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.13.2"@nl ;
    asset:appliesToAssetType asset:InformationAsset ;
    bio:bioMaatregelNummer "8.13.2" ;
    bio:hasMaatregel "Op basis van een expliciete risicoafweging is bepaald wat het maximaal toegestane dataverlies is en wat de maximale hersteltijd is na een incident." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_13_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.13.3"@nl ;
    asset:appliesToAssetType asset:InformationAsset ;
    bio:bioMaatregelNummer "8.13.3" ;
    bio:hasMaatregel """In het back-upbeleid staan minimaal de volgende eisen:
(a) Dataverlies bedraagt maximaal 28 uur.
(b) Hersteltijd in geval van incidenten is maximaal 16 werkuren (2 dagen van 8 uur) in 85% van de gevallen.""" ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_13_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.13.4"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:PhysicalObject ;
    bio:bioMaatregelNummer "8.13.4" ;
    bio:hasMaatregel "Het back-upproces voorziet in opslag van de back-up op een locatie, waarbij een incident op de ene locatie niet kan leiden tot schade op de andere." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_13_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.13.5"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:StorageFacility ;
    bio:bioMaatregelNummer "8.13.5" ;
    bio:hasMaatregel "Zorg dat ten minste één back-up niet online benaderbaar is en beschermd wordt tegen veranderingen." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_13_6 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.13.6"@nl ;
    asset:appliesToAssetType asset:InformationAsset ;
    bio:bioMaatregelNummer "8.13.6" ;
    bio:hasMaatregel "De herstelprocedure wordt minimaal jaarlijks getest of na een grote wijziging, om de goede werking te waarborgen als deze in noodgevallen uitgevoerd moet worden." ;
    bio:implementsControl bio:ISO27002_8_13 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_15_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.15.1"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.15.1" ;
    bio:hasMaatregel """Een logregel bevat minimaal:
(a) de gebeurtenis;
(b) de benodigde informatie die nodig is om het incident met hoge mate van zekerheid te herleiden tot een natuurlijk persoon; 
(c) het gebruikte apparaat;
(d) het resultaat van de handeling;
(e) een datum en tijdstip van de gebeurtenis.""" ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_15_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.15.2"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.15.2" ;
    bio:hasMaatregel "Een logregel bevat in geen geval gegevens die tot het doorbreken van de beveiliging kunnen leiden." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_15_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.15.3"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.15.3" ;
    bio:hasMaatregel "Er is een overzicht van logbestanden die worden gegenereerd." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_15_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.15.4"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.15.4" ;
    bio:hasMaatregel "Ten behoeve van de loganalyse is op basis van een expliciete risicoafweging de bewaarperiode van de logging bepaald. Binnen deze periode is de beschikbaarheid van de loginformatie gewaarborgd." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_15_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.15.5"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.15.5" ;
    bio:hasMaatregel "Oneigenlijk wijzigen, verwijderen of pogingen daartoe van loggegevens worden zo snel mogelijk gemeld als beveiligingsincident via de procedure voor informatiebeveiligingsincidenten conform control 5.24." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_15_6 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.15.6"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.15.6" ;
    bio:hasMaatregel "Minimaal halfjaarlijks wordt door een onafhankelijke functionaris (ten opzichte van de uitvoering) getoetst op het ongewijzigd bestaan van logbestanden gedurende de bewaartermijn." ;
    bio:implementsControl bio:ISO27002_8_15 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_16_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.16.1"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.16.1" ;
    bio:hasMaatregel "De informatieverwerkende omgeving wordt gemonitord met een detectie- en response-oplossing, waarmee aanvallen kunnen worden gedetecteerd en afwijkingen worden adequaat en tijdig behandeld." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_16_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.16.2"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.16.2" ;
    bio:hasMaatregel "Actieve netwerkcomponenten zijn voorzien van logging en monitoring van die logging om afwijkende gebeurtenissen te kunnen waarnemen en daarop te reageren." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_16_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.16.3"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.16.3" ;
    bio:hasMaatregel "Een risicoafweging bepaalt de bewaartermijn van de logging." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_16_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.16.4"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "8.16.4" ;
    bio:hasMaatregel "Bij ontdekte nieuwe dreigingen (aanvallen) via 8.16.1 worden deze binnen geldende juridische kaders verplicht gedeeld binnen de overheid, waaronder met het NCSC (alleen voor rijksoverheidsorganisaties) of via de sectorale CERT (voor andere overheidsorganisaties), middels (bij voorkeur geautomatiseerde) threat intelligence sharing mechanismen." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_16_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.16.5"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.16.5" ;
    bio:hasMaatregel "De SIEM en/of SOC hebben heldere regels over wanneer een incident moet worden gerapporteerd aan het verantwoordelijk management." ;
    bio:implementsControl bio:ISO27002_8_16 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_18_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.18.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.18.1" ;
    bio:hasMaatregel "Alleen bevoegd personeel heeft toegang tot systeemhulpmiddelen." ;
    bio:implementsControl bio:ISO27002_8_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_18_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.18.2"@nl ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Procedure,
        asset:Software ;
    bio:bioMaatregelNummer "8.18.2" ;
    bio:hasMaatregel "Het gebruik van systeemhulpmiddelen wordt gelogd. De logging is een halfjaar beschikbaar voor onderzoek." ;
    bio:implementsControl bio:ISO27002_8_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_19_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.19.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.19.1" ;
    bio:hasMaatregel "Gebruikers kunnen op hun werkomgeving niets zelf installeren, anders dan wat via de ICT-leverancier wordt aangeboden of wordt toegestaan (whitelist)." ;
    bio:implementsControl bio:ISO27002_8_19 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_21_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.21.1"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:Software ;
    bio:bioMaatregelNummer "8.21.1" ;
    bio:hasMaatregel "In koppelpunten met externe of onvertrouwde zones zijn maatregelen getroffen om mogelijke aanvallen die de beschikbaarheid van de informatievoorziening negatief beïnvloeden (bijvoorbeeld DDoS-aanvallen, Distributed Denial of Service attacks) te signaleren en hierop te reageren." ;
    bio:implementsControl bio:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_21_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.21.2"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:Software ;
    bio:bioMaatregelNummer "8.21.2" ;
    bio:hasMaatregel "Het dataverkeer dat de organisatie binnenkomt of uitgaat, wordt bewaakt/geanalyseerd op kwaadaardige elementen middels detectievoorzieningen (zoals beschreven in de richtlijn voor implementatie van detectieoplossingen), zoals het Nationaal Detectie Netwerk (alleen voor rijksoverheidsorganisaties) of GDI, die worden ingezet op basis van een risicoafweging, mede aan de hand van de aard van de te beschermen gegevens en informatiesystemen." ;
    bio:implementsControl bio:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_21_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.21.3"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility ;
    bio:bioMaatregelNummer "8.21.3" ;
    bio:hasMaatregel "Bij ontdekte nieuwe dreigingen vanuit 8.21.2 worden deze, rekening houdend met de geldende juridische kaders, verplicht gedeeld binnen de overheid, waaronder met het NCSC (alleen voor rijksoverheidsorganisaties) of de sectorale CERT, bij voorkeur door geautomatiseerde mechanismen (threat intelligence sharing)." ;
    bio:implementsControl bio:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_21_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.21.4"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:Software ;
    bio:bioMaatregelNummer "8.21.4" ;
    bio:hasMaatregel "Bij draadloze verbindingen zoals wifi en bij bedrade verbindingen buiten het gecontroleerd gebied wordt gebruik gemaakt van encryptiemiddelen waarvoor het Nationaal Bureau voor Verbindingsbeveiliging (NBV) een positief inzetadvies heeft afgegeven." ;
    bio:implementsControl bio:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_22_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.22.1"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility ;
    bio:bioMaatregelNummer "8.22.1" ;
    bio:hasMaatregel "Alle gescheiden groepen hebben een gedefinieerd beveiligingsniveau." ;
    bio:implementsControl bio:ISO27002_8_22 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_24_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.24.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "8.24.1" ;
    bio:hasMaatregel """In het cryptografiebeleid zijn minimaal de volgende onderwerpen uitgewerkt: 
(a) Wanneer cryptografie ingezet wordt. 
(b) Wie verantwoordelijk is voor de implementatie.
(c) Wie verantwoordelijk is voor het sleutelbeheer. 
(d) Welke normen als basis dienen voor cryptografie en de wijze waarop de normen van het Forum Standaardisatie worden toegepast. 
(e) De wijze waarop het beschermingsniveau vastgesteld wordt. 
(f) Bij communicatie tussen organisaties wordt het beleid onderling vastgesteld""" ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_24_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.24.2"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "8.24.2" ;
    bio:hasMaatregel "Cryptografische toepassingen voldoen aan passende standaarden van het Forum Standaardisatie." ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_24_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.24.3"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "8.24.3" ;
    bio:hasMaatregel "De sterkte van de cryptografie wordt waar mogelijk gebaseerd op de actuele adviezen van het NCSC." ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_24_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.24.4"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "8.24.4" ;
    bio:hasMaatregel "In geval van PKIoverheid-certificaten hanteer de PKIoverheid-eisen ten aanzien van het sleutelbeheer. In overige situaties hanteer de norm ISO 11770-1 voor het beheer van cryptografische sleutels." ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_24_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.24.5"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "8.24.5" ;
    bio:hasMaatregel "Er zijn (contractuele) afspraken over reservecertificaten van een alternatieve leverancier als uit risicoafweging blijkt dat deze noodzakelijk zijn." ;
    bio:implementsControl bio:ISO27002_8_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_25_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 8.25.1"@nl ;
    asset:appliesToAssetType asset:Software ;
    bio:bioMaatregelNummer "8.25.1" ;
    bio:hasMaatregel "De gangbare principes rondom ‘security by design’ zijn uitgangspunt voor de ontwikkeling van software en systemen." ;
    bio:implementsControl bio:ISO27002_8_25 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

