    rdfs:domain biz:PerformanceIndicator ;
    rdfs:range biz:RiskTolerance .

biz:indicatesRisk a owl:ObjectProperty ;
    rdfs:label "indicates risk"@en,
        "geeft risico aan"@nl ;
    rdfs:domain biz:KRI ;
    rdfs:range risk:Risk .

biz:kpiDescription a owl:DatatypeProperty ;
    rdfs:label "KPI/KRI description"@en,
        "KPI/KRI beschrijving"@nl ;
    rdfs:domain biz:PerformanceIndicator ;
    rdfs:range rdfs:Literal .

biz:kpiID a owl:DatatypeProperty ;
    rdfs:label "KPI/KRI ID"@en,
        "KPI/KRI-ID"@nl ;
    rdfs:domain biz:PerformanceIndicator ;
