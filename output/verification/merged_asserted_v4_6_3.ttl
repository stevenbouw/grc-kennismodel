ext:ISO22301_10_1 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 10.1: Nonconformity and corrective action"@en,
        "ISO 22301 10.1: Afwijking en corrigerende maatregel"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "Als er een afwijking optreedt moet de organisatie reageren corrigerende maatregelen nemen en de doeltreffendheid evalueren."@nl ;
    ext:clauseNumber "10.1" .

ext:ISO22301_10_2 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 10.2: Continual improvement"@en,
        "ISO 22301 10.2: Voortdurende verbetering"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet continu de geschiktheid toereikendheid en doeltreffendheid van het BCMS verbeteren."@nl ;
    ext:clauseNumber "10.2" .

ext:ISO22301_4_1 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 4.1: Understanding the organization and its context"@en,
        "ISO 22301 4.1: Inzicht in de organisatie en haar context"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet externe en interne kwesties bepalen die relevant zijn voor haar doel en haar vermogen om de beoogde resultaten van haar BCMS te bereiken."@nl ;
    ext:clauseNumber "4.1" .

ext:ISO22301_4_2 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 4.2: Understanding needs of interested parties"@en,
        "ISO 22301 4.2: Inzicht in de behoeften van belanghebbenden"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet de relevante belanghebbenden bepalen die relevant zijn voor het BCMS en hun relevante eisen en wettelijke verplichtingen."@nl ;
    ext:clauseNumber "4.2" .

ext:ISO22301_4_3 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 4.3: Scope of the BCMS"@en,
        "ISO 22301 4.3: Toepassingsgebied van het BCMS"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet de grenzen en toepasselijkheid van het BCMS bepalen."@nl ;
    ext:clauseNumber "4.3" .

ext:ISO22301_5_1 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 5.1: Leadership and commitment"@en,
        "ISO 22301 5.1: Leiderschap en betrokkenheid"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "Het topmanagement moet blijk geven van leiderschap en betrokkenheid met betrekking tot het BCMS."@nl ;
    ext:clauseNumber "5.1" .

ext:ISO22301_5_2 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 5.2: Policy"@en,
        "ISO 22301 5.2: Beleid"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "Het topmanagement moet een BCM-beleid vaststellen dat past bij het doel van de organisatie."@nl ;
    ext:clauseNumber "5.2" .

ext:ISO22301_6_1 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 6.1: Actions to address risks and opportunities"@en,
        "ISO 22301 6.1: Maatregelen voor risicos en kansen"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet risicos en kansen bepalen die moeten worden behandeld om de beoogde resultaten te bereiken."@nl ;
    ext:clauseNumber "6.1" .

ext:ISO22301_6_2 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 6.2: Business continuity objectives"@en,
        "ISO 22301 6.2: Doelstellingen voor bedrijfscontinuiteit"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet BCM-doelstellingen vaststellen voor relevante functies en niveaus."@nl ;
    ext:clauseNumber "6.2" .

ext:ISO22301_8_1 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 8.1: Operational planning and control"@en,
        "ISO 22301 8.1: Operationele planning en beheersing"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet processen plannen implementeren beheersen en controleren om aan de eisen te voldoen."@nl ;
    ext:clauseNumber "8.1" .

ext:ISO22301_8_2 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 8.2: Business impact analysis and risk assessment"@en,
        "ISO 22301 8.2: Analyse van zakelijke impact en risicobeoordeling"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet een formeel gedocumenteerd proces voor BIA en risicobeoordeling implementeren en onderhouden."@nl ;
    compl:satisfiedBy ctrl:ISO27002_5_07,
        ctrl:ISO27002_5_29 ;
    ext:clauseNumber "8.2" .

ext:ISO22301_8_3 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 8.3: Business continuity strategies and solutions"@en,
        "ISO 22301 8.3: Strategieen en oplossingen voor bedrijfscontinuiteit"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet geschikte strategieen en oplossingen bepalen op basis van de BIA en risicobeoordeling."@nl ;
    compl:satisfiedBy ctrl:ISO27002_5_29,
        ctrl:ISO27002_5_30 ;
    ext:clauseNumber "8.3" .

ext:ISO22301_8_4 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 8.4: Business continuity plans and procedures"@en,
        "ISO 22301 8.4: Plannen en procedures voor bedrijfscontinuiteit"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet plannen en procedures documenteren om de respons op verstoringen te begeleiden."@nl ;
    compl:satisfiedBy ctrl:ISO27002_5_29 ;
    ext:clauseNumber "8.4" .

ext:ISO22301_8_5 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 8.5: Exercise programme"@en,
        "ISO 22301 8.5: Oefenprogramma"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet testen en oefeningen uitvoeren om de BCM-plannen en -procedures te valideren en te verbeteren."@nl ;
    ext:clauseNumber "8.5" .

ext:ISO22301_9_1 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 9.1: Monitoring measurement analysis and evaluation"@en,
        "ISO 22301 9.1: Bewaking meting analyse en evaluatie"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet de geschiktheid en doeltreffendheid van het BCMS bewaken meten analyseren en evalueren."@nl ;
    ext:clauseNumber "9.1" .

ext:ISO22301_9_2 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 9.2: Internal audit"@en,
        "ISO 22301 9.2: Interne audit"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "De organisatie moet interne audits uitvoeren om vast te stellen of het BCMS conform is en doeltreffend wordt geimplementeerd."@nl ;
    compl:satisfiedBy ctrl:ISO27002_5_35 ;
    ext:clauseNumber "9.2" .

ext:ISO22301_9_3 a owl:NamedIndividual,
        ext:BCMRequirement ;
    rdfs:label "ISO 22301 9.3: Management review"@en,
        "ISO 22301 9.3: Directiebeoordeling"@nl ;
    compl:derivedFrom fw:ISO_22301_2019 ;
    compl:requirementText "Het topmanagement moet het BCMS beoordelen om de voortdurende geschiktheid toereikendheid en doeltreffendheid te waarborgen."@nl ;
    ext:clauseNumber "9.3" .

ext:ISO27001_10 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Improvement"@en,
        "Verbetering"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie verbetert voortdurend de geschiktheid, toereikendheid en doeltreffendheid van het ISMS."@nl ;
    ext:alignsWithHSClause ext:HSClause_10_Improvement ;
    ext:clauseNumber "10" .

ext:ISO27001_4 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Understanding the Context of the Organization"@en,
        "Context van de organisatie"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie bepaalt externe en interne kwesties die relevant zijn voor haar doel en die van invloed zijn op haar ISMS."@nl ;
    ext:alignsWithHSClause ext:HSClause_4_Context ;
    ext:clauseNumber "4" .

ext:ISO27001_4_3 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Determining the scope of the ISMS"@en,
        "Toepassingsgebied van het ISMS bepalen"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie bepaalt de grenzen en toepasselijkheid van het ISMS om de reikwijdte ervan vast te stellen."@nl ;
    ext:alignsWithHSClause ext:HSClause_4_Context ;
    ext:clauseNumber "4.3" .

ext:ISO27001_5 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Leadership"@en,
        "Leiderschap"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "Het topmanagement toont leiderschap en betrokkenheid bij het ISMS door middel van beleid, rollen en verantwoordelijkheden."@nl ;
    ext:alignsWithHSClause ext:HSClause_5_Leadership ;
    ext:clauseNumber "5" .

ext:ISO27001_5_1 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Leadership and commitment"@en,
        "Leiderschap en betrokkenheid"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "Het topmanagement geeft blijk van leiderschap en betrokkenheid met betrekking tot het ISMS door een IB-beleid vast te stellen en middelen beschikbaar te stellen."@nl ;
    ext:alignsWithHSClause ext:HSClause_5_Leadership ;
    ext:clauseNumber "5.1" .

ext:ISO27001_6 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Planning"@en,
        "Planning"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie neemt maatregelen voor risicos en kansen en stelt informatiebeveiligingsdoelstellingen vast."@nl ;
    ext:alignsWithHSClause ext:HSClause_6_Planning ;
    ext:clauseNumber "6" .

ext:ISO27001_7 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Support"@en,
        "Ondersteuning"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie stelt de benodigde middelen, competentie, bewustzijn, communicatie en gedocumenteerde informatie beschikbaar."@nl ;
    ext:alignsWithHSClause ext:HSClause_7_Support ;
    ext:clauseNumber "7" .

ext:ISO27001_7_5 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Documented information"@en,
        "Gedocumenteerde informatie"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "Het ISMS bevat gedocumenteerde informatie vereist door deze norm en noodzakelijk voor de doeltreffendheid van het ISMS."@nl ;
    ext:alignsWithHSClause ext:HSClause_7_Support ;
    ext:clauseNumber "7.5" .

ext:ISO27001_7_5_1 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "General"@en,
        "Algemeen"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "Het ISMS van de organisatie bevat alle gedocumenteerde informatie vereist door deze norm en noodzakelijk geacht door de organisatie voor de doeltreffendheid van het ISMS."@nl ;
    ext:alignsWithHSClause ext:HSClause_7_Support ;
    ext:clauseNumber "7.5.1" .

ext:ISO27001_7_5_2 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Creating and updating"@en,
        "Aanmaken en bijwerken"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "Bij het aanmaken en bijwerken van gedocumenteerde informatie zorgt de organisatie voor passende identificatie, beschrijving, format en media, en beoordeling en goedkeuring."@nl ;
    ext:alignsWithHSClause ext:HSClause_7_Support ;
    ext:clauseNumber "7.5.2" ;
    ext:implementedBy ctrl:ISO27002_5_33 .

ext:ISO27001_7_5_3 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Control of documented information"@en,
        "Beheersing van gedocumenteerde informatie"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "Gedocumenteerde informatie vereist door het ISMS en door deze norm wordt beheerd om beschikbaarheid, geschiktheid en adequate bescherming te waarborgen."@nl ;
    ext:alignsWithHSClause ext:HSClause_7_Support ;
    ext:clauseNumber "7.5.3" .

ext:ISO27001_8 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Operation"@en,
        "Uitvoering"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie plant, implementeert, beheerst en beoordeelt de processen nodig om aan de eisen te voldoen."@nl ;
    ext:alignsWithHSClause ext:HSClause_8_Operation ;
    ext:clauseNumber "8" .

ext:ISO27001_9 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Performance evaluation"@en,
        "Prestatie-evaluatie"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie bewaakt, meet, analyseert en evalueert de informatiebeveiliging en het ISMS."@nl ;
    ext:alignsWithHSClause ext:HSClause_9_PerformanceEvaluation ;
    ext:clauseNumber "9" .

ext:ISO27001_9_2_1 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "General"@en,
        "Algemeen"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie voert met geplande tussenpozen interne audits uit om informatie te verkrijgen over conformiteit en doeltreffende implementatie."@nl ;
    ext:alignsWithHSClause ext:HSClause_9_PerformanceEvaluation ;
    ext:clauseNumber "9.2.1" .

ext:ISO27001_9_2_2 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Internal audit programme"@en,
        "Auditprogramma"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie plant, stelt vast, implementeert en onderhoudt een of meer auditprogrammas inclusief frequentie, methoden, verantwoordelijkheden en planning."@nl ;
    ext:alignsWithHSClause ext:HSClause_9_PerformanceEvaluation ;
    ext:clauseNumber "9.2.2" ;
    ext:implementedBy ctrl:ISO27002_5_35 .

ext:ISO27001_9_3_1 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "General"@en,
        "Algemeen"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "Het topmanagement beoordeelt het ISMS van de organisatie met geplande tussenpozen."@nl ;
    ext:alignsWithHSClause ext:HSClause_9_PerformanceEvaluation ;
    ext:clauseNumber "9.3.1" .

ext:ISO27001_9_3_2 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Management review input"@en,
        "Informatie voor de directiebeoordeling"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De directiebeoordeling omvat informatie over de status van acties, wijzigingen in externe en interne kwesties, feedback over prestaties en mogelijkheden voor verbetering."@nl ;
    ext:alignsWithHSClause ext:HSClause_9_PerformanceEvaluation ;
    ext:clauseNumber "9.3.2" .

ext:ISO27001_9_3_3 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Management review results"@en,
        "Resultaten van de directiebeoordeling"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De resultaten van de directiebeoordeling omvatten beslissingen over verbetermogelijkheden en eventuele wijzigingen in het ISMS inclusief gedocumenteerde informatie."@nl ;
    ext:alignsWithHSClause ext:HSClause_9_PerformanceEvaluation ;
    ext:clauseNumber "9.3.3" .

