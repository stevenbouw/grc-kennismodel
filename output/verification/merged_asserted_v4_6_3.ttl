    asset:appliesToAssetType asset:InformationAsset ;
    bio:bioMaatregelNummer "5.27.1" ;
    bio:hasMaatregel "Beveiligingsincidenten worden geanalyseerd met als doel te leren en toekomstige beveiligingsincidenten te voorkomen." ;
    bio:implementsControl bio:ISO27002_5_27 ;
