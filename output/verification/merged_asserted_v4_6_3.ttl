ctrl:hasControlObjective a owl:ObjectProperty ;
    rdfs:label "has control objective"@en,
        "heeft beheersmaatregeldoelstelling"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:ControlObjective .

ctrl:hasControlText a owl:DatatypeProperty ;
    rdfs:label "has control text"@en,
        "heeft beheersmaatregeltekst"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range xsd:string .

ctrl:hasControlTitle a owl:DatatypeProperty ;
