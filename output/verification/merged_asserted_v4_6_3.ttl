@prefix asset: <https://grc.example.org/asset/> .
@prefix bio: <https://grc.example.org/bio/> .
@prefix biz: <https://grc.example.org/business/> .
@prefix compl: <https://grc.example.org/compliance/> .
@prefix csf: <https://grc.example.org/csf/> .
@prefix ctrl: <https://grc.example.org/control/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ext: <https://grc.example.org/extended/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix fw: <https://grc.example.org/framework/> .
@prefix isms: <https://grc.example.org/isms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix risk: <https://grc.example.org/risk/> .
@prefix roles: <https://grc.example.org/roles/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

asset:DataCollection a owl:Class ;
    rdfs:label "Data Collection"@en,
        "Gegevensverzameling"@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" ;
    rdfs:comment "A structured or unstructured collection of data that is part of an information system. Per CIO-stelsel 2026 art. 1o 'gegevensverzameling'."@en,
        "Een gestructureerde of ongestructureerde verzameling gegevens die deel uitmaakt van een informatiesysteem. Per CIO-stelsel 2026 art. 1o 'gegevensverzameling'."@nl ;
    rdfs:subClassOf asset:AssetComponent .

asset:SystemProcess a owl:Class ;
    rdfs:label "System Process"@en,
        "Systeemproces"@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" ;
    rdfs:comment "A process executing within an information system. Per CIO-stelsel 2026 art. 1o 'proces'. Naming 'SystemProcess' (not 'Process') to avoid ambiguity with business-processes (biz:) or risk-processes (risk:)."@en,
        "Een proces dat binnen een informatiesysteem wordt uitgevoerd. Per CIO-stelsel 2026 art. 1o 'proces'. Naamgeving 'SystemProcess' (niet 'Process') om verwarring met bedrijfsprocessen (biz:) of risicoprocessen (risk:) te voorkomen."@nl ;
    rdfs:subClassOf asset:AssetComponent .

asset:hasApplicableControl a owl:ObjectProperty ;
    rdfs:label "has applicable control"@en,
        "heeft toepasselijke beheersmaatregel"@nl ;
    rdfs:comment "Inverse of asset:appliesToAssetType. Enables two-way querying: given an asset-type, find all applicable controls."@en,
        "Inverse van asset:appliesToAssetType. Maakt tweezijdige bevraging mogelijk: gegeven een asset-type, vind alle toepasselijke beheersmaatregelen."@nl ;
    rdfs:domain asset:AssetOrComponent ;
    rdfs:range ctrl:Control ;
    owl:inverseOf asset:appliesToAssetType .

asset:operates a owl:ObjectProperty ;
    rdfs:label "operates"@en,
        "bedient"@nl ;
    rdfs:comment "Inverse of asset:isOperatedBy. Relates a person-asset to information systems they operate."@en,
        "Inverse van asset:isOperatedBy. Koppelt een persoons-bedrijfsmiddel aan de informatiesystemen die zij bedient."@nl ;
    rdfs:domain asset:HumanAsset ;
    rdfs:range asset:InformationSystem ;
    owl:inverseOf asset:isOperatedBy .

bio:bioControlNummer a owl:DatatypeProperty ;
    rdfs:label "BIO controlenummer"@nl ;
    rdfs:domain bio:BIOControl ;
    rdfs:range xsd:string .

bio:bioMaatregelNummer a owl:DatatypeProperty ;
    rdfs:label "BIO maatregelnummer"@nl ;
    rdfs:domain bio:OverheidsMaatregel ;
    rdfs:range xsd:string .

bio:correspondsToISO a owl:ObjectProperty ;
    rdfs:label "correspondeert met ISO 27002 control"@nl ;
    rdfs:domain bio:BIOControl ;
    rdfs:range ctrl:Control .

bio:hasControlType a owl:DatatypeProperty ;
    rdfs:label "heeft controlsoort"@nl ;
    rdfs:domain bio:BIOControl ;
    rdfs:range xsd:string .

bio:hasIBEigenschap a owl:DatatypeProperty ;
    rdfs:label "heeft IB-eigenschap"@nl ;
    rdfs:domain bio:BIOControl ;
    rdfs:range xsd:string .

bio:hasMaatregel a owl:DatatypeProperty ;
    rdfs:label "heeft maatregeltekst"@nl ;
    rdfs:domain bio:OverheidsMaatregel ;
    rdfs:range xsd:string .

bio:hasOverheidsMaatregel a owl:ObjectProperty ;
    rdfs:label "heeft overheidsmaatregel"@nl ;
    rdfs:domain bio:BIOControl ;
    rdfs:range bio:OverheidsMaatregel ;
    owl:inverseOf bio:implementsControl .

bio:hasVerantwoordelijke a owl:DatatypeProperty ;
    rdfs:label "heeft verantwoordelijke"@nl ;
    rdfs:domain bio:BIOControl ;
    rdfs:range xsd:string .

biz:CAL_2026 a biz:ComplianceCalendar ;
    rdfs:label "Compliancekalender 2026"@nl ;
    biz:containsEntry biz:CE_01,
        biz:CE_02,
        biz:CE_03,
        biz:CE_04,
        biz:CE_05,
        biz:CE_06,
        biz:CE_07,
        biz:CE_08 .

biz:CriticalService a owl:Class ;
    rdfs:label "Critical Service"@en,
        "Kritieke dienst"@nl ;
    rdfs:comment "A business service whose disruption would have significant impact on public tasks, safety or trust. Relevant for NIS2 Art.21(c) and ISO 22301 scoping."@en,
        "Een bedrijfsdienst waarvan uitval aanzienlijke impact heeft op publieke taken, veiligheid of vertrouwen. Relevant voor NIS2 Art.21(c) en ISO 22301-scoping."@nl ;
    rdfs:subClassOf biz:BusinessService .

biz:DB_2026 a biz:DirectieBeoordeling ;
    rdfs:label "Directiebeoordeling ISMS – November 2026"@nl ;
    rdfs:comment "Jaarlijkse directiebeoordeling conform ISO 27001:2022 Clausule 9.3. Input: auditbevindingen, KPI-rapportage, risicoregister, wijzigingen in context, NIS2/BIO compliance-status."@nl .

biz:Dashboard_2026_Q1 a biz:GRCDashboard ;
    rdfs:label "GRC Management Dashboard Q1 2026"@nl ;
    biz:aggregates biz:DOM_01,
        biz:DOM_02,
        biz:DOM_03,
        biz:DOM_04,
        biz:DOM_05,
        biz:DOM_06 .

biz:GRCProgramHoofdOrg a biz:GRCProgram ;
    rdfs:label "GRC-programma Hoofdorganisatie"@nl ;
    biz:addressedByISMS isms:ISMS_HoofdOrganisatie ;
    biz:hasRiskAppetite biz:RA_Informatiebeveiliging ;
    biz:supportsObjective biz:SO_01,
        biz:SO_02,
        biz:SO_03,
        biz:SO_04,
        biz:SO_05 .

biz:KPI_03 a biz:KPI ;
    rdfs:label "KPI-03: Bewustzijnstraining voltooiing"@nl ;
    biz:currentValue "72%"^^xsd:string ;
    biz:kpiDescription "Percentage medewerkers dat jaarlijkse IB-bewustzijnstraining heeft voltooid"@nl ;
    biz:kpiID "KPI-03" ;
    biz:measurementFrequency "Jaarlijks"^^xsd:string ;
    biz:targetValue "100%"^^xsd:string .

biz:ML_0 a biz:MaturityLevel ;
    rdfs:label "Level 0 – Incomplete"@en,
        "Niveau 0 – Onvolledig"@nl ;
    rdfs:comment "Geen of nauwelijks aantoonbaar proces aanwezig."@nl ;
    biz:maturityScore 0 .

biz:ML_5 a biz:MaturityLevel ;
    rdfs:label "Level 5 – Optimising"@en,
        "Niveau 5 – Optimaliserend"@nl ;
    rdfs:comment "Continu verbeteren op basis van kwantitatieve procesdata."@nl ;
    biz:maturityScore 5 .

biz:RT_HoogRisico a biz:RiskTolerance ;
    rdfs:label "Tolerantie: Hoog risico – niet acceptabel"@nl ;
    rdfs:comment "Risicoscore 16–25: altijd behandelen. Geen uitzonderingen."@nl .

biz:RT_LaagRisico a biz:RiskTolerance ;
    rdfs:label "Tolerantie: Laag risico – accepteerbaar"@nl ;
    rdfs:comment "Risicoscore 1–6: accepteerbaar; monitoren en jaarlijks herbeoordelen."@nl .

biz:RT_MiddelRisico a biz:RiskTolerance ;
    rdfs:label "Tolerantie: Middel risico – behandelen"@nl ;
    rdfs:comment "Risicoscore 8–15: risicobehandeling vereist; escalatie naar CISO."@nl .

biz:addressedByISMS a owl:ObjectProperty ;
    rdfs:label "addressed by ISMS"@en,
        "geadresseerd door ISMS"@nl ;
    rdfs:domain biz:GRCDomain ;
    rdfs:range isms:ISMS .

biz:aggregates a owl:ObjectProperty ;
    rdfs:label "aggregates"@en,
        "aggregeert"@nl ;
    rdfs:domain biz:GRCDashboard ;
    rdfs:range biz:GRCDomain .

