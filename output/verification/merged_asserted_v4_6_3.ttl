fw:Guideline a owl:Class ;
    rdfs:label "Guideline"@en,
        "Richtlijn"@nl ;
    rdfs:comment "A non-binding document providing guidance on implementation of controls or requirements."@en,
        "Een niet-bindend document dat begeleiding biedt bij de implementatie van maatregelen of eisen."@nl ;
    rdfs:subClassOf fw:GRCFramework ;
    owl:disjointWith fw:BestPractice,
        fw:Regulation,
        fw:Standard .

fw:NIST a fw:IssuingBody ;
    rdfs:label "National Institute of Standards and Technology"@en,
        "Nationaal Instituut voor Normen en Technologie (VS)"@nl ;
    foaf:name "NIST" .

fw:NationalStandard a owl:Class ;
    rdfs:label "National Standard"@en,
        "Nationale norm"@nl ;
    rdfs:comment "A standard issued by a national standards body such as NEN or NIST."@en,
        "Een norm uitgevaardigd door een nationaal normalisatie-instituut zoals NEN of NIST."@nl ;
    rdfs:subClassOf fw:Standard .

isms:MaturityCapability a owl:Class ;
    rdfs:label "Maturity Capability"@en,
        "Volwassenheidscapability"@nl ;
    rdfs:comment "Abstract parent for assessable control capabilities with level progression. Basis for both Cbw duty-of-care topics and ISMS clauses."@en,
        "Abstract parent voor evaluatiebare control-capabilities met niveau-progressie. Basis voor zowel Cbw-zorgplicht-thema's als ISMS-clausules."@nl .

isms:Policy a owl:Class ;
    rdfs:label "Policy"@en,
        "Beleidsdocument"@nl ;
    rdfs:comment "A high-level management direction document. Mandatory for ISO 27001:2022 Clause 5.2."@en,
        "Een hoog-niveau managementrichtlijn. Verplicht conform ISO 27001:2022 Clausule 5.2."@nl ;
    rdfs:subClassOf isms:ISMSDocument .

isms:PrimaryAsset a owl:Class ;
    rdfs:label "Primary Asset"@en,
        "Primair bedrijfsmiddel"@nl ;
    rdfs:comment "Business processes and information that are the primary objects of protection. [ISO/IEC 27005:2022]"@en,
        "Bedrijfsprocessen en informatie die het primaire object van bescherming zijn. [ISO/IEC 27005:2022]"@nl ;
    rdfs:subClassOf isms:InformationAsset .

isms:TopicSpecificPolicy a owl:Class ;
    rdfs:label "Topic-Specific Policy"@en,
        "Onderwerpspecifiek beleid"@nl ;
    rdfs:comment "A subordinate policy covering a specific security topic (e.g. access control, cryptography). [ISO 27002:2022 §5.1]"@en,
        "Een onderliggend beleid voor een specifiek beveiligingsonderwerp (bijv. toegangsbeveiliging, cryptografie). [ISO 27002:2022 §5.1]"@nl ;
    rdfs:subClassOf isms:Policy .

risk:RiskManagementTier a owl:Class ;
    rdfs:label "Risk Management Tier"@en,
        "Risicomanagementniveau"@nl ;
    rdfs:comment "One of three organisational tiers at which risk management activities occur, as defined in NIST SP 800-39: (1) Organisation, (2) Mission/Business Process, (3) Information System."@en,
        "Een van drie organisatieniveaus waarop risicomanagementactiviteiten plaatsvinden, zoals gedefinieerd in NIST SP 800-39: (1) Organisatie, (2) Missie/Bedrijfsproces, (3) Informatiesysteem."@nl ;
    skos:exactMatch fw:NIST_SP_800_39 ;
    prov:wasDerivedFrom fw:NIST_SP_800_39 .

risk:ServiceAsset a owl:Class ;
    rdfs:label "Service Asset"@en,
        "Dienstbedrijfsmiddel"@nl ;
    rdfs:comment "An IT or business service on which the organisation depends."@en,
        "Een IT- of bedrijfsdienst waarvan de organisatie afhankelijk is."@nl ;
    rdfs:subClassOf risk:Asset .

roles:ACT_BewustwordingTraining a roles:GRCActivity ;
    roles:hasActivityID "ACT-15" ;
    roles:hasActivityTitle "Conduct security awareness and training"@en,
        "Beveiligingsbewustwording en training uitvoeren"@nl .

roles:ACT_IncidentMelden a roles:GRCActivity ;
    roles:hasActivityID "ACT-09" ;
    roles:hasActivityTitle "Report information security incident"@en,
        "Informatiebeveiligingsincident melden"@nl .

roles:ACT_RestRisicoAanvaarden a roles:GRCActivity ;
    roles:hasActivityID "ACT-04" ;
    roles:hasActivityTitle "Formally accept residual risk"@en,
        "Restrisico formeel aanvaarden"@nl .

roles:Actor a owl:Class ;
    rdfs:label "Actor"@en,
        "Actor"@nl ;
    rdfs:comment "Any agent (person, organisational unit or external party) that can hold a role within the GRC programme."@en,
        "Elke actor (persoon, organisatorische eenheid of externe partij) die een rol kan hebben binnen het GRC-programma."@nl .

roles:AuditRole a owl:Class ;
    rdfs:label "Audit / Oversight Role"@en,
        "Audit- / toezichtrol"@nl ;
    rdfs:comment "Independent roles providing assurance, audit and oversight."@en,
        "Onafhankelijke rollen die assurance, audit en toezicht bieden."@nl ;
    rdfs:subClassOf roles:Role .

roles:ManagementRole a owl:Class ;
    rdfs:label "Management Role"@en,
        "Managementrol"@nl ;
    rdfs:comment "Roles responsible for implementing and operating GRC processes."@en,
        "Rollen verantwoordelijk voor het implementeren en uitvoeren van GRC-processen."@nl ;
    rdfs:subClassOf roles:Role .

roles:OperationalRole a owl:Class ;
    rdfs:label "Operational Role"@en,
        "Operationele rol"@nl ;
    rdfs:comment "Roles involved in day-to-day execution of security and compliance tasks."@en,
        "Rollen betrokken bij de dagelijkse uitvoering van beveiligings- en compliancetaken."@nl ;
    rdfs:subClassOf roles:Role .

roles:OwnerRole a owl:Class ;
    rdfs:label "Owner Role"@en,
        "Eigenaarsrol"@nl ;
    rdfs:comment "Roles that hold formal ownership and accountability for assets, processes or risks."@en,
        "Rollen die formeel eigenaarschap en verantwoording hebben voor bedrijfsmiddelen, processen of risico's."@nl ;
    rdfs:subClassOf roles:Role .

roles:RACIType a owl:Class ;
    rdfs:label "RACI Type"@en,
        "RACI-type"@nl ;
    rdfs:comment "The type of RACI assignment: Responsible, Accountable, Consulted, Informed."@en,
        "Het type RACI-toewijzing: Responsible, Accountable, Consulted, Informed."@nl .

bio:ISO27002_5_12 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Classificeren van informatie"@nl ;
    rdfs:comment "Informatie behoort te worden geclassificeerd volgens de informatiebeveiligingsbehoeften van de organisatie, op basis van de eisen voor vertrouwelijkheid, integriteit, beschikbaarheid en relevante eisen van belanghebbenden."@nl ;
    bio:bioControlNummer "5.12" ;
    bio:correspondsToISO ctrl:ISO27002_5_12 ;
    bio:hasControlType "Organisatorisch" ;
    bio:hasIBEigenschap """#Vertrouwelijkheid
#Integriteit
#Beschikbaarheid""" ;
    bio:hasOverheidsMaatregel bio:BIO2_5_12_1 ;
    bio:hasVerantwoordelijke "Proceseigenaar" ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:ISO27002_6_05 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Verantwoordelijkheden na beëindiging of wijziging van het dienstverband"@nl ;
    rdfs:comment "Verantwoordelijkheden en taken met betrekking tot informatiebeveiliging die van kracht blijven na beëindiging of wijziging van het dienstverband, behoren te worden gedefinieerd, gehandhaafd en gecommuniceerd aan relevant personeel en andere belangheb"@nl ;
    bio:bioControlNummer "6.05" ;
    bio:correspondsToISO ctrl:ISO27002_6_05 ;
    bio:hasControlType "Mensgericht" ;
    bio:hasIBEigenschap """#Vertrouwelijkheid
#Integriteit
#Beschikbaarheid""" ;
    bio:hasVerantwoordelijke """Secretaris/Algemeen directeur
Proceseigenaar""" ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasCbbArticle "art. 14" ;
    ext:hasCbwArticle "art. 21 lid i" ;
    ext:hasHandreikingBBN 1 .

bio:ISO27002_8_26 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Toepassingsbeveiligingseisen"@nl ;
    rdfs:comment "Er behoren eisen aan de informatiebeveiliging te worden geïdentificeerd, gespecificeerd en goedgekeurd bij het ontwikkelen of aanschaffen van toepassingen."@nl ;
    bio:bioControlNummer "8.26" ;
    bio:correspondsToISO ctrl:ISO27002_8_26 ;
    bio:hasControlType "Technologisch" ;
    bio:hasIBEigenschap """#Vertrouwelijkheid
#Integriteit
#Beschikbaarheid""" ;
    bio:hasOverheidsMaatregel bio:BIO2_8_26_1 ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasCbbArticle "art. 11" ;
    ext:hasCbwArticle "art. 21 lid e" ;
    ext:hasHandreikingBBN 1 .

biz:KRI a owl:Class ;
    rdfs:label "Key Risk Indicator (KRI)"@en,
        "Kritieke risico-indicator (KRI)"@nl ;
    rdfs:comment "A metric used to indicate the likelihood that a risk will exceed the organisation's risk tolerance threshold. [COBIT 2019 / ISO 31000]"@en,
        "Een meting gebruikt om de kans aan te geven dat een risico de risicotolerantiedrempel van de organisatie overschrijdt. [COBIT 2019 / ISO 31000]"@nl ;
    rdfs:subClassOf biz:PerformanceIndicator ;
    skos:relatedMatch ext:COSO_ERM_Performance .

biz:RiskAppetite a owl:Class ;
    rdfs:label "Risk Appetite"@en,
        "Risicobereidheid"@nl ;
    rdfs:comment "The amount and type of risk an organisation is willing to pursue or retain in order to achieve its objectives. [ISO 31000:2018 §3.28 / COBIT 2019]"@en,
        "De hoeveelheid en het soort risico dat een organisatie bereid is na te streven of te behouden om haar doelstellingen te bereiken. [ISO 31000:2018 §3.28 / COBIT 2019]"@nl ;
    skos:closeMatch ext:COSO_ERM_GovernanceCulture ;
    prov:wasDerivedFrom fw:COSO_ERM .

biz:RiskTolerance a owl:Class ;
    rdfs:label "Risk Tolerance"@en,
        "Risicotolerantie"@nl ;
    rdfs:comment "The acceptable variation in outcomes related to specific performance measures. Operationalises risk appetite at process or system level. [ISO 31000:2018]"@en,
        "De aanvaardbare variatie in uitkomsten gerelateerd aan specifieke prestatiemetingen. Maakt risicobereidheid operationeel op proces- of systeemniveau. [ISO 31000:2018]"@nl .

compl:OBL_NIS2_Art23 a compl:LegalObligation ;
    compl:accountableRole roles:R_SecretarisDirecteur ;
    compl:belongsToDomain compl:CD_IncidentManagement ;
    compl:hasArticleReference "Art. 23 NIS2 Directive (EU) 2022/2555" ;
    compl:hasDeadline "24h (early warning) / 72h (notification) / 1 month (final report)" ;
    compl:hasObligationID "NIS2-ART23" ;
    compl:hasObligationTitle "Reporting obligations for significant incidents"@en,
        "Meldingsverplichtingen voor significante incidenten"@nl ;
    compl:isMandatory true ;
    compl:responsibleRole roles:R_CISO ;
    compl:sourcedFromFramework fw:NIS2_Directive .

ctrl:ControlTheme a owl:Class ;
    rdfs:label "Control Theme"@en,
        "Beheersmaatregelthema"@nl ;
    rdfs:comment "The ISO/IEC 27002:2022 thematic category of a control: Organisational, People, Physical or Technological."@en,
        "De thematische categorie van een beheersmaatregel conform ISO/IEC 27002:2022: Organisatorisch, Mensgericht, Fysiek of Technologisch."@nl .

ctrl:ISO27002_5_27 a ctrl:ISO27002Control ;
    rdfs:label "Learning from information security incidents"@en,
        "Leren van informatiebeveiligingsincidenten"@nl ;
    owl:sameAs bio:ISO27002_5_27 ;
    skos:broadMatch compl:NIS2_Art21_b ;
    asset:appliesToAssetType asset:InformationAsset ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "5.27" ;
    ctrl:hasControlTitle "Leren van informatiebeveiligingsincidenten"@nl ;
    ctrl:hasControlType ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Beschermen,
        ctrl:Identificeren ;
    ctrl:hasOperationalCapability ctrl:OC_BeveiligingsgebeurtenissenBeheer ;
    ctrl:hasSecurityDomain ctrl:SD_Verdediging ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Organisatorisch ;
    ctrl:isApplicableInBIO true .

ctrl:SecurityDomain a owl:Class ;
    rdfs:label "Security Domain"@en,
        "Beveiligingsdomein"@nl ;
    rdfs:comment "ISO/IEC 27002:2022 attribute: the security domain a control belongs to. Four values: Governance & Ecosystem, Protection, Defence, Resilience."@en,
        "ISO/IEC 27002:2022-attribuut: het beveiligingsdomein waartoe een beheersmaatregel behoort. Vier waarden: Governance & Ecosysteem, Bescherming, Verdediging, Veerkracht."@nl .

csf:DE_CM_01 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "DE.CM-01"@en ;
    rdfs:comment "Networks and network services are monitored to find potentially adverse events"@en ;
