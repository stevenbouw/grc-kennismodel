    asset:appliesToAssetType asset:InformationAsset ;
    bio:bioMaatregelNummer "5.24.6" ;
    bio:hasMaatregel "Informatie afkomstig uit de Coordinated Vulnerability Disclosure (CVD)-procedure is onderdeel van de incidentrapportage." ;
    bio:implementsControl bio:ISO27002_5_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_25_1 a owl:NamedIndividual,
