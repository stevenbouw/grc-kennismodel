compl:NIS2_Art21_i a owl:NamedIndividual,
        compl:RegulatoryObligation ;
    rdfs:label "NIS2 art.21(2)(i) — Human resources security, access control and asset management"@en,
        "NIS2 art.21(2)(i) — Beveiliging personeel, toegangsbeleid en activabeheer"@nl ;
    compl:articleRef "art. 21, lid 2, onderdeel i"^^xsd:string ;
    compl:derivedFrom fw:CBW,
        fw:NIS2_Directive ;
    compl:responsibleRole roles:R_CISO .

isms:Level_3 a owl:NamedIndividual,
        isms:MaturityCapabilityLevel ;
    rdfs:label "Level 3 — Established"@en,
        "Niveau 3 — Vastgesteld"@nl ;
    rdfs:comment "Policy or activity is demonstrably documented with explicitly assigned responsibilities, roles, and authorities."@en,
        "Beleid of activiteit is aantoonbaar schriftelijk vastgesteld met expliciet benoemde verantwoordelijkheden, rollen en bevoegdheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:Level_1 a owl:NamedIndividual,
        isms:MaturityCapabilityLevel ;
    rdfs:label "Level 1 — Ad-hoc"@en,
        "Niveau 1 — Ad-hoc"@nl ;
    rdfs:comment "Policy or activity is not documented; responsibilities are not formally assigned."@en,
        "Beleid of activiteit is niet vastgelegd; verantwoordelijkheden zijn niet formeel belegd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:Level_2 a owl:NamedIndividual,
        isms:MaturityCapabilityLevel ;
    rdfs:label "Level 2 — Informal"@en,
        "Niveau 2 — Informeel"@nl ;
    rdfs:comment "Policy is partially present but not formally documented; responsibilities are informally assigned."@en,
        "Beleid is deels aanwezig maar niet schriftelijk vastgelegd; verantwoordelijkheden informeel belegd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:Level_4 a owl:NamedIndividual,
        isms:MaturityCapabilityLevel ;
    rdfs:label "Level 4 — Evaluated"@en,
        "Niveau 4 — Geëvalueerd"@nl ;
    rdfs:comment "Policy is formally approved, shared with stakeholders, and periodically reviewed for currency and completeness."@en,
        "Beleid is formeel goedgekeurd, gedeeld met stakeholders en wordt periodiek beoordeeld op actualiteit en volledigheid."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

isms:Level_5 a owl:NamedIndividual,
        isms:MaturityCapabilityLevel ;
    rdfs:label "Level 5 — Integrated"@en,
        "Niveau 5 — Geïntegreerd"@nl ;
    rdfs:comment "Policy is fully integrated into governance processes; roles and authorities are structurally evaluated and optimised."@en,
        "Beleid is volledig geïntegreerd in governance-processen; rollen en bevoegdheden worden structureel geëvalueerd en geoptimaliseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 .

roles:Role a owl:Class ;
    rdfs:label "Role"@en,
        "Rol"@nl ;
    rdfs:comment "Roles are held by persons. The architectural typology of persons-as-asset resides in M18 (asset:HumanAsset). M04 models what a role is and which RACI relations apply; M18 models persons as asset type."@en,
        "Rollen worden bekleed door personen. De architecturale typologie van personen-als-asset staat in M18 (asset:HumanAsset). M04 modelleert wat een rol is en welke RACI-relaties gelden; M18 modelleert mensen als asset-type."@nl ;
    rdfs:seeAlso asset:HumanAsset .

bio:ISO27002_5_26 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Reageren op informatiebeveiligingsincidenten"@nl ;
    rdfs:comment "Op informatiebeveiligingsincidenten behoort te worden gereageerd in overeenstemming met de gedocumenteerde procedures."@nl ;
