    compl:derivedFrom compl:OBL_NIS2_Art21 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART21-D" ;
    compl:requirementText "Supply chain security including security aspects of relationships between each entity and its direct suppliers or service providers."@en,
        "Beveiliging van de toeleveringsketen inclusief beveiligingsaspecten van relaties met directe leveranciers."@nl ;
    compl:satisfiedBy ctrl:ISO27002_5_19,
        ctrl:ISO27002_5_20,
        ctrl:ISO27002_5_21 .

compl:REQ_NIS2_Art21_e a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 21(2)(e) — security in acquisition, development and maintenance"@en,
        "Requirement: NIS2 art. 21 lid 2 onderdeel e — beveiliging bij verwerving en ontwikkeling"@nl ;
    compl:belongsToDomain compl:CD_AssetManagement ;
    compl:derivedFrom compl:OBL_NIS2_Art21 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART21-E" ;
    compl:requirementText "Security in network and information systems acquisition, development and maintenance."@en,
        "Beveiliging bij verwerving, ontwikkeling en onderhoud van netwerken en informatiesystemen."@nl ;
    compl:satisfiedBy ctrl:ISO27002_8_25,
        ctrl:ISO27002_8_26,
        ctrl:ISO27002_8_27,
        ctrl:ISO27002_8_28 .

compl:REQ_NIS2_Art21_f a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 21(2)(f) — effectiveness assessment of cybersecurity measures"@en,
        "Requirement: NIS2 art. 21 lid 2 onderdeel f — doeltreffendheidsbeoordeling beveiligingsmaatregelen"@nl ;
    compl:belongsToDomain compl:CD_GovernanceOversight ;
    compl:derivedFrom compl:OBL_NIS2_Art21 ;
    compl:hasStatus compl:CS_NotAssessed ;
