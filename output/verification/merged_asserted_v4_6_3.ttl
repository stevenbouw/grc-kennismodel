ctrl:CybersecurityConcept a owl:Class ;
    rdfs:label "Cybersecurity Concept"@en,
        "Cybersecurityconcept"@nl ;
    rdfs:comment "NIST CSF 2.0-aligned concept: Govern, Identify, Protect, Detect, Respond, Recover. Per CSF 2.0 (NIST CSWP 29, 26 februari 2024) is Govern toegevoegd t.o.v. v1.x."@en,
        "NIST CSF 2.0-gebaseerd concept: Sturen, Identificeren, Beschermen, Detecteren, Reageren, Herstellen. Per CSF 2.0 (NIST CSWP 29, 26 februari 2024) is Sturen toegevoegd t.o.v. v1.x."@nl .

ctrl:Herstellen a ctrl:CybersecurityConcept ;
    rdfs:label "Recover"@en,
        "Herstellen"@nl .

