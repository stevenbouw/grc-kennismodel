compl:OBL_VIR_Classificatie a compl:PolicyObligation ;
    rdfs:comment "Het lijnmanagement stelt betrouwbaarheidseisen vast op basis van een expliciete risicoafweging (VIR 2007, art. 4). Gecorrigeerd 2026-03-26: was 'Art. 5-7' maar VIR 2007 heeft slechts 5 artikelen (art. 5 = Slotbepaling)."@nl ;
    compl:accountableRole roles:R_SecretarisDirecteur ;
    compl:belongsToDomain compl:CD_AssetManagement ;
    compl:hasArticleReference "VIR 2007 Art. 4" ;
    compl:hasObligationID "VIR-CLASS" ;
    compl:hasObligationTitle "VIR 2007 – Information classification for central government"@en,
        "VIR 2007 – Informatieclassificatie rijksoverheidsinformatie"@nl ;
    compl:isMandatory true ;
    compl:sourcedFromFramework fw:VIR_2007 .

compl:REQ_NIS2_Art20_1 a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 20(1) — management body approval and supervision"@en,
        "Requirement: NIS2 art. 20 lid 1 — goedkeuring en toezicht bestuursorgaan"@nl ;
    compl:accountableRole roles:R_Bestuur ;
    compl:derivedFrom compl:OBL_NIS2_Art20 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART20-R1" ;
    compl:requirementText "Management bodies of essential and important entities shall approve cybersecurity risk management measures and oversee their implementation."@en,
        "Bestuursorganen van essentiële en belangrijke entiteiten keuren maatregelen voor cyberbeveiligingsrisicobeheer goed en houden toezicht op de uitvoering ervan."@nl ;
    compl:satisfiedBy ctrl:ISO27002_5_01,
        ctrl:ISO27002_5_04 .

compl:REQ_NIS2_Art20_2 a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 20(2) — management body cybersecurity training"@en,
        "Requirement: NIS2 art. 20 lid 2 — cyberbeveiligingstraining bestuur"@nl ;
    compl:accountableRole roles:R_SecretarisDirecteur ;
    compl:derivedFrom compl:OBL_NIS2_Art20 ;
    compl:hasStatus compl:CS_NotAssessed ;
