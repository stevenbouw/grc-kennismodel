compl:REQ_NIS2_Art21_c a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 21(2)(c) — business continuity and crisis management"@en,
        "Requirement: NIS2 art. 21 lid 2 onderdeel c — bedrijfscontinuïteit en crisismanagement"@nl ;
    compl:belongsToDomain compl:CD_ContinuityResilience ;
    compl:derivedFrom compl:OBL_NIS2_Art21 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART21-C" ;
    compl:requirementText "Business continuity (backup management, disaster recovery, crisis management)."@en,
