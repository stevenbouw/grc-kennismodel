    compl:requirementText "Human resources security, access control policies and asset management."@en,
        "Personeelsbeveiliging, toegangsbeveiligingsbeleid en bedrijfsmiddelenbeheer."@nl ;
    compl:satisfiedBy ctrl:ISO27002_5_09,
        ctrl:ISO27002_5_15,
        ctrl:ISO27002_6_01 .

compl:REQ_NIS2_Art21_j a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 21(2)(j) — multi-factor authentication and secured communications"@en,
        "Requirement: NIS2 art. 21 lid 2 onderdeel j — meervoudige authenticatie en beveiligde communicatie"@nl ;
    compl:belongsToDomain compl:CD_AccessControl ;
    compl:derivedFrom compl:OBL_NIS2_Art21 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART21-J" ;
    compl:requirementText "Use of multi-factor authentication or continuous authentication solutions, secured voice, video and text communications."@en,
        "Gebruik van meervoudige authenticatie of oplossingen voor continue authenticatie, beveiligde spraak-, video- en tekstcommunicatie."@nl ;
    compl:satisfiedBy ctrl:ISO27002_8_05 .

compl:REQ_NIS2_Art23_1 a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 23 — early warning within 24 hours"@en,
        "Requirement: NIS2 art. 23 — vroege waarschuwing binnen 24 uur"@nl ;
    compl:derivedFrom compl:OBL_NIS2_Art23 ;
    compl:hasDeadline "24 uur" ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART23-R1" ;
    compl:requirementText "Submit an early warning to the competent authority or CSIRT without undue delay and in any event within 24 hours of becoming aware of a significant incident."@en,
        "Dien een vroege waarschuwing in bij de bevoegde autoriteit of CSIRT zonder onnodige vertraging en in ieder geval binnen 24 uur na het bewust worden van een significant incident."@nl .

compl:REQ_NIS2_Art23_2 a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 23 — incident notification within 72 hours"@en,
        "Requirement: NIS2 art. 23 — incidentmelding binnen 72 uur"@nl ;
    compl:derivedFrom compl:OBL_NIS2_Art23 ;
    compl:hasDeadline "72 uur" ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART23-R2" ;
    compl:requirementText "Submit an incident notification within 72 hours of becoming aware of the significant incident."@en,
        "Dien een incidentmelding in binnen 72 uur na het bewust worden van het significante incident."@nl .

compl:REQ_NIS2_Art23_3 a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 23 — final report within one month"@en,
        "Requirement: NIS2 art. 23 — eindrapportage binnen één maand"@nl ;
    compl:derivedFrom compl:OBL_NIS2_Art23 ;
    compl:hasDeadline "1 maand" ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART23-R3" ;
    compl:requirementText "Submit a final report no later than one month after submission of the incident notification."@en,
        "Dien uiterlijk één maand na de incidentmelding een eindrapportage in."@nl .

compl:SupplierExclusionOrder a owl:Class ;
    rdfs:label "supplier exclusion order"@en,
        "leveranciers-uitsluitings-besluit"@nl ;
    rdfs:comment "A ministerial decision under Cbb art. 18 that obliges an essential or important entity not to use products or services from specified parties in designated network and information systems, where necessary to manage national security risks. ABox population is Spoor B (dependent on actual ministerial decisions)."@en,
        "Een ministerieel besluit op grond van Cbb art. 18 dat een essentiële of belangrijke entiteit verplicht in aangewezen netwerk- en informatiesystemen géén gebruik te maken van producten of diensten van specifieke partijen, wanneer dat noodzakelijk is om risico's voor de nationale veiligheid te beheersen. ABox-populatie is Spoor B (afhankelijk van werkelijke ministeriële besluiten)."@nl ;
    rdfs:subClassOf compl:Obligation .

compl:VIRBI_Art10_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art.10 — Driejaarlijkse evaluatie"@nl ;
    rdfs:comment "Driejaarlijkse evaluatie van de beveiliging van bijzondere informatie (VIRBI 2025, art.10)."@nl ;
    compl:articleRef "art. 10"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 ;
    compl:responsibleRole roles:R_BVA .

compl:VIRBI_Art2_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art. 2 — Scope and applicability"@en,
        "VIRBI 2025 Art. 2 — Plaatsbepaling en reikwijdte"@nl ;
    rdfs:comment "Het besluit geldt voor de Rijksdienst en is van toepassing op beveiliging van bijzondere informatie, onverminderd VIR 2007, Besluit BVA-stelsel en Besluit CIO-stelsel. Internationaal verkregen informatie behoudt toegekende rubricering."@nl ;
    compl:articleRef "Art. 2"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 .

compl:VIRBI_Art3_Verplichting_ext a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art. 3 — Security policy for classified information"@en,
        "VIRBI 2025 Art. 3 — Beveiligingsbeleid bijzondere informatie"@nl ;
    rdfs:comment "Het ministeriële beveiligingsbeleid (vastgesteld door SG) omvat ten minste uitgangspunten voor beveiliging, toegang, omgang met en verwerking van bijzondere informatie, inclusief rubriceringsbeleid, accreditatieproces en toezicht. De beveiligingsautoriteit bewaakt integraal karakter, coördineert aanpak, en onderzoekt compromitteringen."@nl ;
    compl:articleRef "Art. 3"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 ;
    compl:responsibleRole roles:R_SecretarisDirecteur .

compl:VIRBI_Art4_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art. 4 — Classifications"@en,
        "VIRBI 2025 Art. 4 — Rubriceringen"@nl ;
    rdfs:comment "Informatie waarvan geheimhouding geboden is moet worden voorzien van passend rubriceringsniveau. Vier niveaus: Dep.V, Stg.C, Stg.G, Stg.ZG. Opsteller doet voorstel; vaststeller van inhoud stelt rubricering vast."@nl ;
    compl:articleRef "Art. 4"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 .

compl:VIRBI_Art5_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art. 5 — Review and termination of classification"@en,
        "VIRBI 2025 Art. 5 — Herzien en beëindigen rubricering"@nl ;
    rdfs:comment "Rubriceringen worden verbonden aan maximaal tijdsverloop of bepaalde gebeurtenis. Na die periode/gebeurtenis weegt vaststeller af of herziening/beëindiging aan de orde is. Uitsluitend de vaststeller is bevoegd tot herziening."@nl ;
    compl:articleRef "Art. 5"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 .

compl:VIRBI_Art6_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art.6 — Aanwijzing BVC"@nl ;
    rdfs:comment "Het hoofd van een dienstonderdeel wijst een Beveiligingscoördinator (BVC) aan (VIRBI 2025, art.6)."@nl ;
    compl:articleRef "art. 6"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 ;
    compl:responsibleRole roles:R_BVC .

compl:VIRBI_Art7_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art. 7 — Release outside government service"@en,
        "VIRBI 2025 Art. 7 — Buiten de Rijksdienst brengen"@nl ;
    rdfs:comment "Bij het buiten de Rijksdienst brengen van bijzondere informatie blijven beveiligingseisen en toezicht onverkort van kracht. Internationaal verkregen informatie vereist voorafgaande toestemming van het land/organisatie van herkomst."@nl ;
    compl:articleRef "Art. 7"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 .

compl:VIRBI_Art8_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art. 8 — Compromise reporting obligation"@en,
        "VIRBI 2025 Art. 8 — Compromittering meldplicht"@nl ;
    rdfs:comment "Elke ambtenaar is verplicht onmiddellijk melding te doen van inbreuk of mogelijke inbreuk op de beveiliging die leidt tot compromittering. Bij internationaal verkregen informatie: tevens melding aan verantwoordelijke instantie."@nl ;
    compl:articleRef "Art. 8"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 ;
    compl:responsibleRole roles:R_BVA .

compl:VIRBI_Art9_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIRBI 2025 Art. 9 — Investigation committee"@en,
        "VIRBI 2025 Art. 9 — Commissie van onderzoek"@nl ;
    rdfs:comment "De SG stelt een commissie van onderzoek in bij ernstige compromittering. Onderzoek naar wijze van compromittering, aard/omvang schade, en te nemen maatregelen. Bij staatsgeheimen: melding aan hoofd AIVD (of MIVD voor Defensie)."@nl ;
    compl:articleRef "Art. 9"^^xsd:string ;
    compl:derivedFrom fw:VIRBI_2025 ;
    compl:responsibleRole roles:R_SecretarisDirecteur .

compl:VIR_Art2_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIR 2007 Art. 2 — Scope and applicability"@en,
        "VIR 2007 Art. 2 — Plaatsbepaling en reikwijdte"@nl ;
    rdfs:comment "Het VIR geldt voor de gehele Rijksdienst, het gehele proces van informatievoorziening en de gehele levenscyclus van informatiesystemen, ongeacht technologie of karakter van de informatie. Informatiebeveiliging is een lijnverantwoordelijkheid en onderdeel van kwaliteitszorg (VIR 2007, art. 2)."@nl ;
    compl:articleRef "art. 2"^^xsd:string ;
    compl:derivedFrom fw:VIR_2007 .

compl:VIR_Art3_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIR 2007 Art. 3 — Information security policy"@en,
        "VIR 2007 Art. 3 — Informatiebeveiligingsbeleid"@nl ;
    rdfs:comment "De SG stelt het informatiebeveiligingsbeleid vast, draagt dit uit en legt verantwoording af. Het beleid omvat minimaal: strategische uitgangspunten, organisatie van de IB-functie, toewijzing ketenverantwoordelijkheden, betrouwbaarheidseisen/normen, evaluatiefrequentie, en bevordering beveiligingsbewustzijn (VIR 2007, art. 3)."@nl ;
    compl:articleRef "art. 3"^^xsd:string ;
    compl:derivedFrom fw:VIR_2007 ;
    compl:responsibleRole roles:R_SecretarisDirecteur .

compl:VIR_Art4_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "VIR 2007 Art. 4 — Line management responsibilities"@en,
        "VIR 2007 Art. 4 — Verantwoordelijkheden lijnmanagement"@nl ;
    rdfs:comment "Het lijnmanagement is verantwoordelijk voor de beveiliging van zijn informatiesystemen: (a) stelt betrouwbaarheidseisen vast op basis van risicoafweging, (b) kiest en implementeert maatregelen, (c) stelt vast dat maatregelen overeenstemmen met eisen en worden nageleefd, (d) evalueert periodiek en stelt bij (VIR 2007, art. 4)."@nl ;
    compl:articleRef "art. 4"^^xsd:string ;
    compl:derivedFrom fw:VIR_2007 .

compl:VIR_Art5_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "BVA Decree Art. 3 — BVA system mandatory"@en,
        "Besluit BVA-stelsel Art. 3 — BVA-stelsel verplicht"@nl ;
    rdfs:comment "De minister draagt zorg voor de aanstelling van een BVA met een kaderstellende, adviserende en toezichthoudende rol over de integrale beveiliging. De SG is eindverantwoordelijk voor de integrale beveiliging en stelt het departementale beveiligingsbeleid vast (Besluit BVA-stelsel Rijksdienst 2021, art. 3). Oorspronkelijk foutief als VIR 2007 art. 5 gemodelleerd — gecorrigeerd 2026-03-26."@nl ;
    compl:articleRef "art. 3"^^xsd:string ;
    compl:derivedFrom fw:BesluitBVAStelsel ;
    compl:responsibleRole roles:R_BVA .

compl:VIR_Art9_Verplichting a owl:NamedIndividual,
        compl:LegalObligation ;
    rdfs:label "BVA Decree Art. 4(7) — Periodic security reporting"@en,
        "Besluit BVA-stelsel Art. 4 lid 7 — Periodieke IB-rapportage"@nl ;
    rdfs:comment "De BVA rapporteert periodiek (schriftelijk) over de stand van de integrale beveiliging aan de ambtelijke leiding en informeert de BVA Rijk hierover (Besluit BVA-stelsel Rijksdienst 2021, art. 4 lid 7). Oorspronkelijk foutief als VIR 2007 art. 9 gemodelleerd — gecorrigeerd 2026-03-26."@nl ;
    compl:articleRef "art. 4 lid 7"^^xsd:string ;
    compl:derivedFrom fw:BesluitBVAStelsel ;
    compl:responsibleRole roles:R_BVA .

