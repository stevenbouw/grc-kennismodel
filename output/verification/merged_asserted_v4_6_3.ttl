<https://grc.example.org/ontology/m06-isms> a owl:Ontology ;
    rdfs:label "GRC Ontology Module M6 — ISMS"@en,
        "GRC Ontologie Module M6 — ISMS"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m07-business> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M7 — Business Context"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m08-bio20> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M8 — BIO 2.0"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m09-iso27001-ext> a owl:Ontology ;
    rdfs:label "GRC Ontology Module M9 — ISO 27001:2022 Extended"@en,
        "GRC Ontologie Module M9 — ISO 27001:2022 Extended"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m10-nis2-ext> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M10 — NIS2 Extended"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m11-nist-800-53> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M11 — NIST SP 800-53 Rev5"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m12-dora> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M12 — DORA"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m13-iso22301> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M13 — ISO 22301:2019 BCM"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m14-avg-gdpr> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M14 — AVG/GDPR (IB-raakvlakken)"@nl ;
    rdfs:comment "Alleen de informatiebeveiliging-raakvlakartikelen van de AVG/GDPR. Geen volledige AVG-implementatie in scope."@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m15-ensia> a owl:Ontology ;
    rdfs:label "GRC Ontology Module M15 — ENSIA"@en,
        "GRC Ontologie Module M15 — ENSIA"@nl ;
    rdfs:comment "ENSIA audit framework: assesses BIO compliance and domain-specific information security for Dutch government. The NOREA ENSIA Guidance primarily targets municipalities; for the Dutch government organisation, ENSIA is modelled here as an analogous accountability process."@en,
        "ENSIA auditkader: toetst BIO-compliance en domeinspecifieke informatiebeveiliging bij de overheid. De NOREA Handreiking ENSIA is primair gericht op gemeenten; voor de Rijksoverheidsorganisatie wordt ENSIA hier als vergelijkbaar verantwoordingsproces gemodelleerd."@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m16-virbi-ext> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M16 — VIRBI 2025 uitbreiding"@nl ;
    rdfs:comment "Uitbreiding van de VIRBI 2025-modellering: volledige artikelstructuur en 8 beveiligingsdomeinen uit de Bijlage."@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m17-coso-cobit> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M17 — COSO ICF/ERM + COBIT 2019"@nl ;
    rdfs:comment "Enterprise-governance-laag (D10): COSO ICF en ERM met componenten, COBIT 2019 objectives, en governance-hiërarchie relaties."@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m18-assets> a owl:Ontology ;
    rdfs:label "GRC Ontology Module M18 — Asset"@en,
        "GRC Ontologie Module M18 — Asset"@nl ;
    dcterms:created "2026-04-13"^^xsd:date ;
    rdfs:comment "Architectural asset typology based on ISO 27005:2024, supplemented with government-specific aspects from the BVA-stelsel art. 1k (Te Beschermen Belangen), VIRBI 2025 and Besluit CIO-stelsel 2026 art. 1o. Independent from the ISMS administrative asset stubs in M06 (see rdfs:seeAlso relations)."@en,
        "Architecturale asset-typologie op basis van ISO 27005:2024, aangevuld met overheid-specifieke aspecten uit BVA-stelsel art. 1k (Te Beschermen Belangen), VIRBI 2025 en Besluit CIO-stelsel 2026 art. 1o. Onafhankelijk van de ISMS-administratieve asset-stubs in M06 (zie rdfs:seeAlso-relaties)."@nl ;
    owl:imports <https://grc.example.org/ontology/> ;
    owl:versionInfo "4.2.1" .

risk:ComplianceRisk a owl:Class ;
    rdfs:label "Compliance Risk"@en,
        "Compliancerisico"@nl ;
    rdfs:comment "Risk arising from failure to comply with applicable laws, regulations, standards or contractual obligations."@en,
        "Risico voortvloeiend uit niet-naleving van toepasselijke wet- en regelgeving, normen of contractuele verplichtingen."@nl ;
    rdfs:subClassOf risk:Risk .

risk:HumanVulnerability a owl:Class ;
    rdfs:label "Human Vulnerability"@en,
        "Menselijke kwetsbaarheid"@nl ;
    rdfs:comment "A weakness related to people: lack of awareness, training, skills or susceptibility to social engineering."@en,
        "Een zwakheid gerelateerd aan mensen: gebrek aan bewustzijn, training, vaardigheden of vatbaarheid voor social engineering."@nl ;
    rdfs:subClassOf risk:Vulnerability .

risk:IC_Financial a risk:ImpactCategory ;
    rdfs:label "Financial impact"@en,
        "Financiële impact"@nl .

risk:IC_Integrity a risk:ImpactCategory ;
    rdfs:label "Integrity impact"@en,
        "Integriteitsimpact"@nl .

risk:IC_Operational a risk:ImpactCategory ;
    rdfs:label "Operational impact"@en,
        "Operationele impact"@nl .

risk:IL_Critical a risk:ImpactLevel ;
    rdfs:label "Critical (5)"@en,
        "Kritiek (5)"@nl ;
    rdfs:comment "Catastrophic consequences; existential threat, inability to fulfil legal obligations."@en,
        "Catastrofale gevolgen; existentiële dreiging, onvermogen om wettelijke verplichtingen na te komen."@nl ;
    risk:hasImpactScore 5 .

risk:Impact a owl:Class ;
    rdfs:label "Impact"@en,
        "Impact"@nl ;
    rdfs:comment "The consequence or outcome of a risk materialising: the effect on organisational objectives, operations, assets, individuals or reputation."@en,
        "De consequentie of uitkomst van een zich manifesterende risico: het effect op organisatiedoelstellingen, -activiteiten, -bedrijfsmiddelen, personen of reputatie."@nl ;
    skos:altLabel "Consequence"@en .

risk:LL_High a risk:LikelihoodLevel ;
    rdfs:label "High (4)"@en,
        "Hoog (4)"@nl ;
    rdfs:comment "Event is likely to occur (once or more per year)."@en,
        "Gebeurtenis treedt waarschijnlijk op (eenmaal of vaker per jaar)."@nl ;
    risk:hasLikelihoodScore 4 .

risk:Likelihood a owl:Class ;
    rdfs:label "Likelihood"@en,
        "Waarschijnlijkheid"@nl ;
    rdfs:comment "The chance of something happening, expressed qualitatively or quantitatively. [ISO 31000:2018]"@en,
        "De kans dat iets gebeurt, uitgedrukt kwalitatief of kwantitatief. [ISO 31000:2018]"@nl .

risk:OperationalRisk a owl:Class ;
    rdfs:label "Operational Risk"@en,
        "Operationeel risico"@nl ;
    rdfs:comment "Risk arising from inadequate or failed internal processes, people, systems or from external events."@en,
        "Risico voortvloeiend uit tekortschietende of mislukte interne processen, mensen, systemen of externe gebeurtenissen."@nl ;
    rdfs:subClassOf risk:Risk .

risk:ReportingRisk a owl:Class ;
    rdfs:label "Reporting Risk"@en,
        "Rapportagerisico"@nl ;
    rdfs:comment "Risk related to the reliability and integrity of managerial and financial reporting."@en,
        "Risico met betrekking tot betrouwbaarheid en integriteit van management- en financiële rapportage."@nl ;
    rdfs:isDefinedBy risk: ;
    rdfs:subClassOf risk:Risk ;
    skos:broadMatch ext:COSO_ERM_Performance .

risk:ResidualRisk a owl:Class ;
    rdfs:label "Residual Risk"@en,
        "Restrisico"@nl ;
    rdfs:comment "The risk remaining after risk treatment has been applied."@en,
        "Het risico dat overblijft nadat risicobehandeling is toegepast."@nl ;
    rdfs:subClassOf risk:Risk .

risk:RiskAcceptance a owl:Class ;
    rdfs:label "Risk Acceptance"@en,
        "Risicoaanvaarding"@nl ;
    rdfs:comment "An informed decision to retain a risk without further treatment, within defined risk appetite."@en,
        "Een weloverwogen beslissing om een risico te behouden zonder verdere behandeling, binnen de gedefinieerde risicobereidheid."@nl ;
    rdfs:subClassOf risk:RiskTreatment .

risk:RiskAppetite a owl:Class ;
    rdfs:label "Risk Appetite"@en,
        "Risicobereidheid"@nl ;
    rdfs:comment "The amount and type of risk an organisation is willing to pursue or retain in order to meet its strategic objectives."@en,
        "De hoeveelheid en het type risico dat een organisatie bereid is na te streven of te behouden om haar strategische doelstellingen te bereiken."@nl ;
    skos:broadMatch fw:ISO_31000_2018 ;
    skos:relatedMatch ext:COSO_ERM_GovernanceCulture .

risk:RiskAvoidance a owl:Class ;
    rdfs:label "Risk Avoidance"@en,
        "Risicoafwijzing"@nl ;
    rdfs:comment "Decision not to start or continue with an activity that gives rise to a particular risk."@en,
        "Beslissing om een activiteit die aanleiding geeft tot een specifiek risico niet te starten of voort te zetten."@nl ;
    rdfs:subClassOf risk:RiskTreatment .

risk:RiskCriteria a owl:Class ;
    rdfs:label "Risk Criteria"@en,
        "Risicocriteria"@nl ;
    rdfs:comment "Terms of reference against which the significance of a risk is evaluated."@en,
        "Referentiecriteria aan de hand waarvan de betekenis van een risico wordt beoordeeld."@nl .

risk:RiskMitigation a owl:Class ;
    rdfs:label "Risk Mitigation"@en,
        "Risicomitigatie"@nl ;
    rdfs:comment "Reducing the likelihood or impact of a risk by implementing controls."@en,
        "Verminderen van de waarschijnlijkheid of impact van een risico door beheersmaatregelen te implementeren."@nl ;
    rdfs:subClassOf risk:RiskTreatment .

risk:RiskOwner a owl:Class ;
    rdfs:label "Risk Owner"@en,
        "Risico-eigenaar"@nl ;
    rdfs:comment "A person or entity with the accountability and authority to manage a risk."@en,
        "Een persoon of entiteit met de verantwoordelijkheid en bevoegdheid om een risico te beheren."@nl .

risk:RiskRegister a owl:Class ;
    rdfs:label "Risk Register"@en,
        "Risicoregister"@nl ;
    rdfs:comment "A documented record of identified risks, their assessment results, treatment decisions and residual risk."@en,
        "Een gedocumenteerd overzicht van geïdentificeerde risico's, beoordelingsresultaten, behandelbeslissingen en restrisico."@nl ;
    skos:relatedMatch ext:COSO_ERM_ReviewRevision .

risk:RiskScenario a owl:Class ;
    rdfs:label "Risk Scenario"@en,
        "Risicoscenario"@nl ;
    rdfs:comment "A described sequence of events that may result in the materialisation of a risk, including the threat, the exploited vulnerability and the impact on one or more assets."@en,
        "Een beschreven reeks gebeurtenissen die kan resulteren in het optreden van een risico, inclusief de dreiging, de benutte kwetsbaarheid en de impact op een of meer bedrijfsmiddelen."@nl .

risk:RiskTransfer a owl:Class ;
    rdfs:label "Risk Transfer / Sharing"@en,
        "Risico-overdracht / -deling"@nl ;
    rdfs:comment "Sharing the risk with another party, e.g. through insurance, contracts or outsourcing."@en,
        "Het risico delen met een andere partij, bijv. via verzekering, contracten of uitbesteding."@nl ;
    rdfs:subClassOf risk:RiskTreatment .

risk:StrategicRisk a owl:Class ;
    rdfs:label "Strategic Risk"@en,
        "Strategisch risico"@nl ;
    rdfs:comment "Risk that affects the long-term objectives or strategic direction of the organisation."@en,
        "Risico dat de langetermijndoelstellingen of strategische richting van de organisatie beïnvloedt."@nl ;
    rdfs:subClassOf risk:Risk .

risk:TS_NaturalDisaster a risk:EnvironmentalThreatSource ;
    rdfs:label "Natural disaster"@en,
        "Natuurramp"@nl .

risk:TS_SoftwareFault a risk:TechnicalThreatSource ;
    rdfs:label "Software defect"@en,
        "Softwaredefect"@nl .

risk:TS_Supplier a risk:HumanThreatSource ;
    rdfs:label "Compromised supplier"@en,
        "Gecompromitteerde leverancier"@nl .

risk:T_InsiderSabotage a risk:Threat ;
    rdfs:label "Insider sabotage"@en,
        "Sabotage door insider"@nl ;
    risk:originatesFrom risk:TS_Insider ;
    risk:threatens risk:InformationAsset,
        risk:PhysicalAsset,
        risk:SystemAsset .

risk:T_SupplyChainCompromise a risk:Threat ;
    rdfs:label "Supply chain compromise"@en,
        "Leveranciersketen-compromittering"@nl ;
    risk:originatesFrom risk:TS_NationState,
        risk:TS_Supplier ;
    risk:threatens risk:ServiceAsset,
        risk:SystemAsset .

risk:V_ExcessivePrivileges a risk:OrganisationalVulnerability ;
    rdfs:label "Excessive user privileges"@en,
        "Te ruime gebruikersrechten"@nl ;
    risk:exploits risk:T_InsiderSabotage,
        risk:T_UnauthorisedAccess .

risk:V_NoAwareness a risk:HumanVulnerability ;
    rdfs:label "Insufficient security awareness"@en,
        "Onvoldoende beveiligingsbewustzijn"@nl ;
    risk:exploits risk:T_Phishing .

risk:V_OpenPorts a risk:TechnicalVulnerability ;
    rdfs:label "Unnecessary open ports / services"@en,
        "Onnodige open poorten / diensten"@nl ;
    risk:exploits risk:T_DDoS,
        risk:T_UnauthorisedAccess .

risk:V_SinglePointOfFailure a risk:TechnicalVulnerability ;
    rdfs:label "Single point of failure (no redundancy)"@en,
        "Enkel foutpunt (geen redundantie)"@nl ;
    risk:exploits risk:T_DDoS,
        risk:T_NaturalHazard .

risk:V_UnpatchedSoftware a risk:TechnicalVulnerability ;
    rdfs:label "Unpatched software"@en,
        "Ongepatchte software"@nl ;
    risk:exploits risk:T_Ransomware,
        risk:T_UnauthorisedAccess .

risk:V_WeakSupplierVetting a risk:OrganisationalVulnerability ;
    rdfs:label "Inadequate supplier vetting"@en,
        "Ontoereikende leveranciersbeoordeling"@nl ;
    risk:exploits risk:T_SupplyChainCompromise .

roles:BVC a owl:Class ;
    rdfs:label "Security Coordinator (BVC)"@en,
        "Beveiligingscoördinator (BVC)"@nl ;
    rdfs:comment "The Security Coordinator (BVC) is the designated officer for information security at the level of a service unit. Legal basis: Besluit BVA-stelsel Rijksdienst 2021, art. 6. Functional reporting line to the BVA; hierarchical reporting line to the service unit. BVC is a different role from the CISO (CIO-stelsel, organisation level)."@en,
        "De Beveiligingscoördinator (BVC) is de aangewezen functionaris voor informatiebeveiliging op het niveau van een dienstonderdeel. Grondslag: Besluit BVA-stelsel Rijksdienst 2021, art. 6. Functionele rapportagelijn naar de BVA; hiërarchische rapportagelijn naar dienstonderdeel. BVC is een andere rol dan de CISO (CIO-stelsel, organisatieniveau)."@nl ;
    rdfs:subClassOf roles:SpecialistRole ;
    owl:disjointWith roles:ManagementRole ;
    skos:note "BVC = BVA-stelsel (dienstonderdeel) | CISO = CIO-stelsel (organisatie)"@nl ;
    roles:mandatedBy fw:BesluitBVAStelsel .

roles:ExternalParty a owl:Class ;
    rdfs:label "External Party"@en,
        "Externe partij"@nl ;
    rdfs:comment "A supplier, contractor, regulatory body or other party outside the organisation."@en,
        "Een leverancier, aannemer, toezichthouder of andere partij buiten de organisatie."@nl ;
    rdfs:subClassOf roles:Actor .

roles:OrganisationalUnit a owl:Class ;
    rdfs:label "Organisational Unit"@en,
        "Organisatorische eenheid"@nl ;
    rdfs:comment "A department, team, directorate or other formal organisational grouping."@en,
        "Een afdeling, team, directoraat of andere formele organisatorische groepering."@nl ;
    rdfs:subClassOf roles:Actor .

roles:Person a owl:Class ;
    rdfs:label "Person"@en,
        "Persoon"@nl ;
    rdfs:comment "An individual human actor within or associated with the organisation."@en,
        "Een individuele menselijke actor binnen of geassocieerd met de organisatie."@nl ;
    rdfs:subClassOf roles:Actor .

roles:R_Lijnmanager a roles:ManagementRole ;
    roles:hasRoleDescription "Operationeel manager; verantwoordelijk voor naleving informatiebeveiliging door medewerkers in zijn/haar team. ISO 27002:2022 §5.4."@nl ;
    roles:hasRoleID "MGT-01" ;
    roles:hasRoleTitle "Line Manager"@en,
        "Lijnmanager"@nl ;
    roles:isAccountableFor roles:ACT_IncidentMelden ;
    roles:isInformedAbout roles:ACT_BeveiligingsbeleidVaststellen ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:isResponsibleFor roles:ACT_BewustwordingTraining ;
    roles:mandatedBy fw:ISO_IEC_27002_2022 ;
    roles:reportsTo roles:R_SecretarisDirecteur .

asset:AssetOrComponent a owl:Class ;
    rdfs:label "Asset or Component"@en,
        "Bedrijfsmiddel of component"@nl ;
    dcterms:source "Masterchat-besluit A4.4 (13 april 2026)" ;
    rdfs:comment "Union class of asset:Asset and asset:AssetComponent. Used as rdfs:range for asset:appliesToAssetType. Masterchat-decision A4.4: one property with union-range rather than two separate properties."@en,
        "Unieklasse van asset:Asset en asset:AssetComponent. Gebruikt als rdfs:range voor asset:appliesToAssetType. Masterchat-besluit A4.4: één property met union-range in plaats van twee aparte properties."@nl ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( asset:Asset asset:AssetComponent ) ] .

asset:IntangibleAsset a owl:Class ;
    rdfs:label "Intangible Asset"@en,
        "Immaterieel bedrijfsmiddel"@nl ;
    dcterms:source "BVA-stelsel Rijksdienst 2021 art. 1k (imago); aanvulling op ISO/IEC 27005:2024" ;
    rdfs:comment "Intangible assets: reputation, image, trust. Added beyond ISO 27005:2024 to cover BVA-stelsel 2021 art. 1k 'imago'. Has no physical components but can be affected by incidents involving other asset-types."@en,
        "Immateriële bedrijfsmiddelen: reputatie, imago, vertrouwen. Toegevoegd bovenop ISO 27005:2024 om BVA-stelsel 2021 art. 1k 'imago' te dekken. Heeft geen fysieke componenten maar kan worden geraakt door incidenten bij andere asset-types."@nl ;
    rdfs:subClassOf asset:Asset ;
    skos:exactMatch fw:TBB_Imago .

asset:ProcessingFacility a owl:Class ;
    rdfs:label "Processing Facility"@en,
        "Verwerkingsvoorziening"@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" ;
    rdfs:comment "Processing facility component of an information system (e.g. compute clusters, application servers, container platforms)."@en,
        "Verwerkingsvoorzieningscomponent van een informatiesysteem (bijv. compute clusters, applicatieservers, containerplatforms)."@nl ;
    rdfs:subClassOf asset:Facility .

bio:ISO27002_6_07 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Werken op afstand"@nl ;
    rdfs:comment "Wanneer personeel op afstand werkt, behoren er beveiligingsmaatregelen te worden geïmplementeerd om informatie te beschermen die buiten het gebouw en/of terrein van de organisatie wordt ingezien, verwerkt of opgeslagen."@nl ;
    bio:bioControlNummer "6.07" ;
    bio:correspondsToISO ctrl:ISO27002_6_07 ;
    bio:hasControlType "Mensgericht" ;
    bio:hasIBEigenschap """#Vertrouwelijkheid
#Integriteit
#Beschikbaarheid""" ;
    bio:hasVerantwoordelijke """Secretaris/Algemeen directeur
Dienstenleverancier""" ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasCbbArticle "art. 14" ;
    ext:hasCbwArticle "art. 21 lid i" ;
    ext:hasHandreikingBBN 2 .

bio:ISO27002_7_12 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Beveiligen van bekabeling"@nl ;
    rdfs:comment "Voedingskabels en kabels voor het versturen van gegevens of die informatiediensten ondersteunen, behoren te worden beschermd tegen onderschepping, interferentie of beschadiging."@nl ;
    bio:bioControlNummer "7.12" ;
    bio:correspondsToISO ctrl:ISO27002_7_12 ;
    bio:hasControlType "Fysiek" ;
    bio:hasIBEigenschap """#Vertrouwelijkheid
#Beschikbaarheid""" ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasCbbArticle "art. 16" ;
    ext:hasCbwArticle "art. 21 lid i" ;
    ext:hasHandreikingBBN 1 .

bio:ISO27002_8_06 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Capaciteitsbeheer"@nl ;
    rdfs:comment "Het gebruik van middelen behoort te worden gemonitord en aangepast overeenkomstig de huidige en verwachte capaciteitseisen."@nl ;
    bio:bioControlNummer "8.06" ;
    bio:correspondsToISO ctrl:ISO27002_8_06 ;
    bio:hasControlType "Technologisch" ;
    bio:hasIBEigenschap """#Integriteit
#Beschikbaarheid""" ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasCbbArticle "art. 15/16" ;
    ext:hasCbwArticle "art. 21 lid i" ;
    ext:hasHandreikingBBN 1 .

bio:ISO27002_8_28 a owl:NamedIndividual,
        bio:BIOControl ;
    rdfs:label "Veilig coderen"@nl ;
    rdfs:comment "Er behoren principes voor veilig coderen te worden toegepast op softwareontwikkeling."@nl ;
    bio:bioControlNummer "8.28" ;
    bio:correspondsToISO ctrl:ISO27002_8_28 ;
    bio:hasControlType "Technologisch" ;
    bio:hasIBEigenschap """#Vertrouwelijkheid
#Integriteit
#Beschikbaarheid""" ;
    bio:hasVerantwoordelijke "Dienstenleverancier" ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasCbbArticle "art. 11" ;
    ext:hasCbwArticle "art. 21 lid e" ;
    ext:hasHandreikingBBN 1 .

biz:BusinessProcess a owl:Class ;
    rdfs:label "Business Process"@en,
        "Bedrijfsproces"@nl ;
    rdfs:comment "A repeatable set of activities that delivers a defined business output or service."@en,
        "Een herhaalbaar geheel van activiteiten dat een gedefinieerde bedrijfsoutput of dienst levert."@nl .

biz:ComplianceCalendar a owl:Class ;
    rdfs:label "Compliance Calendar"@en,
        "Compliancekalender"@nl ;
    rdfs:comment "A scheduled overview of recurring GRC obligations and activities (reporting deadlines, audits, reviews, training cycles)."@en,
        "Een gepland overzicht van terugkerende GRC-verplichtingen en -activiteiten (rapportagedeadlines, audits, beoordelingen, trainingscycli)."@nl .

biz:ML_1 a biz:MaturityLevel ;
    rdfs:label "Level 1 – Initial / Ad hoc"@en,
        "Niveau 1 – Initieel / Ad hoc"@nl ;
    rdfs:comment "Processen bestaan maar zijn niet gedocumenteerd of herhaalbaar."@nl ;
    biz:maturityScore 1 .

biz:RiskAppetiteStatement a owl:Class ;
    rdfs:label "Risk Appetite Statement"@en,
        "Risicobereidheidsverklaring"@nl ;
    rdfs:comment "A formal document expressing the organisation's risk appetite, approved by senior management. [NIST SP 800-39 / ISO 31000]"@en,
        "Een formeel document dat de risicobereidheid van de organisatie uitdrukt, goedgekeurd door het senior management. [NIST SP 800-39 / ISO 31000]"@nl ;
    skos:relatedMatch ext:COSO_ERM_GovernanceCulture .

biz:SO_05 a biz:StrategicObjective ;
    rdfs:label "SO-05: Doelmatig GRC-programma"@nl ;
    biz:objectiveDescription "Beheersbaar en doelmatig informatiebeveiligingsprogramma."@nl ;
    biz:objectiveID "SO-05" .

compl:CD_ContinuityResilience a compl:ComplianceDomain ;
    rdfs:label "Business Continuity & Resilience"@en,
        "Bedrijfscontinuïteit en veerkracht"@nl .

compl:CD_SupplyChainSecurity a compl:ComplianceDomain ;
    rdfs:label "Supply Chain Security"@en,
        "Leveranciersketenbeveiliging"@nl .

compl:OBL_BIO2_Governance a compl:PolicyObligation ;
    skos:closeMatch compl:OBL_ISO27001_Cl4 ;
    compl:accountableRole roles:R_SecretarisDirecteur ;
    compl:belongsToDomain compl:CD_GovernanceOversight ;
    compl:hasArticleReference "BIO 2.0 v2.0 – ISO 27002:2022 §5.1 / §5.2 overheidsmaatregelen" ;
    compl:hasObligationID "BIO2-GOV" ;
    compl:hasObligationTitle "BIO 2.0 – Information security governance"@en,
        "BIO 2.0 – Informatiebeveiliging in de bedrijfsvoering"@nl ;
    compl:isMandatory true ;
    compl:responsibleRole roles:R_CISO ;
    compl:sourcedFromFramework fw:BIO_2_0 .

compl:OBL_ISO27001_Cl9_3 a compl:StandardsObligation ;
    compl:accountableRole roles:R_SecretarisDirecteur ;
    compl:belongsToDomain compl:CD_GovernanceOversight ;
    compl:hasArticleReference "ISO/IEC 27001:2022 Clause 9.3" ;
    compl:hasDeadline "Minimaal jaarlijks / At least annually" ;
    compl:hasObligationID "ISO27001-CL9.3" ;
    compl:hasObligationTitle "ISMS management review"@en,
        "Directiebeoordeling ISMS"@nl ;
    compl:isMandatory true ;
    compl:responsibleRole roles:R_CISO ;
    compl:sourcedFromFramework fw:ISO_IEC_27001_2022 .

ctrl:ControlDomain a owl:Class ;
    rdfs:label "Control Domain"@en,
        "Beheersmaatregeldomein"@nl ;
    rdfs:comment "A thematic domain or category within which controls are grouped (e.g. Access Control, Incident Management). Framework-neutral: applies to ISO 27002, NIST 800-53, COBIT and other control frameworks."@en,
        "Een thematisch domein of categorie waarbinnen beheersmaatregelen zijn gegroepeerd (bijv. Toegangsbeveiliging, Incidentbeheer). Framework-neutraal: van toepassing op ISO 27002, NIST 800-53, COBIT en andere maatregelkaders."@nl .

ctrl:ISO27002_5_06 a ctrl:ISO27002Control ;
    rdfs:label "Contact with special interest groups"@en,
        "Contact met speciale belangengroepen"@nl ;
    owl:sameAs bio:ISO27002_5_06 ;
    skos:broadMatch compl:NIS2_Art21_a ;
    asset:appliesToAssetType asset:Asset ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "5.06" ;
    ctrl:hasControlTitle "Contact met speciale belangengroepen"@nl ;
    ctrl:hasControlType ctrl:Corrigerend,
        ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Beschermen,
        ctrl:Herstellen,
        ctrl:Reageren ;
    ctrl:hasOperationalCapability ctrl:OC_Governance ;
    ctrl:hasSecurityDomain ctrl:SD_Verdediging ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Organisatorisch ;
    ctrl:isApplicableInBIO true .

ctrl:ISO27002_5_10 a ctrl:ISO27002Control ;
    rdfs:label "Acceptable use of information and other associated assets"@en,
        "Aanvaard gebruik van informatie en andere gerelateerde bedrijfsmiddelen"@nl ;
    owl:sameAs bio:ISO27002_5_10 ;
    skos:broadMatch compl:NIS2_Art21_i ;
    asset:appliesToAssetType asset:Asset ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "5.10" ;
    ctrl:hasControlTitle "Aanvaard gebruik van informatie en andere gerelateerde bedrijfsmiddelen"@nl ;
    ctrl:hasControlType ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Beschermen ;
    ctrl:hasOperationalCapability ctrl:OC_Bedrijfsmiddelenbeheer,
        ctrl:OC_Informatiebescherming ;
    ctrl:hasSecurityDomain ctrl:SD_Bescherming,
        ctrl:SD_GovernanceEcosysteem ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Organisatorisch ;
    ctrl:isApplicableInBIO true .

ctrl:ISO27002_5_23 a ctrl:ISO27002Control ;
    rdfs:label "Information security for use of cloud services"@en,
        "Informatiebeveiliging voor het gebruik van clouddiensten"@nl ;
    owl:sameAs bio:ISO27002_5_23 ;
    skos:broadMatch compl:NIS2_Art21_d ;
    asset:appliesToAssetType asset:InformationSystem ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "5.23" ;
    ctrl:hasControlTitle "Informatiebeveiliging voor het gebruik van clouddiensten"@nl ;
    ctrl:hasControlType ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Beschermen ;
    ctrl:hasOperationalCapability ctrl:OC_BeveiligingLeveranciersrelaties ;
    ctrl:hasSecurityDomain ctrl:SD_Bescherming,
        ctrl:SD_GovernanceEcosysteem ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Organisatorisch ;
    ctrl:isApplicableInBIO true .

ctrl:ISO27002_5_31 a ctrl:ISO27002Control ;
    rdfs:label "Legal, statutory, regulatory and contractual requirements"@en,
        "Wettelijke, statutaire, regelgevende en contractuele eisen"@nl ;
    owl:sameAs bio:ISO27002_5_31 ;
    skos:broadMatch compl:NIS2_Art21_a,
        compl:NIS2_Art21_d ;
    asset:appliesToAssetType asset:Asset ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "5.31" ;
    ctrl:hasControlTitle "Wettelijke, statutaire, regelgevende en contractuele eisen"@nl ;
    ctrl:hasControlType ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Identificeren ;
    ctrl:hasOperationalCapability ctrl:OC_JuridischCompliance ;
    ctrl:hasSecurityDomain ctrl:SD_Bescherming,
        ctrl:SD_GovernanceEcosysteem ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Organisatorisch ;
    ctrl:isApplicableInBIO true .

ctrl:ISO27002_5_32 a ctrl:ISO27002Control ;
    rdfs:label "Intellectual property rights"@en,
        "Intellectuele-eigendomsrechten"@nl ;
    owl:sameAs bio:ISO27002_5_32 ;
    skos:broadMatch compl:NIS2_Art21_j ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:IntangibleAsset ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "5.32" ;
    ctrl:hasControlTitle "Intellectuele-eigendomsrechten"@nl ;
    ctrl:hasControlType ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Identificeren ;
    ctrl:hasOperationalCapability ctrl:OC_JuridischCompliance ;
    ctrl:hasSecurityDomain ctrl:SD_GovernanceEcosysteem ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Organisatorisch ;
    ctrl:isApplicableInBIO true .

ctrl:ISO27002_6_04 a ctrl:ISO27002Control ;
    rdfs:label "Disciplinary process"@en,
        "Disciplinaire procedure"@nl ;
    owl:sameAs bio:ISO27002_6_04 ;
    skos:broadMatch compl:NIS2_Art21_g ;
    asset:appliesToAssetType asset:HumanAsset ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "6.04" ;
    ctrl:hasControlTitle "Disciplinaire procedure"@nl ;
    ctrl:hasControlType ctrl:Corrigerend,
        ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Beschermen,
        ctrl:Reageren ;
    ctrl:hasOperationalCapability ctrl:OC_Personeelsbeveiliging ;
    ctrl:hasSecurityDomain ctrl:SD_GovernanceEcosysteem ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Mensgericht ;
    ctrl:isApplicableInBIO true .

ctrl:ISO27002_6_07 a ctrl:ISO27002Control ;
    rdfs:label "Remote working"@en,
        "Werken op afstand"@nl ;
    owl:sameAs bio:ISO27002_6_07 ;
    skos:broadMatch compl:NIS2_Art21_i,
        compl:NIS2_Art21_j ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationSystem ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "6.07" ;
    ctrl:hasControlTitle "Werken op afstand"@nl ;
    ctrl:hasControlType ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Beschermen ;
    ctrl:hasOperationalCapability ctrl:OC_Bedrijfsmiddelenbeheer,
        ctrl:OC_FysiekeBeveiliging,
