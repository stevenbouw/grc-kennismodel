csf:Function a owl:Class ;
    rdfs:label "CSF Function"@en,
        "CSF-Function"@nl ;
    rdfs:comment "A Function from NIST Cybersecurity Framework 2.0. Functions form the highest level of the CSF Core: GOVERN, IDENTIFY, PROTECT, DETECT, RESPOND, RECOVER. Per CSF 2.0 GOVERN is new compared to v1.x."@en,
        "Een Function uit NIST Cybersecurity Framework 2.0. Functions vormen het hoogste niveau van de CSF-Core: GOVERN, IDENTIFY, PROTECT, DETECT, RESPOND, RECOVER. Per CSF 2.0 is GOVERN nieuw t.o.v. v1.x."@nl ;
    rdfs:subClassOf ext:FrameworkComponent .

csf:GV_RiskManagementStrategy a owl:NamedIndividual,
        csf:Category ;
    rdfs:label "Risk Management Strategy"@en,
        "Risicobeheersstrategie"@nl ;
    rdfs:comment "The organization’s priorities, constraints, risk tolerance and appetite statements, and assumptions are established, communicated, and used to support operational risk decisions"@en ;
    skos:closeMatch bio:ISO27002_5_01,
        ext:ISO27001_6_1 ;
    skos:relatedMatch ext:COBIT_EDM03,
        ext:COSO_ERM_Performance,
        ext:COSO_ERM_StrategyObjectiveSetting,
        ext:COSO_ICF_RiskAssessment ;
    csf:csfIdentifier "GV.RM" ;
    csf:partOfFunction csf:GOVERN ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_SC_10 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "GV.SC-10"@en ;
    rdfs:comment "Cybersecurity supply chain risk management plans include provisions for activities that occur after the conclusion of a partnership or service agreement"@en ;
    skos:closeMatch bio:ISO27002_5_19,
        bio:ISO27002_5_20,
        bio:ISO27002_5_21,
        bio:ISO27002_5_22,
        bio:ISO27002_8_30,
        ext:ISO27001_6_1_1,
        ext:ISO27001_6_1_2,
        ext:ISO27001_6_1_3,
        ext:NIST_RA_3,
        ext:NIST_RA_5,
        ext:NIST_RA_7,
        ext:NIST_SA_4,
        ext:NIST_SA_9,
        ext:NIST_SR_2,
        ext:NIST_SR_3,
        ext:NIST_SR_6 ;
    csf:csfIdentifier "GV.SC-10" ;
    csf:partOfCategory csf:GV_CybersecuritySupplyChainRiskManagement ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_AssetManagement a owl:NamedIndividual,
        csf:Category ;
    rdfs:label "Asset Management"@en,
        "Activabeheer"@nl ;
    rdfs:comment "Assets (e.g., data, hardware, software, systems, facilities, services, people) that enable the organization to achieve business purposes are identified and managed consistent with their relative importance to organizational objectives and the organization’s risk strategy"@en ;
    skos:closeMatch bio:ISO27002_5_09,
        bio:ISO27002_5_12,
