ext:COSOComponent a owl:Class ;
    rdfs:label "COSO Component"@en,
        "COSO-component"@nl ;
    rdfs:comment "A component of the COSO Internal Control or Enterprise Risk Management framework."@en,
        "Een component van het COSO Internal Control of Enterprise Risk Management framework."@nl ;
    rdfs:subClassOf ext:FrameworkComponent .

ext:FrameworkComponent a owl:Class ;
    rdfs:label "Framework Component"@en,
        "Kaderwerkcomponent"@nl ;
    rdfs:comment "A structural element within a GRC framework, such as a COSO component, COBIT objective, or NIST CSF function. Distinguished from fw:GRCFramework: a component is part of a framework, not a framework itself."@en,
        "Een structureel element binnen een GRC-kaderwerk, zoals een COSO-component, COBIT-doelstelling of NIST CSF-functie. Onderscheiden van fw:GRCFramework: een component is onderdeel van een kaderwerk, niet zelf een kaderwerk."@nl .

ext:ISO27001_4_2 a owl:NamedIndividual,
        ext:ISMSRequirement ;
    rdfs:label "Understanding needs and expectations of interested parties"@en,
        "Inzicht in de behoeften en verwachtingen van belanghebbenden"@nl ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie bepaalt de relevante belanghebbenden die relevant zijn voor het ISMS en hun relevante eisen, inclusief wettelijke en regelgevende eisen."@nl ;
    ext:alignsWithHSClause ext:HSClause_4_Context ;
    ext:clauseNumber "4.2" .

