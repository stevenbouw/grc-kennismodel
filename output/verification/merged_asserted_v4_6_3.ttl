        csf:ImplementationExample ;
    rdfs:label "PR.DS-11.Ex4"@en,
        "PR.DS-11.Ex4"@nl ;
    rdfs:comment "Enforce geographic separation and geolocation restrictions for data backup storage"@en ;
    csf:csfIdentifier "PR.DS-11.Ex4" ;
    csf:exemplifies csf:PR_DS_11 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_IR_01_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "PR.IR-01.Ex1"@en,
        "PR.IR-01.Ex1"@nl ;
    rdfs:comment "Logically segment organization networks and cloud-based platforms according to trust boundaries and platform types (e.g., IT, IoT, OT, mobile, guests), and permit required communications only between segments"@en ;
    csf:csfIdentifier "PR.IR-01.Ex1" ;
    csf:exemplifies csf:PR_IR_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_IR_01_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "PR.IR-01.Ex2"@en,
        "PR.IR-01.Ex2"@nl ;
    rdfs:comment "Logically segment organization networks from external networks, and permit only necessary communications to enter the organization’s networks from the external networks"@en ;
    csf:csfIdentifier "PR.IR-01.Ex2" ;
    csf:exemplifies csf:PR_IR_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_IR_01_Ex3 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "PR.IR-01.Ex3"@en,
        "PR.IR-01.Ex3"@nl ;
    rdfs:comment "Implement zero trust architectures to restrict network access to each resource to the minimum necessary"@en ;
    csf:csfIdentifier "PR.IR-01.Ex3" ;
    csf:exemplifies csf:PR_IR_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_IR_01_Ex4 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "PR.IR-01.Ex4"@en,
        "PR.IR-01.Ex4"@nl ;
    rdfs:comment "Check the cyber health of endpoints before allowing them to access and use production resources"@en ;
    csf:csfIdentifier "PR.IR-01.Ex4" ;
    csf:exemplifies csf:PR_IR_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_IR_02_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "PR.IR-02.Ex1"@en,
        "PR.IR-02.Ex1"@nl ;
    rdfs:comment "Protect organizational equipment from known environmental threats, such as flooding, fire, wind, and excessive heat and humidity"@en ;
    csf:csfIdentifier "PR.IR-02.Ex1" ;
    csf:exemplifies csf:PR_IR_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
