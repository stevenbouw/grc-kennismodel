    fw:hasIdentifier "NIST-SP-800-39" ;
    fw:hasVersionLabel "1.0" ;
    fw:isMandatoryForDutchGovernment false ;
    fw:issuedBy fw:NIST ;
    fw:officialURL "https://doi.org/10.6028/NIST.SP.800-39"^^xsd:anyURI .

isms:CL_Vertrouwelijk a isms:InformationClassificationLevel ;
    rdfs:label "Confidential"@en,
        "Vertrouwelijk"@nl ;
    rdfs:comment "Sensitive information; disclosure may cause damage. VIR 2007."@en,
        "Gevoelige informatie; openbaarmaking kan schade toebrengen. VIR 2007."@nl .

isms:ISMSProcess a owl:Class ;
    rdfs:label "ISMS Process"@en,
        "ISMS-proces"@nl ;
    rdfs:comment "A defined, repeatable activity that contributes to the operation of the ISMS."@en,
        "Een gedefinieerde, herhaalbare activiteit die bijdraagt aan de werking van het ISMS."@nl .

isms:POL_001 a isms:TopLevelPolicy ;
    isms:approvedDate "2025-11-01"^^xsd:date ;
    isms:documentID "POL-001" ;
    isms:documentTitle "Information Security Policy"@en,
        "Overkoepelend Informatiebeveiligingsbeleid"@nl ;
    isms:documentVersion "2.1" ;
    isms:reviewDate "2026-11-01"^^xsd:date .

isms:SupportingAsset a owl:Class ;
    rdfs:label "Supporting Asset"@en,
        "Ondersteunend bedrijfsmiddel"@nl ;
    rdfs:comment "Hardware, software, network, personnel or site assets that support primary assets. [ISO/IEC 27005:2022]"@en,
        "Hardware-, software-, netwerk-, personeel- of locatiebedrijfsmiddelen die primaire bedrijfsmiddelen ondersteunen. [ISO/IEC 27005:2022]"@nl ;
    rdfs:subClassOf isms:InformationAsset .

risk:HumanAsset a owl:Class ;
    rdfs:label "Human Asset"@en,
        "Menselijk bedrijfsmiddel"@nl ;
    rdfs:comment "Personnel and their associated knowledge, skills and competencies."@en,
        "Personeel en de bijbehorende kennis, vaardigheden en competenties."@nl ;
    rdfs:subClassOf risk:Asset .

risk:IL_Significant a risk:ImpactLevel ;
    rdfs:label "Significant (4)"@en,
        "Aanzienlijk (4)"@nl ;
    rdfs:comment "Severe consequences; major disruption, significant financial or reputational damage."@en,
        "Ernstige gevolgen; grote verstoring, aanzienlijke financiële of reputatieschade."@nl ;
    risk:hasImpactScore 4 .

risk:LL_Medium a risk:LikelihoodLevel ;
    rdfs:label "Medium (3)"@en,
        "Gemiddeld (3)"@nl ;
    rdfs:comment "Event may occur (once in 1–5 years)."@en,
        "Gebeurtenis kan optreden (eenmaal in 1–5 jaar)."@nl ;
    risk:hasLikelihoodScore 3 .

risk:OrganisationalVulnerability a owl:Class ;
    rdfs:label "Organisational Vulnerability"@en,
        "Organisatorische kwetsbaarheid"@nl ;
    rdfs:comment "A weakness in organisational processes, procedures, governance structures or culture."@en,
        "Een zwakheid in organisatorische processen, procedures, bestuursstructuren of cultuur."@nl ;
    rdfs:subClassOf risk:Vulnerability .

risk:R_001 a risk:InformationSecurityRisk ;
    risk:affects risk:InformationAsset,
        risk:SystemAsset ;
    risk:atManagementTier risk:Tier3_InformationSystem ;
    risk:hasImpact risk:IL_Critical ;
    risk:hasImpactCategory risk:IC_Availability,
        risk:IC_Financial,
        risk:IC_Integrity ;
    risk:hasInherentRiskScore 20 ;
    risk:hasLikelihood risk:LL_High ;
    risk:hasRiskDescription "Medewerkers klikken op kwaadaardige link waardoor ransomware wordt geïnstalleerd op bedrijfssystemen."@nl ;
    risk:hasRiskID "R-001" ;
    risk:hasRiskTitle "Ransomware via phishing e-mail"@nl ;
    risk:hasThreat risk:T_Ransomware ;
    risk:hasVulnerability risk:V_NoAwareness,
        risk:V_UnpatchedSoftware ;
    risk:mitigatedBy ctrl:ISO27002_6_03,
        ctrl:ISO27002_8_07,
        ctrl:ISO27002_8_13 .

risk:R_002 a risk:InformationSecurityRisk ;
    risk:affects risk:InformationAsset ;
    risk:atManagementTier risk:Tier2_MissionBusinessProcess ;
    risk:hasImpact risk:IL_Significant ;
    risk:hasImpactCategory risk:IC_Confidentiality,
        risk:IC_Legal ;
    risk:hasInherentRiskScore 12 ;
    risk:hasLikelihood risk:LL_Medium ;
    risk:hasRiskDescription "Accounts van vertrokken medewerkers worden niet tijdig uitgeschakeld, waardoor toegang tot systemen mogelijk blijft."@nl ;
    risk:hasRiskID "R-002" ;
    risk:hasRiskTitle "Ongeautoriseerde toegang door ex-medewerker"@nl ;
    risk:hasThreat risk:T_UnauthorisedAccess ;
    risk:hasVulnerability risk:V_ExcessivePrivileges ;
    risk:mitigatedBy ctrl:ISO27002_5_18,
        ctrl:ISO27002_6_05 .

risk:R_003 a risk:InformationSecurityRisk ;
    risk:affects risk:InformationAsset ;
    risk:atManagementTier risk:Tier2_MissionBusinessProcess ;
    risk:hasImpact risk:IL_Significant ;
    risk:hasImpactCategory risk:IC_Confidentiality,
        risk:IC_Legal,
        risk:IC_Reputational ;
    risk:hasInherentRiskScore 12 ;
    risk:hasLikelihood risk:LL_Medium ;
    risk:hasRiskDescription "Een leverancier die toegang heeft tot persoonsgegevens lekt deze door een beveiligingsincident aan zijn kant."@nl ;
    risk:hasRiskID "R-003" ;
    risk:hasRiskTitle "Datalek door leverancier"@nl ;
    risk:hasThreat risk:T_DataLeak ;
    risk:hasVulnerability risk:V_WeakSupplierVetting ;
    risk:mitigatedBy ctrl:ISO27002_5_19,
        ctrl:ISO27002_5_20,
        ctrl:ISO27002_5_21 .

risk:TS_Insider a risk:HumanThreatSource ;
    rdfs:label "Malicious insider"@en,
        "Kwaadwillende insider"@nl .

risk:TS_NationState a risk:HumanThreatSource ;
    rdfs:label "Nation-state actor"@en,
