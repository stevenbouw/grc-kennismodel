ctrl:Organisatorisch a ctrl:ControlTheme ;
    rdfs:label "Organisational"@en,
        "Organisatorisch"@nl .

compl:LegalObligation a owl:Class ;
    rdfs:label "Legal Obligation"@en,
        "Wettelijke verplichting"@nl ;
    rdfs:comment "An obligation arising directly from national or EU law or regulation."@en,
        "D12 obligation layer (v4.3.3): legal grouping below article level, linked via compl:derivedFrom chain to compl:RegulatoryObligation (legal layer) and to framework-specific compl:ComplianceRequirement subclasses (requirement layer)."@en,
        "D12 obligation-laag (v4.3.3): juridische groepering onder artikel-niveau, via compl:derivedFrom-keten gekoppeld aan compl:RegulatoryObligation (wettelijke laag) en aan framework-specifieke compl:ComplianceRequirement-subklassen (requirement-laag)."@nl,
        "Een verplichting die rechtstreeks voortvloeit uit nationale of EU-wet- of regelgeving."@nl ;
    rdfs:subClassOf compl:Obligation .

ctrl:Control a owl:Class ;
    rdfs:label "Control"@en,
        "Beheersmaatregel"@nl ;
    rdfs:comment "An information security control. Each control in this namespace is identical across ISO 27001:2022 Annex A (the requirement), ISO 27002:2022 (implementation guidance) and BIO 2.0 (mandatory baseline). The ctrl: namespace models the control itself; ISO 27002 provides additional implementation guidance; BIO 2.0 adds government-specific measures via bio:OverheidsMaatregel."@en,
        "Een beheersmaatregel voor informatiebeveiliging. Elke control in deze namespace is identiek in ISO 27001:2022 Bijlage A (de eis), ISO 27002:2022 (de implementatierichtlijn) en BIO 2.0 (het verplichte kader). De ctrl:-namespace modelleert de control zelf; ISO 27002 biedt aanvullende implementatierichtlijnen; BIO 2.0 voegt overheidsspecifieke maatregelen toe via bio:OverheidsMaatregel."@nl .

fw:CBW a fw:NationalLaw ;
    rdfs:label "Cyber Security Act (CBW)"@en,
        "Cyberbeveiligingswet (CBW)"@nl ;
    rdfs:comment "Intended Dutch transposition of the NIS2 Directive (EU 2022/2555). Sets requirements for essential and important entities regarding cybersecurity, incident reporting and supervision. Status March 2026: not yet in force."@en,
        "Beoogde Nederlandse implementatiewet van de NIS2-richtlijn (EU 2022/2555). Stelt eisen aan essentiële en belangrijke entiteiten m.b.t. cyberveiligheid, meldplichten en toezicht. Stand maart 2026: nog niet van kracht."@nl ;
    skos:altLabel "Cyberbeveiligingswet"@nl ;
    skos:closeMatch fw:NIS2_Directive ;
    prov:wasDerivedFrom fw:NIS2_Directive ;
    fw:appliesInJurisdiction fw:JurisdictionNL ;
    fw:hasDomain fw:DomainCybersecurity ;
    fw:hasIdentifier "NL-CBW" ;
    fw:isMandatoryForDutchGovernment true ;
    fw:isTranspositieVan fw:NIS2_Directive ;
    fw:issuedBy fw:DutchCentral ;
    fw:status "in preparation"@en,
        "in voorbereiding"@nl ;
    fw:uitgewerktIn fw:Cbb .

fw:GRCFramework a owl:Class ;
    rdfs:label "GRC Framework"@en,
        "GRC-kaderwerk"@nl ;
    rdfs:comment "The top-level class for all governance, risk and compliance frameworks, regulations, standards, guidelines and best practices."@en,
        "De bovenliggende klasse voor alle governance-, risk- en compliance-kaderwerken, wet- en regelgeving, normen, richtlijnen en best practices."@nl .

ext:ISMSRequirement a owl:Class ;
    rdfs:label "ISMS Requirement"@en,
        "ISMS-eis"@nl ;
    rdfs:subClassOf compl:ComplianceRequirement .

asset:Asset a owl:Class ;
    rdfs:label "Asset"@en,
        "Bedrijfsmiddel"@nl ;
    dcterms:source "ISO/IEC 27005:2024; BVA-stelsel Rijksdienst 2021 art. 1k" ;
    rdfs:comment "Top-level class for any asset that has value to the organisation and requires protection. Framework-neutral root (D9). Subclasses cover the seven BVA Te Beschermen Belangen (BVA-stelsel 2021 art. 1k) and the ISO 27005:2024 asset categorisation."@en,
        "Topklasse voor elk bedrijfsmiddel dat waarde heeft voor de organisatie en bescherming vereist. Framework-neutrale basis (D9). Subklassen dekken de zeven BVA Te Beschermen Belangen (BVA-stelsel 2021 art. 1k) en de ISO 27005:2024-asset-categorisering."@nl ;
    rdfs:seeAlso isms:InformationAsset ;
    owl:sameAs risk:Asset .

asset:Software a owl:Class ;
    rdfs:label "Software"@en,
        "Programmatuur"@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" ;
    rdfs:comment "Software components of an information system: applications, services, libraries, firmware. Per CIO-stelsel 2026 art. 1o 'programmatuur'."@en,
        "Programmatuur-componenten van een informatiesysteem: applicaties, diensten, libraries, firmware. Per CIO-stelsel 2026 art. 1o 'programmatuur'."@nl ;
    rdfs:subClassOf asset:AssetComponent .

roles:R_ISSO a roles:SpecialistRole ;
    roles:hasRoleDescription "Verantwoordelijk voor de operationele informatiebeveiliging van één of meer informatiesystemen. Rapporteert aan de CISO. Voert de SoA-beoordeling uit op systeemniveau."@nl ;
    roles:hasRoleID "SPEC-02" ;
    roles:hasRoleTitle "Information Systems Security Officer (ISSO)"@en,
        "Information Systems Security Officer (ISSO)"@nl ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:reportsTo roles:R_CISO .

asset:HumanAsset a owl:Class ;
    rdfs:label "Human Asset"@en,
        "Personeel bedrijfsmiddel"@nl ;
    dcterms:source "ISO/IEC 27005:2024; BVA-stelsel 2021 art. 1k (personen)" ;
    rdfs:comment "Persons as protectable assets: employees, external staff, role-holders. Per masterchat-decision D-M18-5, persons are NOT modelled as components of InformationSystem (Option A). The operator-relation is expressed via asset:isOperatedBy. Role-assignment is handled by the M04 roles-module."@en,
        "Personen als beschermwaardige bedrijfsmiddelen: medewerkers, externen, rolhouders. Conform masterchat-besluit D-M18-5 worden personen NIET als component van InformationSystem gemodelleerd (Optie A). De bedienings-relatie wordt uitgedrukt via asset:isOperatedBy. Rolkoppeling valt onder M04 rollen-module."@nl ;
    rdfs:seeAlso roles:Role ;
    rdfs:subClassOf asset:Asset ;
    owl:sameAs risk:HumanAsset ;
    skos:exactMatch fw:TBB_Personen .

fw:ISO_IEC_27001_2022 a fw:InternationalStandard ;
    rdfs:label "ISO/IEC 27001:2022"@en,
        "ISO/IEC 27001:2022"@nl ;
    rdfs:comment "Requirements for an Information Security Management System (ISMS)."@en,
        "Eisen voor een managementsysteem voor informatiebeveiliging (ISMS)."@nl ;
    skos:broadMatch fw:ISO_31000_2018 ;
    skos:relatedMatch fw:BIO_2_0,
        fw:NIST_SP_800_53_R5 ;
    prov:wasDerivedFrom fw:ISO_IEC_27001_2013 ;
    fw:appliesInJurisdiction fw:JurisdictionInternational,
        fw:JurisdictionNL ;
    fw:hasDomain fw:DomainInformationSecurity ;
    fw:hasIdentifier "ISO-IEC-27001-2022" ;
    fw:hasPublicationDate "2022-10-01"^^xsd:date ;
    fw:hasScope "ISMS requirements – applicable to all types and sizes of organisations."@en ;
    fw:hasVersionLabel "2022" ;
    fw:isMandatoryForDutchGovernment true ;
    fw:issuedBy fw:IEC,
        fw:ISO ;
    fw:officialURL "https://www.iso.org/standard/27001"^^xsd:anyURI ;
    fw:relatedTo fw:ISO_IEC_27002_2022 .

ctrl:SD_Bescherming a ctrl:SecurityDomain ;
    rdfs:label "Protection"@en,
        "Bescherming"@nl .

roles:R_CISO a roles:SpecialistRole ;
    skos:closeMatch fw:ISO_IEC_27001_2022 ;
    roles:advisesRole roles:R_SecretarisDirecteur ;
    roles:hasRoleDescription "Verantwoordelijk voor het informatiebeveiligingsbeleid, ISMS, risicobeheerprogramma en compliance. Adviseert CIO en bestuur. ISO 27001:2022 §5.3."@nl ;
    roles:hasRoleID "CIO-02" ;
    roles:hasRoleTitle "Chief Information Security Officer (CISO)"@en,
        "Chief Information Security Officer (CISO)"@nl ;
    roles:isAccountableFor roles:ACT_BewustwordingTraining,
        roles:ACT_ComplianceMonitoring,
        roles:ACT_IncidentAfhandelen,
        roles:ACT_RisicoBehandelplanOpstellen,
        roles:ACT_RisicoBeoordelingUitvoeren,
        roles:ACT_SoAOpstellen ;
    roles:isConsultedFor roles:ACT_BeheersmaatregelImplementatie,
        roles:ACT_ISMSInternAudit,
        roles:ACT_RestRisicoAanvaarden ;
    roles:isInformedAbout roles:ACT_IncidentMelden ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:isResponsibleFor roles:ACT_BeveiligingsbeleidVaststellen,
        roles:ACT_ComplianceMonitoring,
        roles:ACT_DirectieBeoordelingISMS,
        roles:ACT_LeveranciersBeheer,
        roles:ACT_NIS2MeldingPlicht,
        roles:ACT_RisicoBehandelplanOpstellen,
        roles:ACT_RisicobeleidVaststellen,
        roles:ACT_SoAOpstellen ;
    roles:mandatedBy fw:ISO_IEC_27001_2022 ;
    roles:reportsTo roles:R_CIO .

ctrl:Beschermen a ctrl:CybersecurityConcept ;
    rdfs:label "Protect"@en,
        "Beschermen"@nl .

ctrl:Preventief a ctrl:ControlType ;
    rdfs:label "Preventive"@en,
        "Preventief"@nl .

asset:InformationSystem a owl:Class ;
    rdfs:label "Information System"@en,
        "Informatiesysteem"@nl ;
    dcterms:source "ISO/IEC 27005:2024; Besluit CIO-stelsel Rijksdienst 2026 art. 1o; BVA-stelsel 2021 art. 1k (informatiesystemen)" ;
    rdfs:comment "A composite asset consisting of data collections, procedures, processes, software and facilities for storage, processing and communication. Per Besluit CIO-stelsel Rijksdienst 2026 art. 1o. Components are linked via asset:hasComponent. Persons who operate the system are linked via asset:isOperatedBy — NOT via asset:hasComponent (masterchat decision D-M18-5: CIO-stelsel primary source, not VIRBI 2025 / VIR 2007 which do include 'personen' in the informatiesysteem definition)."@en,
        "Een samengesteld bedrijfsmiddel bestaande uit gegevensverzamelingen, procedures, processen, programmatuur en voorzieningen voor opslag, verwerking en communicatie. Conform Besluit CIO-stelsel Rijksdienst 2026 art. 1o. Componenten via asset:hasComponent. Personen die het systeem bedienen via asset:isOperatedBy — NIET via asset:hasComponent (masterchat-besluit D-M18-5: CIO-stelsel als primaire bron, niet VIRBI 2025 / VIR 2007 die 'personen' wel in de informatiesysteem-definitie opnemen)."@nl ;
    rdfs:subClassOf asset:Asset ;
    skos:exactMatch fw:TBB_Informatiesystemen .

ctrl:Beschikbaarheid a ctrl:SecurityProperty ;
    rdfs:label "Availability"@en,
        "Beschikbaarheid"@nl .

ctrl:Integriteit a ctrl:SecurityProperty ;
    rdfs:label "Integrity"@en,
        "Integriteit"@nl .

ctrl:Vertrouwelijkheid a ctrl:SecurityProperty ;
    rdfs:label "Confidentiality"@en,
        "Vertrouwelijkheid"@nl .

isms:Status_NogNietBeoordeeld a owl:NamedIndividual,
        isms:ApplicabilityDecision ;
    rdfs:label "Not yet assessed"@en,
        "Nog niet beoordeeld"@nl .

isms:SoA_2026 a owl:NamedIndividual,
        isms:StatementOfApplicability ;
    rdfs:label "Statement of Applicability 2026"@en,
        "Statement of Applicability 2026"@nl ;
    dcterms:created "2026-03-10"^^xsd:date ;
    rdfs:comment "Complete SoA based on ISO 27001:2022 Annex A / ISO 27002:2022. Status: draft — applicability decisions not yet taken."@en,
        "Volledige SoA op basis van ISO 27001:2022 Annex A / ISO 27002:2022. Status: concept — toepasselijkheidsbesluiten nog niet genomen."@nl ;
    owl:versionInfo "concept-v1" ;
    isms:hasSoAVersion "2026-v1"^^xsd:string .

ctrl:ISO27002Control a owl:Class ;
    rdfs:label "ISO/IEC 27002:2022 Control"@en,
        "ISO/IEC 27002:2022 Beheersmaatregel"@nl ;
    rdfs:comment "A control defined in ISO/IEC 27002:2022, organised in four themes: Organisational, People, Physical, Technological."@en,
        "Een beheersmaatregel gedefinieerd in ISO/IEC 27002:2022, georganiseerd in vier thema's: Organisatorisch, Mensgericht, Fysiek, Technologisch."@nl ;
    rdfs:subClassOf ctrl:Control .

bio:BIOControl a owl:Class ;
    rdfs:label "BIO Control"@en,
        "BIO Beheersmaatregel"@nl ;
    rdfs:subClassOf ctrl:Control .

fw:ISO_IEC_27002_2022 a fw:InternationalStandard ;
    rdfs:label "ISO/IEC 27002:2022"@en,
        "ISO/IEC 27002:2022"@nl ;
    rdfs:comment "ISO/IEC 27002:2022 contains the same 93 controls as ISO 27001:2022 Annex A, but with detailed implementation guidance, examples and considerations. It is not a separate set of controls but a guidance document for the same set. Controls are modelled in the ctrl: namespace."@en,
        "ISO/IEC 27002:2022 bevat dezelfde 93 beheersmaatregelen als ISO 27001:2022 Bijlage A, maar voorzien van gedetailleerde implementatierichtlijnen, voorbeelden en overwegingen. Het is geen apart set maatregelen maar een handleiding bij dezelfde set. De controls worden in dit model gemodelleerd in de ctrl:-namespace."@nl ;
    fw:appliesInJurisdiction fw:JurisdictionInternational,
        fw:JurisdictionNL ;
    fw:geeftRichtlijnenVoor fw:ISO_IEC_27001_2022 ;
    fw:hasDomain fw:DomainInformationSecurity ;
    fw:hasIdentifier "ISO-IEC-27002-2022" ;
    fw:hasPublicationDate "2022-02-15"^^xsd:date ;
    fw:hasVersionLabel "2022" ;
    fw:isMandatoryForDutchGovernment true ;
    fw:issuedBy fw:IEC,
        fw:ISO ;
    fw:officialURL "https://www.iso.org/standard/75652.html"^^xsd:anyURI ;
    fw:relatedTo fw:ISO_IEC_27001_2022 .

isms:SoAEntry a owl:Class ;
    rdfs:label "SoA Entry"@en,
        "VvT-invoer"@nl ;
    rdfs:comment "A single row in the Statement of Applicability, corresponding to one ISO/IEC 27001:2022 Annex A control (= ISO/IEC 27002:2022 control). Contains: control reference, applicability decision, implementation status, justification."@en,
        "Een enkele rij in de Verklaring van Toepasselijkheid, overeenkomend met één ISO/IEC 27001:2022 Bijlage A-beheersmaatregel. Bevat: controlreferentie, toepasselijkheidsbeslissing, implementatiestatus, motivatie."@nl .

ext:NISTControl a owl:Class ;
    rdfs:label "NIST Control"@en,
        "NIST Beheersmaatregel"@nl ;
    rdfs:subClassOf ctrl:Control .

asset:InformationAsset a owl:Class ;
    rdfs:label "Information Asset"@en,
        "Informatiebedrijfsmiddel"@nl ;
    dcterms:source "ISO/IEC 27005:2024; BVA-stelsel 2021 art. 1k (informatie); VIRBI 2025" ;
    rdfs:comment "Information as a standalone asset: data, documents, knowledge. Includes classified information under VIRBI 2025. Distinct from asset:InformationSystem (which is the composite processing environment)."@en,
        "Informatie als zelfstandig bedrijfsmiddel: data, documenten, kennis. Omvat gerubriceerde informatie onder VIRBI 2025. Onderscheiden van asset:InformationSystem (dat de samengestelde verwerkingsomgeving is)."@nl ;
    rdfs:seeAlso isms:InformationAsset ;
    rdfs:subClassOf asset:Asset ;
    owl:sameAs isms:InformationAsset,
        risk:InformationAsset ;
    skos:exactMatch fw:TBB_Informatie .

csf:Subcategory a owl:Class ;
    rdfs:label "CSF Subcategory"@en,
        "CSF-Subcategory"@nl ;
    rdfs:comment "A Subcategory from NIST Cybersecurity Framework 2.0. Subcategories describe specific technical and management outcomes that realise a Category. CSF 2.0 has 106 Subcategories with format XX.YY-NN (e.g. GV.OC-01)."@en,
        "Een Subcategory uit NIST Cybersecurity Framework 2.0. Subcategories beschrijven specifieke technische en management-uitkomsten die een Category verwezenlijken. CSF 2.0 telt 106 Subcategories met format XX.YY-NN (bv. GV.OC-01)."@nl ;
    rdfs:subClassOf ext:FrameworkComponent .

fw:NIST_SP_800_53_R5 a fw:NationalStandard ;
    rdfs:label "NIST SP 800-53 Rev. 5"@en,
        "NIST SP 800-53 Rev. 5"@nl ;
    rdfs:comment "Security and Privacy Controls for Information Systems and Organizations."@en,
        "Beveiligings- en privacymaatregelen voor informatiesystemen en organisaties."@nl ;
    fw:alignsWith fw:ISO_IEC_27002_2022 ;
    fw:appliesInJurisdiction fw:JurisdictionUS ;
    fw:hasDomain fw:DomainInformationSecurity,
        fw:DomainPrivacy ;
    fw:hasIdentifier "NIST-SP-800-53-R5" ;
    fw:hasPublicationDate "2020-09-23"^^xsd:date ;
    fw:hasVersionLabel "Rev.5" ;
    fw:isMandatoryForDutchGovernment false ;
    fw:issuedBy fw:NIST ;
    fw:officialURL "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI .

bio:OverheidsMaatregel a owl:Class ;
    rdfs:label "Government-Specific Measure"@en,
        "Overheidsmaatregel"@nl ;
    rdfs:subClassOf ctrl:Control .

isms:CapabilityLevelDescription a owl:Class ;
    rdfs:label "Capability Level Description"@en,
        "Beschrijving capability-niveau"@nl ;
    rdfs:comment "Item-specific description of what a specific level means for a specific MaturityCapability. Qualified relation between capability and level."@en,
        "Item-specifieke beschrijving van wat een specifiek niveau betekent voor een specifieke MaturityCapability. Qualified-relation tussen capability en niveau."@nl .

ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 a owl:NamedIndividual,
        ext:SourceAttribution ;
    rdfs:label "NBA-LIO/NOREA Maturity Model (via CBW-Excel)"@en,
        "NBA-LIO/NOREA Volwassenheidsmodel (via CBW-Excel)"@nl ;
    ext:hasAttributionText "Maturity model level descriptions from NBA-LIO/NOREA, delivered via CBW-Excel sheet 'Volwassenheid beheersmaatregel' (ADR/NOREA, version 1.0 dated 30 September 2025, CC-BY 4.0). Original methodology: NBA-LIO/NOREA Maturity Model. SHA256 CBW-Excel: 52472ddb28eb0ddc81b06ded72d071bbe42f644b0ab3b6d93338315fce03d23b"@en,
        "Volwassenheidsmodel-niveaubeschrijvingen afkomstig van NBA-LIO/NOREA, toegeleverd via CBW-Excel sheet 'Volwassenheid beheersmaatregel' (ADR/NOREA, versie 1.0 van 30 september 2025, CC-BY 4.0). Originele methodologie: NBA-LIO/NOREA Volwassenheidsmodel. SHA256 CBW-Excel: 52472ddb28eb0ddc81b06ded72d071bbe42f644b0ab3b6d93338315fce03d23b"@nl ;
    ext:hasLicense "CC-BY 4.0 (CBW-Excel)" ;
    ext:hasLicenseURL "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
    ext:hasSourcePublicationDate "2025-09-30"^^xsd:date ;
    ext:hasSourceVersion "CBW-Excel v1.0 (NBA-LIO/NOREA-content)" .

fw:BIO_2_0 a fw:GovernmentBaseline ;
    rdfs:label "BIO 2.0 (Baseline Informatiebeveiliging Overheid)"@en,
        "BIO 2.0 (Baseline Informatiebeveiliging Overheid)"@nl ;
    rdfs:comment "The mandatory minimum information security baseline for all Dutch government entities, version 2.0 (March 2026)."@en,
        "De verplichte minimale informatiebeveiligingsbaseline voor alle Nederlandse overheidsorganisaties, versie 2.0 (maart 2026)."@nl ;
    skos:broadMatch fw:NIS2_Directive ;
    skos:closeMatch fw:ISO_IEC_27002_2022 ;
    prov:wasDerivedFrom fw:ISO_IEC_27002_2022 ;
    fw:alignsWith fw:ISO_IEC_27001_2022,
        fw:ISO_IEC_27002_2022 ;
    fw:appliesInJurisdiction fw:JurisdictionNL ;
    fw:dektAf fw:NIS2_Directive ;
    fw:hasDomain fw:DomainInformationSecurity ;
    fw:hasIdentifier "BIO-2.0" ;
    fw:hasPublicationDate "2026-03-05"^^xsd:date ;
    fw:hasVersionLabel "2.0" ;
    fw:isMandatoryForDutchGovernment true ;
    fw:issuedBy fw:DutchCentral,
        fw:NCSC_NL ;
    fw:officialURL "https://bio-overheid.nl"^^xsd:anyURI ;
    fw:supersedes fw:BIO_1_0 .

csf:ImplementationExample a owl:Class ;
    rdfs:label "CSF Implementation Example"@en,
        "CSF Implementation Example"@nl ;
    rdfs:comment "An Implementation Example from NIST Cybersecurity Framework 2.0. Implementation Examples are action-oriented examples for achieving a Subcategory outcome. Not exhaustive; not a required baseline of actions."@en,
        "Een Implementation Example uit NIST Cybersecurity Framework 2.0. Implementation Examples zijn actie-georienteerde voorbeelden voor het verwezenlijken van een Subcategory-uitkomst. Niet uitputtend; geen verplichte baseline-acties."@nl ;
    rdfs:subClassOf ext:FrameworkComponent .

ext:Attr_NIST_CSF_2_0_Core_2024 a owl:NamedIndividual,
        ext:SourceAttribution ;
    rdfs:label "NIST CSF 2.0 Core — Public Domain"@en,
        "NIST CSF 2.0 Core — Publiek domein"@nl ;
    ext:hasAttributionText "NIST Cybersecurity Framework 2.0, NIST CSWP 29 (26 February 2024). Public domain as US Federal Government work. Contains: 6 Functions, 22 Categories, 106 Subcategories, ~385 Implementation Examples."@en,
        "NIST Cybersecurity Framework 2.0, NIST CSWP 29 (26 februari 2024). Publiek domein als werk van de Amerikaanse federale overheid. Bevat: 6 Functions, 22 Categories, 106 Subcategories, ~385 Implementation Examples."@nl ;
    ext:hasLicense "Public Domain (US Government Work)" ;
    ext:hasLicenseURL "https://www.nist.gov/oism/copyrights"^^xsd:anyURI ;
    ext:hasSourcePublicationDate "2024-02-26"^^xsd:date ;
    ext:hasSourceVersion "2.0" .

fw:NIST_CSF_2_0 a owl:NamedIndividual,
        fw:GRCFramework ;
    rdfs:label "NIST Cybersecurity Framework 2.0"@en,
        "NIST Cybersecurity Framework 2.0"@nl ;
    fw:appliesInJurisdiction fw:JurisdictionInternational ;
    fw:hasIdentifier "NIST_CSF_2_0" ;
    fw:hasPublicationDate "2024-02-26"^^xsd:date ;
    fw:hasScope "Mapped reference framework for cybersecurity risk management. Not legally required; supportive for executive communication and supply chain. Contains 6 Functions, 22 Categories, 106 Subcategories with SKOS mappings to ISO 27001/27002, NIST SP 800-53 and BIO 2.0."@en,
        "Gemapt referentiekader voor cybersecurity-risicobeheer. Niet wettelijk verplicht; ondersteunend voor bestuurscommunicatie en supply-chain. Bevat 6 Functions, 22 Categories, 106 Subcategories met SKOS-mappings naar ISO 27001/27002, NIST SP 800-53 en BIO 2.0."@nl ;
    fw:hasVersionLabel "2.0" ;
    fw:isMandatoryForDutchGovernment false ;
    fw:issuedBy fw:NIST ;
    fw:officialURL "https://www.nist.gov/cyberframework"^^xsd:anyURI ;
    fw:status "established"@en,
        "vastgesteld"@nl .

[] a owl:AllDisjointClasses ;
    owl:members ( biz:KPI biz:KRI biz:KCI ) .

[] a owl:AllDisjointClasses ;
    owl:members ( isms:Policy isms:Procedure isms:Guideline isms:WorkInstruction isms:Record ) .

[] a owl:AllDisjointClasses ;
    owl:members ( risk:InformationSecurityRisk risk:OperationalRisk risk:StrategicRisk risk:ComplianceRisk risk:ReportingRisk ) .

[] a owl:AllDisjointClasses ;
    owl:members ( risk:RiskMitigation risk:RiskAcceptance risk:RiskAvoidance risk:RiskTransfer ) .

[] a owl:AllDisjointClasses ;
    owl:members ( risk:InformationAsset risk:SystemAsset risk:PhysicalAsset risk:HumanAsset risk:ServiceAsset ) .

[] a owl:AllDisjointClasses ;
    owl:members ( compl:LegalObligation compl:StandardsObligation compl:PolicyObligation compl:ContractualObligation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( compl:NonConformity compl:Observation compl:PositiveFinding ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ctrl:ISO27002Control ctrl:NIST80053Control ) .

[] a owl:AllDisjointClasses ;
    owl:members ( roles:Person roles:OrganisationalUnit roles:ExternalParty ) .

[] a owl:AllDisjointClasses ;
    owl:members ( roles:GovernanceRole roles:ManagementRole roles:SpecialistRole roles:OwnerRole roles:OperationalRole roles:AuditRole ) .

