    ext:hasCbwArticle "art. 21 lid b en c" ;
    ext:hasHandreikingBBN 1 .

csf:Category a owl:Class ;
    rdfs:label "CSF Category"@en,
        "CSF-Category"@nl ;
    rdfs:comment "A Category from NIST Cybersecurity Framework 2.0. Categories are subdivisions of Functions that group related cybersecurity outcomes. CSF 2.0 has 22 Categories distributed across 6 Functions."@en,
        "Een Category uit NIST Cybersecurity Framework 2.0. Categories zijn onderverdelingen van Functions die gerelateerde cybersecurity-uitkomsten groeperen. CSF 2.0 telt 22 Categories verdeeld over 6 Functions."@nl ;
    rdfs:subClassOf ext:FrameworkComponent .

ext:NIST_IR_4 a owl:NamedIndividual,
        ext:NISTControl ;
    rdfs:label "IR-4"@en ;
    ctrl:definedInFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlDomain ext:NIST_CF_IR ;
    ctrl:hasControlID "IR-4" ;
    ext:mappedToISO27002 ctrl:ISO27002_5_24,
        ctrl:ISO27002_5_25,
        ctrl:ISO27002_5_26 .

asset:Equipment a owl:Class ;
    rdfs:label "Equipment"@en,
        "Materieel"@nl ;
    dcterms:source "BVA-stelsel Rijksdienst 2021 art. 1k" ;
    rdfs:comment "Equipment: durable operational resources such as hardware, tools, vehicles, specialised instruments. Corresponds to BVA-stelsel 2021 art. 1k 'materieel'."@en,
        "Materieel: duurzame operationele middelen zoals hardware, gereedschap, voertuigen, specialistische instrumenten. Correspondeert met BVA-stelsel 2021 art. 1k 'materieel'."@nl ;
    rdfs:subClassOf asset:PhysicalAsset ;
    skos:exactMatch fw:TBB_Materieel .

ctrl:CBWControl a owl:Class ;
    rdfs:label "CBW control"@en,
        "CBW-control"@nl ;
    rdfs:comment "Control from the CBW/NIS2 Control Framework (ADR & NOREA, version 1.0, 30 September 2025). Not a legally mandated security measure but an ADR/NOREA-interpretative elaboration of CBW duty-of-care articles at operational level."@en,
        "Control uit het CBW/NIS2 Control Framework (ADR & NOREA, versie 1.0, 30 september 2025). Geen wettelijk verplichte beheersmaatregel, maar een ADR/NOREA-interpretatieve uitwerking van CBW-zorgplichtartikelen op operationeel niveau."@nl ;
    rdfs:subClassOf ctrl:Control .

ext:Attr_CBW_NIS2_Framework_2025_CC_BY_4_0 a owl:NamedIndividual,
        ext:SourceAttribution ;
    rdfs:label "CBW/NIS2 Control Framework — CC-BY 4.0"@en,
        "CBW/NIS2 Control Framework — CC-BY 4.0"@nl ;
    ext:hasAttributionText "CBW/NIS2 Control Framework, ADR & NOREA, version 1.0, 30 September 2025. Contains: CBW controls, ADR/NOREA interpretation of Commission Implementing Regulation (EU) 2024/2690, sheet 9 Cbw/Cbb mappings. Licensed under CC-BY 4.0."@en,
        "CBW/NIS2 Control Framework, ADR & NOREA, versie 1.0, 30 september 2025. Bevat: CBW-controls, ADR/NOREA-interpretatie van Uitvoeringsverordening (EU) 2024/2690, sheet 9 Cbw/Cbb-mappings. Gelicentieerd onder CC-BY 4.0."@nl ;
    ext:hasLicense "CC-BY 4.0" ;
    ext:hasLicenseURL "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
    ext:hasSourcePublicationDate "2025-09-30"^^xsd:date ;
    ext:hasSourceVersion "1.0" .

fw:NIS2_Directive a fw:EUDirective ;
