csf:PR_IR_02_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "PR.IR-02.Ex2"@en,
        "PR.IR-02.Ex2"@nl ;
    rdfs:comment "Include protection from environmental threats and provisions for adequate operating infrastructure in requirements for service providers that operate systems on the organization's behalf"@en ;
    csf:csfIdentifier "PR.IR-02.Ex2" ;
    csf:exemplifies csf:PR_IR_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:PR_IR_03_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "PR.IR-03.Ex1"@en,
        "PR.IR-03.Ex1"@nl ;
    rdfs:comment "Avoid single points of failure in systems and infrastructure"@en ;
    csf:csfIdentifier "PR.IR-03.Ex1" ;
    csf:exemplifies csf:PR_IR_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
