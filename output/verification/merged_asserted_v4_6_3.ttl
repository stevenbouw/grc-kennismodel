        "ICT-dienstbeheer"@nl .

fw:ENSIA a owl:NamedIndividual,
        fw:GRCFramework ;
    rdfs:label "ENSIA — Single Normative Information Audit"@en,
        "ENSIA — Eenduidige Normatiek Single Information Audit"@nl ;
    rdfs:comment "Audit framework for information security in Dutch (local) government. ENSIA integrates accountability for information security (BIO) and domain-specific aspects into a single audit approach. Started July 1, 2017. Joint initiative of BZK, municipalities, SZW and VNG."@en,
        "Auditkader voor informatiebeveiliging bij de Nederlandse (lokale) overheid. ENSIA integreert de verantwoording over informatiebeveiliging (BIO) en domeinspecifieke aspecten in één systematiek. Gestart 1 juli 2017. Gezamenlijk initiatief van BZK, gemeenten, SZW en VNG."@nl,
        "NB: De ENSIA Handreiking v1.0 (december 2024) is primair gericht op gemeenten. Voor Rijksoverheid geldt een vergelijkbaar verantwoordingsproces. De ENSIA-toetsing 2024 is nog gebaseerd op BIO 1.04zv; overgang naar BIO 2.0 volgt."@nl ;
    skos:relatedMatch fw:BIO_2_0,
        fw:ISO_IEC_27001_2022 ;
    ext:hasAuditDomain ext:ENSIA_BAG,
        ext:ENSIA_BGT,
        ext:ENSIA_BIO,
        ext:ENSIA_BRO,
        ext:ENSIA_BRP,
        ext:ENSIA_DigiD,
        ext:ENSIA_Reisdocumenten,
        ext:ENSIA_Suwinet ;
    ext:sourceAttribution ext:Attr_ENSIA_Logius_2024 ;
    fw:appliesInJurisdiction fw:JurisdictionNL ;
    fw:hasDomain fw:DomainCompliance,
        fw:DomainInformationSecurity ;
    fw:hasIdentifier "ENSIA" ;
    fw:hasPublicationDate "2024-12-19"^^xsd:date ;
    fw:hasVersionLabel "Verantwoordingsjaar 2024" ;
    fw:isMandatoryForDutchGovernment true ;
    fw:issuedBy fw:DutchCentral,
        fw:NOREA,
        fw:VNG ;
    fw:officialURL "https://www.ensia.nl"^^xsd:anyURI ;
    fw:status "established"@en,
        "vastgesteld"@nl ;
    fw:toetst fw:BIO_2_0 .

