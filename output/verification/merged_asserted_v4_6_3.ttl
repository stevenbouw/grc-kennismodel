        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.35.1" ;
    bio:hasMaatregel "Er is een information security management system (ISMS) waarmee aantoonbaar de gehele Plan-Do-Check-Act cyclus op gestructureerde wijze wordt afgedekt." ;
    bio:implementsControl bio:ISO27002_5_35 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_35_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.35.2"@nl ;
