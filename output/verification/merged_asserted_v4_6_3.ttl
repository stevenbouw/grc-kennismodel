        csf:ImplementationExample ;
    rdfs:label "PR.PS-01.Ex2"@en,
        "PR.PS-01.Ex2"@nl ;
    rdfs:comment "Review all default configuration settings that may potentially impact cybersecurity when installing or upgrading software"@en ;
    csf:csfIdentifier "PR.PS-01.Ex2" ;
    csf:exemplifies csf:PR_PS_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
