    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_MA_02_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.MA-02.Ex2"@en,
        "RS.MA-02.Ex2"@nl ;
    rdfs:comment "Apply criteria to estimate the severity of an incident"@en ;
    csf:csfIdentifier "RS.MA-02.Ex2" ;
    csf:exemplifies csf:RS_MA_02 ;
