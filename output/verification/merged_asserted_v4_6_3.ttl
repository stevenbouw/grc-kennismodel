    rdfs:range rdfs:Literal .

biz:objectiveID a owl:DatatypeProperty ;
    rdfs:label "objective ID"@en,
        "doelstelling-ID"@nl ;
    rdfs:domain biz:StrategicObjective ;
    rdfs:range xsd:string .

