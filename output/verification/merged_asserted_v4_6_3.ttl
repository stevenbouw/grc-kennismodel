isms:ISMSScope a owl:Class ;
    rdfs:label "ISMS Scope"@en,
        "ISMS-toepassingsgebied"@nl ;
    rdfs:comment "The boundaries and applicability of the ISMS as required by ISO/IEC 27001:2022 Clause 4.3. Defines the organisational units, locations, processes and technologies covered."@en,
        "De grenzen en toepasselijkheid van het ISMS conform ISO/IEC 27001:2022 Clausule 4.3. Definieert de organisatorische eenheden, locaties, processen en technologieën die zijn opgenomen."@nl .

isms:PDCAPhase a owl:Class ;
    rdfs:label "PDCA Phase"@en,
        "PDCA-fase"@nl .

risk:HumanThreatSource a owl:Class ;
    rdfs:label "Human Threat Source"@en,
        "Menselijke dreigingsbron"@nl ;
    rdfs:comment "Threat source involving human actors, either intentional (adversarial) or unintentional (accidental)."@en,
        "Dreigingsbron waarbij menselijke actoren betrokken zijn, intentioneel (adversarieel) of onbedoeld (per ongeluk)."@nl ;
    rdfs:subClassOf risk:ThreatSource .

risk:InformationSecurityRisk a owl:Class ;
    rdfs:label "Information Security Risk"@en,
        "Informatiebeveiligingsrisico"@nl ;
    rdfs:comment "A risk specific to information security: the potential that a threat will exploit a vulnerability of an information asset causing harm to the organisation."@en,
        "Een risico specifiek voor informatiebeveiliging: de mogelijkheid dat een dreiging een kwetsbaarheid van een informatiebedrijfsmiddel benut en schade veroorzaakt."@nl ;
    rdfs:subClassOf risk:Risk ;
    prov:wasDerivedFrom fw:ISO_IEC_27005_2022 .

risk:PhysicalAsset a owl:Class ;
    rdfs:label "Physical Asset"@en,
        "Fysiek bedrijfsmiddel"@nl ;
    rdfs:comment "Physical items such as hardware, facilities, and equipment."@en,
        "Fysieke items zoals hardware, faciliteiten en apparatuur."@nl ;
    rdfs:subClassOf risk:Asset .

risk:ThreatSource a owl:Class ;
    rdfs:label "Threat Source"@en,
        "Dreigingsbron"@nl ;
    rdfs:comment "The intent and method targeted at the intentional exploitation of a vulnerability, or a situation and method that may accidentally trigger a vulnerability. [NIST SP 800-30]"@en,
        "De intentie en methode gericht op het opzettelijk benutten van een kwetsbaarheid, of een situatie en methode die per ongeluk een kwetsbaarheid kan activeren. [NIST SP 800-30]"@nl .

