    rdfs:domain biz:MaturityLevel ;
    rdfs:range xsd:integer .

biz:measuredBy a owl:ObjectProperty ;
    rdfs:label "measured by"@en,
        "gemeten door"@nl ;
    rdfs:domain biz:GRCDomain ;
    rdfs:range biz:PerformanceIndicator .

biz:measurementFrequency a owl:DatatypeProperty ;
    rdfs:label "measurement frequency"@en,
        "meetfrequentie"@nl ;
    rdfs:domain biz:PerformanceIndicator ;
    rdfs:range xsd:string .

biz:measuresControl a owl:ObjectProperty ;
    rdfs:label "measures control"@en,
        "meet beheersmaatregel"@nl ;
    rdfs:domain biz:KCI ;
