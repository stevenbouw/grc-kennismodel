        csf:ImplementationExample ;
    rdfs:label "RS.MA-04.Ex1"@en,
        "RS.MA-04.Ex1"@nl ;
    rdfs:comment "Track and validate the status of all ongoing incidents"@en ;
    csf:csfIdentifier "RS.MA-04.Ex1" ;
    csf:exemplifies csf:RS_MA_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_MA_04_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.MA-04.Ex2"@en,
        "RS.MA-04.Ex2"@nl ;
