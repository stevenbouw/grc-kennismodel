csf:RC_CO_03_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.CO-03.Ex1"@en,
        "RC.CO-03.Ex1"@nl ;
    rdfs:comment "Securely share recovery information, including restoration progress, consistent with response plans and information sharing agreements"@en ;
    csf:csfIdentifier "RC.CO-03.Ex1" ;
    csf:exemplifies csf:RC_CO_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
