    rdfs:label "VIR 2007 (Voorschrift Informatiebeveiliging Rijksdienst)"@en,
        "VIR 2007 (Voorschrift Informatiebeveiliging Rijksdienst)"@nl ;
    rdfs:comment "Dutch government regulation for information security in the central government."@en,
