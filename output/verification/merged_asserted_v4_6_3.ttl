    rdfs:label "constrains risk"@en,
        "begrenst risico"@nl ;
    rdfs:domain biz:RiskAppetite ;
    rdfs:range risk:Risk .

biz:containsEntry a owl:ObjectProperty ;
    rdfs:label "contains entry"@en,
        "bevat invoer"@nl ;
    rdfs:domain biz:ComplianceCalendar ;
    rdfs:range biz:ComplianceCalendarEntry .

biz:coversDomain a owl:ObjectProperty ;
    rdfs:label "covers domain"@en,
        "dekt domein"@nl ;
    rdfs:domain biz:GRCDomain ;
    rdfs:range compl:ComplianceDomain .

biz:currentValue a owl:DatatypeProperty ;
    rdfs:label "current value"@en,
        "huidige waarde"@nl ;
    rdfs:domain biz:PerformanceIndicator ;
    rdfs:range xsd:string .

biz:deliveredBy a owl:ObjectProperty ;
    rdfs:label "delivered by"@en,
        "geleverd door"@nl ;
    rdfs:domain biz:BusinessService ;
    rdfs:range biz:BusinessProcess .

biz:documentedIn a owl:ObjectProperty ;
    rdfs:label "documented in"@en,
        "gedocumenteerd in"@nl ;
    rdfs:domain biz:RiskAppetite ;
    rdfs:range biz:RiskAppetiteStatement .

biz:domainID a owl:DatatypeProperty ;
    rdfs:label "domain ID"@en,
        "domein-ID"@nl ;
    rdfs:domain biz:GRCDomain ;
    rdfs:range xsd:string .

biz:hasMaturityLevel a owl:ObjectProperty ;
    rdfs:label "has maturity level"@en,
        "heeft volwassenheidsniveau"@nl ;
    rdfs:domain biz:GRCDomain ;
    rdfs:range biz:MaturityLevel .

biz:hasRiskAppetite a owl:ObjectProperty ;
    rdfs:label "has risk appetite"@en,
        "heeft risicobereidheid"@nl ;
    rdfs:domain biz:GRCProgram ;
    rdfs:range biz:RiskAppetite .

biz:hasRiskTolerance a owl:ObjectProperty ;
    rdfs:label "has risk tolerance"@en,
        "heeft risicotolerantie"@nl ;
    rdfs:domain biz:GRCDomain ;
    rdfs:range biz:RiskTolerance .

