    rdfs:label "reported in"@en,
        "gerapporteerd in"@nl ;
    rdfs:domain biz:PerformanceIndicator ;
    rdfs:range biz:GRCDashboard .

biz:riskAppetiteNarrative a owl:DatatypeProperty ;
    rdfs:label "risk appetite narrative"@en,
        "risicobereidheidsformulering"@nl ;
    rdfs:domain biz:RiskAppetite ;
    rdfs:range rdfs:Literal .

biz:supportsObjective a owl:ObjectProperty ;
    rdfs:label "supports objective"@en,
        "ondersteunt doelstelling"@nl ;
    rdfs:domain biz:GRCProgram ;
    rdfs:range biz:StrategicObjective .

biz:supportsService a owl:ObjectProperty ;
    rdfs:label "supports service"@en,
        "ondersteunt dienst"@nl ;
