csf:GV_OC_01_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-01.Ex1"@en,
        "GV.OC-01.Ex1"@nl ;
    rdfs:comment "Share the organization’s mission (e.g., through vision and mission statements, marketing, and service strategies) to provide a basis for identifying risks that may impede that mission"@en ;
    csf:csfIdentifier "GV.OC-01.Ex1" ;
    csf:exemplifies csf:GV_OC_01 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_02_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-02.Ex1"@en,
        "GV.OC-02.Ex1"@nl ;
    rdfs:comment "Identify relevant internal stakeholders and their cybersecurity-related expectations (e.g., performance and risk expectations of officers, directors, and advisors; cultural expectations of employees)"@en ;
    csf:csfIdentifier "GV.OC-02.Ex1" ;
    csf:exemplifies csf:GV_OC_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_02_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-02.Ex2"@en,
        "GV.OC-02.Ex2"@nl ;
    rdfs:comment "Identify relevant external stakeholders and their cybersecurity-related expectations (e.g., privacy expectations of customers, business expectations of partnerships, compliance expectations of regulators, ethics expectations of society)"@en ;
    csf:csfIdentifier "GV.OC-02.Ex2" ;
    csf:exemplifies csf:GV_OC_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_03_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-03.Ex1"@en,
        "GV.OC-03.Ex1"@nl ;
    rdfs:comment "Determine a process to track and manage legal and regulatory requirements regarding protection of individuals’ information (e.g., Health Insurance Portability and Accountability Act, California Consumer Privacy Act, General Data Protection Regulation)"@en ;
    csf:csfIdentifier "GV.OC-03.Ex1" ;
    csf:exemplifies csf:GV_OC_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_03_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-03.Ex2"@en,
        "GV.OC-03.Ex2"@nl ;
    rdfs:comment "Determine a process to track and manage contractual requirements for cybersecurity management of supplier, customer, and partner information"@en ;
    csf:csfIdentifier "GV.OC-03.Ex2" ;
    csf:exemplifies csf:GV_OC_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_03_Ex3 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-03.Ex3"@en,
        "GV.OC-03.Ex3"@nl ;
    rdfs:comment "Align the organization’s cybersecurity strategy with legal, regulatory, and contractual requirements"@en ;
    csf:csfIdentifier "GV.OC-03.Ex3" ;
    csf:exemplifies csf:GV_OC_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_04_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-04.Ex1"@en,
        "GV.OC-04.Ex1"@nl ;
    rdfs:comment "Establish criteria for determining the criticality of capabilities and services as viewed by internal and external stakeholders"@en ;
    csf:csfIdentifier "GV.OC-04.Ex1" ;
    csf:exemplifies csf:GV_OC_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_04_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-04.Ex2"@en,
        "GV.OC-04.Ex2"@nl ;
    rdfs:comment "Determine (e.g., from a business impact analysis) assets and business operations that are vital to achieving mission objectives and the potential impact of a loss (or partial loss) of such operations"@en ;
    csf:csfIdentifier "GV.OC-04.Ex2" ;
    csf:exemplifies csf:GV_OC_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_04_Ex3 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-04.Ex3"@en,
        "GV.OC-04.Ex3"@nl ;
    rdfs:comment "Establish and communicate resilience objectives (e.g., recovery time objectives) for delivering critical capabilities and services in various operating states (e.g., under attack, during recovery, normal operation)"@en ;
    csf:csfIdentifier "GV.OC-04.Ex3" ;
    csf:exemplifies csf:GV_OC_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_05_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-05.Ex1"@en,
        "GV.OC-05.Ex1"@nl ;
    rdfs:comment "Create an inventory of the organization’s dependencies on external resources (e.g., facilities, cloud-based hosting providers) and their relationships to organizational assets and business functions"@en ;
    csf:csfIdentifier "GV.OC-05.Ex1" ;
    csf:exemplifies csf:GV_OC_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OC_05_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OC-05.Ex2"@en,
        "GV.OC-05.Ex2"@nl ;
    rdfs:comment "Identify and document external dependencies that are potential points of failure for the organization’s critical capabilities and services, and share that information with appropriate personnel"@en ;
    csf:csfIdentifier "GV.OC-05.Ex2" ;
    csf:exemplifies csf:GV_OC_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_OV_01_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.OV-01.Ex1"@en,
        "GV.OV-01.Ex1"@nl ;
    rdfs:comment "Measure how well the risk management strategy and risk results have helped leaders make decisions and achieve organizational objectives"@en ;
    csf:csfIdentifier "GV.OV-01.Ex1" ;
    csf:exemplifies csf:GV_OV_01 ;
