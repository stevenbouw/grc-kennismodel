fw:BestPractice a owl:Class ;
    rdfs:label "Best Practice"@en,
        "Best practice"@nl ;
    rdfs:comment "A framework or methodology representing industry-accepted good practice, not formally standardised."@en,
        "Een kaderwerk of methodologie die algemeen aanvaarde branchepraktijken vertegenwoordigt, zonder formele normstatus."@nl ;
    rdfs:subClassOf fw:GRCFramework ;
    owl:disjointWith fw:Guideline,
        fw:Regulation,
        fw:Standard .

fw:COSO_ICF a fw:BestPractice ;
    rdfs:label "COSO Internal Control — Integrated Framework (2013)"@en,
        "COSO Interne Beheersing — Geïntegreerd Raamwerk (2013)"@nl ;
    rdfs:comment "Enterprise-wide framework for internal control. Defines five components: Control Environment, Risk Assessment, Control Activities, Information & Communication, and Monitoring Activities. Provides the foundation that COBIT operationalises for the IT domain."@en,
        "Organisatiebreed raamwerk voor interne beheersing. Definieert vijf componenten: Beheersomgeving, Risicobeoordeling, Beheersingsactiviteiten, Informatie & Communicatie, en Monitoringactiviteiten. Vormt het fundament dat COBIT voor het IT-domein operationaliseert."@nl ;
    skos:relatedMatch fw:COBIT_2019,
        fw:ISO_IEC_27001_2022 ;
    fw:appliesInJurisdiction fw:JurisdictionInternational ;
    fw:hasDomain fw:DomainCompliance,
        fw:DomainITGovernance ;
    fw:hasIdentifier "COSO-ICF-2013" ;
    fw:hasPublicationDate "2013-05-14"^^xsd:date ;
    fw:hasVersionLabel "2013" ;
    fw:isMandatoryForDutchGovernment false ;
    fw:issuedBy fw:COSO .

fw:ISO a fw:IssuingBody ;
    rdfs:label "International Organization for Standardization"@en,
        "Internationale Organisatie voor Standaardisatie"@nl ;
    foaf:name "ISO" .

