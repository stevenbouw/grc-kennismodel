compl:REQ_NIS2_Art21_d a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 21(2)(d) — supply chain security"@en,
        "Requirement: NIS2 art. 21 lid 2 onderdeel d — beveiliging toeleveringsketen"@nl ;
