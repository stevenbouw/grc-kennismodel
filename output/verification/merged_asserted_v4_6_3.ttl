ctrl:Identificeren a ctrl:CybersecurityConcept ;
    rdfs:label "Identify"@en,
        "Identificeren"@nl .

isms:CbwCapability a owl:Class ;
    rdfs:label "Cbw Duty-of-Care Capability"@en,
        "Cbw-zorgplicht-capability"@nl ;
    rdfs:comment "An assessable capability for one of the 23 duty-of-care topics in the Cbw maturity model."@en,
        "Een evaluatiebare capability voor één van de 23 zorgplicht-thema's uit het Cbw-volwassenheidsmodel."@nl ;
