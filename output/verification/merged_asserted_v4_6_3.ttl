        "op niveau"@nl ;
    rdfs:comment "Indicates which of the 5 global MaturityCapabilityLevels a LevelDescription pertains to."@en,
        "Geeft aan op welk van de 5 globale MaturityCapabilityLevels een LevelDescription betrekking heeft."@nl ;
    rdfs:domain isms:CapabilityLevelDescription ;
    rdfs:range isms:MaturityCapabilityLevel .

isms:availabilityValue a owl:DatatypeProperty ;
    rdfs:label "availability value (1-3)"@en,
        "beschikbaarheidswaarde (1-3)"@nl ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range xsd:integer .

isms:confidentialityValue a owl:DatatypeProperty ;
    rdfs:label "confidentiality value (1-3)"@en,
        "vertrouwelijkheidswaarde (1-3)"@nl ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range xsd:integer .

isms:containsEntry a owl:ObjectProperty ;
    rdfs:label "contains SoA entry"@en,
        "bevat VvT-invoer"@nl ;
    rdfs:comment "Links a Statement of Applicability to one of its entries. Inverse of isms:forSoA."@en,
        "Koppelt een Statement of Applicability aan een van zijn entries. Inverse van isms:forSoA."@nl ;
    rdfs:domain isms:StatementOfApplicability ;
    rdfs:range isms:SoAEntry ;
    owl:inverseOf isms:forSoA .

isms:controlDomain a owl:DatatypeProperty ;
    rdfs:label "control domain"@en,
        "beheersmaatregeldomein"@nl ;
    rdfs:comment "The thematic domain of the control in the SoA context (e.g. 'Organisatorisch', 'Technologisch')."@en,
        "Het thematisch domein van de beheersmaatregel in de SoA-context (bijv. 'Organisatorisch', 'Technologisch')."@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range rdfs:Literal .

isms:documentID a owl:DatatypeProperty ;
    rdfs:label "document ID"@en,
        "document-ID"@nl ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range xsd:string .

isms:documentTitle a owl:DatatypeProperty ;
    rdfs:label "document title"@en,
        "documenttitel"@nl ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range rdfs:Literal .

isms:documentVersion a owl:DatatypeProperty ;
    rdfs:label "document version"@en,
        "documentversie"@nl ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range xsd:string .

isms:documentedIn a owl:ObjectProperty ;
    rdfs:label "documented in"@en,
        "gedocumenteerd in"@nl ;
    rdfs:domain isms:ISMSProcess ;
    rdfs:range isms:ISMSDocument .

isms:followsPhase a owl:ObjectProperty ;
    rdfs:label "follows phase"@en,
        "volgt fase"@nl ;
    rdfs:domain isms:PDCACycle ;
    rdfs:range isms:PDCAPhase .

isms:forRisk a owl:ObjectProperty ;
    rdfs:label "for risk"@en,
        "voor risico"@nl ;
    rdfs:comment "Links SoA entry to the justifying risk per ISO 27001:2022 §6.1.3.c/d/e."@en,
        "Koppelt VvT-invoer aan rechtvaardigend risico conform ISO 27001:2022 §6.1.3.c/d/e."@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:isDefinedBy isms: ;
    rdfs:range risk:Risk .

isms:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by"@en,
        "bestuurd door"@nl ;
    rdfs:domain isms:ISMS ;
    rdfs:range roles:Role .

isms:hasApplicabilityDecision a owl:ObjectProperty ;
    rdfs:label "has applicability decision"@en,
        "heeft toepasselijkheidsbeslissing"@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range isms:ApplicabilityDecision .

isms:hasClassification a owl:ObjectProperty ;
    rdfs:label "has classification"@en,
        "heeft classificatie"@nl ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range isms:InformationClassificationLevel .

isms:hasContext a owl:ObjectProperty ;
    rdfs:label "has context"@en,
        "heeft context"@nl ;
    rdfs:domain isms:ISMS ;
    rdfs:range isms:ISMSContext .

isms:hasControlObjective a owl:ObjectProperty ;
    rdfs:label "has control objective"@en,
        "heeft beheersdoelstelling"@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range isms:ControlObjective .

isms:hasExclusion a owl:DatatypeProperty ;
    rdfs:label "has exclusion"@en,
        "heeft uitsluiting"@nl ;
    rdfs:domain isms:ISMSScope ;
    rdfs:range rdfs:Literal .

isms:hasISMSID a owl:DatatypeProperty ;
    rdfs:label "has ISMS ID"@en,
        "heeft ISMS-ID"@nl ;
    rdfs:domain isms:ISMS ;
    rdfs:range xsd:string .

isms:hasImplementationStatus a owl:ObjectProperty ;
    rdfs:label "has implementation status"@en,
        "heeft implementatiestatus"@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range isms:ImplementationStatus .

isms:hasInterestedParty a owl:ObjectProperty ;
    rdfs:label "has interested party"@en,
        "heeft belanghebbende"@nl ;
    rdfs:domain isms:ISMS ;
    rdfs:range isms:InterestedParty .

isms:hasScope a owl:ObjectProperty ;
    rdfs:label "has scope"@en,
        "heeft toepassingsgebied"@nl ;
    rdfs:domain isms:ISMS ;
    rdfs:range isms:ISMSScope .

isms:hasScopeDescription a owl:DatatypeProperty ;
    rdfs:label "has scope description"@en,
        "heeft toepassingsgebiedbeschrijving"@nl ;
    rdfs:domain isms:ISMSScope ;
    rdfs:range rdfs:Literal .

isms:hasSoA a owl:ObjectProperty ;
    rdfs:label "has Statement of Applicability"@en,
        "heeft Verklaring van Toepasselijkheid"@nl ;
    rdfs:domain isms:ISMS ;
    rdfs:range isms:StatementOfApplicability .

isms:hasSoAVersion a owl:DatatypeProperty ;
    rdfs:label "has SoA version"@en,
        "heeft SoA-versie"@nl ;
    rdfs:comment "Version identifier for the Statement of Applicability."@en,
        "Versieaanduiding van de Statement of Applicability."@nl ;
    rdfs:domain isms:StatementOfApplicability ;
    rdfs:range xsd:string .

isms:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by procedure"@en,
        "geïmplementeerd door procedure"@nl ;
    rdfs:domain isms:Policy ;
    rdfs:range isms:Procedure .

isms:implementsControl a owl:ObjectProperty ;
    rdfs:label "implements control"@en,
        "implementeert beheersmaatregel"@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range ctrl:Control .

isms:inScopeOf a owl:ObjectProperty ;
    rdfs:label "in scope of"@en,
        "valt binnen toepassingsgebied van"@nl ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range isms:ISMSScope .

isms:integrityValue a owl:DatatypeProperty ;
    rdfs:label "integrity value (1-3)"@en,
        "integriteitswaarde (1-3)"@nl ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range xsd:integer .

isms:justification a owl:DatatypeProperty ;
    rdfs:label "justification"@en,
        "motivatie"@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range rdfs:Literal .

isms:linkedToRisk a owl:ObjectProperty ;
    rdfs:label "linked to risk"@en,
        "gekoppeld aan risico"@nl ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range risk:Risk .

isms:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en,
        "eigendom van"@nl ;
    rdfs:domain isms:InformationAsset ;
    rdfs:range roles:Role .

isms:reviewDate a owl:DatatypeProperty ;
    rdfs:label "review date"@en,
        "herzieningsdatum"@nl ;
    rdfs:domain isms:ISMSDocument ;
    rdfs:range xsd:date .

isms:satisfiesRequirement a owl:ObjectProperty ;
    rdfs:label "satisfies requirement"@en,
        "vervult vereiste"@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range compl:ComplianceRequirement .

isms:soaApprovalDate a owl:DatatypeProperty ;
    rdfs:label "SoA approval date"@en,
        "goedkeuringsdatum VvT"@nl ;
    rdfs:domain isms:StatementOfApplicability ;
    rdfs:range xsd:date .

isms:soaVersion a owl:DatatypeProperty ;
    rdfs:label "SoA version"@en,
        "VvT-versie"@nl ;
    rdfs:domain isms:StatementOfApplicability ;
    rdfs:range xsd:string .

isms:subordinateTo a owl:ObjectProperty ;
    rdfs:label "subordinate to"@en,
        "onderliggend aan"@nl ;
    rdfs:domain isms:TopicSpecificPolicy ;
    rdfs:range isms:TopLevelPolicy ;
    rdfs:subPropertyOf owl:topObjectProperty .

isms:supportedByProcess a owl:ObjectProperty ;
    rdfs:label "supported by process"@en,
        "ondersteund door proces"@nl ;
    rdfs:domain isms:ISMSProcess ;
    rdfs:range isms:ISMSProcess .

isms:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en,
        "ondersteunt"@nl ;
    rdfs:domain isms:SupportingAsset ;
    rdfs:range isms:PrimaryAsset .

<https://grc.example.org/ontology/m21-csf> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M21 — NIST CSF 2.0"@nl ;
    owl:imports <https://grc.example.org/ontology/> .

risk:IC_Safety a risk:ImpactCategory ;
    rdfs:label "Safety impact"@en,
        "Veiligheidsimpact"@nl .

risk:IL_Minor a risk:ImpactLevel ;
    rdfs:label "Minor (2)"@en,
        "Gering (2)"@nl ;
    rdfs:comment "Limited consequences; short disruption, manageable."@en,
        "Beperkte gevolgen; korte verstoring, beheersbaar."@nl ;
    risk:hasImpactScore 2 .

risk:IL_Moderate a risk:ImpactLevel ;
    rdfs:label "Moderate (3)"@en,
        "Matig (3)"@nl ;
    rdfs:comment "Significant consequences; notable disruption to services or operations."@en,
        "Aanzienlijke gevolgen; merkbare verstoring van diensten of activiteiten."@nl ;
    risk:hasImpactScore 3 .

risk:IL_Negligible a risk:ImpactLevel ;
    rdfs:label "Negligible (1)"@en,
        "Verwaarloosbaar (1)"@nl ;
    rdfs:comment "Minimal consequence; easily recoverable, no significant disruption."@en,
        "Minimale gevolgen; eenvoudig herstelbaar, geen noemenswaardige verstoring."@nl ;
    risk:hasImpactScore 1 .

risk:LL_Low a risk:LikelihoodLevel ;
    rdfs:label "Low (2)"@en,
        "Laag (2)"@nl ;
    rdfs:comment "Event is unlikely to occur (once in 5–10 years)."@en,
        "Gebeurtenis is onwaarschijnlijk (eenmaal in 5–10 jaar)."@nl ;
    risk:hasLikelihoodScore 2 .

risk:LL_VeryHigh a risk:LikelihoodLevel ;
    rdfs:label "Very High (5)"@en,
        "Zeer hoog (5)"@nl ;
    rdfs:comment "Event is almost certain to occur (multiple times per year)."@en,
        "Gebeurtenis treedt bijna zeker op (meerdere keren per jaar)."@nl ;
    risk:hasLikelihoodScore 5 .

risk:LL_VeryLow a risk:LikelihoodLevel ;
    rdfs:label "Very Low (1)"@en,
        "Zeer laag (1)"@nl ;
    rdfs:comment "Event is very unlikely to occur (< once in 10 years)."@en,
        "Gebeurtenis is zeer onwaarschijnlijk (< eenmaal in 10 jaar)."@nl ;
    risk:hasLikelihoodScore 1 .

risk:PhysicalVulnerability a owl:Class ;
    rdfs:label "Physical Vulnerability"@en,
        "Fysieke kwetsbaarheid"@nl ;
    rdfs:comment "A weakness in physical security measures, facilities or environment."@en,
        "Een zwakheid in fysieke beveiligingsmaatregelen, faciliteiten of omgeving."@nl ;
    rdfs:subClassOf risk:Vulnerability .

risk:R_004 a risk:InformationSecurityRisk ;
    risk:affects risk:ServiceAsset ;
    risk:atManagementTier risk:Tier3_InformationSystem ;
    risk:hasImpact risk:IL_Significant ;
    risk:hasImpactCategory risk:IC_Availability,
        risk:IC_Operational,
        risk:IC_Reputational ;
    risk:hasInherentRiskScore 12 ;
    risk:hasLikelihood risk:LL_Medium ;
    risk:hasRiskDescription "Een DDoS-aanval maakt een kritieke publiek-toegankelijke dienst onbereikbaar."@nl ;
    risk:hasRiskID "R-004" ;
    risk:hasRiskTitle "Uitval kritieke ICT-dienst door DDoS"@nl ;
    risk:hasThreat risk:T_DDoS ;
    risk:hasVulnerability risk:V_OpenPorts,
        risk:V_SinglePointOfFailure ;
    risk:mitigatedBy ctrl:ISO27002_8_14,
        ctrl:ISO27002_8_20,
        ctrl:ISO27002_8_22 .

risk:TS_HardwareFault a risk:TechnicalThreatSource ;
    rdfs:label "Hardware failure"@en,
        "Hardwarestoring"@nl .

risk:TS_PowerFailure a risk:EnvironmentalThreatSource ;
    rdfs:label "Power / utility failure"@en,
        "Stroom- / nutsuitval"@nl .

risk:T_ConfigError a risk:Threat ;
    rdfs:label "Configuration error / misconfiguration"@en,
        "Configuratiefout"@nl ;
    risk:originatesFrom risk:TS_Negligent,
        risk:TS_SoftwareFault ;
    risk:threatens risk:SystemAsset .

risk:T_PhysicalIntrusion a risk:Threat ;
    rdfs:label "Physical intrusion"@en,
        "Fysieke inbraak"@nl ;
    risk:originatesFrom risk:TS_Cybercriminal ;
    risk:threatens risk:InformationAsset,
        risk:PhysicalAsset .

risk:Tier1_Organisation a owl:NamedIndividual,
        risk:RiskManagementTier ;
    rdfs:label "Tier 1 — Organisation"@en,
        "Tier 1 — Organisatie"@nl ;
    rdfs:comment "Addresses risk from an organisational perspective. Provides the context for all risk management activities: risk framing, risk governance, risk appetite, and organisational risk strategy."@en,
        "Adresseert risico vanuit organisatieperspectief. Biedt de context voor alle risicomanagementactiviteiten: risicokader, risicogovernance, risicobereidheid en organisatorische risicostrategie."@nl ;
    skos:relatedMatch ext:COSO_ERM_GovernanceCulture,
        ext:COSO_ERM_StrategyObjectiveSetting .

risk:V_InadequateBackup a risk:OrganisationalVulnerability ;
    rdfs:label "Inadequate backup and recovery"@en,
        "Ontoereikende back-up en herstel"@nl ;
    risk:exploits risk:T_NaturalHazard,
        risk:T_Ransomware .

risk:V_MissingMFA a risk:TechnicalVulnerability ;
    rdfs:label "Missing multi-factor authentication"@en,
        "Ontbrekende meervoudige authenticatie"@nl ;
    risk:exploits risk:T_Phishing,
        risk:T_UnauthorisedAccess .

risk:V_NoEncryption a risk:TechnicalVulnerability ;
    rdfs:label "Unencrypted data storage or transfer"@en,
        "Onversleutelde gegevensopslag of -overdracht"@nl ;
    risk:exploits risk:T_DataLeak .

risk:V_WeakPasswords a risk:TechnicalVulnerability ;
    rdfs:label "Weak authentication / passwords"@en,
        "Zwakke authenticatie / wachtwoorden"@nl ;
    risk:exploits risk:T_UnauthorisedAccess .

risk:affects a owl:ObjectProperty ;
    rdfs:label "affects"@en,
        "beïnvloedt"@nl ;
    rdfs:comment "A risk has potential consequences for one or more assets."@en,
        "Een risico heeft mogelijke gevolgen voor een of meer bedrijfsmiddelen."@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:Asset .

risk:assessedAgainst a owl:ObjectProperty ;
    rdfs:label "assessed against framework"@en,
        "beoordeeld aan de hand van kaderwerk"@nl ;
    rdfs:domain risk:RiskAssessment ;
    rdfs:range fw:GRCFramework .

risk:assessedIn a owl:ObjectProperty ;
    rdfs:label "assessed in"@en,
        "beoordeeld in"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:RiskAssessment .

risk:assessmentDate a owl:DatatypeProperty ;
    rdfs:label "assessment date"@en,
        "beoordelingsdatum"@nl ;
    rdfs:domain risk:RiskAssessment ;
    rdfs:range xsd:date .

risk:atManagementTier a owl:ObjectProperty ;
    rdfs:label "at management tier"@en,
        "op managementniveau"@nl ;
    rdfs:comment "Links a risk to the NIST 800-39 management tier at which it is primarily assessed and managed."@en,
        "Koppelt een risico aan het NIST 800-39 managementniveau waarop het primair wordt beoordeeld en beheerst."@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:RiskManagementTier .

risk:cveID a owl:DatatypeProperty ;
    rdfs:label "CVE identifier"@en,
        "CVE-identificatiecode"@nl ;
    rdfs:comment "Common Vulnerabilities and Exposures (CVE) identifier (e.g. CVE-2024-1234)."@en,
        "Common Vulnerabilities and Exposures (CVE) identificatiecode (bijv. CVE-2024-1234)."@nl ;
    rdfs:domain risk:TechnicalVulnerability ;
    rdfs:range xsd:string .

risk:cvssScore a owl:DatatypeProperty ;
    rdfs:label "CVSS score"@en,
        "CVSS-score"@nl ;
    rdfs:comment "Common Vulnerability Scoring System (CVSS) base score (0.0–10.0)."@en,
        "Common Vulnerability Scoring System (CVSS) basisscore (0,0–10,0)."@nl ;
    rdfs:domain risk:TechnicalVulnerability ;
    rdfs:range xsd:decimal .

risk:describesScenario a owl:ObjectProperty ;
    rdfs:label "describes scenario"@en,
        "beschrijft scenario"@nl ;
    rdfs:domain risk:RiskAssessment ;
    rdfs:range risk:RiskScenario .

risk:exploits a owl:ObjectProperty ;
    rdfs:label "exploits"@en,
        "benut"@nl ;
    rdfs:comment "A threat exploits a vulnerability to materialise."@en,
        "Een dreiging benut een kwetsbaarheid om zich te manifesteren."@nl ;
    rdfs:domain risk:Threat ;
    rdfs:range risk:Vulnerability .

risk:governedByAppetite a owl:ObjectProperty ;
    rdfs:label "governed by appetite"@en,
        "gestuurd door risicobereidheid"@nl ;
    rdfs:domain risk:RiskAssessment ;
    rdfs:range risk:RiskAppetite .

risk:hasImpact a owl:ObjectProperty ;
    rdfs:label "has impact"@en,
        "heeft impact"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:ImpactLevel .

risk:hasImpactCategory a owl:ObjectProperty ;
    rdfs:label "has impact category"@en,
        "heeft impactcategorie"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:ImpactCategory .

risk:hasImpactScore a owl:DatatypeProperty ;
    rdfs:label "has impact score"@en,
        "heeft impactscore"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range xsd:integer .

risk:hasInherentRiskScore a owl:DatatypeProperty ;
    rdfs:label "has inherent risk score"@en,
        "heeft inherente risicoscore"@nl ;
    rdfs:comment "Numeric score before treatment (e.g. likelihood × impact on a 1–5 scale)."@en,
        "Numerieke score vóór behandeling (bijv. waarschijnlijkheid × impact op een 1–5 schaal)."@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range xsd:integer .

risk:hasLikelihood a owl:ObjectProperty ;
    rdfs:label "has likelihood"@en,
        "heeft waarschijnlijkheid"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:LikelihoodLevel .

risk:hasLikelihoodScore a owl:DatatypeProperty ;
    rdfs:label "has likelihood score"@en,
        "heeft waarschijnlijkheidsscore"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range xsd:integer .

risk:hasResidualRiskScore a owl:DatatypeProperty ;
    rdfs:label "has residual risk score"@en,
        "heeft restrisicoscore"@nl ;
    rdfs:comment "Numeric score after treatment."@en,
        "Numerieke score na behandeling."@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range xsd:integer .

risk:hasRiskCriteria a owl:ObjectProperty ;
    rdfs:label "has risk criteria"@en,
        "heeft risicocriteria"@nl ;
    rdfs:domain risk:RiskAssessment ;
    rdfs:range risk:RiskCriteria .

risk:hasRiskDescription a owl:DatatypeProperty ;
    rdfs:label "has risk description"@en,
        "heeft risicoомschrijving"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range rdfs:Literal .

risk:hasRiskID a owl:DatatypeProperty ;
    rdfs:label "has risk ID"@en,
        "heeft risico-ID"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range xsd:string .

risk:hasRiskTitle a owl:DatatypeProperty ;
    rdfs:label "has risk title"@en,
        "heeft risicotitel"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range rdfs:Literal .

risk:hasSource a owl:ObjectProperty ;
    rdfs:label "has source"@en,
        "heeft bron"@nl ;
    rdfs:comment "Links a risk to the threat source(s) that cause it."@en,
        "Koppelt een risico aan de dreigingsbron(nen) die het veroorzaken."@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:ThreatSource .

risk:hasThreat a owl:ObjectProperty ;
    rdfs:label "has threat"@en,
        "heeft dreiging"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:Threat .

risk:hasVulnerability a owl:ObjectProperty ;
    rdfs:label "has vulnerability"@en,
        "heeft kwetsbaarheid"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:Vulnerability .

risk:hasVulnerabilityInAsset a owl:ObjectProperty ;
    rdfs:label "is present in asset"@en,
        "aanwezig in bedrijfsmiddel"@nl ;
    rdfs:domain risk:Vulnerability ;
    rdfs:range risk:Asset .

risk:isAccepted a owl:DatatypeProperty ;
    rdfs:label "is accepted"@en,
        "is aanvaard"@nl ;
    rdfs:comment "True if the residual risk is formally accepted by the risk owner."@en,
        "True als het restrisico formeel is aanvaard door de risico-eigenaar."@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range xsd:boolean .

risk:isInRegister a owl:ObjectProperty ;
    rdfs:label "is recorded in register"@en,
        "is opgenomen in register"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:RiskRegister .

risk:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigated by"@en,
        "gemitigeerd door"@nl ;
    rdfs:comment "Links a risk to the control(s) that mitigate it."@en,
        "Koppelt een risico aan de beheersmaatregel(en) die het mitigeren."@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range ctrl:Control .

risk:originatesFrom a owl:ObjectProperty ;
    rdfs:label "originates from"@en,
        "afkomstig van"@nl ;
    rdfs:domain risk:Threat ;
    rdfs:range risk:ThreatSource .

risk:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en,
        "eigendom van"@nl ;
    rdfs:comment "The risk owner is accountable for managing the risk."@en,
        "De risico-eigenaar is verantwoordelijk voor het beheren van het risico."@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:RiskOwner .

risk:resultsInResidualRisk a owl:ObjectProperty ;
    rdfs:label "results in residual risk"@en,
        "resulteert in restrisico"@nl ;
    rdfs:domain risk:RiskTreatment ;
    rdfs:range risk:ResidualRisk .

risk:reviewDate a owl:DatatypeProperty ;
    rdfs:label "review date"@en,
        "herzieningsdatum"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range xsd:date .

risk:threatens a owl:ObjectProperty ;
    rdfs:label "threatens"@en,
        "bedreigt"@nl ;
    rdfs:comment "A threat potentially causes harm to one or more assets."@en,
        "Een dreiging veroorzaakt potentieel schade aan een of meer bedrijfsmiddelen."@nl ;
    rdfs:domain risk:Threat ;
    rdfs:range risk:Asset .

risk:treatedBy a owl:ObjectProperty ;
    rdfs:label "treated by"@en,
        "behandeld door"@nl ;
    rdfs:domain risk:Risk ;
    rdfs:range risk:RiskTreatment .

roles:A_Accountable a roles:RACIType ;
    rdfs:label "Accountable (A)"@en,
        "Eindverantwoordelijk (A)"@nl ;
    rdfs:comment "Ultimately answerable. Exactly one per activity."@en,
        "Uiteindelijk verantwoordelijk. Precies één per activiteit."@nl .

roles:Accountability a owl:Class ;
    rdfs:label "Accountability"@en,
        "Eindverantwoordelijkheid"@nl ;
    rdfs:comment "The ultimate obligation of a role for the outcome of a GRC activity. Only one actor may be accountable (A in RACI)."@en,
        "De ultieme verplichting van een rol voor de uitkomst van een GRC-activiteit. Slechts één actor kan eindverantwoordelijk zijn (A in RACI)."@nl .

roles:C_Consulted a roles:RACIType ;
    rdfs:label "Consulted (C)"@en,
        "Geconsulteerd (C)"@nl ;
    rdfs:comment "Two-way communication, provides expertise."@en,
        "Tweerichtingscommunicatie, levert expertise."@nl .

roles:I_Informed a roles:RACIType ;
    rdfs:label "Informed (I)"@en,
        "Geïnformeerd (I)"@nl ;
    rdfs:comment "One-way communication, kept up to date."@en,
        "Eénrichtingscommunicatie, wordt op de hoogte gehouden."@nl .

roles:RACIAssignment a owl:Class ;
    rdfs:label "RACI Assignment"@en,
        "RACI-toewijzing"@nl ;
    rdfs:comment "A reified assignment linking a Role to a GRCActivity with a specific RACI type (R/A/C/I)."@en,
        "Een gereïficeerde koppeling tussen een Rol en een GRC-activiteit met een specifiek RACI-type (R/A/C/I)."@nl .

roles:R_ABVA a roles:SpecialistRole ;
    roles:hasRoleDescription "Ondersteunt de BVA; kan BVA-taken uitvoeren bij afwezigheid."@nl ;
    roles:hasRoleID "BVA-02" ;
    roles:hasRoleTitle "Deputy Security Officer (ABVA)"@en,
        "Adjunct-Beveiligingsambtenaar (ABVA)"@nl ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:mandatedBy fw:BesluitBVAStelsel ;
    roles:reportsTo roles:R_BVA .

roles:R_BeveiligingsArchitect a roles:SpecialistRole ;
    roles:hasRoleDescription "Ontwerp van beveiligingsarchitectuur en technische beveiligingsprincipes. ISO 27002:2022 §8.27."@nl ;
    roles:hasRoleID "SPEC-01" ;
    roles:hasRoleTitle "Security Architect"@en,
        "Beveiligingsarchitect"@nl ;
    roles:isConsultedFor roles:ACT_BeheersmaatregelImplementatie ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:reportsTo roles:R_CISO .

roles:R_ExternAuditor a roles:AuditRole ;
    roles:hasRoleDescription "Externe certificeringsaudit ISO 27001; of externe review BIO 2.0 compliance."@nl ;
    roles:hasRoleID "AUD-02" ;
    roles:hasRoleTitle "External Auditor / Certification Body"@en,
        "Extern Auditor / Certificerende instelling"@nl ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:mandatedBy fw:ISO_IEC_27001_2022 .

roles:R_FG a roles:SpecialistRole ;
    skos:closeMatch fw:BIO_2_0 ;
    roles:advisesRole roles:R_Bestuur,
        roles:R_SecretarisDirecteur ;
    roles:hasRoleDescription "Wettelijk verplichte rol conform AVG Art. 37-39. Toezicht op verwerking persoonsgegevens; onafhankelijk."@nl ;
    roles:hasRoleID "PRIV-01" ;
    roles:hasRoleTitle "Data Protection Officer (DPO)"@en,
        "Functionaris Gegevensbescherming (FG)"@nl ;
    roles:isConsultedFor roles:ACT_BeveiligingsbeleidVaststellen,
        roles:ACT_IncidentAfhandelen,
        roles:ACT_LeveranciersBeheer,
        roles:ACT_NIS2MeldingPlicht,
        roles:ACT_RisicoBeoordelingUitvoeren ;
    roles:isMandatoryUnderDutchLaw true ;
    roles:mandatedBy fw:BIO_2_0 .

roles:R_ITBeheerder a roles:OperationalRole ;
    roles:hasRoleDescription "Technisch beheer van systemen en infrastructuur; uitvoering van technische beveiligingsmaatregelen."@nl ;
    roles:hasRoleID "OPS-01" ;
    roles:hasRoleTitle "IT / System Administrator"@en,
        "IT-beheerder / Systeembeheerder"@nl ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:isResponsibleFor roles:ACT_BeheersmaatregelImplementatie,
        roles:ACT_IncidentAfhandelen ;
    roles:reportsTo roles:R_DienstenleverancierIntern .

roles:R_Medewerker a roles:OperationalRole ;
    roles:hasRoleDescription "Elke medewerker met toegang tot informatiebedrijfsmiddelen; draagt eigen verantwoordelijkheid conform ISO 27002:2022 §6.3 en BIO 2.0."@nl ;
    roles:hasRoleID "OPS-03" ;
    roles:hasRoleTitle "Employee / Staff Member"@en,
        "Medewerker"@nl ;
    roles:isInformedAbout roles:ACT_BeveiligingsbeleidVaststellen,
        roles:ACT_BewustwordingTraining ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:isResponsibleFor roles:ACT_IncidentMelden ;
    roles:mandatedBy fw:BIO_2_0,
        fw:ISO_IEC_27002_2022 .

roles:R_NIS2Toezichthouder a roles:AuditRole ;
    roles:hasRoleDescription "Bevoegde autoriteit ex NIS2 Art. 32/33 en Cyberbeveiligingswet; bevoegd tot toezicht, audit en handhaving."@nl ;
    roles:hasRoleID "AUD-03" ;
    roles:hasRoleTitle "NIS2/CBW Supervisory Authority"@en,
        "NIS2/CBW Toezichthouder"@nl ;
    roles:isMandatoryUnderDutchLaw true ;
    roles:mandatedBy fw:CBW,
        fw:NIS2_Directive .

roles:R_Responsible a roles:RACIType ;
    rdfs:label "Responsible (R)"@en,
        "Uitvoerend verantwoordelijk (R)"@nl ;
    rdfs:comment "Does the work. Can be shared."@en,
        "Voert het werk uit. Kan worden gedeeld."@nl .

roles:R_SecurityAnalist a roles:OperationalRole ;
    roles:hasRoleDescription "Monitoring, detectie en eerste respons op beveiligingsincidenten."@nl ;
    roles:hasRoleID "OPS-02" ;
    roles:hasRoleTitle "Security Analyst / SOC Analyst"@en,
        "Security Analist / SOC Analist"@nl ;
    roles:isInformedAbout roles:ACT_IncidentMelden ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:isResponsibleFor roles:ACT_IncidentAfhandelen,
        roles:ACT_RisicoBeoordelingUitvoeren ;
    roles:reportsTo roles:R_CISO .

roles:R_Systeemeigenaar a roles:OwnerRole ;
    roles:hasRoleDescription "Eigenaar van een specifiek informatiesysteem; verantwoordelijk voor beveiligingsmaatregelen, classificatie en toegangsbeheer van het systeem."@nl ;
    roles:hasRoleID "OWN-03" ;
    roles:hasRoleTitle "System Owner"@en,
        "Systeemeigenaar"@nl ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:mandatedBy fw:BIO_2_0,
        fw:ISO_IEC_27001_2022 ;
    roles:reportsTo roles:R_Proceseigenaar .

roles:Responsibility a owl:Class ;
    rdfs:label "Responsibility"@en,
        "Verantwoordelijkheid"@nl ;
    rdfs:comment "A duty assigned to a role to perform or oversee a specific GRC activity."@en,
        "Een taak toegewezen aan een rol om een specifieke GRC-activiteit uit te voeren of te bewaken."@nl .

roles:advisesRole a owl:ObjectProperty ;
    rdfs:label "advises"@en,
        "adviseert"@nl ;
    rdfs:comment "An advisory (functional) relationship between roles."@en,
        "Een adviserende (functionele) relatie tussen rollen."@nl ;
    rdfs:domain roles:Role ;
    rdfs:range roles:Role .

roles:delegatesTo a owl:ObjectProperty ;
    rdfs:label "delegates to"@en,
        "delegeert aan"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range roles:Role .

roles:hasActivityID a owl:DatatypeProperty ;
    rdfs:label "has activity ID"@en,
        "heeft activiteits-ID"@nl ;
    rdfs:domain roles:GRCActivity ;
    rdfs:range xsd:string .

roles:hasActivityTitle a owl:DatatypeProperty ;
    rdfs:label "has activity title"@en,
        "heeft activiteitstitel"@nl ;
    rdfs:domain roles:GRCActivity ;
    rdfs:range rdfs:Literal .

roles:hasRole a owl:ObjectProperty ;
    rdfs:label "has role"@en,
        "heeft rol"@nl ;
    rdfs:comment "An actor holds a specific role."@en,
        "Een actor bekleedt een specifieke rol."@nl ;
    rdfs:domain roles:Actor ;
    rdfs:range roles:Role .

roles:hasRoleDescription a owl:DatatypeProperty ;
    rdfs:label "has role description"@en,
        "heeft rolbeschrijving"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range rdfs:Literal .

roles:hasRoleID a owl:DatatypeProperty ;
    rdfs:label "has role ID"@en,
        "heeft rol-ID"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range xsd:string .

roles:hasRoleTitle a owl:DatatypeProperty ;
    rdfs:label "has role title"@en,
        "heeft roltitel"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range rdfs:Literal .

roles:isAccountableFor a owl:ObjectProperty ;
    rdfs:label "is accountable for (A)"@en,
        "is eindverantwoordelijk voor (A)"@nl ;
    rdfs:comment "RACI-A: The role is ultimately answerable. Exactly one role per activity."@en,
        "RACI-A: De rol is uiteindelijk verantwoordelijk. Precies één rol per activiteit."@nl ;
    rdfs:domain roles:Role ;
    rdfs:range roles:GRCActivity .

roles:isAssetOwnerOf a owl:ObjectProperty ;
    rdfs:label "is asset owner of"@en,
        "is bedrijfsmiddeleigenaar van"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range risk:Asset .

roles:isConsultedFor a owl:ObjectProperty ;
    rdfs:label "is consulted for (C)"@en,
        "wordt geconsulteerd voor (C)"@nl ;
    rdfs:comment "RACI-C: The role provides expert input; two-way communication."@en,
        "RACI-C: De rol levert deskundige input; tweerichtingscommunicatie."@nl ;
    rdfs:domain roles:Role ;
    rdfs:range roles:GRCActivity .

roles:isInformedAbout a owl:ObjectProperty ;
    rdfs:label "is informed about (I)"@en,
        "wordt geïnformeerd over (I)"@nl ;
    rdfs:comment "RACI-I: The role receives information after decisions are made; one-way."@en,
        "RACI-I: De rol ontvangt informatie na besluitvorming; één richting."@nl ;
    rdfs:domain roles:Role ;
    rdfs:range roles:GRCActivity .

roles:isMandatoryUnderDutchLaw a owl:DatatypeProperty ;
    rdfs:label "is mandatory under Dutch law"@en,
        "verplicht op basis van Nederlandse wetgeving"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range xsd:boolean .

roles:isProcessOwnerOf a owl:ObjectProperty ;
    rdfs:label "is process owner of"@en,
        "is proceseigenaar van"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range roles:GRCActivity .

roles:isResponsibleFor a owl:ObjectProperty ;
    rdfs:label "is responsible for (R)"@en,
        "is uitvoerend verantwoordelijk voor (R)"@nl ;
    rdfs:comment "RACI-R: The role performs the activity. Multiple roles can share R."@en,
        "RACI-R: De rol voert de activiteit uit. Meerdere rollen kunnen R delen."@nl ;
    rdfs:domain roles:Role ;
    rdfs:range roles:GRCActivity .

roles:isRiskOwnerOf a owl:ObjectProperty ;
    rdfs:label "is risk owner of"@en,
        "is risico-eigenaar van"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range risk:Risk .

roles:mandatedBy a owl:ObjectProperty ;
    rdfs:label "mandated by"@en,
        "verplicht gesteld door"@nl ;
    rdfs:comment "The role is formally required by a legal instrument or standard."@en,
        "De rol is formeel vereist door een wettelijk instrument of norm."@nl ;
    rdfs:domain roles:Role ;
    rdfs:range fw:GRCFramework .

roles:performsControl a owl:ObjectProperty ;
    rdfs:label "performs control"@en,
        "voert beheersmaatregel uit"@nl ;
    rdfs:domain roles:Role ;
    rdfs:range ctrl:Control .

roles:reportsTo a owl:ObjectProperty ;
    rdfs:label "reports to"@en,
        "rapporteert aan"@nl ;
    rdfs:comment "Hierarchical reporting relationship between roles."@en,
        "Hiërarchische rapportagerelatie tussen rollen."@nl ;
    rdfs:domain roles:Role ;
    rdfs:range roles:Role .

asset:StorageFacility a owl:Class ;
    rdfs:label "Storage Facility"@en,
        "Opslagvoorziening"@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" ;
    rdfs:comment "Storage facility component of an information system (e.g. storage arrays, databases at infrastructure level, archive systems)."@en,
        "Opslagvoorzieningscomponent van een informatiesysteem (bijv. storage arrays, databases op infrastructuurniveau, archiefsystemen)."@nl ;
    rdfs:subClassOf asset:Facility .

asset:TangibleGoods a owl:Class ;
    rdfs:label "Tangible Goods"@en,
        "Goederen"@nl ;
    dcterms:source "BVA-stelsel Rijksdienst 2021 art. 1k" ;
    rdfs:comment "Consumable or inventoried tangible goods. Corresponds to BVA-stelsel 2021 art. 1k 'goederen'. Distinct from Equipment (durable) and PhysicalObject (other protectable objects)."@en,
        "Verbruiksgoederen of inventarisgoederen. Correspondeert met BVA-stelsel 2021 art. 1k 'goederen'. Onderscheiden van Materieel (duurzaam) en PhysicalObject (overige beschermwaardige objecten)."@nl ;
    rdfs:subClassOf asset:PhysicalAsset ;
    skos:exactMatch fw:TBB_Goederen .

asset:appliesToAssetType a owl:ObjectProperty ;
    rdfs:label "applies to asset type"@en,
        "is van toepassing op bedrijfsmiddeltype"@nl ;
    dcterms:source "Masterchat-besluiten A4.4 en D-M18-2 (13 april 2026)" ;
    rdfs:comment "Relates a control to the asset type(s) — asset-class or component-class — for which it is relevant. Class-level property (Spoor A): the object is an asset-class, not an instance. Instance-level applicability (Spoor B) follows once the asset inventory is populated. Placed in asset:-namespace per masterchat-decision D-M18-2 (Option 2b) to respect the no-changes-to-M02 constraint (DEEL 7.3 of M18 chatstarter)."@en,
        "Koppelt een beheersmaatregel aan het asset-type (of component-type) waarvoor deze relevant is. Klasse-niveau-property (Spoor A): het object is een asset-klasse, geen instance. Instance-niveau-toepasbaarheid (Spoor B) volgt zodra de asset-inventaris is gevuld. Geplaatst in asset:-namespace per masterchat-besluit D-M18-2 (Optie 2b) om de geen-wijzigingen-in-M02-constraint te respecteren (DEEL 7.3 van M18 chatstarter)."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range asset:AssetOrComponent .

asset:hasComponent a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has component"@en,
        "heeft component"@nl ;
    dcterms:source "Masterchat-besluit A4.3 (13 april 2026)" ;
    rdfs:comment "Mereological part-whole relation: the subject-asset has the object as a constituent component. Transitive: if A hasComponent B and B hasComponent C, then A hasComponent C. Usage varies per asset-subclass; for InformationSystem, components are typed per CIO-stelsel 2026 art. 1o."@en,
        "Mereologische deel-geheel-relatie: het subject-bedrijfsmiddel heeft het object als samenstellende component. Transitief: als A hasComponent B en B hasComponent C, dan A hasComponent C. Gebruik varieert per asset-subklasse; voor InformationSystem worden componenten getypeerd per CIO-stelsel 2026 art. 1o."@nl ;
    rdfs:domain asset:Asset ;
    rdfs:range asset:AssetComponent ;
    owl:inverseOf asset:isComponentOf .

asset:isComponentOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is component of"@en,
        "is component van"@nl ;
    rdfs:comment "Inverse of asset:hasComponent. Transitive."@en,
        "Inverse van asset:hasComponent. Transitief."@nl ;
    rdfs:domain asset:AssetComponent ;
    rdfs:range asset:Asset ;
    owl:inverseOf asset:hasComponent .

asset:isOperatedBy a owl:ObjectProperty ;
    rdfs:label "is operated by"@en,
        "wordt bediend door"@nl ;
    dcterms:source "Masterchat-besluit D-M18-5 (13 april 2026); Besluit CIO-stelsel Rijksdienst 2026 art. 1o" ;
    rdfs:comment "Relates an information system to the persons who operate it. Distinct from asset:hasComponent (masterchat-decision D-M18-5, Option A): persons are not mereological parts of a system. Note: VIR 2007 art. 1b, VIRBI 2025 art. 1 and BIO 2.0 DO include 'personen' in their information-system definition; this model follows Besluit CIO-stelsel 2026 art. 1o as primary source for architectural cleanliness."@en,
        "Koppelt een informatiesysteem aan de personen die het bedienen. Onderscheiden van asset:hasComponent (masterchat-besluit D-M18-5, Optie A): personen zijn geen mereologische delen van een systeem. Noot: VIR 2007 art. 1b, VIRBI 2025 art. 1 en BIO 2.0 noemen 'personen' WEL in hun informatiesysteem-definitie; dit model volgt Besluit CIO-stelsel 2026 art. 1o als primaire bron voor architecturale zuiverheid."@nl ;
    rdfs:domain asset:InformationSystem ;
    rdfs:range asset:HumanAsset .

bio:BIO2_5_01_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.01.1"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.01.1" ;
    bio:hasMaatregel """De organisatie heeft een informatiebeveiligingsbeleid opgesteld. Dit beleid is vastgesteld door de leiding van de organisatie en bevat ten minste de volgende punten:
(a) De strategische uitgangspunten en randvoorwaarden die de organisatie hanteert voor informatiebeveiliging en in het bijzonder de inbedding in en afstemming op het algemene beveiligingsbeleid en het informatievoorzieningsbeleid.
(b) De organisatie van de informatiebeveiligingsfunctie, waaronder verantwoordelijkheden, taken en be""" ;
    bio:implementsControl bio:ISO27002_5_01 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_01_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.01.2"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.01.2" ;
    bio:hasMaatregel "Het informatiebeveiligingsbeleid wordt periodiek en in aansluiting bij de (bestaande) bestuurs- en Planning & Control (P&C)-cycli en externe ontwikkelingen beoordeeld en zo nodig bijgesteld." ;
    bio:implementsControl bio:ISO27002_5_01 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_02_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.02.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset ;
    bio:bioMaatregelNummer "5.02.1" ;
    bio:hasMaatregel "De leiding van de organisatie heeft vastgelegd wat de verantwoordelijkheden en rollen zijn op het gebied van informatiebeveiliging binnen haar organisatie." ;
    bio:implementsControl bio:ISO27002_5_02 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_02_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.02.2"@nl ;
    asset:appliesToAssetType asset:HumanAsset ;
    bio:bioMaatregelNummer "5.02.2" ;
    bio:hasMaatregel "De verantwoordelijkheden en rollen ten aanzien van informatiebeveiliging zijn gebaseerd op relevante voorschriften en wetten." ;
    bio:implementsControl bio:ISO27002_5_02 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_02_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.02.3"@nl ;
    asset:appliesToAssetType asset:Asset,
        asset:HumanAsset ;
    bio:bioMaatregelNummer "5.02.3" ;
    bio:hasMaatregel "De rol en verantwoordelijkheden van de Chief Information Security Officer (CISO) zijn in een CISO-functieprofiel vastgelegd." ;
    bio:implementsControl bio:ISO27002_5_02 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_02_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.02.4"@nl ;
    asset:appliesToAssetType asset:Asset,
        asset:HumanAsset ;
    bio:bioMaatregelNummer "5.02.4" ;
    bio:hasMaatregel "Er is een CISO aangesteld conform een vastgesteld CISO-functieprofiel." ;
    bio:implementsControl bio:ISO27002_5_02 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_03_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.03.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.03.1" ;
    bio:hasMaatregel "Er zijn maatregelen getroffen die onbedoelde of ongeautoriseerde toegang tot bedrijfsmiddelen waarnemen of voorkomen." ;
    bio:implementsControl bio:ISO27002_5_03 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_04_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.04.1"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.04.1" ;
    bio:hasMaatregel "Er is aansluiting bij een klokkenluidersregeling, zodat iedereen anoniem en veilig beveiligingsissues kan melden." ;
    bio:implementsControl bio:ISO27002_5_04 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_05_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.05.1"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.05.1" ;
    bio:hasMaatregel "De organisatie heeft uitgewerkt wie met welke (overheids)instanties en toezichthouders contact heeft ten aanzien van informatiebeveiligingsaangelegenheden (vergunningen/incidenten/calamiteiten) en welke eisen voor deze aangelegenheden relevant zijn." ;
    bio:implementsControl bio:ISO27002_5_05 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_05_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.05.2"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.05.2" ;
    bio:hasMaatregel "Het contactoverzicht wordt jaarlijks geactualiseerd." ;
    bio:implementsControl bio:ISO27002_5_05 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_08_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.08.1"@nl ;
    asset:appliesToAssetType asset:Asset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.08.1" ;
    bio:hasMaatregel "Bij nieuwe informatiesystemen en bij wijzigingen op bestaande informatiesystemen moet een expliciete risicoafweging worden uitgevoerd ten behoeve van het vaststellen van de beveiligingseisen, uitgaande van de BIO." ;
    bio:implementsControl bio:ISO27002_5_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_10_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.10.1"@nl ;
    asset:appliesToAssetType asset:Asset,
        asset:HumanAsset ;
    bio:bioMaatregelNummer "5.10.1" ;
    bio:hasMaatregel "Alle medewerkers zijn aantoonbaar gewezen op de gedragsregels voor het gebruik van bedrijfsmiddelen." ;
    bio:implementsControl bio:ISO27002_5_10 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_10_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.10.2"@nl ;
    asset:appliesToAssetType asset:Asset,
        asset:HumanAsset ;
    bio:bioMaatregelNummer "5.10.2" ;
    bio:hasMaatregel "De gedragsregels voor het gebruik van bedrijfsmiddelen zijn voor extern personeel in het contract vastgelegd overeenkomstig de huisregels of gedragsregels." ;
    bio:implementsControl bio:ISO27002_5_10 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_12_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.12.1"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.12.1" ;
    bio:hasMaatregel "De informatie in alle informatiesystemen is door middel van een expliciete risicoafweging geclassificeerd, zodat duidelijk is welke bescherming nodig is." ;
    bio:implementsControl bio:ISO27002_5_12 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_14_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.14.1"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "5.14.1" ;
    bio:hasMaatregel "Voor de beveiliging van elektronische (e-mail)berichten gelden de vastgestelde open standaarden tegen phishing en afluisteren op de ‘pas toe of leg uit’-lijst van het Forum Standaardisatie. Voor beveiliging van websiteverkeer gelden de open standaarden tegen afluisteren op de ‘pas toe of leg uit’-lijst van het Forum Standaardisatie." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_14_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.14.2"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "5.14.2" ;
    bio:hasMaatregel "Voor veilige berichtenuitwisseling met basisregistraties wordt, conform de ‘pas toe of leg uit’-lijst van het Forum Standaardisatie, gebruik gemaakt van de actuele versie van Digikoppeling." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_14_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.14.3"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "5.14.3" ;
    bio:hasMaatregel "Maak bij openbaar webverkeer van gevoelige gegevens gebruik van ten minste publiek vertrouwde Organization Validated-certificaten. Maak bij intern webverkeer voor gevoelige gegevens gebruik van ten minste publieke vertrouwde OV-certificaten of private PKIo-certificaten. Hogere eisen aan certificaten kunnen voortvloeien uit een risicoanalyse, aansluitvoorwaarden of wetgeving." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_14_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.14.4"@nl ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:InformationAsset ;
    bio:bioMaatregelNummer "5.14.4" ;
    bio:hasMaatregel "Verzend gevoelige gegevens via e-mail alleen over onvertrouwde netwerken als de keten tussen verzender en ontvanger voldoende beveiligd is, zoals door het toepassen van maatregel 5.14.1." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_14_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.14.5"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:Software ;
    bio:bioMaatregelNummer "5.14.5" ;
    bio:hasMaatregel "Om zekerheid te bieden over de integriteit van het elektronische bericht, wordt voor elektronische handtekeningen gebruik gemaakt van de AdES Baseline Profile standaard." ;
    bio:implementsControl bio:ISO27002_5_14 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_15_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.15.1"@nl ;
    asset:appliesToAssetType asset:Equipment,
        asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.15.1" ;
    bio:hasMaatregel "Alleen geauthentiseerde apparatuur kan toegang krijgen tot een vertrouwde zone." ;
    bio:implementsControl bio:ISO27002_5_15 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_15_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.15.2"@nl ;
    asset:appliesToAssetType asset:Equipment,
        asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.15.2" ;
    bio:hasMaatregel "Gebruikers met eigen of ongeauthentiseerde apparatuur (Bring Your Own Device) krijgen alleen toegang tot een onvertrouwde zone." ;
    bio:implementsControl bio:ISO27002_5_15 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_16_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.16.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationSystem,
        asset:Procedure ;
    bio:bioMaatregelNummer "5.16.1" ;
    bio:hasMaatregel "Er is een sluitende formele registratie- en afmeldprocedure voor het beheren van gebruikersidentificaties." ;
    bio:implementsControl bio:ISO27002_5_16 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_16_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.16.2"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.16.2" ;
    bio:hasMaatregel "Het gebruiken van groepsaccounts is niet toegestaan, tenzij dit wordt gemotiveerd en vastgelegd door de proceseigenaar." ;
    bio:implementsControl bio:ISO27002_5_16 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_17_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.17.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.17.1" ;
    bio:hasMaatregel """Bij het aanloggen op een vertrouwde zone:
(a) is het gebruik van tweefactor-authenticatie altijd verplicht;
(b) is de minimale wachtwoordlengte 12 posities en wordt het wachtwoord minimaal halfjaarlijks vernieuwd als geen tweefactor-authenticatie mogelijk is (zie ook 8.5.1);
(c) mogen wachtwoorden niet worden hergebruikt;
(d) zijn de tekens van een wachtwoord zo willekeurig mogelijk gekozen dat individuele tekens of combinaties van tekens geen voorspellende waarde hebben voor de rest van het""" ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_17_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.17.2"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "5.17.2" ;
    bio:hasMaatregel "Medewerkers worden ondersteund in het beheren van hun wachtwoorden door het beschikbaar stellen van een wachtwoordmanager of een vergelijkbaar systeem." ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_17_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.17.3"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "5.17.3" ;
    bio:hasMaatregel "Een wachtwoordmanager is in staat om een waarschuwing te geven als de combinatie van account en wachtwoord voorkomt op lijsten met gecompromitteerde wachtwoorden of het vermoeden bestaat dat het wachtwoord gecompromitteerd is. In dat geval moet het wachtwoord worden gewijzigd." ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_17_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.17.4"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "5.17.4" ;
    bio:hasMaatregel "De eisen aan wachtwoorden moeten geautomatiseerd worden afgedwongen." ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_17_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.17.5"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "5.17.5" ;
    bio:hasMaatregel "Van initiële wachtwoorden en wachtwoorden die gereset zijn, wordt automatisch afgedwongen dat deze bij het eerste gebruik worden gewijzigd." ;
    bio:implementsControl bio:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_18_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.18.1"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.18.1" ;
    bio:hasMaatregel "Er is uitsluitend toegang verleend tot informatiesystemen na autorisatie door een bevoegde functionaris." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_18_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.18.2"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.18.2" ;
    bio:hasMaatregel "Op basis van een risicoafweging is bepaald waar en op welke wijze functiescheiding wordt toegepast en welke toegangsrechten worden gegeven." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_18_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.18.3"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.18.3" ;
    bio:hasMaatregel "Er is een actueel mandaatregister of er zijn functieprofielen waaruit blijkt welke personen bevoegdheden hebben voor het verlenen van toegangsrechten." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_18_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.18.4"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.18.4" ;
    bio:hasMaatregel "Alle uitgegeven toegangsrechten worden minimaal eenmaal per jaar beoordeeld." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_18_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.18.5"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.18.5" ;
    bio:hasMaatregel "Alle uitgegeven toegangsrechten worden minimaal eenmaal per halfjaar beoordeeld." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_18_6 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.18.6"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem ;
    bio:bioMaatregelNummer "5.18.6" ;
    bio:hasMaatregel "Ongeautoriseerde afwijkingen op of ongeautoriseerde aanpassingen aan uitgegeven toegangsrechten worden beschouwd als beveiligingsgebeurtenis en als zodanig vastgelegd en afgehandeld." ;
    bio:implementsControl bio:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_19_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.19.1"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.19.1" ;
    bio:hasMaatregel "Bij offerteaanvragen waar informatie(voorziening) een rol speelt, worden inkoopeisen ten aanzien van informatiebeveiliging (beschikbaarheid, integriteit en vertrouwelijkheid) benoemd. Deze eisen zijn gebaseerd op een expliciete risicoafweging. Bijvoorbeeld kan gebruik gemaakt worden van de maatregelset uit de Inkoopeisen Cybersecurity Overheid (ICO)." ;
    bio:implementsControl bio:ISO27002_5_19 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_19_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.19.2"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.19.2" ;
    bio:hasMaatregel "Op basis van een expliciete risicoafweging worden de beheersmaatregelen met betrekking tot leverancierstoegang tot bedrijfsinformatie vastgesteld." ;
    bio:implementsControl bio:ISO27002_5_19 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_19_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.19.3"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.19.3" ;
    bio:hasMaatregel "Met alle leveranciers die als verwerker voor of namens de organisatie persoonsgegevens verwerken, worden verwerkersovereenkomsten gesloten waarin alle wettelijk vereiste afspraken zijn vastgesteld." ;
    bio:implementsControl bio:ISO27002_5_19 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_20_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.20.1"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.20.1" ;
    bio:hasMaatregel "De beveiligingseisen uit de offerteaanvraag worden expliciet opgenomen in de (inkoop)contracten waar de verwerking van informatie een rol speelt." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_20_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.20.2"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.20.2" ;
    bio:hasMaatregel "In de inkoopcontracten worden expliciet prestatie-indicatoren en de bijbehorende verantwoordingsrapportages opgenomen." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_20_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.20.3"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.20.3" ;
    bio:hasMaatregel "In situaties waarin contractvoorwaarden worden opgelegd door leveranciers, is voorafgaand aan het tekenen van het contract met een risicoafweging helder gemaakt wat de consequenties hiervan zijn voor de organisatie. Expliciet is gemaakt welke consequenties geaccepteerd worden, welke gemitigeerd moeten zijn en welke voorwaarden niet of nooit geaccepteerd mogen worden bij het aangaan van de overeenkomst." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_20_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.20.4"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.20.4" ;
    bio:hasMaatregel "Ter waarborging van vertrouwelijkheid of geheimhouding worden bij IT-inkopen standaardvoorwaarden voor inkoop gehanteerd." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_20_5 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.20.5"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.20.5" ;
    bio:hasMaatregel "Voordat een contract wordt afgesloten, wordt in een risicoafweging bepaald of de afhankelijkheid van een leverancier beheersbaar is. Een vast onderdeel van het contract is een expliciete uitwerking van de exit-strategie." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_20_6 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.20.6"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.20.6" ;
    bio:hasMaatregel "In inkoopcontracten wordt expliciet de mogelijkheid van een externe audit opgenomen waarmee de betrouwbaarheid van de geleverde dienst kan worden getoetst. Een audit is niet nodig als de contractant door middel van certificering aantoont dat de gewenste betrouwbaarheid van de dienst is geborgd." ;
    bio:implementsControl bio:ISO27002_5_20 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_21_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.21.1"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.21.1" ;
    bio:hasMaatregel """Leveranciers moeten gedurende de looptijd van het contract:
(a) hun keten van toeleveranciers bekendmaken;
(b) transparant zijn over de maatregelen die zij genomen hebben om de aan hen opgelegde eisen ook door te vertalen naar hun toeleveranciers;
(c) transparant zijn over de resultaten van de controle bij toeleveranciers over de aan hen opgelegde maatregelen, zie ook paragraaf 4.4;
(d) risico's terugmelden.""" ;
    bio:implementsControl bio:ISO27002_5_21 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_22_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.22.1"@nl ;
    asset:appliesToAssetType asset:Asset ;
    bio:bioMaatregelNummer "5.22.1" ;
    bio:hasMaatregel "Jaarlijks wordt de prestatie van leveranciers op het gebied van informatiebeveiliging beoordeeld op vooraf vastgestelde prestatie-indicatoren, zoals in het contract opgenomen is." ;
    bio:implementsControl bio:ISO27002_5_22 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_24_1 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.24.1"@nl ;
    asset:appliesToAssetType asset:InformationAsset,
        asset:Procedure ;
    bio:bioMaatregelNummer "5.24.1" ;
    bio:hasMaatregel "Er is een meldloket waar beveiligingsincidenten kunnen worden gemeld." ;
    bio:implementsControl bio:ISO27002_5_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_24_2 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.24.2"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:Procedure ;
    bio:bioMaatregelNummer "5.24.2" ;
    bio:hasMaatregel "Er is een meldprocedure waarin de taken en verantwoordelijkheden van het meldloket staan beschreven." ;
    bio:implementsControl bio:ISO27002_5_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_24_3 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.24.3"@nl ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset ;
    bio:bioMaatregelNummer "5.24.3" ;
    bio:hasMaatregel "De proceseigenaar is verantwoordelijk voor het oplossen van beveiligingsincidenten." ;
    bio:implementsControl bio:ISO27002_5_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_24_4 a owl:NamedIndividual,
        bio:OverheidsMaatregel ;
    rdfs:label "BIO2 Maatregel 5.24.4"@nl ;
    asset:appliesToAssetType asset:InformationAsset ;
    bio:bioMaatregelNummer "5.24.4" ;
    bio:hasMaatregel "De opvolging van incidenten wordt maandelijks gerapporteerd aan de verantwoordelijke." ;
    bio:implementsControl bio:ISO27002_5_24 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
