        "Koppelt een beheersmaatregel aan het thematisch domein waartoe deze behoort."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:ControlDomain .

ctrl:hasControlFamily a owl:ObjectProperty ;
    rdfs:label "has control family"@en,
        "heeft beheersmaatregelfamilie"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:ControlFamily .

ctrl:hasControlID a owl:DatatypeProperty ;
    rdfs:label "has control ID"@en,
