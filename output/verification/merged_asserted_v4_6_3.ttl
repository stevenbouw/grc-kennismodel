csf:RS_MA_01_Ex4 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.MA-01.Ex4"@en,
        "RS.MA-01.Ex4"@nl ;
    rdfs:comment "Initiate execution of additional cybersecurity plans as needed to support incident response (for example, business continuity and disaster recovery)"@en ;
