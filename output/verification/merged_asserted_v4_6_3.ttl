csf:RS_CO_03_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.CO-03.Ex1"@en,
        "RS.CO-03.Ex1"@nl ;
    rdfs:comment "Securely share information consistent with response plans and information sharing agreements"@en ;
