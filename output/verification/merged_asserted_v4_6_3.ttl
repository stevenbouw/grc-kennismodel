csf:PR_PS_01_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "PR.PS-01.Ex1"@en,
        "PR.PS-01.Ex1"@nl ;
    rdfs:comment "Establish, test, deploy, and maintain hardened baselines that enforce the organization’s cybersecurity policies and provide only essential capabilities (i.e., principle of least functionality)"@en ;
