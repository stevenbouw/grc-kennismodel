    csf:csfIdentifier "GV.SC-05.Ex6" ;
    csf:exemplifies csf:GV_SC_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_SC_05_Ex7 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.SC-05.Ex7"@en,
        "GV.SC-05.Ex7"@nl ;
    rdfs:comment "Contractually require suppliers to provide and maintain a current component inventory (e.g., software or hardware bill of materials) for critical products"@en ;
    csf:csfIdentifier "GV.SC-05.Ex7" ;
    csf:exemplifies csf:GV_SC_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_SC_05_Ex8 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.SC-05.Ex8"@en,
        "GV.SC-05.Ex8"@nl ;
