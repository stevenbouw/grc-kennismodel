    compl:satisfiedBy ctrl:ISO27002_5_35,
        ctrl:ISO27002_5_36 .

compl:REQ_NIS2_Art21_g a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 21(2)(g) — basic cyber hygiene practices and training"@en,
        "Requirement: NIS2 art. 21 lid 2 onderdeel g — basismaatregelen cyberhygiëne en training"@nl ;
    compl:belongsToDomain compl:CD_GovernanceOversight ;
    compl:derivedFrom compl:OBL_NIS2_Art21 ;
