        "RC.RP-02.Ex2"@nl ;
    rdfs:comment "Change planned recovery actions based on a reassessment of organizational needs and resources"@en ;
    csf:csfIdentifier "RC.RP-02.Ex2" ;
    csf:exemplifies csf:RC_RP_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_03_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.RP-03.Ex1"@en,
        "RC.RP-03.Ex1"@nl ;
    rdfs:comment "Check restoration assets for indicators of compromise, file corruption, and other integrity issues before use"@en ;
    csf:csfIdentifier "RC.RP-03.Ex1" ;
    csf:exemplifies csf:RC_RP_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_04_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.RP-04.Ex1"@en,
        "RC.RP-04.Ex1"@nl ;
    rdfs:comment "Use business impact and system categorization records (including service delivery objectives) to validate that essential services are restored in the appropriate order"@en ;
    csf:csfIdentifier "RC.RP-04.Ex1" ;
    csf:exemplifies csf:RC_RP_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_04_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.RP-04.Ex2"@en,
        "RC.RP-04.Ex2"@nl ;
    rdfs:comment "Work with system owners to confirm the successful restoration of systems and the return to normal operations"@en ;
    csf:csfIdentifier "RC.RP-04.Ex2" ;
    csf:exemplifies csf:RC_RP_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_04_Ex3 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.RP-04.Ex3"@en,
        "RC.RP-04.Ex3"@nl ;
    rdfs:comment "Monitor the performance of restored systems to verify the adequacy of the restoration"@en ;
    csf:csfIdentifier "RC.RP-04.Ex3" ;
    csf:exemplifies csf:RC_RP_04 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_05_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.RP-05.Ex1"@en,
        "RC.RP-05.Ex1"@nl ;
    rdfs:comment "Check restored assets for indicators of compromise and remediation of root causes of the incident before production use"@en ;
    csf:csfIdentifier "RC.RP-05.Ex1" ;
    csf:exemplifies csf:RC_RP_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_05_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.RP-05.Ex2"@en,
        "RC.RP-05.Ex2"@nl ;
    rdfs:comment "Verify the correctness and adequacy of the restoration actions taken before putting a restored system online"@en ;
    csf:csfIdentifier "RC.RP-05.Ex2" ;
    csf:exemplifies csf:RC_RP_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_06_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.RP-06.Ex1"@en,
        "RC.RP-06.Ex1"@nl ;
    rdfs:comment "Prepare an after-action report that documents the incident itself, the response and recovery actions taken, and lessons learned"@en ;
    csf:csfIdentifier "RC.RP-06.Ex1" ;
    csf:exemplifies csf:RC_RP_06 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_06_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RC.RP-06.Ex2"@en,
        "RC.RP-06.Ex2"@nl ;
    rdfs:comment "Declare the end of incident recovery once the criteria are met"@en ;
    csf:csfIdentifier "RC.RP-06.Ex2" ;
    csf:exemplifies csf:RC_RP_06 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_AN_03_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.AN-03.Ex1"@en,
        "RS.AN-03.Ex1"@nl ;
