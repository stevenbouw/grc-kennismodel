    skos:definition "Image and reputation as a protected interest within the central government."@en,
        "Imago en reputatie als beschermwaardig belang binnen de Rijksdienst."@nl ;
    skos:exactMatch asset:IntangibleAsset ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "image"@en,
        "imago"@nl .

fw:TBB_Informatie a skos:Concept ;
    rdfs:label "TBB Information"@en,
        "TBB Informatie"@nl ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    skos:definition "Information as a protected interest within the central government, regardless of medium or form."@en,
        "Informatie als beschermwaardig belang binnen de Rijksdienst, ongeacht drager of vorm."@nl ;
    skos:exactMatch asset:InformationAsset ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "information"@en,
        "informatie"@nl .

fw:TBB_Informatiesystemen a skos:Concept ;
    rdfs:label "TBB Information Systems"@en,
        "TBB Informatiesystemen"@nl ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    skos:definition "Information systems as a protected interest within the central government."@en,
        "Informatiesystemen als beschermwaardig belang binnen de Rijksdienst."@nl ;
    skos:exactMatch asset:InformationSystem ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "information systems"@en,
        "informatiesystemen"@nl .

fw:TBB_Materieel a skos:Concept ;
    rdfs:label "TBB Equipment"@en,
        "TBB Materieel"@nl ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    skos:definition "Durable operational resources as a protected interest within the central government."@en,
        "Duurzame operationele middelen als beschermwaardig belang binnen de Rijksdienst."@nl ;
    skos:exactMatch asset:Equipment ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "equipment"@en,
        "materieel"@nl .

fw:TBB_Objecten a skos:Concept ;
    rdfs:label "TBB Objects"@en,
        "TBB Objecten"@nl ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    skos:definition "Physical objects (such as buildings and secure rooms) as a protected interest within the central government, insofar as not covered by equipment or tangible goods."@en,
        "Fysieke objecten (zoals gebouwen en beveiligde ruimten) als beschermwaardig belang binnen de Rijksdienst, voor zover niet vallend onder materieel of goederen."@nl ;
    skos:exactMatch asset:PhysicalObject ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "objects"@en,
        "objecten"@nl .

fw:TBB_Personen a skos:Concept ;
    rdfs:label "TBB Persons"@en,
        "TBB Personen"@nl ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    skos:definition "Natural persons as a protected interest within the central government."@en,
        "Natuurlijke personen als beschermwaardig belang binnen de Rijksdienst."@nl ;
    skos:exactMatch asset:HumanAsset ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "persons"@en,
        "personen"@nl .

fw:VIRBI_2013 a fw:NationalLaw ;
    rdfs:label "VIRBI 2013"@en,
        "VIRBI 2013"@nl ;
    rdfs:comment "Superseded version of VIRBI."@en,
        "Vervangen versie van VIRBI."@nl ;
    fw:hasIdentifier "VIRBI-2013" .

fw:VNG a fw:IssuingBody ;
    rdfs:label "Association of Netherlands Municipalities (VNG)"@en,
        "Vereniging van Nederlandse Gemeenten (VNG)"@nl ;
    foaf:name "VNG" .

fw:transposedBy a owl:ObjectProperty ;
    rdfs:label "transposed by"@en,
        "omgezet door"@nl ;
    rdfs:comment "Links an EU Directive to the national law(s) that transpose it."@en,
        "Koppelt een EU-richtlijn aan de nationale wet(ten) die haar omzetten."@nl ;
    rdfs:domain fw:EUDirective ;
    rdfs:range fw:NationalLaw .

fw:uitgewerktIn a owl:ObjectProperty ;
    rdfs:label "elaborated in"@en,
        "uitgewerkt in"@nl ;
    rdfs:comment "Links a national law to a general administrative order (AMvB) that elaborates it. Example v4.4.0: fw:CBW fw:uitgewerktIn fw:Cbb. Domain and range are both fw:NationalLaw following precedent (BesluitCIOStelsel, BesluitBVAStelsel and VIR/VIRBI are also plain fw:NationalLaw individuals without an AMvB subclass)."@en,
        "Koppelt een wet aan een algemene maatregel van bestuur (AMvB) die haar uitwerkt. Voorbeeld v4.4.0: fw:CBW fw:uitgewerktIn fw:Cbb. Domain en range zijn beide fw:NationalLaw conform precedent (BesluitCIOStelsel, BesluitBVAStelsel en VIR/VIRBI zijn ook gewone fw:NationalLaw-individuals zonder AMvB-subklasse)."@nl ;
    rdfs:domain fw:NationalLaw ;
    rdfs:range fw:NationalLaw .

isms:ASSET_003 a isms:PrimaryAsset ;
    isms:assetID "AST-003" ;
    isms:assetName "Correspondentie en beleidsdocumenten"@nl ;
    isms:availabilityValue 2 ;
    isms:confidentialityValue 2 ;
    isms:hasClassification isms:CL_Intern ;
    isms:inScopeOf isms:SCOPE_Hoofdorganisatie ;
    isms:integrityValue 2 ;
    isms:ownedBy roles:R_Lijnmanager .

isms:ActPhase a owl:Class ;
    rdfs:label "Act Phase"@en,
        "Act-fase"@nl ;
    rdfs:comment "Take corrective actions and continually improve the ISMS. [ISO 27001:2022 Clause 10]"@en,
        "Neem corrigerende maatregelen en verbeter het ISMS continu. [ISO 27001:2022 Clausule 10]"@nl ;
    rdfs:subClassOf isms:PDCAPhase .

isms:CheckPhase a owl:Class ;
    rdfs:label "Check Phase"@en,
        "Check-fase"@nl ;
    rdfs:comment "Monitor, measure, audit and review ISMS performance. [ISO 27001:2022 Clause 9]"@en,
        "Monitor, meet, audit en beoordeel ISMS-prestaties. [ISO 27001:2022 Clausule 9]"@nl ;
    rdfs:subClassOf isms:PDCAPhase .

isms:ControlObjective a owl:Class ;
    rdfs:label "Control Objective"@en,
        "Beheersdoelstelling"@nl ;
    rdfs:comment "A statement of intent describing what is to be achieved by implementing controls in a given area."@en,
        "Een intentieformulering die beschrijft wat beoogd wordt te bereiken door het implementeren van beheersmaatregelen in een bepaald gebied."@nl .

isms:DoPhase a owl:Class ;
    rdfs:label "Do Phase"@en,
        "Do-fase"@nl ;
    rdfs:comment "Implement and operate controls, processes and procedures. [ISO 27001:2022 Clause 8]"@en,
        "Implementeer en beheer beheersmaatregelen, processen en procedures. [ISO 27001:2022 Clausule 8]"@nl ;
    rdfs:subClassOf isms:PDCAPhase .

isms:Guideline a owl:Class ;
    rdfs:label "Guideline"@en,
        "Richtlijn"@nl ;
    rdfs:comment "Advisory document providing recommended approaches (not mandatory)."@en,
        "Advisdocument met aanbevolen benaderingen (niet verplicht)."@nl ;
    rdfs:subClassOf isms:ISMSDocument .

isms:ISMSContext a owl:Class ;
    rdfs:label "ISMS Context"@en,
        "ISMS-context"@nl ;
    rdfs:comment "Internal and external issues relevant to the ISMS. [ISO/IEC 27001:2022 Clause 4.1]"@en,
        "Interne en externe onderwerpen die relevant zijn voor het ISMS. [ISO/IEC 27001:2022 Clausule 4.1]"@nl .

isms:ISMS_HoofdOrganisatie a isms:ISMS ;
    rdfs:label "Main Organisation ISMS"@en,
        "ISMS Hoofdorganisatie"@nl ;
    rdfs:comment "The organisation's primary ISMS, certified per ISO/IEC 27001:2022, also covering BIO 2.0 and NIS2/CBW obligations."@en,
        "Het primaire ISMS van de organisatie, gecertificeerd conform ISO/IEC 27001:2022, mede dekkend BIO 2.0 en NIS2/CBW-verplichtingen."@nl ;
    isms:addressesObligation compl:OBL_BIO2_Governance,
        compl:OBL_ISO27001_Cl6_1,
        compl:OBL_NIS2_Art20,
        compl:OBL_NIS2_Art21 ;
    isms:governedBy roles:R_CISO ;
    isms:hasISMSID "ISMS-NL-GOV-001" ;
    isms:hasScope isms:SCOPE_Hoofdorganisatie ;
    isms:hasSoA isms:SoA_2026 .

isms:InterestedParty a owl:Class ;
    rdfs:label "Interested Party / Stakeholder"@en,
        "Belanghebbende"@nl ;
    rdfs:comment "Person or organisation that can affect, be affected by, or perceive itself to be affected by the ISMS. [ISO/IEC 27001:2022 Clause 4.2]"@en,
        "Persoon of organisatie die het ISMS kan beïnvloeden, erdoor beïnvloed kan worden, of zichzelf als beïnvloed beschouwt. [ISO/IEC 27001:2022 Clausule 4.2]"@nl .

isms:PDCA_Act_2026 a isms:ActPhase ;
    rdfs:label "Act 2026: Processing of audit findings, corrective actions"@en,
        "Act 2026: Verwerking auditbevindingen, corrigerende maatregelen"@nl .

isms:PDCA_Check_2026 a isms:CheckPhase ;
    rdfs:label "Check 2026: Internal audit Q3, management review Q4"@en,
        "Check 2026: Interne audit Q3, directiebeoordeling Q4"@nl .

isms:PDCA_Do_2026 a isms:DoPhase ;
    rdfs:label "Do 2026: Incident procedure implementation, MFA rollout, supplier policy"@en,
        "Do 2026: Implementatie incidentprocedure, MFA-uitrol, leveranciersbeleid"@nl .

isms:PDCA_Plan_2026 a isms:PlanPhase ;
    rdfs:label "Plan 2026: Risk assessment, SoA update, policy remediation"@en,
        "Plan 2026: Risicobeoordeling, SoA-update, beleidsherstel"@nl .

isms:PROC_001 a isms:Procedure ;
    isms:approvedDate "2025-10-01"^^xsd:date ;
    isms:documentID "PROC-001" ;
    isms:documentTitle "User Management and Access Provisioning Procedure"@en,
        "Procedure Gebruikersbeheer en Toegangsverlening"@nl ;
    isms:documentVersion "2.0" ;
    isms:reviewDate "2026-10-01"^^xsd:date .

isms:PROC_002 a isms:Procedure ;
    isms:documentID "PROC-002" ;
    isms:documentTitle "Information Security Incident Reporting and Handling Procedure"@en,
        "Procedure Informatiebeveiligingsincidentmelding en -afhandeling"@nl ;
    isms:documentVersion "0.5-CONCEPT" ;
    isms:reviewDate "2026-04-01"^^xsd:date .

isms:PlanPhase a owl:Class ;
    rdfs:label "Plan Phase"@en,
        "Plan-fase"@nl ;
    rdfs:comment "Establish ISMS scope, policy, risk assessment, risk treatment, SoA. [ISO 27001:2022 Clauses 4–6]"@en,
        "Stel ISMS-toepassingsgebied, beleid, risicobeoordeling, risicobehandeling, VvT vast. [ISO 27001:2022 Clausules 4–6]"@nl ;
    rdfs:subClassOf isms:PDCAPhase .

isms:Record a owl:Class ;
    rdfs:label "Record (Documented Evidence)"@en,
        "Registratie (gedocumenteerd bewijs)"@nl ;
    rdfs:comment "Evidence of activities performed, retained as documented information."@en,
        "Bewijs van uitgevoerde activiteiten, bewaard als gedocumenteerde informatie."@nl ;
    rdfs:subClassOf isms:ISMSDocument .

isms:WorkInstruction a owl:Class ;
    rdfs:label "Work Instruction"@en,
        "Werkinstructie"@nl ;
    rdfs:comment "Detailed step-by-step instructions for a specific task."@en,
        "Gedetailleerde stap-voor-stap instructies voor een specifieke taak."@nl ;
    rdfs:subClassOf isms:ISMSDocument .

isms:forCapability a owl:ObjectProperty ;
    rdfs:label "for capability"@en,
        "voor capability"@nl ;
    rdfs:comment "Inverse of isms:hasLevelDescription. Points from a LevelDescription back to the Capability."@en,
        "Inverse van isms:hasLevelDescription. Wijst van een LevelDescription terug naar de Capability."@nl ;
    rdfs:domain isms:CapabilityLevelDescription ;
    rdfs:range isms:MaturityCapability ;
    owl:inverseOf isms:hasLevelDescription .

isms:forSoA a owl:ObjectProperty ;
    rdfs:label "for SoA"@en,
        "behoort bij SoA"@nl ;
    rdfs:comment "Links a Statement of Applicability entry to the SoA it belongs to."@en,
        "Koppelt een SoA-entry aan de Statement of Applicability waartoe deze behoort."@nl ;
    rdfs:domain isms:SoAEntry ;
    rdfs:range isms:StatementOfApplicability .

isms:hasLevelDescription a owl:ObjectProperty ;
    rdfs:label "has level description"@en,
        "heeft niveau-beschrijving"@nl ;
    rdfs:comment "Links a MaturityCapability to its item-specific level descriptions (typically 5)."@en,
        "Koppelt een MaturityCapability aan zijn item-specifieke niveau-beschrijvingen (typisch 5)."@nl ;
    rdfs:domain isms:MaturityCapability ;
    rdfs:range isms:CapabilityLevelDescription ;
    owl:inverseOf isms:forCapability .

<https://grc.example.org/ontology/grc-bridges> a owl:Ontology ;
    rdfs:label "GRC Ontology — Cross-Module Bridges"@en,
        "GRC Ontologie — Cross-Module Bridges"@nl ;
    rdfs:comment "owl:sameAs assertions for namespace bridges. D5 (v4.0.0): 93 ctrl:↔bio: bridge triples for ISO 27002 controls. D11 (v4.3.0): 5 asset convergence bridges between asset: (M18), risk: (M03) and isms: (M06). Both bridges require OWL RL or stronger for inference."@en,
        "owl:sameAs asserties voor namespace-bruggen. D5 (v4.0.0): 93 ctrl:↔bio: brug-triples voor ISO 27002-controls. D11 (v4.3.0): 5 asset-convergentie-bruggen tussen asset: (M18), risk: (M03) en isms: (M06). Beide bruggen vereisen OWL RL of sterker voor inferentie."@nl ;
    owl:imports <https://grc.example.org/ontology/> .

<https://grc.example.org/ontology/m01-framework> a owl:Ontology ;
    rdfs:label "GRC Ontologie Module M1 — Framework"@nl ;
