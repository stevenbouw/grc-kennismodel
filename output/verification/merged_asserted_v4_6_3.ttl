    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_MA_03_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.MA-03.Ex1"@en,
        "RS.MA-03.Ex1"@nl ;
    rdfs:comment "Further review and categorize incidents based on the type of incident (e.g., data breach, ransomware, DDoS, account compromise)"@en ;
