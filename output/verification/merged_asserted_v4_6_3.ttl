csf:GV_RR_04_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.RR-04.Ex1"@en,
        "GV.RR-04.Ex1"@nl ;
    rdfs:comment "Integrate cybersecurity risk management considerations into human resources processes (e.g., personnel screening, onboarding, change notification, offboarding)"@en ;
