fw:ISO_IEC_27005_2022 a fw:InternationalStandard ;
    rdfs:label "ISO/IEC 27005:2022"@en,
        "ISO/IEC 27005:2022"@nl ;
    rdfs:comment "Information security risk management – guidelines aligned with ISO 31000."@en,
        "Risicobeheer voor informatiebeveiliging – richtlijnen afgestemd op ISO 31000."@nl ;
    skos:broadMatch fw:ISO_31000_2018 ;
    skos:closeMatch fw:NIST_SP_800_30_R1 ;
    fw:appliesInJurisdiction fw:JurisdictionInternational ;
    fw:hasDomain fw:DomainInformationSecurity,
        fw:DomainRiskManagement ;
    fw:hasIdentifier "ISO-IEC-27005-2022" ;
    fw:hasPublicationDate "2022-10-01"^^xsd:date ;
    fw:hasVersionLabel "2022" ;
    fw:isMandatoryForDutchGovernment false ;
    fw:issuedBy fw:IEC,
        fw:ISO ;
    fw:relatedTo fw:ISO_31000_2018 .

fw:InternationalStandard a owl:Class ;
    rdfs:label "International Standard"@en,
        "Internationale norm"@nl ;
    rdfs:comment "A standard published by an international body such as ISO or IEC."@en,
        "Een norm gepubliceerd door een internationale instantie zoals ISO of IEC."@nl ;
    rdfs:subClassOf fw:Standard .

fw:Regulation a owl:Class ;
    rdfs:label "Regulation"@en,
        "Wet- en regelgeving"@nl ;
    rdfs:comment "A legally binding instrument issued by a governmental or supranational authority."@en,
        "Een juridisch bindend instrument, uitgevaardigd door een overheids- of supranationaal gezag."@nl ;
    rdfs:subClassOf fw:GRCFramework ;
    owl:disjointWith fw:BestPractice,
        fw:Guideline,
        fw:Standard .

isms:ApplicabilityDecision a owl:Class ;
    rdfs:label "Applicability Decision"@en,
        "Toepasselijkheidsbeslissing"@nl ;
    rdfs:comment "Whether an Annex A control is included or excluded in the SoA."@en,
        "Of een Bijlage A-beheersmaatregel is opgenomen of uitgesloten in de VvT."@nl .

isms:StatementOfApplicability a owl:Class ;
    rdfs:label "Statement of Applicability (SoA)"@en,
        "Verklaring van Toepasselijkheid (VvT)"@nl ;
    rdfs:comment "A document required by ISO/IEC 27001:2022 Clause 6.1.3(d) listing all Annex A controls with applicability decisions, implementation status and justifications."@en,
        "Een document vereist door ISO/IEC 27001:2022 Clausule 6.1.3(d) met alle Annex A-beheersmaatregelen, toepasselijkheidsbesluiten, implementatiestatus en motivaties."@nl .

risk:Vulnerability a owl:Class ;
    rdfs:label "Vulnerability"@en,
        "Kwetsbaarheid"@nl ;
    rdfs:comment "A weakness in an information system, security procedures, internal controls or implementation that could be exploited or triggered by a threat source. [NIST SP 800-30]"@en,
        "Een zwakheid in een informatiesysteem, beveiligingsprocedures, interne beheersmaatregelen of implementatie die door een dreigingsbron benut of getriggerd kan worden. [NIST SP 800-30]"@nl ;
    skos:closeMatch fw:NIST_SP_800_30_R1 ;
    prov:wasDerivedFrom fw:ISO_IEC_27005_2022 .

roles:ACT_RisicoBeoordelingUitvoeren a roles:GRCActivity ;
    roles:hasActivityID "ACT-02" ;
    roles:hasActivityTitle "Conduct risk assessment (identify, analyse, evaluate)"@en,
        "Risicobeoordeling uitvoeren (identify, analyse, evaluate)"@nl .

asset:AssetComponent a owl:Class ;
    rdfs:label "Asset Component"@en,
        "Bedrijfsmiddelcomponent"@nl ;
    dcterms:source "Besluit CIO-stelsel Rijksdienst 2026 art. 1o" ;
    rdfs:comment "A constituent part of an asset. Used as range (together with asset:Asset) for mereological relations (asset:hasComponent) and for control-applicability (asset:appliesToAssetType). Components are typed per asset subclass — see CIO-stelsel art. 1o for the canonical InformationSystem components."@en,
        "Een samenstellend onderdeel van een bedrijfsmiddel. Gebruikt als range (samen met asset:Asset) voor mereologische relaties (asset:hasComponent) en voor maatregeltoepasbaarheid (asset:appliesToAssetType). Componenten worden per asset-subklasse getypeerd — zie CIO-stelsel art. 1o voor de canonieke InformationSystem-componenten."@nl .

