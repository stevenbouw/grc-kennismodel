        csf:ImplementationExample ;
    rdfs:label "PR.IR-04.Ex1"@en,
        "PR.IR-04.Ex1"@nl ;
    rdfs:comment "Monitor usage of storage, power, compute, network bandwidth, and other resources"@en ;
