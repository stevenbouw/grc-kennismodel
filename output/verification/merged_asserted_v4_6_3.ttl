ext:StgC a owl:NamedIndividual,
        ext:ClassificationLevel ;
    rdfs:label "State Secret CONFIDENTIAL (Stg.C)"@en,
        "Staatsgeheim CONFIDENTIEEL (Stg.C)"@nl ;
    rdfs:comment "Kennisname door niet-geautoriseerden kan schade toebrengen aan een van de vitale belangen van Nederland en de Nederlandse staat, of zijn bondgenoten."@nl .

ext:StgG a owl:NamedIndividual,
        ext:ClassificationLevel ;
    rdfs:label "State Secret SECRET (Stg.G)"@en,
        "Staatsgeheim GEHEIM (Stg.G)"@nl ;
    rdfs:comment "Kennisname door niet-geautoriseerden kan ernstige schade toebrengen aan een van de vitale belangen van Nederland en de Nederlandse staat, of zijn bondgenoten."@nl .

ext:StgZG a owl:NamedIndividual,
        ext:ClassificationLevel ;
    rdfs:label "State Secret TOP SECRET (Stg.ZG)"@en,
        "Staatsgeheim ZEER GEHEIM (Stg.ZG)"@nl ;
    rdfs:comment "Kennisname door niet-geautoriseerden kan zeer ernstige schade toebrengen aan een van de vitale belangen van Nederland en de Nederlandse staat, of zijn bondgenoten."@nl .

ext:alignsWithHSClause a owl:ObjectProperty ;
    rdfs:label "aligns with HS clause"@en,
        "sluit aan bij HS-clausule"@nl ;
    rdfs:comment "Links an ISMS requirement (e.g. an ISO 27001 clause) to the Annex SL Harmonized Structure clause it is substantively aligned with."@en,
        "Koppelt een ISMS-vereiste (bijv. een ISO 27001-clausule) aan de Annex SL Harmonized Structure-clausule waaraan deze inhoudelijk is uitgelijnd."@nl ;
    rdfs:domain ext:ISMSRequirement ;
    rdfs:range ext:HSClause .

ext:clauseNumber a owl:DatatypeProperty ;
    rdfs:label "clause number"@en,
        "clausenummer"@nl ;
    rdfs:domain compl:ComplianceRequirement ;
    rdfs:range xsd:string .

ext:cobitDomain a owl:DatatypeProperty ;
    rdfs:label "COBIT domain"@en,
        "COBIT-domein (EDM/APO/BAI/DSS/MEA)"@nl ;
    rdfs:domain ext:COBITObjective ;
    rdfs:range xsd:string .

ext:cobitObjectiveID a owl:DatatypeProperty ;
    rdfs:label "COBIT objective ID"@en,
        "COBIT-doelstellingscode"@nl ;
    rdfs:domain ext:COBITObjective ;
    rdfs:range xsd:string .

ext:controlFamilyCode a owl:DatatypeProperty ;
    rdfs:label "control family code"@en,
        "controlefamilie code"@nl ;
    rdfs:domain ext:ControlFamily ;
    rdfs:range xsd:string .

ext:hasAttributionText a owl:DatatypeProperty ;
    rdfs:label "attribution text"@en,
        "attribuering-tekst"@nl ;
    rdfs:comment "Bilingual citation text for publication/dashboard output. Satisfies the source license attribution requirement."@en,
        "Tweetalige citeer-zin voor publicatie/dashboard-uitvoer. Voldoet aan attributievereiste van de bronlicentie."@nl ;
    rdfs:domain ext:SourceAttribution ;
    rdfs:range rdfs:Literal .

ext:hasAuditDomain a owl:ObjectProperty ;
    rdfs:label "has audit domain"@en,
        "heeft auditdomein"@nl ;
    rdfs:comment "Links ENSIA to one of its audit domains."@en,
        "Koppelt ENSIA aan een van de verantwoordingsdomeinen."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range ext:ENSIAAuditDomain .

ext:hasCbbArticle a owl:DatatypeProperty ;
    rdfs:label "Cbb article"@en,
        "Cbb-artikel"@nl ;
    rdfs:comment "Reference to the Cbb article providing the operational elaboration for this control. Source: CBW/NIS2 Control Framework (ADR & NOREA, CC-BY 4.0) — sheet 'Mapping BIO2' column G for bio:BIOControl subjects; sheet 'Cbw (NIS2) Control Framework' column D for ctrl:CBWControl subjects. Reference notation is taken verbatim from the source material; one control may carry multiple Cbb article references."@en,
        "Verwijzing naar het Cbb-artikel dat de operationele invulling vormt voor deze control. Bron: CBW/NIS2 Control Framework (ADR & NOREA, CC-BY 4.0) — sheet 'Mapping BIO2' kolom G voor bio:BIOControl-subjects; sheet 'Cbw (NIS2) Control Framework' kolom D voor ctrl:CBWControl-subjects. Ref-notatie wordt letterlijk overgenomen uit het bronmateriaal; één control kan meerdere Cbb-artikel-refs hebben."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range xsd:string .

ext:hasCbwArticle a owl:DatatypeProperty ;
    rdfs:label "CBW article"@en,
        "Cbw-artikel"@nl ;
    rdfs:comment "Reference to the CBW article providing the legal basis for this control. Source: CBW/NIS2 Control Framework (ADR & NOREA, CC-BY 4.0) — sheet 'Mapping BIO2' column F for bio:BIOControl subjects; sheet 'Cbw (NIS2) Control Framework' column D for ctrl:CBWControl subjects. Reference notation is taken verbatim from the source material; one control may carry multiple CBW article references."@en,
        "Verwijzing naar het Cbw-artikel dat de juridische basis vormt voor deze control. Bron: CBW/NIS2 Control Framework (ADR & NOREA, CC-BY 4.0) — sheet 'Mapping BIO2' kolom F voor bio:BIOControl-subjects; sheet 'Cbw (NIS2) Control Framework' kolom D voor ctrl:CBWControl-subjects. Ref-notatie wordt letterlijk overgenomen uit het bronmateriaal; één control kan meerdere Cbw-artikel-refs hebben."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range xsd:string .

ext:hasControlStatement a owl:DatatypeProperty ;
    rdfs:label "control statement"@en,
        "control-statement"@nl ;
    rdfs:comment "The operational core statement of a control: a concise description of the measure to be taken or outcome to be achieved. Distinguished from rdfs:comment: rdfs:comment may contain explanatory context; ext:hasControlStatement is the normative core requirement. First use in v4.4.0: 26 ctrl:CBWControl individuals (sheet 3 column F Beheersmaatregel text). Generic domain ctrl:Control makes it reusable for future NIST CSF, NIST 800-53, ISO 27002 controls."@en,
        "De operationele kern-statement van een control: een beknopte beschrijving van de te treffen maatregel of het te behalen resultaat. Onderscheid t.o.v. rdfs:comment: rdfs:comment kan toelichtende context bevatten; ext:hasControlStatement is de normatieve kern-eis. Eerste toepassing v4.4.0: 26 ctrl:CBWControl-individuals (sheet 3 kolom F Beheersmaatregel-tekst). Generic domain ctrl:Control maakt herbruikbaar voor toekomstige NIST CSF, NIST 800-53, ISO 27002-controls."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range rdfs:Literal .

ext:hasHandreikingBBN a owl:DatatypeProperty ;
    rdfs:label "has Handreiking BBN"@en,
        "heeft Handreiking-BBN"@nl ;
    dcterms:source "Handreiking BIO2-opmaat v2.5" ;
    rdfs:comment "Baseline protection level (BBN) as assigned by the Handreiking BIO2-opmaat v2.5 (transition document). Applies broadly to baseline controls: both bio:BIOControl (ISO 27002-based) and bio:OverheidsMaatregel (government-specific). BBN is NOT defined in BIO 2.0 itself, only in the Handreiking. Valid values: 1 (baseline) and 2 (elevated). BBN 3 does not exist in this source."@en,
        "Basisbeveiligingsniveau (BBN) zoals toegekend door de Handreiking BIO2-opmaat v2.5 (transitiedocument). Van toepassing op baselinecontroles breed: zowel bio:BIOControl (ISO 27002-gebaseerd) als bio:OverheidsMaatregel (overheidsspecifiek). BBN is NIET gedefinieerd in BIO 2.0 zelf, maar uitsluitend in de Handreiking. Geldige waarden: 1 (basis) en 2 (verhoogd). BBN 3 bestaat niet in deze bron."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range xsd:integer .

ext:hasLicense a owl:DatatypeProperty ;
    rdfs:label "license"@en,
        "licentie"@nl ;
    rdfs:comment "Short license identifier (e.g. \"CC-BY 4.0\", \"public domain\", \"EU law\")."@en,
        "Korte aanduiding van de licentie (bv. \"CC-BY 4.0\", \"publiek domein\", \"EU-recht\")."@nl ;
    rdfs:domain ext:SourceAttribution ;
    rdfs:range xsd:string .

ext:hasLicenseURL a owl:DatatypeProperty ;
    rdfs:label "license URL"@en,
        "licentie-URL"@nl ;
    rdfs:comment "URL to the official license text."@en,
        "URL naar de officiële licentietekst."@nl ;
    rdfs:domain ext:SourceAttribution ;
    rdfs:range xsd:anyURI .

ext:hasSourcePublicationDate a owl:DatatypeProperty ;
    rdfs:label "source publication date"@en,
        "publicatiedatum bron"@nl ;
    rdfs:comment "Date on which the external source material was officially published."@en,
        "Datum waarop het externe bronmateriaal officieel is gepubliceerd."@nl ;
    rdfs:domain ext:SourceAttribution ;
    rdfs:range xsd:date .

ext:hasSourceVersion a owl:DatatypeProperty ;
    rdfs:label "source version"@en,
        "versie bron"@nl ;
    rdfs:comment "Version identifier of the external source material (e.g. \"1.0\", \"v2.5\")."@en,
        "Versie-identificatie van het externe bronmateriaal (bv. \"1.0\", \"v2.5\")."@nl ;
    rdfs:domain ext:SourceAttribution ;
    rdfs:range xsd:string .

ext:hasUVInterpretation a owl:DatatypeProperty ;
    rdfs:label "UV interpretation"@en,
        "UV-interpretatie"@nl ;
    rdfs:comment "ADR/NOREA's interpretative elaboration of Commission Implementing Regulation (EU) 2024/2690 at control level, with its own numbering convention (1.1.2, 1.2.3, etc.). Source: CBW/NIS2 Control Framework (ADR & NOREA, version 1.0, 30 September 2025), sheet 'Cbw (NIS2) Control Framework', column H. NOT the verbatim UV text and NOT the ENISA Technical Implementation Guidance — both are separate sources."@en,
        "ADR/NOREA's interpretatieve uitwerking van Uitvoeringsverordening (EU) 2024/2690 op control-niveau, met eigen nummering-conventie (1.1.2, 1.2.3, etc.). Bronmateriaal: CBW/NIS2 Control Framework (ADR & NOREA, versie 1.0, 30 september 2025), sheet 'Cbw (NIS2) Control Framework', kolom H. NIET de letterlijke UV-tekst en NIET de ENISA Technical Implementation Guidance — beide zijn separate bronnen."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range rdfs:Literal .

ext:hasVIRBIDomain a owl:ObjectProperty ;
    rdfs:label "has VIRBI domain"@en,
        "heeft VIRBI-domein"@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range ext:VIRBISecurityDomain .

ext:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en,
        "geimplementeerd door"@nl ;
    rdfs:domain ext:ISMSRequirement ;
    rdfs:range ctrl:Control .

ext:isComponentOf a owl:ObjectProperty ;
    rdfs:label "is component of"@en,
        "is component van"@nl ;
    rdfs:comment "Links a framework component to the framework it belongs to. Standard property for component-framework relationships, replacing ad-hoc use of compl:derivedFrom for this purpose."@en,
        "Koppelt een kaderwerkcomponent aan het kaderwerk waartoe het behoort. Standaard-property voor component-framework relaties, vervangt ad-hoc gebruik van compl:derivedFrom voor dit doel."@nl ;
    rdfs:domain ext:FrameworkComponent ;
    rdfs:range fw:GRCFramework .

ext:mappedToISO27002 a owl:ObjectProperty ;
    rdfs:label "mapped to ISO 27002"@en,
        "gekoppeld aan ISO 27002"@nl ;
    rdfs:domain ext:NISTControl ;
    rdfs:range ctrl:Control .

ext:sourceAttribution a owl:ObjectProperty ;
    rdfs:label "source attribution"@en,
        "bron-attribuering"@nl ;
    rdfs:comment "Links an individual to a source attribution record. Domain is owl:Thing intentionally to allow attribution from arbitrary model individuals (controls, government measures, frameworks)."@en,
        "Koppelt een individual aan een bron-attribuering-record. Dom is bewust owl:Thing om koppeling vanaf willekeurige model-individuals (controls, overheidsmaatregelen, frameworks) toe te laten."@nl ;
    rdfs:domain owl:Thing ;
    rdfs:range ext:SourceAttribution .

fw:MinisterieVanBZK a fw:IssuingBody ;
    rdfs:label "Ministry of the Interior and Kingdom Relations"@en,
        "Ministerie van Binnenlandse Zaken en Koninkrijksrelaties"@nl ;
    rdfs:comment "Dutch ministry responsible for the Cyberbeveiligingswet (CBW)."@en,
        "Nederlands ministerie verantwoordelijk voor de Cyberbeveiligingswet (CBW)."@nl ;
    foaf:name "Ministerie van BZK" .

fw:NEN a fw:IssuingBody ;
    rdfs:label "Royal Netherlands Standardisation Institute"@en,
        "Nederlands Normalisatie Instituut"@nl ;
    foaf:name "NEN" .

fw:alignsWith a owl:ObjectProperty ;
    rdfs:label "aligns with"@en,
        "sluit aan op"@nl ;
    rdfs:comment "Indicates partial or full alignment between two frameworks."@en,
        "Geeft gedeeltelijke of volledige afstemming tussen twee kaderwerken aan."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework .

fw:appliesInJurisdiction a owl:ObjectProperty ;
    rdfs:label "applies in jurisdiction"@en,
        "van toepassing in rechtsgebied"@nl ;
    rdfs:comment "Specifies the jurisdiction(s) in which a framework is applicable or binding."@en,
        "Specificeert de rechtsgebieden waarbinnen een kaderwerk van toepassing of bindend is."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:Jurisdiction .

fw:dektAf a owl:ObjectProperty ;
    rdfs:label "covers requirements of"@en,
        "dekt eisen af van"@nl ;
    rdfs:comment "Indicates that compliance with the subject framework substantially covers the requirements of the object framework. This is a directional, non-symmetric relationship: A fw:dektAf B means implementing A satisfies (most of) B's requirements."@en,
        "Geeft aan dat naleving van het subject-framework in hoge mate de eisen van het object-framework afdekt. Dit is een directionele, niet-symmetrische relatie: A fw:dektAf B betekent dat implementatie van A (het merendeel van) B's eisen vervult."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework .

fw:geeftITInvullingAan a owl:ObjectProperty ;
    rdfs:label "provides IT implementation of"@en,
        "geeft IT-invulling aan"@nl ;
    rdfs:comment "Indicates that the subject framework provides the IT-specific implementation or operationalisation of the (broader, enterprise-level) object framework. E.g. COBIT fw:geeftITInvullingAan COSO ICF."@en,
        "Geeft aan dat het subject-framework de IT-specifieke invulling of operationalisatie biedt van het (bredere, enterprise-level) object-framework. Bijv. COBIT fw:geeftITInvullingAan COSO ICF."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework .

fw:geeftRichtlijnenVoor a owl:ObjectProperty ;
    rdfs:label "provides implementation guidance for"@en,
        "geeft implementatierichtlijnen voor"@nl ;
    rdfs:comment "Indicates that a standard provides implementation guidance for the controls of another standard. Specifically: ISO 27002 provides guidance for the implementation of ISO 27001 Annex A controls."@en,
        "Geeft aan dat een norm implementatierichtlijnen biedt voor de controls uit een andere norm. Specifiek: ISO 27002 geeft richtlijnen voor de implementatie van ISO 27001 Bijlage A controls."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework .

fw:hasDomain a owl:ObjectProperty ;
    rdfs:label "has domain"@en,
        "heeft domein"@nl ;
    rdfs:comment "Associates a framework with one or more thematic domains."@en,
        "Koppelt een kaderwerk aan een of meer thematische domeinen."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:FrameworkDomain .

fw:hasIdentifier a owl:DatatypeProperty ;
    rdfs:label "has identifier"@en,
        "heeft identificatiecode"@nl ;
    rdfs:comment "A short unique identifier for the framework (e.g. 'ISO-27001-2022')."@en,
        "Een korte unieke identificatiecode voor het kaderwerk (bijv. 'ISO-27001-2022')."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:string .

fw:hasPublicationDate a owl:DatatypeProperty ;
    rdfs:label "has publication date"@en,
        "heeft publicatiedatum"@nl ;
    rdfs:comment "The official publication date of the framework or its version."@en,
        "De officiële publicatiedatum van het kaderwerk of zijn versie."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:date .

fw:hasScope a owl:DatatypeProperty ;
    rdfs:label "has scope"@en,
        "heeft toepassingsgebied"@nl ;
    rdfs:comment "A textual description of the scope of the framework."@en,
        "Een tekstuele beschrijving van het toepassingsgebied van het kaderwerk."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range rdfs:Literal .

fw:hasVersion a owl:ObjectProperty ;
    rdfs:label "has version"@en,
        "heeft versie"@nl ;
    rdfs:comment "Links a framework to one of its published versions."@en,
        "Koppelt een kaderwerk aan een van zijn gepubliceerde versies."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:FrameworkVersion .

fw:hasVersionLabel a owl:DatatypeProperty ;
    rdfs:label "has version label"@en,
        "heeft versielabel"@nl ;
    rdfs:comment "The version string of the framework (e.g. '2022', 'Rev.5', 'v2.0')."@en,
        "De versieaanduiding van het kaderwerk (bijv. '2022', 'Rev.5', 'v2.0')."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:string .

fw:isMandatoryForDutchGovernment a owl:DatatypeProperty ;
    rdfs:label "is mandatory for Dutch government"@en,
        "verplicht voor Nederlandse overheid"@nl ;
    rdfs:comment "Indicates whether compliance with this framework is legally mandatory for Dutch government entities."@en,
        "Geeft aan of naleving van dit kaderwerk wettelijk verplicht is voor Nederlandse overheidsorganisaties."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:boolean .

fw:isTranspositieVan a owl:ObjectProperty ;
    rdfs:label "is transposition of"@en,
        "is omzetting van"@nl ;
    rdfs:comment "Links a national law to the EU Directive it transposes. Inverse of fw:transposedBy."@en,
        "Koppelt een nationale wet aan de EU-richtlijn die zij omzet. Inverse van fw:transposedBy."@nl ;
    rdfs:domain fw:NationalLaw ;
    rdfs:range fw:EUDirective ;
    owl:inverseOf fw:transposedBy .

fw:issuedBy a owl:ObjectProperty ;
    rdfs:label "issued by"@en,
        "uitgegeven door"@nl ;
    rdfs:comment "Links a framework to its issuing body."@en,
        "Koppelt een kaderwerk aan de uitgevende instantie."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:IssuingBody .

fw:officialURL a owl:DatatypeProperty ;
    rdfs:label "official URL"@en,
        "officiële URL"@nl ;
    rdfs:comment "The official web location where the framework can be accessed."@en,
        "De officiële weblocatie waar het kaderwerk kan worden geraadpleegd."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range xsd:anyURI .

fw:relatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related to"@en,
        "gerelateerd aan"@nl ;
    rdfs:comment "A symmetric property linking related frameworks (e.g. ISO 27001 and ISO 27002)."@en,
        "Een symmetrische eigenschap die gerelateerde kaderwerken koppelt (bijv. ISO 27001 en ISO 27002)."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework .

fw:status a owl:DatatypeProperty ;
    rdfs:label "status"@en,
        "status"@nl ;
    rdfs:comment "The current legal or publication status of a framework (e.g. 'in force', 'in preparation', 'superseded')."@en,
        "De huidige juridische of publicatiestatus van een kaderwerk (bijv. 'van kracht', 'in voorbereiding', 'vervangen')."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range rdfs:Literal .

fw:stelVerplicht a owl:ObjectProperty ;
    rdfs:label "mandates"@en,
        "stelt verplicht"@nl ;
    rdfs:comment "Indicates that the subject framework legally mandates the implementation of the object framework. E.g. VIR 2007 mandates BIO 2.0 for the Dutch central government."@en,
        "Geeft aan dat het subject-framework het object-framework wettelijk verplicht stelt. Bijv. VIR 2007 stelt BIO 2.0 verplicht voor de Rijksdienst."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework .

fw:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en,
        "vervangt"@nl ;
    rdfs:comment "Indicates that this framework version supersedes an earlier version."@en,
        "Geeft aan dat dit kaderwerk een eerdere versie vervangt."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework .

fw:toetst a owl:ObjectProperty ;
    rdfs:label "audits"@en,
        "toetst"@nl ;
    rdfs:comment "Indicates that the subject framework serves as an audit or assessment instrument for the object framework. E.g. ENSIA fw:toetst BIO 2.0."@en,
        "Geeft aan dat het subject-framework als audit- of toetsingsinstrument dient voor het object-framework. Bijv. ENSIA fw:toetst BIO 2.0."@nl ;
    rdfs:domain fw:GRCFramework ;
    rdfs:range fw:GRCFramework .

fw:werktUit a owl:ObjectProperty ;
    rdfs:label "elaborates"@en,
        "werkt uit"@nl ;
    rdfs:comment "Links a general administrative order to the law it elaborates. Inverse of fw:uitgewerktIn."@en,
        "Koppelt een AMvB aan de wet die zij uitwerkt. Inverse van fw:uitgewerktIn."@nl ;
    rdfs:domain fw:NationalLaw ;
    rdfs:range fw:NationalLaw ;
    owl:inverseOf fw:uitgewerktIn .

isms:AD_Excluded a isms:ApplicabilityDecision ;
    rdfs:label "Excluded"@en,
        "Uitgesloten"@nl ;
    rdfs:comment "Control is not applicable; documented justification required."@en,
        "Beheersmaatregel is niet van toepassing; gedocumenteerde motivatie vereist."@nl .

isms:AD_Included a isms:ApplicabilityDecision ;
    rdfs:label "Included"@en,
        "Opgenomen"@nl ;
    rdfs:comment "Control is applicable and included in the SoA."@en,
        "Beheersmaatregel is van toepassing en opgenomen in de VvT."@nl .

isms:ASSET_004 a isms:SupportingAsset ;
    isms:assetID "AST-004" ;
    isms:assetName "Centrale documentbeheeromgeving (DMS)"@nl ;
    isms:hasClassification isms:CL_Intern ;
    isms:inScopeOf isms:SCOPE_Hoofdorganisatie ;
    isms:ownedBy roles:R_DienstenleverancierIntern ;
    isms:supports isms:ASSET_001,
        isms:ASSET_002,
        isms:ASSET_003 .

isms:ASSET_005 a isms:SupportingAsset ;
    isms:assetID "AST-005" ;
    isms:assetName "Active Directory / Identiteitsbeheerplatform"@nl ;
    isms:hasClassification isms:CL_Vertrouwelijk ;
    isms:inScopeOf isms:SCOPE_Hoofdorganisatie ;
    isms:ownedBy roles:R_DienstenleverancierIntern ;
    isms:supports isms:ASSET_001,
        isms:ASSET_002 .

isms:CL_Confidentieel a isms:InformationClassificationLevel ;
    rdfs:label "Confidential (Classified)"@en,
        "Confidentieel (Conf.)"@nl ;
    rdfs:comment "Classified information per VIRBI 2025 – level 2. Disclosure may cause damage to state interests."@en,
        "Gerubriceerde informatie conform VIRBI 2025 – niveau 2. Openbaarmaking kan schade aan belangen van de staat veroorzaken."@nl .

isms:CL_Geheim a isms:InformationClassificationLevel ;
    rdfs:label "Secret"@en,
        "Geheim"@nl ;
    rdfs:comment "Classified information per VIRBI 2025 – level 3. Severe damage to state interests."@en,
        "Gerubriceerde informatie conform VIRBI 2025 – niveau 3. Ernstige schade aan belangen van de staat."@nl .

isms:CL_GeheimDep a isms:InformationClassificationLevel ;
    rdfs:label "Departmentally Confidential"@en,
        "Departementaal Vertrouwelijk (Dep.V)"@nl ;
    rdfs:comment "Classified information per VIRBI 2025 – level 1. Limited distribution within the department."@en,
        "Gerubriceerde informatie conform VIRBI 2025 – niveau 1. Beperkte verspreiding binnen het departement."@nl .

isms:CL_Openbaar a isms:InformationClassificationLevel ;
    rdfs:label "Public"@en,
        "Openbaar"@nl ;
    rdfs:comment "Information that may be published without restriction. VIR 2007."@en,
        "Informatie die zonder beperking gepubliceerd mag worden. VIR 2007."@nl .

isms:CL_ZeerGeheim a isms:InformationClassificationLevel ;
    rdfs:label "Top Secret"@en,
        "Zeer Geheim (STG-ZG)"@nl ;
    rdfs:comment "Classified information per VIRBI 2025 – level 4 (highest). Exceptionally severe damage."@en,
        "Gerubriceerde informatie conform VIRBI 2025 – niveau 4 (hoogste). Uitzonderlijk ernstige schade."@nl .

isms:CapLevel_Cbw_01_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_01 — Level 1"@en,
        "Cap_Cbw_01 — Niveau 1"@nl ;
    rdfs:comment "Er is geen schriftelijk beleid beschikbaar voor netwerk- en informatiesystemen; verantwoordelijkheden, rollen en bevoegdheden zijn niet formeel vastgelegd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_01 .

isms:CapLevel_Cbw_01_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_01 — Level 2"@en,
        "Cap_Cbw_01 — Niveau 2"@nl ;
    rdfs:comment "Beleid is deels aanwezig, maar niet schriftelijk vastgelegd of organisatiebreed gecommuniceerd; verantwoordelijkheden zijn informeel belegd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_01 .

isms:CapLevel_Cbw_01_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_01 — Level 3"@en,
        "Cap_Cbw_01 — Niveau 3"@nl ;
    rdfs:comment "Er is een aantoonbaar schriftelijk vastgesteld beleid waarin verantwoordelijkheden, rollen en bevoegdheden expliciet zijn benoemd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_01 .

isms:CapLevel_Cbw_01_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_01 — Level 4"@en,
        "Cap_Cbw_01 — Niveau 4"@nl ;
    rdfs:comment "Het beleid is formeel goedgekeurd, gedeeld met relevante stakeholders, en wordt periodiek beoordeeld op actualiteit en volledigheid van verantwoordelijkheden en bevoegdheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_01 .

isms:CapLevel_Cbw_01_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_01 — Level 5"@en,
        "Cap_Cbw_01 — Niveau 5"@nl ;
    rdfs:comment "Het beleid is volledig geïntegreerd in governanceprocessen; rollen, verantwoordelijkheden en bevoegdheden worden structureel geëvalueerd en geoptimaliseerd op basis van organisatorische en technologische ontwikkelingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_01 .

isms:CapLevel_Cbw_02_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_02 — Level 1"@en,
        "Cap_Cbw_02 — Niveau 1"@nl ;
    rdfs:comment "Er is geen formeel risicobeheerproces; risico’s worden niet systematisch vastgesteld, beoordeeld of gemitigeerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_02 .

isms:CapLevel_Cbw_02_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_02 — Level 2"@en,
        "Cap_Cbw_02 — Niveau 2"@nl ;
    rdfs:comment "Risico’s worden incidenteel vastgesteld of gemitigeerd, maar zonder vastgelegde structuur of systematiek."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_02 .

isms:CapLevel_Cbw_02_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_02 — Level 3"@en,
        "Cap_Cbw_02 — Niveau 3"@nl ;
    rdfs:comment "Er is een schriftelijk vastgesteld proces waarin aantoonbaar wordt beschreven hoe risico’s op netwerk- en informatiesystemen worden vastgesteld, beoordeeld en gemitigeerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_02 .

isms:CapLevel_Cbw_02_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_02 — Level 4"@en,
        "Cap_Cbw_02 — Niveau 4"@nl ;
    rdfs:comment "Het proces is operationeel, de resultaten worden gedocumenteerd, en risicobeoordelingen worden periodiek uitgevoerd en geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_02 .

isms:CapLevel_Cbw_02_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_02 — Level 5"@en,
        "Cap_Cbw_02 — Niveau 5"@nl ;
    rdfs:comment "Het proces is volledig geïntegreerd in de strategische besluitvorming en wordt continu verbeterd op basis van incidenten, audits en dreigingsanalyses."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_02 .

isms:CapLevel_Cbw_03_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_03 — Level 1"@en,
        "Cap_Cbw_03 — Niveau 1"@nl ;
    rdfs:comment "Er is geen formeel incident managementproces; meldingen van ICT-incidenten verlopen ongeorganiseerd of worden niet geregistreerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_03 .

isms:CapLevel_Cbw_03_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_03 — Level 2"@en,
        "Cap_Cbw_03 — Niveau 2"@nl ;
    rdfs:comment "Incidenten worden geregistreerd of gemeld, maar zonder formele procedures voor opvolging of evaluatie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_03 .

isms:CapLevel_Cbw_03_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_03 — Level 3"@en,
        "Cap_Cbw_03 — Niveau 3"@nl ;
    rdfs:comment "Er is een formeel aantoonbaar incident managementproces waarin het melden, registreren, opvolgen en evalueren van ICT-incidenten is beschreven."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_03 .

isms:CapLevel_Cbw_03_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_03 — Level 4"@en,
        "Cap_Cbw_03 — Niveau 4"@nl ;
    rdfs:comment "Het incidentproces is in werking, incidentgegevens worden geanalyseerd en lessen worden gedocumenteerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_03 .

isms:CapLevel_Cbw_03_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_03 — Level 5"@en,
        "Cap_Cbw_03 — Niveau 5"@nl ;
    rdfs:comment "Het incidentproces wordt continu verbeterd op basis van trendanalyse, periodieke oefeningen en integratie met bredere risicobeheersing."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_03 .

isms:CapLevel_Cbw_04_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_04 — Level 1"@en,
        "Cap_Cbw_04 — Niveau 1"@nl ;
    rdfs:comment "Er is geen structureel logmanagement aanwezig; logbestanden worden niet centraal opgeslagen, geanalyseerd of opgevolgd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_04 .

isms:CapLevel_Cbw_04_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_04 — Level 2"@en,
        "Cap_Cbw_04 — Niveau 2"@nl ;
    rdfs:comment "Enkele loggegevens worden verzameld, maar analyse en opvolging vinden slechts incidenteel en handmatig plaats."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_04 .

isms:CapLevel_Cbw_04_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_04 — Level 3"@en,
        "Cap_Cbw_04 — Niveau 3"@nl ;
    rdfs:comment "Logmanagement is aantoonbaar ingericht en gericht op het detecteren, analyseren en opvolgen van relevante gebeurtenissen. Procedures en verantwoordelijkheden zijn vastgelegd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_04 .

isms:CapLevel_Cbw_04_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_04 — Level 4"@en,
        "Cap_Cbw_04 — Niveau 4"@nl ;
    rdfs:comment "Logmanagement is effectief: logging vindt plaats op kritieke systemen, gebeurtenissen worden geanalyseerd, afwijkingen worden opgevolgd en de werking wordt periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_04 .

isms:CapLevel_Cbw_04_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_04 — Level 5"@en,
        "Cap_Cbw_04 — Niveau 5"@nl ;
    rdfs:comment "Logmanagement is geautomatiseerd, risicogebaseerd ingericht, en continue analyse leidt tot proactieve opsporing en structurele verbetering van beveiligingsmaatregelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_04 .

isms:CapLevel_Cbw_05_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_05 — Level 1"@en,
        "Cap_Cbw_05 — Niveau 1"@nl ;
    rdfs:comment "Er zijn geen maatregelen getroffen voor bedrijfscontinuïteit. Er is geen herstelplan, geen herstelprocedures en geen bijbehorend beleid beschikbaar."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_05 .

isms:CapLevel_Cbw_05_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_05 — Level 2"@en,
        "Cap_Cbw_05 — Niveau 2"@nl ;
    rdfs:comment "Er bestaan enkele ongedocumenteerde maatregelen voor bedrijfscontinuïteit. Een herstelplan of herstelprocedures zijn deels aanwezig, maar niet vastgelegd in beleid of getest."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_05 .

isms:CapLevel_Cbw_05_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_05 — Level 3"@en,
        "Cap_Cbw_05 — Niveau 3"@nl ;
    rdfs:comment "Er is beleid vastgesteld waarin maatregelen voor bedrijfscontinuïteit en een herstelplan met herstelprocedures zijn opgenomen. Deze documenten zijn beschikbaar en bekend binnen de organisatie. Het herstelplan en de herstelprocedures zijn aantoonbaar getest."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_05 .

isms:CapLevel_Cbw_05_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_05 — Level 4"@en,
        "Cap_Cbw_05 — Niveau 4"@nl ;
    rdfs:comment "Het beleid voor bedrijfscontinuïteit en herstel is afgestemd op de organisatiecontext en wordt periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_05 .

isms:CapLevel_Cbw_05_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_05 — Level 5"@en,
        "Cap_Cbw_05 — Niveau 5"@nl ;
    rdfs:comment "Het beleid, het herstelplan en de herstelprocedures voor bedrijfscontinuïteit zijn volledig geïntegreerd in de bedrijfsvoering. Ze worden cyclisch getest, geëvalueerd en verbeterd op basis van risicoanalyses en lessons learned."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_05 .

isms:CapLevel_Cbw_06_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_06 — Level 1"@en,
        "Cap_Cbw_06 — Niveau 1"@nl ;
    rdfs:comment "Er zijn geen formele maatregelen of beleid voor crisisbeheer. Er zijn geen afspraken over communicatie of coördinatie bij ernstige verstoringen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_06 .

isms:CapLevel_Cbw_06_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_06 — Level 2"@en,
        "Cap_Cbw_06 — Niveau 2"@nl ;
    rdfs:comment "Er zijn informele afspraken voor crisisbeheer, maar deze zijn niet vastgelegd in beleid. Communicatie en coördinatie gebeuren reactief en op basis van individuele kennis of ervaring."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_06 .

isms:CapLevel_Cbw_06_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_06 — Level 3"@en,
        "Cap_Cbw_06 — Niveau 3"@nl ;
    rdfs:comment "Er is vastgesteld beleid voor crisisbeheer waarin aantoonbaar procedures, rollen en verantwoordelijkheden zijn opgenomen, inclusief afspraken over communicatie en coördinatie bij verstoringen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_06 .

isms:CapLevel_Cbw_06_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_06 — Level 4"@en,
        "Cap_Cbw_06 — Niveau 4"@nl ;
    rdfs:comment "Het beleid voor crisisbeheer is in werking en wordt periodiek geoefend of getest. Communicatie en coördinatie verlopen via vastgestelde protocollen, en evaluaties worden uitgevoerd na crisissituaties."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_06 .

isms:CapLevel_Cbw_06_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_06 — Level 5"@en,
        "Cap_Cbw_06 — Niveau 5"@nl ;
    rdfs:comment "Crisisbeheer is geïntegreerd in de governance- en risicostructuur van de organisatie. Beleidsdocumenten, communicatieprotocollen en coördinatiemechanismen worden continu verbeterd op basis van oefeningen, evaluaties en externe dreigingsontwikkelingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_06 .

isms:CapLevel_Cbw_07_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_07 — Level 1"@en,
        "Cap_Cbw_07 — Niveau 1"@nl ;
    rdfs:comment "Er is geen vastgesteld beleid met betrekking tot de beveiliging van de toeleveringsketen. Afhankelijkheden van leveranciers worden ad hoc benaderd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_07 .

isms:CapLevel_Cbw_07_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_07 — Level 2"@en,
        "Cap_Cbw_07 — Niveau 2"@nl ;
    rdfs:comment "Er is een conceptbeleid opgesteld over toeleveringsketenbeveiliging, maar dit is nog niet vastgesteld of organisatiebreed toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_07 .

isms:CapLevel_Cbw_07_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_07 — Level 3"@en,
        "Cap_Cbw_07 — Niveau 3"@nl ;
    rdfs:comment "Er is vastgesteld beleid over de toeleveringsketen en afhankelijkheden worden geïnventariseerd. Toepassing vindt aantoonbaar plaats, maar zonder structurele borging of aantoonbaarheid"@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_07 .

isms:CapLevel_Cbw_07_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_07 — Level 4"@en,
        "Cap_Cbw_07 — Niveau 4"@nl ;
    rdfs:comment "Het beleid is vastgesteld, breed gecommuniceerd en wordt toegepast binnen relevante processen. Afhankelijkheden worden periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_07 .

isms:CapLevel_Cbw_07_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_07 — Level 5"@en,
        "Cap_Cbw_07 — Niveau 5"@nl ;
    rdfs:comment "Het beleid is volledig geïntegreerd in governance en risicomanagement. Evaluatie en bijstelling vinden cyclisch plaats op basis van risico’s en leveranciersontwikkeling. Er is continue monitoring van naleving."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_07 .

isms:CapLevel_Cbw_08_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_08 — Level 1"@en,
        "Cap_Cbw_08 — Niveau 1"@nl ;
    rdfs:comment "Er worden geen of slechts incidenteel afspraken gemaakt over cyberbeveiliging met leveranciers."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_08 .

isms:CapLevel_Cbw_08_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_08 — Level 2"@en,
        "Cap_Cbw_08 — Niveau 2"@nl ;
    rdfs:comment "Er zijn enkele schriftelijke afspraken gemaakt met leveranciers, maar deze zijn niet gebaseerd op uniform beleid. Naleving wordt niet actief bewaakt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_08 .

isms:CapLevel_Cbw_08_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_08 — Level 3"@en,
        "Cap_Cbw_08 — Niveau 3"@nl ;
    rdfs:comment "Schriftelijke afspraken over beveiliging worden systematisch gemaakt voor nieuwe contracten, gebaseerd op het beleid. Naleving wordt aantoonbaar reactief gemonitord."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_08 .

isms:CapLevel_Cbw_08_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_08 — Level 4"@en,
        "Cap_Cbw_08 — Niveau 4"@nl ;
    rdfs:comment "Er is een standaard raamwerk voor beveiligingseisen in contracten. Naleving wordt actief en regelmatig gecontroleerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_08 .

isms:CapLevel_Cbw_08_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_08 — Level 5"@en,
        "Cap_Cbw_08 — Niveau 5"@nl ;
    rdfs:comment "Cyberbeveiligingseisen zijn onderdeel van alle leveranciersrelaties. Er vindt gestructureerde toetsing en auditing plaats. Er is een escalatiemechanisme bij niet-naleving."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_08 .

isms:CapLevel_Cbw_09_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_09 — Level 1"@en,
        "Cap_Cbw_09 — Niveau 1"@nl ;
    rdfs:comment "Er is geen centraal of actueel overzicht van leveranciers en bijbehorende afspraken."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_09 .

isms:CapLevel_Cbw_09_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_09 — Level 2"@en,
        "Cap_Cbw_09 — Niveau 2"@nl ;
    rdfs:comment "Een overzicht wordt handmatig en beperkt bijgehouden, maar is incompleet of verouderd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_09 .

isms:CapLevel_Cbw_09_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_09 — Level 3"@en,
        "Cap_Cbw_09 — Niveau 3"@nl ;
    rdfs:comment "Er is een actueel overzicht van leveranciers, producten/diensten en afspraken. Dit wordt periodiek handmatig bijgewerkt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_09 .

isms:CapLevel_Cbw_09_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_09 — Level 4"@en,
        "Cap_Cbw_09 — Niveau 4"@nl ;
    rdfs:comment "Het leveranciersoverzicht is volledig, digitaal toegankelijk en geïntegreerd in de beheersprocessen. Wijzigingen worden systematisch verwerkt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_09 .

isms:CapLevel_Cbw_09_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_09 — Level 5"@en,
        "Cap_Cbw_09 — Niveau 5"@nl ;
    rdfs:comment "Het overzicht is realtime, gekoppeld aan contractbeheer en risicobeoordeling. Er is inzicht in ketenafhankelijkheden, risico's en beveiligingsafspraken per leverancier."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_09 .

isms:CapLevel_Cbw_10_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_10 — Level 1"@en,
        "Cap_Cbw_10 — Niveau 1"@nl ;
    rdfs:comment "Er zijn geen maatregelen of beleid voor veilige ontwikkeling en onderhoud van informatiesystemen. Kwetsbaarheden worden niet systematisch beheerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_10 .

isms:CapLevel_Cbw_10_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_10 — Level 2"@en,
        "Cap_Cbw_10 — Niveau 2"@nl ;
    rdfs:comment "Er zijn enkele ontwikkel- en onderhoudsactiviteiten, maar zonder formeel beleid of vastgelegde procedures. Beveiligingsmaatregelen worden incidenteel toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_10 .

isms:CapLevel_Cbw_10_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_10 — Level 3"@en,
        "Cap_Cbw_10 — Niveau 3"@nl ;
    rdfs:comment "Er is vastgesteld beleid waarin maatregelen zijn opgenomen voor veilige ontwikkeling en onderhoud van informatiesystemen, inclusief rollen, verantwoordelijkheden en basismaatregelen voor het omgaan met kwetsbaarheden. De maatregelen uit het beleid worden aantoonbaar toegepast tijdens ontwikkeling en onderhoud."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_10 .

isms:CapLevel_Cbw_10_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_10 — Level 4"@en,
        "Cap_Cbw_10 — Niveau 4"@nl ;
    rdfs:comment "Er is structurele aandacht voor kwetsbaarheden, en updates en patches worden volgens vaste processen uitgevoerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_10 .

isms:CapLevel_Cbw_10_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_10 — Level 5"@en,
        "Cap_Cbw_10 — Niveau 5"@nl ;
    rdfs:comment "Beveiliging is geïntegreerd in de gehele levenscyclus van informatiesystemen. Beleid wordt periodiek aangepast op basis van nieuwe kwetsbaarheden, dreigingen en technologische ontwikkelingen. Verbeteringen worden systematisch doorgevoerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_10 .

isms:CapLevel_Cbw_11_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_11 — Level 1"@en,
        "Cap_Cbw_11 — Niveau 1"@nl ;
    rdfs:comment "Er is geen structurele aandacht voor bewustwording of cyberhygiëne. Medewerkers worden niet geïnformeerd over risico’s of goed gedrag."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_11 .

isms:CapLevel_Cbw_11_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_11 — Level 2"@en,
        "Cap_Cbw_11 — Niveau 2"@nl ;
    rdfs:comment "Er zijn incidentele communicatie- of bewustwordingsacties, zoals een nieuwsbrief of eenmalige campagne. Er is geen structuur of borging."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_11 .

isms:CapLevel_Cbw_11_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_11 — Level 3"@en,
        "Cap_Cbw_11 — Niveau 3"@nl ;
    rdfs:comment "Er is een basisbewustwordingsprogramma actief. Medewerkers ontvangen informatie en er is aantoonbaar aandacht voor goede cyberhygiëne. Deelname wordt beperkt gemonitord."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_11 .

isms:CapLevel_Cbw_11_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_11 — Level 4"@en,
        "Cap_Cbw_11 — Niveau 4"@nl ;
    rdfs:comment "Cyberbewustwording is geïntegreerd in het onboardingproces, periodieke trainingen en communicatie. Deelname en gedragsverandering worden actief gemeten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_11 .

isms:CapLevel_Cbw_11_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_11 — Level 5"@en,
        "Cap_Cbw_11 — Niveau 5"@nl ;
    rdfs:comment "Er is een doorlopend en aangepast bewustwordingsprogramma, gebaseerd op gedragsonderzoek en risicoanalyses. Medewerkers worden actief betrokken en getraind op rol-specifieke risico’s. Cyberhygiëne is onderdeel van de organisatiecultuur."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_11 .

isms:CapLevel_Cbw_12_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_12 — Level 1"@en,
        "Cap_Cbw_12 — Niveau 1"@nl ;
    rdfs:comment "Rollen met cybersecurityverantwoordelijkheden zijn niet expliciet toegewezen. Er worden geen gerichte opleidingen gegeven."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_12 .

isms:CapLevel_Cbw_12_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_12 — Level 2"@en,
        "Cap_Cbw_12 — Niveau 2"@nl ;
    rdfs:comment "Enkele rollen zijn benoemd, maar niet organisatiebreed. Opleidingen zijn incidenteel en niet afgestemd op taken of verantwoordelijkheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_12 .

isms:CapLevel_Cbw_12_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_12 — Level 3"@en,
        "Cap_Cbw_12 — Niveau 3"@nl ;
    rdfs:comment "Relevante rollen en verantwoordelijkheden zijn benoemd. Medewerkers met die rollen volgen periodiek basisopleidingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_12 .

isms:CapLevel_Cbw_12_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_12 — Level 4"@en,
        "Cap_Cbw_12 — Niveau 4"@nl ;
    rdfs:comment "Rollen zijn formeel vastgelegd. Er is een opleidingsplan met inhoud afgestemd op specifieke taken en risicoprofielen. Voortgang wordt gevolgd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_12 .

isms:CapLevel_Cbw_12_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_12 — Level 5"@en,
        "Cap_Cbw_12 — Niveau 5"@nl ;
    rdfs:comment "Rollen en vaardigheden zijn gekoppeld aan competentieprofielen en functiebeschrijvingen. Er is een gestructureerd leerprogramma met certificering, regelmatige bijscholing en evaluatie van effectiviteit. Ontwikkeling wordt continu bijgehouden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_12 .

isms:CapLevel_Cbw_13_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_13 — Level 1"@en,
        "Cap_Cbw_13 — Niveau 1"@nl ;
    rdfs:comment "Er is geen beleid voor het gebruik van cryptografie. Toepassing ervan gebeurt willekeurig of ontbreekt volledig, zonder aandacht voor doel, algoritmes of sleutelbeheer."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_13 .

isms:CapLevel_Cbw_13_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_13 — Level 2"@en,
        "Cap_Cbw_13 — Niveau 2"@nl ;
    rdfs:comment "Cryptografie wordt op onderdelen toegepast, maar zonder vastgesteld beleid. Keuze van algoritmes en omgang met sleutels is niet uniform of onderbouwd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_13 .

isms:CapLevel_Cbw_13_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_13 — Level 3"@en,
        "Cap_Cbw_13 — Niveau 3"@nl ;
    rdfs:comment "De entiteit heeft beleid vastgesteld voor het gebruik van cryptografie, waarin het doel (zoals vertrouwelijkheid, integriteit en authenticatie) en basisprincipes van sleutelbeheer zijn opgenomen. Toepassing en sleutelbeheer zijn aantoonbaar afgestemd op risico’s"@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_13 .

isms:CapLevel_Cbw_13_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_13 — Level 4"@en,
        "Cap_Cbw_13 — Niveau 4"@nl ;
    rdfs:comment "Het beleid voor cryptografie is geïmplementeerd binnen relevante processen. Toepassing en sleutelbeheer zijn aantoonbaar afgestemd op risico’s en worden periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_13 .

isms:CapLevel_Cbw_13_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_13 — Level 5"@en,
        "Cap_Cbw_13 — Niveau 5"@nl ;
    rdfs:comment "Het cryptografiebeleid wordt continu geoptimaliseerd op basis van technologische ontwikkelingen, cryptografische standaarden en dreigingen. Cryptografisch gebruik en sleutelbeheer zijn volledig afgestemd op beveiligingsdoelstellingen en zijn aantoonbaar effectief."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_13 .

isms:CapLevel_Cbw_14_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_14 — Level 1"@en,
        "Cap_Cbw_14 — Niveau 1"@nl ;
    rdfs:comment "Er is geen formele aanwijzing van personeel of andere werkzame personen met betrekking tot de beveiliging van de netwerk- en informatiesystemen. Er zijn geen betrouwbaarheidseisen vastgesteld."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_14 .

isms:CapLevel_Cbw_14_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_14 — Level 2"@en,
        "Cap_Cbw_14 — Niveau 2"@nl ;
    rdfs:comment "Enkele personen worden ad hoc betrokken bij activiteiten met betrekking tot de beveiliging van netwerk- en informatiesystemen, maar zonder formele vastlegging van rollen, verantwoordelijkheden of bevoegdheden. Betrouwbaarheidseisen worden niet of incidenteel toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_14 .

isms:CapLevel_Cbw_14_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_14 — Level 3"@en,
        "Cap_Cbw_14 — Niveau 3"@nl ;
    rdfs:comment "De entiteit heeft beleid waarin zij personeel en andere werkzame personen formeel aanwijst met specifieke rollen, verantwoordelijkheden en bevoegdheden met betrekking tot de beveiliging van haar netwerk- en informatiesystemen. Passende betrouwbaarheidseisen zijn vastgesteld voor relevante functies."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_14 .

isms:CapLevel_Cbw_14_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_14 — Level 4"@en,
        "Cap_Cbw_14 — Niveau 4"@nl ;
    rdfs:comment "De aanwijzing van personeel en andere werkzame personen met betrekking tot de beveiliging van netwerk- en informatiesystemen wordt periodiek geëvalueerd en geactualiseerd. De toepassing van betrouwbaarheidseisen is aantoonbaar ingebed in HR-processen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_14 .

isms:CapLevel_Cbw_14_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_14 — Level 5"@en,
        "Cap_Cbw_14 — Niveau 5"@nl ;
    rdfs:comment "De entiteit stemt de aanwijzing van personeel en werkzame personen, inclusief hun verantwoordelijkheden en bevoegdheden, systematisch af op actuele risico’s. Betrouwbaarheidseisen worden risicogebaseerd beheerd en continu verbeterd, met periodieke effectiviteitsmetingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_14 .

isms:CapLevel_Cbw_15_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_15 — Level 1"@en,
        "Cap_Cbw_15 — Niveau 1"@nl ;
    rdfs:comment "Er is geen schriftelijk toegangsbeveiligingsbeleid voor logische of fysieke toegang. Identiteiten, authenticaties, autorisaties en logbestanden worden niet of slechts incidenteel beheerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_15 .

isms:CapLevel_Cbw_15_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_15 — Level 2"@en,
        "Cap_Cbw_15 — Niveau 2"@nl ;
    rdfs:comment "Toegang wordt deels beheerd op basis van informele afspraken. Uitgifte en intrekking van rechten vinden plaats, maar zonder eenduidig beleid. Logbestanden worden beperkt of niet structureel beheerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_15 .

isms:CapLevel_Cbw_15_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_15 — Level 3"@en,
        "Cap_Cbw_15 — Niveau 3"@nl ;
    rdfs:comment "De entiteit beschikt over schriftelijk vastgesteld beleid voor logische en fysieke toegangsbeveiliging. Het beleid beschrijft het uitgeven, monitoren, gebruiken en intrekken van identiteiten, authenticaties en autorisaties, evenals het beheer van logbestanden en dit beleid wordt aantoonbaar toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_15 .

isms:CapLevel_Cbw_15_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_15 — Level 4"@en,
        "Cap_Cbw_15 — Niveau 4"@nl ;
    rdfs:comment "Het toegangsbeveiligingsbeleid wordt aantoonbaar toegepast. Toegang wordt structureel beheerd en gelogd. Periodieke beoordeling van identiteiten, authenticaties en autorisaties op noodzakelijkheid, juistheid en actualiteit is ingebed in de processen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_15 .

isms:CapLevel_Cbw_15_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_15 — Level 5"@en,
        "Cap_Cbw_15 — Niveau 5"@nl ;
    rdfs:comment "Toegangsbeheer is volledig geïntegreerd in de beveiligingsstrategie. Het beleid wordt continu verbeterd op basis van risicoanalyses, incidenten en technologische ontwikkelingen. Periodieke evaluaties leiden aantoonbaar tot optimalisaties van toegangsrechten en logbeheer."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_15 .

isms:CapLevel_Cbw_16_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_16 — Level 1"@en,
        "Cap_Cbw_16 — Niveau 1"@nl ;
    rdfs:comment "Er is geen vastgesteld beleid voor configuratiebeheer. Netwerk- en informatiesystemen worden ongecoördineerd ingericht en aangepast. Er is geen systeem voor classificatie van systemen op basis van vertrouwelijkheid, integriteit en beschikbaarheid (CIA). Regels voor gebruik zijn niet gedefinieerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_16 .

isms:CapLevel_Cbw_16_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_16 — Level 2"@en,
        "Cap_Cbw_16 — Niveau 2"@nl ;
    rdfs:comment "Er zijn beperkte richtlijnen voor configuratiebeheer, maar deze zijn niet formeel vastgesteld of consistent toegepast. Classificatie van systemen gebeurt incidenteel, zonder uniform kader. Regels voor gebruik bestaan deels, maar zijn niet breed bekend of toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_16 .

isms:CapLevel_Cbw_16_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_16 — Level 3"@en,
        "Cap_Cbw_16 — Niveau 3"@nl ;
    rdfs:comment "Er is formeel beleid voor configuratiebeheer. Netwerk- en informatiesystemen worden systematisch geregistreerd en beheerd, inclusief een basale classificatie op CIA-criteria. Regels voor aanvaardbaar gebruik zijn vastgelegd en worden gecommuniceerd aan medewerkers. Toepassing wordt aantoonbaar gemonitord."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_16 .

isms:CapLevel_Cbw_16_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_16 — Level 4"@en,
        "Cap_Cbw_16 — Niveau 4"@nl ;
    rdfs:comment "Configuratiebeheer is integraal onderdeel van IT-beheerprocessen. Alle relevante systemen zijn geclassificeerd volgens een vastgesteld model (CIA), en deze classificatie beïnvloedt de inrichting en beveiligingsmaatregelen. Regels voor gebruik zijn breed bekend, ingebed in processen en er vindt handhaving plaats. Naleving is aantoonbaar via logging, controles en audits."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_16 .

isms:CapLevel_Cbw_16_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_16 — Level 5"@en,
        "Cap_Cbw_16 — Niveau 5"@nl ;
    rdfs:comment "Configuratiebeheer is geautomatiseerd en geïntegreerd met risicomanagement, incidentrespons en compliance. Classificatie van systemen vindt dynamisch plaats, wordt periodiek herzien en is gekoppeld aan autorisatie-, back-up- en monitoringstrategieën. Regels voor gebruik en omgang zijn verankerd in cultuur en tooling (bijv. automatische waarschuwingen of blokkades bij ongewenst gedrag). Beleid wordt continu verbeterd op basis van evaluaties, dreigingen en technologische ontwikkelingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_16 .

isms:CapLevel_Cbw_17_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_17 — Level 1"@en,
        "Cap_Cbw_17 — Niveau 1"@nl ;
    rdfs:comment "Er is geen inventaris van informatie of netwerk- en informatiesystemen beschikbaar. Inzicht in aanwezige assets ontbreekt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_17 .

isms:CapLevel_Cbw_17_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_17 — Level 2"@en,
        "Cap_Cbw_17 — Niveau 2"@nl ;
    rdfs:comment "Een gedeeltelijke inventaris is aanwezig, gebaseerd op losse overzichten of spreadsheets. De volledigheid en actualiteit zijn beperkt, en er is geen formeel proces voor onderhoud."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_17 .

isms:CapLevel_Cbw_17_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_17 — Level 3"@en,
        "Cap_Cbw_17 — Niveau 3"@nl ;
    rdfs:comment "Er is een formeel proces en format vastgesteld voor het bijhouden van een inventaris van informatie en netwerk- en informatiesystemen. De inventaris is grotendeels volledig en wordt periodiek geactualiseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_17 .

isms:CapLevel_Cbw_17_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_17 — Level 4"@en,
        "Cap_Cbw_17 — Niveau 4"@nl ;
    rdfs:comment "De inventaris is volledig en actueel en wordt aantoonbaar bijgehouden volgens een vastgesteld proces. Nieuwe of gewijzigde assets worden structureel toegevoegd of aangepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_17 .

isms:CapLevel_Cbw_17_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_17 — Level 5"@en,
        "Cap_Cbw_17 — Niveau 5"@nl ;
    rdfs:comment "De inventaris is geïntegreerd in geautomatiseerde beheerprocessen en tooling. Volledigheid en actualiteit worden real-time of near real-time bewaakt. De inventaris ondersteunt risicobeheer en beveiligingsmaatregelen effectief."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_17 .

isms:CapLevel_Cbw_18_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_18 — Level 1"@en,
        "Cap_Cbw_18 — Niveau 1"@nl ;
    rdfs:comment "De entiteit ontvangt zelden of niet actief dreigingsinformatie. Er is geen vastgesteld proces voor beoordeling of opvolging van beveiligingsadviezen. Vastlegging van eventuele acties ontbreekt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_18 .

isms:CapLevel_Cbw_18_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_18 — Level 2"@en,
        "Cap_Cbw_18 — Niveau 2"@nl ;
    rdfs:comment "Informatie van CSIRT’s, leveranciers of andere bronnen wordt incidenteel verwerkt. Beoordelingen vinden ongestructureerd plaats. Soms wordt actie ondernomen, maar dit is niet vastgelegd of aantoonbaar."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_18 .

isms:CapLevel_Cbw_18_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_18 — Level 3"@en,
        "Cap_Cbw_18 — Niveau 3"@nl ;
    rdfs:comment "De entiteit ontvangt regelmatig relevante dreigingsinformatie via ingestelde kanalen. Er is een intern proces voor beoordeling en eventuele aanpassing van maatregelen. Vastlegging gebeurt aantoonbaar."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_18 .

isms:CapLevel_Cbw_18_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_18 — Level 4"@en,
        "Cap_Cbw_18 — Niveau 4"@nl ;
    rdfs:comment "Dreigingsinformatie wordt systematisch verzameld via erkende bronnen (bijv. NCSC, CSIRT, leveranciers). Beoordeling vindt plaats op basis van vastgestelde criteria. Besluiten over aanvullende maatregelen worden schriftelijk vastgelegd en gecommuniceerd naar betrokken teams."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_18 .

isms:CapLevel_Cbw_18_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_18 — Level 5"@en,
        "Cap_Cbw_18 — Niveau 5"@nl ;
    rdfs:comment "De verwerking van dreigingsinformatie is geïntegreerd in risicobeheer- en wijzigingsprocessen. De entiteit monitort actief relevante bronnen, voert risico-impactanalyses uit, en past maatregelen structureel aan. De evaluatie en opvolging worden intern geaudit. Lessen uit eerdere dreigingen worden meegenomen in beleid en bewustwording."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_18 .

isms:CapLevel_Cbw_19_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_19 — Level 1"@en,
        "Cap_Cbw_19 — Niveau 1"@nl ;
    rdfs:comment "Bestuurders ontvangen geen training of bewustwording over cybersecurityrisico’s. Er is geen kennis aanwezig over risico’s of risicobeheersing."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_19 .

isms:CapLevel_Cbw_19_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_19 — Level 2"@en,
        "Cap_Cbw_19 — Niveau 2"@nl ;
    rdfs:comment "Bestuurders zijn geïnformeerd over basisprincipes van cyberrisico’s, vaak via een eenmalige sessie. Risico’s en maatregelen worden niet systematisch begrepen of beoordeeld."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_19 .

isms:CapLevel_Cbw_19_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_19 — Level 3"@en,
        "Cap_Cbw_19 — Niveau 3"@nl ;
    rdfs:comment "Bestuurders hebben aantoonbaar een training gevolgd die de risico’s en risicobeheersing op hoofdlijnen behandelt. Ze kunnen risico’s benoemen en inschatten op abstract niveau. Training is niet afgestemd op wettelijke eisen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_19 .

isms:CapLevel_Cbw_19_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_19 — Level 4"@en,
        "Cap_Cbw_19 — Niveau 4"@nl ;
    rdfs:comment "Bestuurders hebben aantoonbaar een training gevolgd die voldoet aan de eisen uit de wet. Ze kunnen risico’s herkennen, doorvertalen naar de eigen organisatie en beoordelen welke maatregelen passend zijn."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_19 .

isms:CapLevel_Cbw_19_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_19 — Level 5"@en,
        "Cap_Cbw_19 — Niveau 5"@nl ;
    rdfs:comment "Bestuurders zijn aantoonbaar strategisch vaardig in het inschatten van risico’s en beoordelen van gevolgen. Training is cyclisch, gecertificeerd en gekoppeld aan governanceprocessen. Cyberrisico’s worden structureel besproken in bestuursbesluiten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_19 .

isms:CapLevel_Cbw_20_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_20 — Level 1"@en,
        "Cap_Cbw_20 — Niveau 1"@nl ;
    rdfs:comment "Er zijn geen afspraken over training voor bestuursleden. Deelname is vrijblijvend. Kennis wordt niet onderhouden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_20 .

isms:CapLevel_Cbw_20_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_20 — Level 2"@en,
        "Cap_Cbw_20 — Niveau 2"@nl ;
    rdfs:comment "Er is het voornemen om training te volgen, maar er is geen planning of borging dat alle leden binnen 2 jaar voldoen. Actualisatie vindt ad hoc plaats."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_20 .

isms:CapLevel_Cbw_20_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_20 — Level 3"@en,
        "Cap_Cbw_20 — Niveau 3"@nl ;
    rdfs:comment "Alle bestuursleden voldoen aantoonbaar binnen 2 jaar aan de wettelijke trainingseisen. Actualiseren van kennis is nog niet structureel ingericht."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_20 .

isms:CapLevel_Cbw_20_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_20 — Level 4"@en,
        "Cap_Cbw_20 — Niveau 4"@nl ;
    rdfs:comment "Alle bestuursleden voldoen aantoonbaar binnen 2 jaar aan de wettelijke trainingseisen. Actualisering vindt minimaal eens per 2 jaar plaats via een update- of herhalingstraining. Certificaten worden geregistreerd en geverifieerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_20 .

isms:CapLevel_Cbw_20_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_20 — Level 5"@en,
        "Cap_Cbw_20 — Niveau 5"@nl ;
    rdfs:comment "De organisatie borgt structureel dat bestuursleden altijd over actuele kennis beschikken. Training wordt cyclisch herhaald, inhoud wordt aangepast op nieuwe dreigingen en wetgeving. Interne of externe toetsing op kennisniveau is onderdeel van governance."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_20 .

isms:CapLevel_Cbw_21_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_21 — Level 1"@en,
        "Cap_Cbw_21 — Niveau 1"@nl ;
    rdfs:comment "Er is geen beleid of procedure voor het melden van significante incidenten. Meldingen aan CSIRT of autoriteit vinden niet of alleen op ad-hocbasis plaats. Criteria voor “significant” zijn onbekend of ongedefinieerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_21 .

isms:CapLevel_Cbw_21_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_21 — Level 2"@en,
        "Cap_Cbw_21 — Niveau 2"@nl ;
    rdfs:comment "De entiteit onderkent het belang van melding, maar handelt reactief. Enkele meldingen zijn gedaan, zonder vastgelegde criteria of processen. Vrijwillige melding wordt niet benut."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_21 .

isms:CapLevel_Cbw_21_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_21 — Level 3"@en,
        "Cap_Cbw_21 — Niveau 3"@nl ;
    rdfs:comment "De entiteit beschikt over een aantoonbare procedure voor het melden van significante incidenten aan CSIRT en bevoegde autoriteit. Criteria voor wat als significant geldt zijn vastgelegd. Vrijwillige meldingsoptie is bekend en kan worden toegepast."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_21 .

isms:CapLevel_Cbw_21_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_21 — Level 4"@en,
        "Cap_Cbw_21 — Niveau 4"@nl ;
    rdfs:comment "Significante incidenten worden tijdig, correct en aantoonbaar gemeld. Criteria en processen zijn ingebed in incidentmanagement. Er wordt actief overwogen om ook vrijwillig meldingen te doen van relevante (bijna-)incidenten of cyberdreigingen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_21 .

isms:CapLevel_Cbw_21_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_21 — Level 5"@en,
        "Cap_Cbw_21 — Niveau 5"@nl ;
    rdfs:comment "De meldingsprocedure wordt regelmatig geëvalueerd en verbeterd. De entiteit maakt strategisch gebruik van vrijwillige meldingen om het eigen en ketenbewustzijn te versterken. Samenwerking met CSIRT en autoriteit verloopt actief en constructief."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_21 .

isms:CapLevel_Cbw_22_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_22 — Level 1"@en,
        "Cap_Cbw_22 — Niveau 1"@nl ;
    rdfs:comment "Er is geen vastgesteld proces voor het tijdig melden van significante incidenten in drie fasen. Rapportages worden onvolledig of niet binnen de voorgeschreven termijnen aangeleverd. Inhoudelijke vereisten zijn onbekend."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_22 .

isms:CapLevel_Cbw_22_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_22 — Level 2"@en,
        "Cap_Cbw_22 — Niveau 2"@nl ;
    rdfs:comment "Er is enige kennis van de rapportageplicht en termijnen. De entiteit probeert meldingen te doen, maar volgt de drie fasen niet consistent of mist vereiste informatie. Er is geen formeel proces of sjabloon voor rapportage."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_22 .

isms:CapLevel_Cbw_22_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_22 — Level 3"@en,
        "Cap_Cbw_22 — Niveau 3"@nl ;
    rdfs:comment "De entiteit beschikt over een formeel proces voor meldingen in drie fasen met duidelijke termijnen en inhoudsvereisten. Eerste meldingen, updates en eindverslagen worden aantoonbaar tijdig en met de juiste informatie ingediend."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_22 .

isms:CapLevel_Cbw_22_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_22 — Level 4"@en,
        "Cap_Cbw_22 — Niveau 4"@nl ;
    rdfs:comment "De entiteit meldt alle significante incidenten aantoonbaar tijdig in de drie fasen. Rapportages bevatten consistent de voorgeschreven gegevens. Inhoud en tijdigheid worden structureel gemonitord en verantwoord."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_22 .

isms:CapLevel_Cbw_22_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_22 — Level 5"@en,
        "Cap_Cbw_22 — Niveau 5"@nl ;
    rdfs:comment "De meldprocedure is volledig ingebed in incidentresponsprocessen. Rapportages worden automatisch ondersteund (bijv. via workflows of tooling). De inhoud wordt vooraf getoetst op volledigheid. Lessons learned uit eerdere meldingen leiden tot continue verbetering van kwaliteit en snelheid van rapportages."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_22 .

isms:CapLevel_Cbw_23_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_23 — Level 1"@en,
        "Cap_Cbw_23 — Niveau 1"@nl ;
    rdfs:comment "De entiteit informeert de ontvangers van haar diensten niet of slechts ad hoc bij een significant incident. Er worden geen maatregelen gedeeld die deze ontvangers kunnen nemen in reactie op de dreiging."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_Cbw_23 .

isms:CapLevel_Cbw_23_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_23 — Level 2"@en,
        "Cap_Cbw_23 — Niveau 2"@nl ;
    rdfs:comment "De entiteit informeert incidenteel en zonder vaste werkwijze de ontvangers van haar diensten bij een significant incident. Informatie over maatregelen die deze ontvangers kunnen nemen in reactie op de dreiging is beperkt of ontbreekt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_Cbw_23 .

isms:CapLevel_Cbw_23_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_23 — Level 3"@en,
        "Cap_Cbw_23 — Niveau 3"@nl ;
    rdfs:comment "De entiteit beschikt over een vastgelegd proces om de ontvangers aantoonbaar van haar diensten onverwijld in kennis te stellen bij een significant incident dat een nadelige invloed kan hebben op de verlening van hun diensten. Daarbij worden ook maatregelen gedeeld die deze ontvangers kunnen nemen in reactie op de dreiging."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_Cbw_23 .

isms:CapLevel_Cbw_23_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_23 — Level 4"@en,
        "Cap_Cbw_23 — Niveau 4"@nl ;
    rdfs:comment "De entiteit informeert aantoonbaar en onverwijld alle relevante ontvangers van haar diensten bij een significant incident met mogelijke nadelige invloed op hun dienstverlening. Daarbij worden concrete en passende maatregelen gedeeld die deze ontvangers kunnen nemen in reactie op de dreiging. De toepassing en werking van het proces wordt periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_Cbw_23 .

isms:CapLevel_Cbw_23_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_Cbw_23 — Level 5"@en,
        "Cap_Cbw_23 — Niveau 5"@nl ;
    rdfs:comment "De entiteit hanteert een volledig geïntegreerd en aantoonbaar effectief proces om bij ieder significant incident de relevante ontvangers van haar diensten onverwijld te informeren. Daarbij worden afgestemde maatregelen gedeeld die deze ontvangers kunnen nemen in reactie op de dreiging. Het proces wordt structureel verbeterd op basis van terugkoppeling en ervaringen uit eerdere incidenten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_Cbw_23 .

isms:CapLevel_ISMS_01_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_01 — Level 1"@en,
        "Cap_ISMS_01 — Niveau 1"@nl ;
    rdfs:comment "De entiteit heeft geen inzicht in de eigen organisatie en is zich niet bewust van de context waarin zij haar processen en diensten  heeft ingericht. Er is geen besef van de toepasbaarheid van wet- en regelgeving binnen de organisatie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_01 .

isms:CapLevel_ISMS_01_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_01 — Level 2"@en,
        "Cap_ISMS_01 — Niveau 2"@nl ;
    rdfs:comment "De entiteit heeft een beperkt inzicht in de eigen organisatie en is zich in beperkte mate bewust van de context waarin zij haar processen en diensten heeft ingericht. Er is enige bewustwording van de toepasbaarheid van wet- en regelgeving, maar dit is nog niet consistent binnen de organisatie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_01 .

isms:CapLevel_ISMS_01_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_01 — Level 3"@en,
        "Cap_ISMS_01 — Niveau 3"@nl ;
    rdfs:comment "De entiteit heeft een duidelijk inzicht in de eigen organisatie en begrijpt de context waarin zij haar processen en diensten heeft ingericht. De toepasbaarheid van wet- en regelgeving is bekend en wordt consistent toegepast binnen de organisatie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_01 .

isms:CapLevel_ISMS_01_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_01 — Level 4"@en,
        "Cap_ISMS_01 — Niveau 4"@nl ;
    rdfs:comment "De entiteit heeft een diepgaand inzicht in de eigen organisatie en de context waarin zij haar processen en diensten heeft ingericht. De toepasbaarheid van wet- en regelgeving wordt actief gemonitord en beheerd, en er zijn meetbare indicatoren om de naleving te beoordelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_01 .

isms:CapLevel_ISMS_01_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_01 — Level 5"@en,
        "Cap_ISMS_01 — Niveau 5"@nl ;
    rdfs:comment "De entiteit heeft een geïntegreerd en proactief inzicht in de eigen organisatie en de context waarin zij haar processen en diensten heeft ingericht. De toepasbaarheid van wet- en regelgeving wordt continu geëvalueerd en verbeterd, met een focus op innovatie en aanpassing aan veranderende omstandigheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_ISMS_01 .

isms:CapLevel_ISMS_02_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_02 — Level 1"@en,
        "Cap_ISMS_02 — Niveau 1"@nl ;
    rdfs:comment "Het bestuur toont geen leiderschap of betrokkenheid met betrekking tot het Informatiebeveiligingsbeleid. Er is geen formele toewijzing van eigenaarschap, rollen, verantwoordelijkheden of aansprakelijkheid op dit gebied."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_02 .

isms:CapLevel_ISMS_02_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_02 — Level 2"@en,
        "Cap_ISMS_02 — Niveau 2"@nl ;
    rdfs:comment "Het bestuur toont enige betrokkenheid bij het Informatiebeveiligingsbeleid, maar deze betrokkenheid is informeel en inconsistent. Eigenaarschap, rollen, verantwoordelijkheden en aansprakelijkheid zijn benoemd, maar worden niet systematisch toegepast of geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_02 .

isms:CapLevel_ISMS_02_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_02 — Level 3"@en,
        "Cap_ISMS_02 — Niveau 3"@nl ;
    rdfs:comment "Het bestuur toont formeel leiderschap en betrokkenheid bij het Informatiebeveiligingsbeleid. Eigenaarschap, rollen, verantwoordelijkheden en aansprakelijkheid zijn duidelijk toegewezen en worden consistent toegepast. Er is een formele intentieverklaring  die de doelen en uitgangspunten van informatiebeveiliging ondersteunt."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_02 .

isms:CapLevel_ISMS_02_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_02 — Level 4"@en,
        "Cap_ISMS_02 — Niveau 4"@nl ;
    rdfs:comment "Het bestuur toont actief leiderschap en betrokkenheid bij het Informatiebeveiligingsbeleid. Eigenaarschap, rollen, verantwoordelijkheden en aansprakelijkheid zijn ingebed in het juiste managementniveau en worden periodiek geëvalueerd. Er is een formele risicobereidheid vastgesteld voor informatierisico’s en de acceptatie van restrisico’s."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_02 .

isms:CapLevel_ISMS_02_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_02 — Level 5"@en,
        "Cap_ISMS_02 — Niveau 5"@nl ;
    rdfs:comment "Het bestuur toont proactief leiderschap en betrokkenheid bij het Informatiebeveiligingsbeleid. Eigenaarschap, rollen, verantwoordelijkheden en aansprakelijkheid worden continu geëvalueerd en verbeterd. Er is een cultuur van continue verbetering, waarbij het bestuur actief betrokken is bij het beoordelen en aanpassen van de informatiebeveiligingsstrategie."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_ISMS_02 .

isms:CapLevel_ISMS_03_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_03 — Level 1"@en,
        "Cap_ISMS_03 — Niveau 1"@nl ;
    rdfs:comment "De entiteit heeft geen algemeen informatiebeveiligingsplan. Er is geen vertaling van organisatiedoelen, risico's of compliance-eisen naar informatiebeveiliging. De IT-infrastructuur en veiligheidscultuur worden niet meegenomen in de planning."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_03 .

isms:CapLevel_ISMS_03_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_03 — Level 2"@en,
        "Cap_ISMS_03 — Niveau 2"@nl ;
    rdfs:comment "Er is een informeel informatiebeveiligingsplan aanwezig. Organisatiedoelen, risico's en compliance-eisen worden op een ad-hoc basis vertaald naar het plan. De IT-infrastructuur en veiligheidscultuur worden beperkt meegenomen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_03 .

isms:CapLevel_ISMS_03_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_03 — Level 3"@en,
        "Cap_ISMS_03 — Niveau 3"@nl ;
    rdfs:comment "Het informatiebeveiligingsplan is formeel vastgesteld. Organisatiedoelen, risico's en compliance-eisen worden systematisch vertaald naar het plan. De IT-infrastructuur en veiligheidscultuur worden meegenomen in de planning."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_03 .

isms:CapLevel_ISMS_03_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_03 — Level 4"@en,
        "Cap_ISMS_03 — Niveau 4"@nl ;
    rdfs:comment "Het informatiebeveiligingsplan is geïntegreerd in de bedrijfsvoering. Organisatiedoelen, risico's en compliance-eisen worden continu gemonitord en geëvalueerd. De IT-infrastructuur en veiligheidscultuur worden actief beheerd en geoptimaliseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_03 .

isms:CapLevel_ISMS_03_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_03 — Level 5"@en,
        "Cap_ISMS_03 — Niveau 5"@nl ;
    rdfs:comment "Het informatiebeveiligingsplan is een dynamisch document dat continu wordt aangepast aan veranderende omstandigheden. Organisatiedoelen, risico's en compliance-eisen worden proactief geïdentificeerd en geïntegreerd. De IT-infrastructuur en veiligheidscultuur worden voortdurend verbeterd op basis van feedback en evaluaties."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_ISMS_03 .

isms:CapLevel_ISMS_04_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_04 — Level 1"@en,
        "Cap_ISMS_04 — Niveau 1"@nl ;
    rdfs:comment "De entiteit heeft geen inzicht in de benodigde middelen voor informatiebeveiliging. Er is geen systematische aanpak voor het inrichten, implementeren, onderhouden of verbeteren van informatiebeveiliging."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_04 .

isms:CapLevel_ISMS_04_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_04 — Level 2"@en,
        "Cap_ISMS_04 — Niveau 2"@nl ;
    rdfs:comment "De entiteit heeft een beperkt inzicht in de benodigde middelen voor informatiebeveiliging. Er worden incidentele maatregelen getroffen om informatiebeveiliging in te richten en te implementeren, maar er is geen structurele aanpak voor onderhoud en verbetering."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_04 .

isms:CapLevel_ISMS_04_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_04 — Level 3"@en,
        "Cap_ISMS_04 — Niveau 3"@nl ;
    rdfs:comment "De entiteit heeft vastgesteld welke middelen nodig zijn voor informatiebeveiliging en stelt deze beschikbaar. Er is een gestructureerde aanpak voor het inrichten, implementeren, onderhouden en verbeteren van informatiebeveiliging, met duidelijke processen en verantwoordelijkheden."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_04 .

isms:CapLevel_ISMS_04_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_04 — Level 4"@en,
        "Cap_ISMS_04 — Niveau 4"@nl ;
    rdfs:comment "De entiteit heeft een geïntegreerde benadering voor informatiebeveiliging, waarbij middelen effectief worden ingezet en beheerd. Er is een systematische evaluatie van de effectiviteit van maatregelen, en verbeteringen worden doorgevoerd op basis van meetbare resultaten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_04 .

isms:CapLevel_ISMS_04_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_04 — Level 5"@en,
        "Cap_ISMS_04 — Niveau 5"@nl ;
    rdfs:comment "De entiteit heeft een cultuur van continue verbetering op het gebied van informatiebeveiliging. Middelen worden proactief aangepast en geoptimaliseerd op basis van evaluaties, feedback en veranderende omstandigheden, met als doel een hoog niveau van informatiebeveiliging te waarborgen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_ISMS_04 .

isms:CapLevel_ISMS_05_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_05 — Level 1"@en,
        "Cap_ISMS_05 — Niveau 1"@nl ;
    rdfs:comment "De entiteit heeft geen vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Er is geen schriftelijke vastlegging van dit beleid, en het wordt niet aantoonbaar toegepast. Er is geen aansturing van personeel of andere werkzame personen met betrekking tot de naleving van dit beleid. Het beleid wordt niet periodiek geactualiseerd, geëvalueerd of goedgekeurd door het bestuur."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_05 .

isms:CapLevel_ISMS_05_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_05 — Level 2"@en,
        "Cap_ISMS_05 — Niveau 2"@nl ;
    rdfs:comment "De entiteit heeft een informeel vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Dit beleid is gedeeltelijk schriftelijk vastgelegd en wordt op inconsistente wijze toegepast. Er is enige aansturing van personeel of andere werkzame personen met betrekking tot de naleving van dit beleid, maar dit gebeurt niet systematisch. Het beleid wordt niet periodiek geactualiseerd, geëvalueerd of goedgekeurd door het bestuur."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_05 .

isms:CapLevel_ISMS_05_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_05 — Level 3"@en,
        "Cap_ISMS_05 — Niveau 3"@nl ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Dit beleid is schriftelijk vastgelegd en wordt op gestructureerde en geformaliseerde wijze toegepast. Er is aantoonbare aansturing van personeel en andere werkzame personen met betrekking tot de naleving van dit beleid. Het beleid wordt periodiek geactualiseerd, geëvalueerd en goedgekeurd door het bestuur."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_05 .

isms:CapLevel_ISMS_05_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_05 — Level 4"@en,
        "Cap_ISMS_05 — Niveau 4"@nl ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Dit beleid is schriftelijk vastgelegd en wordt op gestructureerde en geformaliseerde wijze toegepast. Er is aantoonbare aansturing van personeel en andere werkzame personen met betrekking tot de naleving van dit beleid. Het beleid wordt periodiek geactualiseerd, geëvalueerd en goedgekeurd door het bestuur. De effectiviteit van het beleid wordt periodiek geëvalueerd en verbeterd op basis van meetbare resultaten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_05 .

isms:CapLevel_ISMS_05_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_05 — Level 5"@en,
        "Cap_ISMS_05 — Niveau 5"@nl ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld beleid over de beveiliging van haar netwerk- en informatiesystemen. Dit beleid is schriftelijk vastgelegd en wordt op gestructureerde en geformaliseerde wijze toegepast. Er is aantoonbare aansturing van personeel en andere werkzame personen met betrekking tot de naleving van dit beleid. Het beleid wordt periodiek geactualiseerd, geëvalueerd en goedgekeurd door het bestuur. De effectiviteit van het beleid wordt continu geëvalueerd en verbeterd op basis van meetbare resultaten en feedback."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_ISMS_05 .

isms:CapLevel_ISMS_06_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_06 — Level 1"@en,
        "Cap_ISMS_06 — Niveau 1"@nl ;
    rdfs:comment "De entiteit heeft geen vastgesteld informatiebeveiligingsplan. Er is geen formele uitvoering of naleving van doelen en eisen met betrekking tot informatiebeveiliging. Er is geen aansturing of toezicht op de naleving van informatiebeveiligingsmaatregelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_06 .

isms:CapLevel_ISMS_06_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_06 — Level 2"@en,
        "Cap_ISMS_06 — Niveau 2"@nl ;
    rdfs:comment "De entiteit heeft een informeel informatiebeveiligingsplan. Er worden enkele doelen en eisen uitgevoerd, maar deze zijn niet consistent of systematisch. Er is beperkte aansturing en toezicht op de naleving van informatiebeveiligingsmaatregelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_06 .

isms:CapLevel_ISMS_06_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_06 — Level 3"@en,
        "Cap_ISMS_06 — Niveau 3"@nl ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld informatiebeveiligingsplan. Doelen en eisen worden systematisch uitgevoerd en nageleefd. Er is duidelijke aansturing en toezicht op de naleving van informatiebeveiligingsmaatregelen."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_06 .

isms:CapLevel_ISMS_06_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_06 — Level 4"@en,
        "Cap_ISMS_06 — Niveau 4"@nl ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld informatiebeveiligingsplan. Doelen en eisen worden effectief uitgevoerd en nageleefd. Er is gestructureerde aansturing en toezicht op de naleving van informatiebeveiligingsmaatregelen. De effectiviteit van de uitvoering wordt periodiek geëvalueerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_06 .

isms:CapLevel_ISMS_06_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_06 — Level 5"@en,
        "Cap_ISMS_06 — Niveau 5"@nl ;
    rdfs:comment "De entiteit heeft een formeel vastgesteld informatiebeveiligingsplan. Doelen en eisen worden proactief uitgevoerd en nageleefd. Er is continue aansturing en toezicht op de naleving van informatiebeveiligingsmaatregelen. De effectiviteit van de uitvoering wordt continu geëvalueerd en verbeterd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_ISMS_06 .

isms:CapLevel_ISMS_07_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_07 — Level 1"@en,
        "Cap_ISMS_07 — Niveau 1"@nl ;
    rdfs:comment "Er is geen formeel proces voor het periodiek evalueren van de doeltreffendheid van genomen maatregelen met betrekking tot het mitigeren van risico’s voor de beveiliging van netwerk- en informatiesystemen. Evaluaties worden niet systematisch uitgevoerd en zijn afhankelijk van incidenten of ad-hoc verzoeken."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_07 .

isms:CapLevel_ISMS_07_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_07 — Level 2"@en,
        "Cap_ISMS_07 — Niveau 2"@nl ;
    rdfs:comment "Er zijn informele procedures voor het evalueren van de doeltreffendheid van maatregelen. Evaluaties worden uitgevoerd, maar zijn niet consistent of gedocumenteerd. Er is beperkte betrokkenheid van relevante stakeholders en de resultaten worden niet systematisch gebruikt om verbeteringen door te voeren."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_07 .

isms:CapLevel_ISMS_07_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_07 — Level 3"@en,
        "Cap_ISMS_07 — Niveau 3"@nl ;
    rdfs:comment "Het proces voor het periodiek evalueren van de doeltreffendheid van maatregelen is formeel gedefinieerd en gedocumenteerd. Evaluaties worden systematisch uitgevoerd met betrokkenheid van relevante stakeholders. De resultaten worden geanalyseerd en gebruikt om verbetermaatregelen te identificeren en door te voeren."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_07 .

isms:CapLevel_ISMS_07_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_07 — Level 4"@en,
        "Cap_ISMS_07 — Niveau 4"@nl ;
    rdfs:comment "Het evaluatieproces is geïntegreerd in het bredere risicomanagement- en kwaliteitsmanagementsysteem. Evaluaties worden periodiek uitgevoerd volgens een vastgesteld schema en methodologie. De effectiviteit van genomen maatregelen wordt gemeten en gerapporteerd aan het management. Corrigerende en preventieve maatregelen worden geïdentificeerd en geïmplementeerd op basis van evaluatieresultaten."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_07 .

isms:CapLevel_ISMS_07_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_07 — Level 5"@en,
        "Cap_ISMS_07 — Niveau 5"@nl ;
    rdfs:comment "Het evaluatieproces is volledig geïntegreerd in de organisatiecultuur. Er wordt actief gezocht naar kansen voor verbetering, zowel reactief als proactief. Evaluaties worden continu uitgevoerd en leiden tot voortdurende optimalisatie van maatregelen. Innovaties en best practices worden geïdentificeerd en geïmplementeerd, en de effectiviteit van maatregelen wordt continu gemonitord en geoptimaliseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_ISMS_07 .

isms:CapLevel_ISMS_08_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_08 — Level 1"@en,
        "Cap_ISMS_08 — Niveau 1"@nl ;
    rdfs:comment "Er is geen formeel vastgelegde procedure voor het verbeteren van de geschiktheid, toereikendheid en doeltreffendheid van het managementsysteem voor informatiebeveiliging. Verbeteringen worden ad hoc uitgevoerd, afhankelijk van incidenten of individuele initiatieven."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_08 .

isms:CapLevel_ISMS_08_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_08 — Level 2"@en,
        "Cap_ISMS_08 — Niveau 2"@nl ;
    rdfs:comment "Er zijn informele procedures en richtlijnen aanwezig voor het verbeteren van het managementsysteem. Verbeteringen worden op consistente wijze uitgevoerd, maar zijn niet formeel gedocumenteerd of geïntegreerd in het bredere managementsysteem."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_08 .

isms:CapLevel_ISMS_08_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_08 — Level 3"@en,
        "Cap_ISMS_08 — Niveau 3"@nl ;
    rdfs:comment "Het proces voor het verbeteren van de geschiktheid, toereikendheid en doeltreffendheid van het managementsysteem is formeel gedefinieerd en gedocumenteerd. Verbeteringen worden systematisch geïdentificeerd, gepland en uitgevoerd, met duidelijke verantwoordelijkheden en rapportage aan het management."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_08 .

isms:CapLevel_ISMS_08_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_08 — Level 4"@en,
        "Cap_ISMS_08 — Niveau 4"@nl ;
    rdfs:comment "Het verbeterproces is geïntegreerd in het bredere risicomanagement- en kwaliteitsmanagementsysteem. Verbeteringen worden periodiek geëvalueerd op effectiviteit, en er worden corrigerende en preventieve maatregelen genomen op basis van evaluaties en audits."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_08 .

isms:CapLevel_ISMS_08_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_08 — Level 5"@en,
        "Cap_ISMS_08 — Niveau 5"@nl ;
    rdfs:comment "Het verbeterproces is volledig geïntegreerd in de organisatiecultuur. Er wordt actief gezocht naar kansen voor  verbetering, zowel reactief als proactief. Innovaties en best practices worden geïdentificeerd en geïmplementeerd, en de effectiviteit van verbetermaatregelen wordt continu gemonitord en geoptimaliseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
    isms:forCapability isms:Cap_ISMS_08 .

isms:CapLevel_ISMS_09_Level_1 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_09 — Level 1"@en,
        "Cap_ISMS_09 — Niveau 1"@nl ;
    rdfs:comment "Er is geen formeel vastgelegde procedure voor het treffen van maatregelen om afwijkingen in de geschiktheid, toereikendheid en doeltreffendheid van het managementsysteem voor informatiebeveiliging te beheersen. Maatregelen worden ad hoc uitgevoerd, afhankelijk van incidenten of individuele initiatieven."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_1 ;
    isms:forCapability isms:Cap_ISMS_09 .

isms:CapLevel_ISMS_09_Level_2 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_09 — Level 2"@en,
        "Cap_ISMS_09 — Niveau 2"@nl ;
    rdfs:comment "Er zijn informele procedures en richtlijnen aanwezig voor het treffen van maatregelen om afwijkingen in het managementsysteem te trefen. Maatregelen worden op consistente wijze uitgevoerd, maar zijn niet formeel gedocumenteerd of geïntegreerd in het bredere managementsysteem."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_2 ;
    isms:forCapability isms:Cap_ISMS_09 .

isms:CapLevel_ISMS_09_Level_3 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_09 — Level 3"@en,
        "Cap_ISMS_09 — Niveau 3"@nl ;
    rdfs:comment "Het proces voor het treffen van maatregelen om de afwijkingen in de geschiktheid, toereikendheid en doeltreffendheid van het managementsysteem te beheersen is formeel gedefinieerd en gedocumenteerd. Maatregelen worden systematisch geïdentificeerd, gepland en uitgevoerd, met duidelijke verantwoordelijkheden en rapportage aan het management."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_3 ;
    isms:forCapability isms:Cap_ISMS_09 .

isms:CapLevel_ISMS_09_Level_4 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_09 — Level 4"@en,
        "Cap_ISMS_09 — Niveau 4"@nl ;
    rdfs:comment "Het treffen van maatregelen is geïntegreerd in het bredere risicomanagement- en kwaliteitsmanagementsysteem. Maatregelen worden periodiek geëvalueerd op effectiviteit, en er worden corrigerende en preventieve maatregelen genomen op basis van evaluaties en audits."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_4 ;
    isms:forCapability isms:Cap_ISMS_09 .

isms:CapLevel_ISMS_09_Level_5 a owl:NamedIndividual,
        isms:CapabilityLevelDescription ;
    rdfs:label "Cap_ISMS_09 — Level 5"@en,
        "Cap_ISMS_09 — Niveau 5"@nl ;
    rdfs:comment "Het treffen van maatregelen is volledig geïntegreerd in de organisatiecultuur. Er wordt actief gezocht naar kansen voor  verbetering, zowel reactief als proactief. Innovaties en best practices worden geïdentificeerd en geïmplementeerd, en de effectiviteit van verbetermaatregelen wordt continu gemonitord en geoptimaliseerd."@nl ;
    ext:sourceAttribution ext:Attr_NBA_LIO_NOREA_Volwassenheidsmodel_via_CBW_2026 ;
    isms:atMaturityLevel isms:Level_5 ;
