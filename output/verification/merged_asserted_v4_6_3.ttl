biz:DOM_06 a biz:GRCDomain ;
    rdfs:label "Domein: Privacy & gegevensbescherming"@nl ;
    biz:alignedWith biz:SO_02 ;
    biz:coversDomain compl:CD_PrivacyDataProtection ;
    biz:domainID "DOM-06" ;
    biz:hasMaturityLevel biz:ML_2 ;
    biz:targetMaturityLevel biz:ML_3 .

biz:DirectieBeoordeling a owl:Class ;
    rdfs:label "Management Review (Directiebeoordeling)"@en,
        "Directiebeoordeling"@nl ;
    rdfs:comment "The formal management review of the ISMS as required by ISO/IEC 27001:2022 Clause 9.3. Must cover changes in context, risk treatment outcomes, audit results, KPIs and improvement opportunities."@en,
        "De formele directiebeoordeling van het ISMS conform ISO/IEC 27001:2022 Clausule 9.3. Moet betrekking hebben op contextwijzigingen, risicobehandelingsresultaten, auditresultaten, KPI's en verbetermogelijkheden."@nl ;
    rdfs:subClassOf biz:ManagementReport ;
    skos:relatedMatch ext:COSO_ERM_ReviewRevision .

biz:KCI_01 a biz:KCI ;
    rdfs:label "KCI-01: Effectiviteit toegangsreview"@nl ;
    biz:kpiDescription "Effectiviteitsscore toegangsreview (percentage accounts correct beheerd)"@nl ;
    biz:kpiID "KCI-01" ;
    biz:measurementFrequency "Kwartaal"^^xsd:string ;
    biz:measuresControl ctrl:ISO27002_5_15 ;
    biz:targetValue "≥95%"^^xsd:string .

biz:KPI_01 a biz:KPI ;
    rdfs:label "KPI-01: NIS2 Art.21 implementatie"@nl ;
    biz:currentValue "47%"^^xsd:string ;
    biz:kpiDescription "Percentage NIS2 Art.21-eisen volledig geïmplementeerd"@nl ;
    biz:kpiID "KPI-01" ;
    biz:measurementFrequency "Kwartaal"^^xsd:string ;
    biz:targetValue "100%"^^xsd:string .

biz:KPI_02 a biz:KPI ;
    rdfs:label "KPI-02: SoA-implementatiegraad"@nl ;
    biz:currentValue "20%"^^xsd:string ;
    biz:kpiDescription "Percentage SoA-controls volledig geïmplementeerd (van 93 totaal)"@nl ;
    biz:kpiID "KPI-02" ;
    biz:measurementFrequency "Kwartaal"^^xsd:string ;
    biz:targetValue "80%"^^xsd:string .

biz:KPI_04 a biz:KPI ;
    rdfs:label "KPI-04: Doorlooptijd auditbevindingen"@nl ;
    biz:currentValue "Niet gemeten"^^xsd:string ;
    biz:kpiDescription "Gemiddelde tijd tot sluiting van openstaande auditbevindingen (dagen)"@nl ;
    biz:kpiID "KPI-04" ;
    biz:measurementFrequency "Kwartaal"^^xsd:string ;
    biz:targetValue "≤60 dagen"^^xsd:string .

biz:KPI_05 a biz:KPI ;
    rdfs:label "KPI-05: Gemiddeld volwassenheidsniveau"@nl ;
    biz:currentValue "1.8"^^xsd:string ;
    biz:kpiDescription "Gemiddeld volwassenheidsniveau GRC-domeinen"@nl ;
    biz:kpiID "KPI-05" ;
    biz:measurementFrequency "Jaarlijks"^^xsd:string ;
    biz:targetValue "3.0 (gedefinieerd)"^^xsd:string .

biz:KRI_01 a biz:KRI ;
    rdfs:label "KRI-01: Ongepatcht kritieke kwetsbaarheden"@nl ;
    biz:currentValue "Niet gemeten"^^xsd:string ;
    biz:indicatesRisk risk:R_001 ;
    biz:kpiDescription "Aantal kritieke kwetsbaarheden (CVSS ≥9.0) niet gepatcht binnen 72 uur"@nl ;
    biz:kpiID "KRI-01" ;
    biz:measurementFrequency "Wekelijks"^^xsd:string ;
    biz:targetValue "0"^^xsd:string .

biz:KRI_02 a biz:KRI ;
    rdfs:label "KRI-02: Leveranciers zonder actueel IB-assessment"@nl ;
    biz:currentValue "Niet gemeten"^^xsd:string ;
    biz:indicatesRisk risk:R_003 ;
    biz:kpiDescription "Aantal leveranciers zonder actueel IB-assessment (>12 maanden)"@nl ;
    biz:kpiID "KRI-02" ;
    biz:measurementFrequency "Kwartaal"^^xsd:string ;
    biz:targetValue "0"^^xsd:string .

biz:KRI_03 a biz:KRI ;
    rdfs:label "KRI-03: Systemen zonder MFA"@nl ;
    biz:currentValue "Niet gemeten"^^xsd:string ;
    biz:indicatesRisk risk:R_002 ;
    biz:kpiDescription "Percentage systemen zonder actieve MFA (intern)"@nl ;
    biz:kpiID "KRI-03" ;
    biz:measurementFrequency "Maandelijks"^^xsd:string ;
    biz:targetValue "0%"^^xsd:string .

biz:ML_4 a biz:MaturityLevel ;
    rdfs:label "Level 4 – Quantitatively Managed"@en,
        "Niveau 4 – Beheerst / Kwantitatief"@nl ;
    rdfs:comment "Processen worden kwantitatief gemeten en gestuurd."@nl ;
    biz:maturityScore 4 .

biz:ManagementReport a owl:Class ;
    rdfs:label "Management Report"@en,
        "Managementrapportage"@nl ;
    rdfs:comment "Periodic formal report to governing bodies on ISMS / GRC performance, as required by ISO 27001:2022 Clause 9.3."@en,
        "Periodieke formele rapportage aan bestuursorganen over ISMS/GRC-prestaties, vereist door ISO 27001:2022 Clausule 9.3."@nl ;
    skos:relatedMatch ext:COSO_ERM_InformationCommunicationReporting .

biz:MaturityAssessment a owl:Class ;
    rdfs:label "Maturity Assessment"@en,
        "Volwassenheidsbeoordeling"@nl ;
    rdfs:comment "A formal evaluation of the current maturity level of a GRC domain or control area."@en,
        "Een formele evaluatie van het huidige volwassenheidsniveau van een GRC-domein of beheersgebied."@nl .

biz:RAS_2025 a biz:RiskAppetiteStatement ;
    rdfs:label "Risicobereidheidsverklaring 2025"@nl ;
    rdfs:comment "Vastgesteld door Secretaris-Generaal, november 2025. Jaarlijks te herzien conform ISO 31000:2018 §6.4.2."@nl .

biz:RA_Informatiebeveiliging a biz:RiskAppetite ;
    rdfs:label "Risicobereidheid Informatiebeveiliging"@nl ;
    biz:constrainsRisk risk:R_001,
        risk:R_002,
        risk:R_003 ;
    biz:documentedIn biz:RAS_2025 ;
    biz:riskAppetiteNarrative "De organisatie hanteert een lage risicobereidheid voor informatiebeveiliging. Risico's die de vertrouwelijkheid van persoonsgegevens, de continuïteit van publieke dienstverlening of de naleving van wet- en regelgeving in gevaar brengen, worden niet geaccepteerd en vereisen actieve behandeling. Operationele risico's met beperkte impact (residueel risicoscore ≤6 op 5×5-matrix) kunnen onder voorwaarden worden geaccepteerd."@nl .

compl:AuditProgram a owl:Class ;
    rdfs:label "Audit Programme"@en,
        "Auditprogramma"@nl ;
    rdfs:comment "A set of planned audits covering a defined scope and time period."@en,
        "Een reeks geplande audits die een gedefinieerd toepassingsgebied en tijdsperiode bestrijken."@nl .

compl:CA_001 a compl:CorrectiveAction ;
    compl:actionDescription "Risicoregister actualiseren en formeel vaststellen voor 1 mei 2026; daarna kwartaallijkse reviewcyclus inrichten."@nl ;
    compl:ownedByRole roles:R_CISO ;
    compl:targetResolutionDate "2026-05-01"^^xsd:date .

compl:CA_002 a compl:CorrectiveAction ;
    compl:actionDescription "Incidentmeldprocedure conform NIS2 Art.23 (24h/72h/1maand) opstellen, testen en vaststellen voor 1 april 2026."@nl ;
    compl:ownedByRole roles:R_CISO ;
    compl:targetResolutionDate "2026-04-01"^^xsd:date .

compl:CD_CryptographyKeyMgmt a compl:ComplianceDomain ;
    rdfs:label "Cryptography & Key Management"@en,
        "Cryptografie en sleutelbeheer"@nl .

compl:CD_PrivacyDataProtection a compl:ComplianceDomain ;
    rdfs:label "Privacy & Data Protection"@en,
        "Privacy en gegevensbescherming"@nl .

compl:ContractualObligation a owl:Class ;
    rdfs:label "Contractual Obligation"@en,
        "Contractuele verplichting"@nl ;
    rdfs:comment "An obligation arising from a contract, SLA or processor agreement."@en,
        "Een verplichting uit een contract, SLA of verwerkersovereenkomst."@nl ;
    rdfs:subClassOf compl:Obligation .

compl:FIND_001 a compl:MinorNonConformity ;
    compl:addressedBy compl:CA_001 ;
    compl:findingDate "2026-03-01"^^xsd:date ;
    compl:findingDescription "Risicoregister is meer dan 12 maanden geleden voor het laatst bijgewerkt; voldoet niet aan ISO 27001:2022 clausule 6.1.2 (periodieke herbeoordeling vereist)."@nl ;
    compl:findingID "FIND-001" ;
    compl:relatesToRequirement compl:OBL_ISO27001_Cl6_1 .

compl:FIND_002 a compl:MajorNonConformity ;
    compl:addressedBy compl:CA_002 ;
    compl:findingDate "2026-03-01"^^xsd:date ;
    compl:findingDescription "Geen gedocumenteerde procedure voor NIS2 Art.23 meldplicht aangetroffen; ontbreekt volledig."@nl ;
    compl:findingID "FIND-002" ;
    compl:relatesToRequirement compl:OBL_NIS2_Art23 .

compl:MajorNonConformity a owl:Class ;
    rdfs:label "Major Nonconformity"@en,
        "Majeure non-conformiteit"@nl ;
    rdfs:comment "A nonconformity that affects the capability of the ISMS to achieve intended results or violates a legal obligation."@en,
        "Een non-conformiteit die het vermogen van het ISMS aantast om beoogde resultaten te bereiken, of die een wettelijke verplichting schendt."@nl ;
    rdfs:subClassOf compl:NonConformity .

compl:MinorNonConformity a owl:Class ;
    rdfs:label "Minor Nonconformity"@en,
        "Mineure non-conformiteit"@nl ;
    rdfs:comment "An isolated failure to meet a requirement, with limited impact on ISMS effectiveness."@en,
        "Een geïsoleerde tekortkoming in het voldoen aan een vereiste, met beperkte impact op de ISMS-effectiviteit."@nl ;
    rdfs:subClassOf compl:NonConformity .

compl:OBL_ISO27001_Cl4 a compl:StandardsObligation ;
    compl:belongsToDomain compl:CD_GovernanceOversight ;
    compl:hasArticleReference "ISO/IEC 27001:2022 Clause 4" ;
    compl:hasObligationID "ISO27001-CL4" ;
    compl:hasObligationTitle "Context of the organisation"@en,
        "Context van de organisatie"@nl ;
    compl:isMandatory true ;
    compl:sourcedFromFramework fw:ISO_IEC_27001_2022 .

compl:OBL_ISO27001_Cl6_1_3 a compl:StandardsObligation ;
    compl:accountableRole roles:R_CISO ;
    compl:belongsToDomain compl:CD_RiskManagement ;
    compl:hasArticleReference "ISO/IEC 27001:2022 Clause 6.1.3" ;
    compl:hasObligationID "ISO27001-CL6.1.3" ;
    compl:hasObligationTitle "Information security risk treatment & Statement of Applicability"@en,
        "Risicobehandeling en Verklaring van Toepasselijkheid"@nl ;
    compl:isMandatory true ;
    compl:sourcedFromFramework fw:ISO_IEC_27001_2022 .

compl:OBL_ISO27001_Cl9_2 a compl:StandardsObligation ;
    compl:accountableRole roles:R_InternAuditor ;
    compl:belongsToDomain compl:CD_GovernanceOversight ;
    compl:hasArticleReference "ISO/IEC 27001:2022 Clause 9.2" ;
    compl:hasDeadline "Minimaal jaarlijks / At least annually" ;
    compl:hasObligationID "ISO27001-CL9.2" ;
    compl:hasObligationTitle "ISMS internal audit"@en,
        "ISMS interne audit"@nl ;
    compl:isMandatory true ;
    compl:sourcedFromFramework fw:ISO_IEC_27001_2022 .

compl:OBL_VIRBI_Staatsgeheim a compl:PolicyObligation ;
    compl:accountableRole roles:R_BVA ;
    compl:belongsToDomain compl:CD_AssetManagement ;
    compl:hasArticleReference "VIRBI 2025 (Voorschrift Informatiebeveiliging Rijksdienst Bijzondere Informatie)" ;
    compl:hasObligationID "VIRBI-STG" ;
    compl:hasObligationTitle "VIRBI 2025 – Protection of classified and sensitive government information"@en,
        "VIRBI 2025 – Bescherming staatsgeheimen en bijzondere informatie"@nl ;
    compl:isMandatory true ;
    compl:responsibleRole roles:R_BVA ;
    compl:sourcedFromFramework fw:VIRBI_2025 .

compl:Observation a owl:Class ;
    rdfs:label "Observation / Opportunity for Improvement"@en,
        "Observatie / verbetermogelijkheid"@nl ;
    rdfs:comment "A finding that is not a nonconformity but indicates a potential improvement area."@en,
        "Een bevinding die geen non-conformiteit is maar een potentieel verbeterpunt aangeeft."@nl ;
    rdfs:subClassOf compl:AuditFinding .

compl:PositiveFinding a owl:Class ;
    rdfs:label "Positive Finding"@en,
        "Positieve bevinding"@nl ;
    rdfs:comment "An audit finding confirming that a requirement is effectively met."@en,
        "Een auditbevinding die bevestigt dat een vereiste effectief wordt nageleefd."@nl ;
    rdfs:subClassOf compl:AuditFinding .

compl:RemediationPlan a owl:Class ;
    rdfs:label "Remediation Plan"@en,
        "Verbeterplan"@nl ;
    rdfs:comment "A documented plan describing corrective actions, owners, timelines and success criteria."@en,
        "Een gedocumenteerd plan met corrigerende maatregelen, eigenaren, tijdlijnen en succescriteria."@nl .

ctrl:ControlObjective a owl:Class ;
    rdfs:label "Control Objective"@en,
        "Beheersmaatregeldoelstelling"@nl ;
    rdfs:comment "The intended outcome or purpose a control is designed to achieve."@en,
        "Het beoogde resultaat of doel dat een beheersmaatregel is ontworpen te bereiken."@nl .

ctrl:ISO27002_8_30 a ctrl:ISO27002Control ;
    rdfs:label "Outsourced development"@en,
        "Uitbestede systeemontwikkeling"@nl ;
    owl:sameAs bio:ISO27002_8_30 ;
    skos:broadMatch compl:NIS2_Art21_d,
        compl:NIS2_Art21_e ;
    asset:appliesToAssetType asset:Software ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:hasControlID "8.30" ;
    ctrl:hasControlTitle "Uitbestede systeemontwikkeling"@nl ;
    ctrl:hasControlType ctrl:Detectief,
        ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Beschermen,
        ctrl:Detecteren,
        ctrl:Identificeren ;
    ctrl:hasOperationalCapability ctrl:OC_BeveiligingLeveranciersrelaties,
        ctrl:OC_SysteemNetwerkbeveiliging,
        ctrl:OC_Toepassingsbeveiliging ;
    ctrl:hasSecurityDomain ctrl:SD_Bescherming,
        ctrl:SD_GovernanceEcosysteem ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Technologisch ;
    ctrl:isApplicableInBIO true .

ctrl:NIST80053Control a owl:Class ;
    rdfs:label "NIST SP 800-53 Rev.5 Control"@en,
        "NIST SP 800-53 Rev.5 Beheersmaatregel"@nl ;
    rdfs:comment "A security or privacy control defined in NIST SP 800-53 Revision 5."@en,
        "Een beveiligings- of privacymaatregel gedefinieerd in NIST SP 800-53 Revisie 5."@nl ;
    rdfs:subClassOf ctrl:Control .

ctrl:NIST_AT a ctrl:ControlFamily ;
    rdfs:label "Awareness and Training (AT)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlID "AT" .

ctrl:NIST_AU a ctrl:ControlFamily ;
    rdfs:label "Audit and Accountability (AU)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlID "AU" .

ctrl:NIST_PL a ctrl:ControlFamily ;
    rdfs:label "Planning (PL)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlID "PL" .

ctrl:NIST_RA a ctrl:ControlFamily ;
    rdfs:label "Risk Assessment (RA)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlID "RA" .

ctrl:NIST_SI a ctrl:ControlFamily ;
    rdfs:label "System and Information Integrity (SI)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlID "SI" .

ctrl:OC_Leveranciersrelaties a ctrl:OperationalCapability ;
    rdfs:label "Supplier Relationships Security"@en,
        "Beveiliging in leveranciersrelaties"@nl .

csf:GV_OC_01 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "GV.OC-01"@en ;
    rdfs:comment "The organizational mission is understood and informs cybersecurity risk management"@en ;
    skos:closeMatch ext:ISO27001_4_1,
        ext:ISO27001_6_1,
        ext:ISO27001_8_1,
        ext:ISO27001_8_2,
        ext:ISO27001_8_3 ;
    csf:csfIdentifier "GV.OC-01" ;
    csf:partOfCategory csf:GV_OrganizationalContext ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_RA_09 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "ID.RA-09"@en ;
    rdfs:comment "The authenticity and integrity of hardware and software are assessed prior to acquisition and use"@en ;
    skos:closeMatch bio:ISO27002_5_19,
        bio:ISO27002_5_20,
        bio:ISO27002_5_21,
        bio:ISO27002_5_22,
        bio:ISO27002_5_23,
        ext:NIST_SA_11,
        ext:NIST_SA_4,
        ext:NIST_SI_7,
        ext:NIST_SR_6 ;
    csf:csfIdentifier "ID.RA-09" ;
    csf:partOfCategory csf:ID_RiskAssessment ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:ID_RA_10 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "ID.RA-10"@en ;
    rdfs:comment "Critical suppliers are assessed prior to acquisition"@en ;
    skos:closeMatch bio:ISO27002_5_19,
        bio:ISO27002_5_20,
        bio:ISO27002_5_21,
        bio:ISO27002_5_22,
        bio:ISO27002_5_23,
        bio:ISO27002_7_11,
        bio:ISO27002_8_30,
        ext:NIST_SR_6 ;
    csf:csfIdentifier "ID.RA-10" ;
    csf:partOfCategory csf:ID_RiskAssessment ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RC_RP_03 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "RC.RP-03"@en ;
    rdfs:comment "The integrity of backups and other restoration assets is verified before using them for restoration"@en ;
    skos:closeMatch bio:ISO27002_8_13,
        ext:NIST_CP_2,
        ext:NIST_CP_4,
        ext:NIST_CP_9 ;
    csf:csfIdentifier "RC.RP-03" ;
    csf:partOfCategory csf:RC_IncidentRecoveryPlanExecution ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_AN_07 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "RS.AN-07"@en ;
    rdfs:comment "Incident data and metadata are collected, and their integrity and provenance are preserved"@en ;
    skos:closeMatch bio:ISO27002_5_28,
        bio:ISO27002_8_15,
        bio:ISO27002_8_16,
        bio:ISO27002_8_17,
        ext:NIST_IR_4,
        ext:NIST_IR_6 ;
    csf:csfIdentifier "RS.AN-07" ;
    csf:partOfCategory csf:RS_IncidentAnalysis ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

