    compl:requirementID "NIS2-ART21-G" ;
    compl:requirementText "Basic cyber hygiene practices and cybersecurity training."@en,
        "Basismaatregelen voor cyberhygiëne en cyberbeveiligingstraining."@nl ;
    compl:satisfiedBy ctrl:ISO27002_6_03 .

compl:REQ_NIS2_Art21_h a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 21(2)(h) — cryptography and encryption"@en,
        "Requirement: NIS2 art. 21 lid 2 onderdeel h — cryptografie en versleuteling"@nl ;
    compl:belongsToDomain compl:CD_CryptographyKeyMgmt ;
    compl:derivedFrom compl:OBL_NIS2_Art21 ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART21-H" ;
    compl:requirementText "Policies and procedures regarding the use of cryptography and encryption."@en,
        "Beleid en procedures inzake het gebruik van cryptografie en versleuteling."@nl ;
    compl:satisfiedBy ctrl:ISO27002_8_24 .

compl:REQ_NIS2_Art21_i a owl:NamedIndividual,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 21(2)(i) — human resources security, access control and asset management"@en,
        "Requirement: NIS2 art. 21 lid 2 onderdeel i — personeelsbeveiliging, toegangsbeheer en bedrijfsmiddelenbeheer"@nl ;
    compl:belongsToDomain compl:CD_AccessControl ;
    compl:derivedFrom compl:OBL_NIS2_Art21 ;
