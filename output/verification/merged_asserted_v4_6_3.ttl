csf:DE_CM_09 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "DE.CM-09"@en ;
    rdfs:comment "Computing hardware and software, runtime environments, and their data are monitored to find potentially adverse events"@en ;
    skos:closeMatch bio:ISO27002_5_32,
        bio:ISO27002_8_07,
        bio:ISO27002_8_16,
        bio:ISO27002_8_31,
