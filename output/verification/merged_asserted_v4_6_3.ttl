ctrl:NIST_PM a ctrl:ControlFamily ;
    rdfs:label "Program Management (PM)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlID "PM" .

ctrl:NIST_PS a ctrl:ControlFamily ;
    rdfs:label "Personnel Security (PS)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlID "PS" .

ctrl:NIST_PT a ctrl:ControlFamily ;
    rdfs:label "PII Processing and Transparency (PT)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlID "PT" .

ctrl:NIST_SA a ctrl:ControlFamily ;
    rdfs:label "System and Services Acquisition (SA)"@en ;
    ctrl:belongsToFramework fw:NIST_SP_800_53_R5 ;
