csf:RS_MA_03_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.MA-03.Ex2"@en,
        "RS.MA-03.Ex2"@nl ;
    rdfs:comment "Prioritize incidents based on their scope, likely impact, and time-critical nature"@en ;
    csf:csfIdentifier "RS.MA-03.Ex2" ;
    csf:exemplifies csf:RS_MA_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_MA_03_Ex3 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.MA-03.Ex3"@en,
        "RS.MA-03.Ex3"@nl ;
