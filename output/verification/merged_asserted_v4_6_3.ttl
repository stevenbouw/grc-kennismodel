    csf:exemplifies csf:RS_AN_03 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_AN_06_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.AN-06.Ex1"@en,
        "RS.AN-06.Ex1"@nl ;
    rdfs:comment "Require each incident responder and others (e.g., system administrators, cybersecurity engineers) who perform incident response tasks to record their actions and make the record immutable"@en ;
    csf:csfIdentifier "RS.AN-06.Ex1" ;
    csf:exemplifies csf:RS_AN_06 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_AN_06_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.AN-06.Ex2"@en,
        "RS.AN-06.Ex2"@nl ;
    rdfs:comment "Require the incident lead to document the incident in detail and be responsible for preserving the integrity of the documentation and the sources of all information being reported"@en ;
    csf:csfIdentifier "RS.AN-06.Ex2" ;
    csf:exemplifies csf:RS_AN_06 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_AN_07_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.AN-07.Ex1"@en,
        "RS.AN-07.Ex1"@nl ;
    rdfs:comment "Collect, preserve, and safeguard the integrity of all pertinent incident data and metadata (e.g., data source, date/time of collection) based on evidence preservation and chain-of-custody procedures"@en ;
    csf:csfIdentifier "RS.AN-07.Ex1" ;
    csf:exemplifies csf:RS_AN_07 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_AN_08_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.AN-08.Ex1"@en,
        "RS.AN-08.Ex1"@nl ;
    rdfs:comment "Review other potential targets of the incident to search for indicators of compromise and evidence of persistence"@en ;
    csf:csfIdentifier "RS.AN-08.Ex1" ;
    csf:exemplifies csf:RS_AN_08 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_AN_08_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.AN-08.Ex2"@en,
        "RS.AN-08.Ex2"@nl ;
    rdfs:comment "Automatically run tools on targets to look for indicators of compromise and evidence of persistence"@en ;
    csf:csfIdentifier "RS.AN-08.Ex2" ;
    csf:exemplifies csf:RS_AN_08 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:RS_CO_02_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.CO-02.Ex1"@en,
        "RS.CO-02.Ex1"@nl ;
