    csf:exemplifies csf:GV_SC_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_SC_05_Ex5 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "GV.SC-05.Ex5"@en,
        "GV.SC-05.Ex5"@nl ;
    rdfs:comment "Define security requirements in service-level agreements (SLAs) for monitoring suppliers for acceptable security performance throughout the supplier relationship lifecycle"@en ;
    csf:csfIdentifier "GV.SC-05.Ex5" ;
    csf:exemplifies csf:GV_SC_05 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_SC_05_Ex6 a owl:NamedIndividual,
        csf:ImplementationExample ;
