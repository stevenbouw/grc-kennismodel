csf:RS_AN_03_Ex4 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.AN-03.Ex4"@en,
        "RS.AN-03.Ex4"@nl ;
    rdfs:comment "Check any cyber deception technology for additional information on attacker behavior"@en ;
