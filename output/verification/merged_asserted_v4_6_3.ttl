csf:GV_CybersecuritySupplyChainRiskManagement a owl:NamedIndividual,
        csf:Category ;
    rdfs:label "Cybersecurity Supply Chain Risk Management"@en,
        "Risicobeheer cybersecurity-toeleveringsketen"@nl ;
    rdfs:comment "Cyber supply chain risk management processes are identified, established, managed, monitored, and improved by organizational stakeholders"@en ;
    skos:closeMatch bio:ISO27002_5_01,
        bio:ISO27002_5_19,
        bio:ISO27002_5_20,
        ext:ISO27001_8_1 ;
    csf:csfIdentifier "GV.SC" ;
    csf:partOfFunction csf:GOVERN ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:GV_SC_05 a owl:NamedIndividual,
        csf:Subcategory ;
    rdfs:label "GV.SC-05"@en ;
    rdfs:comment "Requirements to address cybersecurity risks in supply chains are established, prioritized, and integrated into contracts and other types of agreements with suppliers and other relevant third parties"@en ;
    skos:closeMatch bio:ISO27002_5_19,
        bio:ISO27002_5_20,
        bio:ISO27002_5_21,
        bio:ISO27002_5_31,
        bio:ISO27002_8_30,
        ext:ISO27001_4_2,
        ext:NIST_SA_4,
        ext:NIST_SA_9,
        ext:NIST_SR_3,
        ext:NIST_SR_6 ;
    csf:csfIdentifier "GV.SC-05" ;
    csf:partOfCategory csf:GV_CybersecuritySupplyChainRiskManagement ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

