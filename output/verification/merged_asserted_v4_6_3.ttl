csf:RS_CO_02_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "RS.CO-02.Ex2"@en,
        "RS.CO-02.Ex2"@nl ;
    rdfs:comment "Notify business partners and customers of incidents in accordance with contractual requirements"@en ;
