        "heeft beheersmaatregeltitel"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range rdfs:Literal .

ctrl:hasControlType a owl:ObjectProperty ;
    rdfs:label "has control type"@en,
        "heeft type beheersmaatregel"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:ControlType .

ctrl:hasCybersecurityConcept a owl:ObjectProperty ;
    rdfs:label "has cybersecurity concept"@en,
        "heeft cybersecurityconcept"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:CybersecurityConcept .

ctrl:hasOperationalCapability a owl:ObjectProperty ;
    rdfs:label "has operational capability"@en,
        "heeft operationele capaciteit"@nl ;
    rdfs:comment "Links a control to the operational capability it supports. ISO/IEC 27002:2022 attribute. Multi-valued."@en,
        "Koppelt een beheersmaatregel aan de operationele capaciteit die deze ondersteunt. ISO/IEC 27002:2022-attribuut. Meerwaardig."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:OperationalCapability .

ctrl:hasSecurityDomain a owl:ObjectProperty ;
    rdfs:label "has security domain"@en,
        "heeft beveiligingsdomein"@nl ;
    rdfs:comment "Links a control to the security domain it belongs to. ISO/IEC 27002:2022 attribute. Multi-valued."@en,
        "Koppelt een beheersmaatregel aan het beveiligingsdomein waartoe deze behoort. ISO/IEC 27002:2022-attribuut. Meerwaardig."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:SecurityDomain .

ctrl:hasSecurityProperty a owl:ObjectProperty ;
    rdfs:label "has security property"@en,
        "heeft informatiebeveiligingseigenschap"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:SecurityProperty .

ctrl:hasTheme a owl:ObjectProperty ;
    rdfs:label "has theme"@en,
        "heeft thema"@nl ;
    rdfs:comment "The ISO 27002:2022 thematic category."@en,
        "De thematische categorie conform ISO 27002:2022."@nl ;
    rdfs:domain ctrl:ISO27002Control ;
    rdfs:range ctrl:ControlTheme .

ctrl:isApplicableInBIO a owl:DatatypeProperty ;
    rdfs:label "is applicable in BIO 2.0"@en,
        "van toepassing in BIO 2.0"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range xsd:boolean .

ctrl:relatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related to"@en,
        "gerelateerd aan"@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range ctrl:Control .

ctrl:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies"@en,
        "voldoet aan"@nl ;
    rdfs:comment "Links a control to a regulatory obligation or requirement it helps satisfy."@en,
        "Koppelt een beheersmaatregel aan een wettelijke verplichting of eis die deze helpt te vervullen."@nl ;
    rdfs:domain ctrl:Control ;
    rdfs:range owl:Thing .

csf:DE_AE_02_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "DE.AE-02.Ex1"@en,
        "DE.AE-02.Ex1"@nl ;
    rdfs:comment "Use security information and event management (SIEM) or other tools to continuously monitor log events for known malicious and suspicious activity"@en ;
    csf:csfIdentifier "DE.AE-02.Ex1" ;
    csf:exemplifies csf:DE_AE_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:DE_AE_02_Ex2 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "DE.AE-02.Ex2"@en,
        "DE.AE-02.Ex2"@nl ;
    rdfs:comment "Utilize up-to-date cyber threat intelligence in log analysis tools to improve detection accuracy and characterize threat actors, their methods, and indicators of compromise"@en ;
    csf:csfIdentifier "DE.AE-02.Ex2" ;
    csf:exemplifies csf:DE_AE_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:DE_AE_02_Ex3 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "DE.AE-02.Ex3"@en,
        "DE.AE-02.Ex3"@nl ;
    rdfs:comment "Regularly conduct manual reviews of log events for technologies that cannot be sufficiently monitored through automation"@en ;
    csf:csfIdentifier "DE.AE-02.Ex3" ;
    csf:exemplifies csf:DE_AE_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:DE_AE_02_Ex4 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "DE.AE-02.Ex4"@en,
        "DE.AE-02.Ex4"@nl ;
    rdfs:comment "Use log analysis tools to generate reports on their findings"@en ;
    csf:csfIdentifier "DE.AE-02.Ex4" ;
    csf:exemplifies csf:DE_AE_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:DE_AE_03_Ex1 a owl:NamedIndividual,
        csf:ImplementationExample ;
    rdfs:label "DE.AE-03.Ex1"@en,
        "DE.AE-03.Ex1"@nl ;
    rdfs:comment "Constantly transfer log data generated by other sources to a relatively small number of log servers"@en ;
