ext:NIS2Requirement a owl:Class ;
    rdfs:label "NIS2 requirement"@en,
        "NIS2-vereiste"@nl ;
    rdfs:comment "D12 requirement layer (v4.3.3): operational translation of a statutory NIS2 obligation, carrying compl:hasStatus, compl:satisfiedBy, compl:belongsToDomain and compl:requirementText. Subjects with single compl:derivedFrom (NIS2_Directive only) remain on this class; subjects also nationally enforceable via CBW (art. 21(2)) sit on compl:RegulatoryObligation (D12 legal layer)."@en,
        "Mandatory article from NIS2 (EU 2022/2555) as specific subclass of compl:ComplianceRequirement. Analogous to ext:DORARequirement, ext:ISMSRequirement, ext:BCMRequirement."@en,
        "D12 requirement-laag (v4.3.3): operationele vertaling van een wettelijke NIS2-verplichting, met compl:hasStatus, compl:satisfiedBy, compl:belongsToDomain en compl:requirementText. Subjects met enkelvoudige compl:derivedFrom (NIS2_Directive only) blijven op deze klasse; subjects die via CBW ook nationaal afdwingbaar zijn (art. 21, lid 2) staan op compl:RegulatoryObligation (D12 wettelijke laag)."@nl,
        "Verplichtingsartikel uit NIS2 (EU 2022/2555) als specifieke subklasse van compl:ComplianceRequirement. Analoog aan ext:DORARequirement, ext:ISMSRequirement, ext:BCMRequirement."@nl ;
    rdfs:subClassOf compl:ComplianceRequirement .

ctrl:SD_Verdediging a ctrl:SecurityDomain ;
    rdfs:label "Defence"@en,
        "Verdediging"@nl .

