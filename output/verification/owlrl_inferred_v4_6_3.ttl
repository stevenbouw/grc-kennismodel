bio:BIO2_5_35_2 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 5.35.2"@nl ;
    owl:sameAs bio:BIO2_5_35_2 ;
