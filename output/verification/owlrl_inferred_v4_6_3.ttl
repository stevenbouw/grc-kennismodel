fw:BestPractice a owl:Class ;
    rdfs:label "Best Practice"@en,
        "Best practice"@nl ;
    rdfs:comment "A framework or methodology representing industry-accepted good practice, not formally standardised."@en,
        "Een kaderwerk of methodologie die algemeen aanvaarde branchepraktijken vertegenwoordigt, zonder formele normstatus."@nl ;
    rdfs:subClassOf owl:Thing,
        fw:BestPractice,
        fw:GRCFramework ;
    owl:disjointWith fw:Guideline,
        fw:Regulation,
        fw:Standard ;
    owl:equivalentClass fw:BestPractice ;
    owl:sameAs fw:BestPractice .

fw:ISO_IEC_27005_2022 a owl:Thing,
        fw:GRCFramework,
        fw:InternationalStandard,
        fw:Standard ;
    rdfs:label "ISO/IEC 27005:2022"@en,
        "ISO/IEC 27005:2022"@nl ;
    rdfs:comment "Information security risk management – guidelines aligned with ISO 31000."@en,
        "Risicobeheer voor informatiebeveiliging – richtlijnen afgestemd op ISO 31000."@nl ;
    owl:sameAs fw:ISO_IEC_27005_2022 ;
    skos:broadMatch fw:ISO_31000_2018 ;
    skos:closeMatch fw:NIST_SP_800_30_R1 ;
    fw:appliesInJurisdiction fw:JurisdictionInternational ;
    fw:hasDomain fw:DomainInformationSecurity,
        fw:DomainRiskManagement ;
    fw:hasIdentifier "ISO-IEC-27005-2022" ;
    fw:hasPublicationDate "2022-10-01"^^xsd:date ;
    fw:hasVersionLabel "2022" ;
    fw:isMandatoryForDutchGovernment false ;
    fw:issuedBy fw:IEC,
        fw:ISO ;
    fw:relatedTo fw:ISO_31000_2018 .

fw:NationalStandard a owl:Class ;
    rdfs:label "National Standard"@en,
        "Nationale norm"@nl ;
    rdfs:comment "A standard issued by a national standards body such as NEN or NIST."@en,
        "Een norm uitgevaardigd door een nationaal normalisatie-instituut zoals NEN of NIST."@nl ;
    rdfs:subClassOf owl:Thing,
        fw:GRCFramework,
        fw:NationalStandard,
        fw:Standard ;
    owl:equivalentClass fw:NationalStandard ;
    owl:sameAs fw:NationalStandard .

isms:MaturityCapabilityLevel a owl:Class ;
    rdfs:label "Maturity Capability Level"@en,
        "Volwassenheidsniveau"@nl ;
    rdfs:comment "Level (1-5) on the NBA-LIO/NOREA maturity scale: ad-hoc → informal → established → evaluated → integrated."@en,
        "Niveau (1-5) in de NBA-LIO/NOREA volwassenheidsschaal: ad-hoc → informeel → vastgesteld → geëvalueerd → geïntegreerd."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:MaturityCapabilityLevel ;
    owl:equivalentClass isms:MaturityCapabilityLevel ;
    owl:sameAs isms:MaturityCapabilityLevel .

isms:Procedure a owl:Class ;
    rdfs:label "Procedure"@en,
        "Procedure"@nl ;
    rdfs:comment "ISMS administrative stub for procedures. Architectural component modeling resides in M18 (asset:Procedure)."@en,
        "ISMS-administratieve stub voor procedures. Architecturale component-modellering staat in M18 (asset:Procedure)."@nl ;
    rdfs:seeAlso asset:Procedure ;
    rdfs:subClassOf owl:Thing,
        isms:ISMSDocument,
        isms:Procedure ;
    owl:equivalentClass isms:Procedure ;
    owl:sameAs isms:Procedure .

risk:ImpactLevel a owl:Class ;
    rdfs:label "Impact Level"@en,
        "Impactniveau"@nl ;
    rdfs:comment "A qualitative level of impact on a defined scale."@en,
        "Een kwalitatief niveau van impact op een gedefinieerde schaal."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:Impact,
        risk:ImpactLevel ;
    owl:equivalentClass risk:ImpactLevel ;
    owl:sameAs risk:ImpactLevel ;
    skos:closeMatch fw:NIST_SP_800_30_R1 .

risk:LikelihoodLevel a owl:Class ;
    rdfs:label "Likelihood Level"@en,
        "Waarschijnlijkheidsniveau"@nl ;
    rdfs:comment "A qualitative level of likelihood on a defined scale."@en,
        "Een kwalitatief niveau van waarschijnlijkheid op een gedefinieerde schaal."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:Likelihood,
        risk:LikelihoodLevel ;
    owl:equivalentClass risk:LikelihoodLevel ;
    owl:sameAs risk:LikelihoodLevel ;
    skos:closeMatch fw:NIST_SP_800_30_R1 .

risk:RiskAssessment a owl:Class ;
    rdfs:label "Risk Assessment"@en,
        "Risicobeoordeling"@nl ;
    rdfs:comment "The overall process of risk identification, risk analysis and risk evaluation. [ISO 31000:2018]"@en,
        "Het algehele proces van risicoidentificatie, risicoanalyse en risico-evaluatie. [ISO 31000:2018]"@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskAssessment ;
    owl:equivalentClass risk:RiskAssessment ;
    owl:sameAs risk:RiskAssessment ;
    skos:exactMatch fw:ISO_IEC_27005_2022 ;
    skos:relatedMatch ext:COSO_ERM_Performance ;
    prov:wasDerivedFrom fw:ISO_31000_2018,
        fw:ISO_IEC_27005_2022 .

risk:RiskTreatment a owl:Class ;
    rdfs:label "Risk Treatment"@en,
        "Risicobehandeling"@nl ;
    rdfs:comment "A process to modify risk. Treatment options: modify (mitigate), retain (accept), avoid, share/transfer. [ISO 31000:2018]"@en,
        "Een proces om risico te wijzigen. Behandelopties: wijzigen (mitigeren), behouden (accepteren), vermijden, delen/overdragen. [ISO 31000:2018]"@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskTreatment ;
    owl:equivalentClass risk:RiskTreatment ;
    owl:sameAs risk:RiskTreatment ;
    skos:broadMatch fw:ISO_31000_2018 ;
    skos:relatedMatch ext:COSO_ERM_Performance ;
    prov:wasDerivedFrom fw:ISO_31000_2018 .

