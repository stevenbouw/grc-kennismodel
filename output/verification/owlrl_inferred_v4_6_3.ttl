    fw:issuedBy fw:DutchCentral .

fw:InternationalStandard a owl:Class ;
    rdfs:label "International Standard"@en,
        "Internationale norm"@nl ;
    rdfs:comment "A standard published by an international body such as ISO or IEC."@en,
        "Een norm gepubliceerd door een internationale instantie zoals ISO of IEC."@nl ;
