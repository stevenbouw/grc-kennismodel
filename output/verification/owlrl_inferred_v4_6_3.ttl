csf:Function a owl:Class ;
    rdfs:label "CSF Function"@en,
        "CSF-Function"@nl ;
    rdfs:comment "A Function from NIST Cybersecurity Framework 2.0. Functions form the highest level of the CSF Core: GOVERN, IDENTIFY, PROTECT, DETECT, RESPOND, RECOVER. Per CSF 2.0 GOVERN is new compared to v1.x."@en,
        "Een Function uit NIST Cybersecurity Framework 2.0. Functions vormen het hoogste niveau van de CSF-Core: GOVERN, IDENTIFY, PROTECT, DETECT, RESPOND, RECOVER. Per CSF 2.0 is GOVERN nieuw t.o.v. v1.x."@nl ;
    rdfs:subClassOf owl:Thing,
        csf:Function,
        ext:FrameworkComponent ;
    owl:equivalentClass csf:Function ;
    owl:sameAs csf:Function .

csf:GV_CybersecuritySupplyChainRiskManagement a owl:NamedIndividual,
        owl:Thing,
        csf:Category,
        ext:FrameworkComponent ;
    rdfs:label "Cybersecurity Supply Chain Risk Management"@en,
        "Risicobeheer cybersecurity-toeleveringsketen"@nl ;
    rdfs:comment "Cyber supply chain risk management processes are identified, established, managed, monitored, and improved by organizational stakeholders"@en ;
