ext:COSO_ERM_InformationCommunicationReporting a owl:NamedIndividual,
        owl:Thing,
        ext:COSOComponent,
        ext:FrameworkComponent ;
    rdfs:label "Information, Communication & Reporting"@en,
        "Informatie, Communicatie & Rapportage"@nl ;
    rdfs:comment "ERM vereist een continu proces van het verkrijgen en delen van noodzakelijke informatie, uit zowel interne als externe bronnen, die stroomt door de gehele organisatie."@nl ;
    owl:sameAs ext:COSO_ERM_InformationCommunicationReporting ;
    ext:isComponentOf fw:COSO_ERM .

ext:COSO_ICF_MonitoringActivities a owl:NamedIndividual,
        owl:Thing,
        ext:COSOComponent,
        ext:FrameworkComponent ;
    rdfs:label "Monitoring Activities"@en,
        "Monitoringactiviteiten"@nl ;
    rdfs:comment "Doorlopende evaluaties, afzonderlijke evaluaties of een combinatie daarvan, om vast te stellen of alle vijf componenten van interne beheersing aanwezig en werkzaam zijn."@nl ;
    owl:sameAs ext:COSO_ICF_MonitoringActivities ;
    ext:isComponentOf fw:COSO_ICF .

ext:COSO_ICF_RiskAssessment a owl:NamedIndividual,
        owl:Thing,
        ext:COSOComponent,
        ext:FrameworkComponent ;
    rdfs:label "Risk Assessment"@en,
        "Risicobeoordeling"@nl ;
    rdfs:comment "Het dynamische en iteratieve proces voor het identificeren en analyseren van risico's die het bereiken van doelstellingen bedreigen. Vormt de basis voor het bepalen hoe risico's moeten worden beheerst."@nl ;
    owl:sameAs ext:COSO_ICF_RiskAssessment ;
    ext:isComponentOf fw:COSO_ICF .

ext:ISO27001_4_1 a owl:NamedIndividual,
        owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:label "Understanding the organization and its context"@en,
        "Inzicht in de organisatie en haar context"@nl ;
    owl:sameAs ext:ISO27001_4_1 ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie bepaalt externe en interne kwesties die relevant zijn voor haar doel en die van invloed zijn op haar vermogen het beoogde resultaat van haar ISMS te bereiken."@nl ;
    ext:alignsWithHSClause ext:HSClause_4_Context ;
    ext:clauseNumber "4.1" .

ext:ISO27001_4_4 a owl:NamedIndividual,
        owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:label "Information security management system"@en,
