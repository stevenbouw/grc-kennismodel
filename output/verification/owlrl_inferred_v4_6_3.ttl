ext:alignsWithHSClause a owl:ObjectProperty ;
    rdfs:label "aligns with HS clause"@en,
        "sluit aan bij HS-clausule"@nl ;
    rdfs:comment "Links an ISMS requirement (e.g. an ISO 27001 clause) to the Annex SL Harmonized Structure clause it is substantively aligned with."@en,
        "Koppelt een ISMS-vereiste (bijv. een ISO 27001-clausule) aan de Annex SL Harmonized Structure-clausule waaraan deze inhoudelijk is uitgelijnd."@nl ;
    rdfs:domain owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:range owl:Thing,
        ext:FrameworkComponent,
        ext:HSClause ;
    rdfs:subPropertyOf ext:alignsWithHSClause ;
    owl:equivalentProperty ext:alignsWithHSClause ;
    owl:sameAs ext:alignsWithHSClause .

ext:clauseNumber a owl:DatatypeProperty ;
    rdfs:label "clause number"@en,
        "clausenummer"@nl ;
    rdfs:domain owl:Thing,
        compl:ComplianceRequirement ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ext:clauseNumber ;
    owl:equivalentProperty ext:clauseNumber ;
    owl:sameAs ext:clauseNumber .

