        owl:Thing,
        asset:Asset,
        asset:AssetOrComponent,
        risk:Asset ;
    rdfs:label "Information Asset"@en,
        "Informatiebedrijfsmiddel"@nl ;
    dcterms:source "ISO/IEC 27005:2024; BVA-stelsel 2021 art. 1k (informatie); VIRBI 2025" ;
    rdfs:comment "ISMS administrative stub for information assets. The architectural typology of information assets resides in M18 (asset:InformationAsset). This class remains for ISMS administration and SoA work; M18 provides the architectural taxonomy."@en,
        "Information as a standalone asset: data, documents, knowledge. Includes classified information under VIRBI 2025. Distinct from asset:InformationSystem (which is the composite processing environment)."@en,
        "Information or data in any form that has value to the organisation."@en,
        "ISMS-administratieve stub voor information assets. De architecturale typologie van information assets staat in M18 (asset:InformationAsset). Deze klasse blijft voor ISMS-administratie en SoA-werk; M18 levert de architecturale taxonomie."@nl,
        "Informatie als zelfstandig bedrijfsmiddel: data, documenten, kennis. Omvat gerubriceerde informatie onder VIRBI 2025. Onderscheiden van asset:InformationSystem (dat de samengestelde verwerkingsomgeving is)."@nl,
        "Informatie of gegevens in welke vorm dan ook die waarde heeft voor de organisatie."@nl ;
    rdfs:seeAlso asset:InformationAsset,
        isms:InformationAsset,
        risk:InformationAsset ;
    rdfs:subClassOf _:n3f94f8b74b824c38916a9ff5d1cbf89ab1,
        owl:Thing,
        asset:Asset,
        asset:AssetOrComponent,
        asset:InformationAsset,
        isms:InformationAsset,
        risk:Asset,
        risk:InformationAsset ;
    owl:equivalentClass asset:InformationAsset,
        isms:InformationAsset,
        risk:InformationAsset ;
    owl:sameAs asset:InformationAsset,
        isms:InformationAsset,
        risk:InformationAsset ;
