biz:KPI a owl:Class ;
    rdfs:label "Key Performance Indicator (KPI)"@en,
        "Kritieke prestatie-indicator (KPI)"@nl ;
    rdfs:comment "A measurable value that demonstrates how effectively a GRC objective is being achieved. [COBIT 2019 / ISO 27004]"@en,
        "Een meetbare waarde die aantoont hoe effectief een GRC-doelstelling wordt bereikt. [COBIT 2019 / ISO 27004]"@nl ;
    rdfs:subClassOf owl:Thing,
        biz:KPI,
        biz:PerformanceIndicator ;
    owl:equivalentClass biz:KPI ;
    owl:sameAs biz:KPI ;
    skos:relatedMatch ext:COSO_ERM_Performance .

compl:CD_GovernanceOversight a owl:Thing,
        compl:ComplianceDomain ;
    rdfs:label "Governance & Oversight"@en,
        "Governance en toezicht"@nl ;
    owl:sameAs compl:CD_GovernanceOversight .

compl:ComplianceStatus a owl:Class ;
    rdfs:label "Compliance Status"@en,
        "Compliancestatus"@nl ;
    rdfs:comment "The assessed status of a compliance requirement at a point in time."@en,
        "De beoordeelde status van een compliancevereiste op een bepaald tijdstip."@nl ;
    rdfs:subClassOf owl:Thing,
        compl:ComplianceStatus ;
    owl:equivalentClass compl:ComplianceStatus ;
    owl:sameAs compl:ComplianceStatus .

compl:NonConformity a owl:Class ;
    rdfs:label "Nonconformity"@en,
        "Non-conformiteit"@nl ;
    rdfs:comment "Non-fulfilment of a requirement. [ISO 9000:2015]"@en,
        "Niet-vervulling van een vereiste. [ISO 9000:2015]"@nl ;
    rdfs:subClassOf owl:Thing,
        compl:AuditFinding,
        compl:NonConformity ;
    owl:equivalentClass compl:NonConformity ;
    owl:sameAs compl:NonConformity .

compl:PolicyObligation a owl:Class ;
    rdfs:label "Policy Obligation"@en,
        "Beleidsverplichting"@nl ;
    rdfs:comment "An obligation from an internal policy, BIO 2.0 government measure, or VIR directive."@en,
        "Een verplichting uit een intern beleid, BIO 2.0 overheidsmaatregel of VIR-voorschrift."@nl ;
    rdfs:subClassOf owl:Thing,
        compl:Obligation,
        compl:PolicyObligation ;
    owl:equivalentClass compl:PolicyObligation ;
    owl:sameAs compl:PolicyObligation .

ctrl:CybersecurityConcept a owl:Class ;
    rdfs:label "Cybersecurity Concept"@en,
        "Cybersecurityconcept"@nl ;
    rdfs:comment "NIST CSF 2.0-aligned concept: Govern, Identify, Protect, Detect, Respond, Recover. Per CSF 2.0 (NIST CSWP 29, 26 februari 2024) is Govern toegevoegd t.o.v. v1.x."@en,
        "NIST CSF 2.0-gebaseerd concept: Sturen, Identificeren, Beschermen, Detecteren, Reageren, Herstellen. Per CSF 2.0 (NIST CSWP 29, 26 februari 2024) is Sturen toegevoegd t.o.v. v1.x."@nl ;
    rdfs:subClassOf owl:Thing,
        ctrl:CybersecurityConcept ;
    owl:equivalentClass ctrl:CybersecurityConcept ;
    owl:sameAs ctrl:CybersecurityConcept .

