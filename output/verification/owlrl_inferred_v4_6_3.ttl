csf:csfIdentifier a owl:DatatypeProperty ;
    rdfs:label "CSF identifier"@en,
        "CSF-identifier"@nl ;
    rdfs:comment "The original NIST CSF 2.0 identifier (e.g. GV, GV.OC, GV.OC-01, GV.OC-01.Ex1). Retains period+dash convention from source; separate property alongside IRI conversion."@en,
        "De originele NIST CSF 2.0 identifier (bv. GV, GV.OC, GV.OC-01, GV.OC-01.Ex1). Behoudt punt+dash-conventie uit bron; aparte property naast IRI-conversie."@nl ;
    rdfs:domain owl:Thing,
        ext:FrameworkComponent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf csf:csfIdentifier ;
    owl:equivalentProperty csf:csfIdentifier ;
    owl:sameAs csf:csfIdentifier .

csf:exemplifies a owl:ObjectProperty ;
    rdfs:label "exemplifies"@en,
        "voorbeeld voor"@nl ;
    rdfs:comment "Links an Implementation Example to the Subcategory it illustrates."@en,
        "Koppelt een Implementation Example aan de Subcategory die het illustreert."@nl ;
