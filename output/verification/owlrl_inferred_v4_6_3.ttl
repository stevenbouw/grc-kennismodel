ext:ISO27001_6_2 a owl:NamedIndividual,
        owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:label "Information security objectives and planning to achieve them"@en,
        "Informatiebeveiligingsdoelstellingen en planning om deze te bereiken"@nl ;
