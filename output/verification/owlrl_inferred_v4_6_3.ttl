        csf:ImplementationExample,
        ext:FrameworkComponent ;
    rdfs:range owl:Thing,
        csf:Subcategory,
        ext:FrameworkComponent ;
    rdfs:subPropertyOf csf:exemplifies ;
    owl:equivalentProperty csf:exemplifies ;
    owl:sameAs csf:exemplifies .

csf:partOfCategory a owl:ObjectProperty ;
    rdfs:label "part of CSF Category"@en,
        "deel van CSF-Category"@nl ;
    rdfs:comment "Links a Subcategory to the Category it belongs to."@en,
        "Koppelt een Subcategory aan de Category waar zij onder valt."@nl ;
    rdfs:domain owl:Thing,
        csf:Subcategory,
        ext:FrameworkComponent ;
    rdfs:range owl:Thing,
        csf:Category,
        ext:FrameworkComponent ;
    rdfs:subPropertyOf csf:partOfCategory ;
    owl:equivalentProperty csf:partOfCategory ;
    owl:sameAs csf:partOfCategory .

csf:partOfFunction a owl:ObjectProperty ;
    rdfs:label "part of CSF Function"@en,
        "deel van CSF-Function"@nl ;
    rdfs:comment "Links a Category to the Function it belongs to."@en,
        "Koppelt een Category aan de Function waar zij onder valt."@nl ;
    rdfs:domain owl:Thing,
        csf:Category,
        ext:FrameworkComponent ;
    rdfs:range owl:Thing,
        csf:Function,
        ext:FrameworkComponent ;
    rdfs:subPropertyOf csf:partOfFunction ;
    owl:equivalentProperty csf:partOfFunction ;
    owl:sameAs csf:partOfFunction .

csf:riskGovernanceDescription a owl:DatatypeProperty ;
    rdfs:label "risk governance dimension description"@en,
        "beschrijving risk governance-dimensie"@nl ;
    rdfs:comment "Text description of the Cybersecurity Risk Governance dimension for a specific Tier (from CSWP 29 Appendix B Table 2)."@en,
        "Tekst-beschrijving van de Cybersecurity Risk Governance-dimensie voor een specifieke Tier (uit CSWP 29 Appendix B Table 2)."@nl ;
    rdfs:domain owl:Thing,
        csf:CSFTier,
        ext:FrameworkComponent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf csf:riskGovernanceDescription ;
    owl:equivalentProperty csf:riskGovernanceDescription ;
    owl:sameAs csf:riskGovernanceDescription .

csf:riskManagementDescription a owl:DatatypeProperty ;
    rdfs:label "risk management dimension description"@en,
        "beschrijving risk management-dimensie"@nl ;
    rdfs:comment "Text description of the Cybersecurity Risk Management dimension for a specific Tier (from CSWP 29 Appendix B Table 2)."@en,
        "Tekst-beschrijving van de Cybersecurity Risk Management-dimensie voor een specifieke Tier (uit CSWP 29 Appendix B Table 2)."@nl ;
