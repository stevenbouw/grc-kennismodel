fw:AVG_GDPR a owl:Thing,
        compl:Obligation,
        fw:GRCFramework,
        fw:Regulation ;
    rdfs:label "GDPR (EU) 2016/679"@en,
        "AVG / GDPR (EU) 2016/679"@nl ;
    rdfs:comment "General Data Protection Regulation. In this model only the information security interface articles: art. 5(1)(f) integrity and confidentiality, art. 25 data protection by design and by default, art. 32 security of processing, art. 33 notification of breach to supervisory authority, art. 34 communication of breach to data subject."@en,
        "Algemene Verordening Gegevensbescherming. In dit model uitsluitend de IB-raakvlakartikelen: art. 5(1)(f) integriteit en vertrouwelijkheid, art. 25 gegevensbescherming door ontwerp en door standaardinstellingen, art. 32 beveiliging van de verwerking, art. 33 melding inbreuk aan toezichthoudende autoriteit, art. 34 mededeling inbreuk aan betrokkene."@nl ;
    owl:sameAs fw:AVG_GDPR ;
    skos:relatedMatch fw:BIO_2_0,
        fw:ISO_IEC_27001_2022 ;
    fw:appliesInJurisdiction fw:JurisdictionEU,
        fw:JurisdictionNL ;
    fw:hasDomain fw:DomainInformationSecurity,
        fw:DomainPrivacy ;
    fw:hasIdentifier "EU-2016-679" ;
    fw:hasPublicationDate "2016-04-27"^^xsd:date ;
    fw:hasVersionLabel "2016/679" ;
    fw:isMandatoryForDutchGovernment true ;
    fw:issuedBy fw:EuropeanCommission ;
    fw:officialURL "https://eur-lex.europa.eu/legal-content/NL/TXT/?uri=CELEX:32016R0679"^^xsd:anyURI .

fw:GovernmentBaseline a owl:Class ;
    rdfs:label "Government Security Baseline"@en,
        "Overheidsbaseline beveiliging"@nl ;
    rdfs:comment "A mandatory minimum security baseline mandated for a government sector."@en,
        "Een verplichte minimale beveiligingsbaseline, voorgeschreven voor een overheidssector."@nl ;
    rdfs:subClassOf owl:Thing,
        fw:GRCFramework,
        fw:GovernmentBaseline,
        fw:NationalStandard,
        fw:Standard ;
    owl:equivalentClass fw:GovernmentBaseline ;
    owl:sameAs fw:GovernmentBaseline .

