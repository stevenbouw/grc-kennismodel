    owl:equivalentClass isms:PDCAPhase ;
    owl:sameAs isms:PDCAPhase .

risk:ImpactCategory a owl:Class ;
    rdfs:label "Impact Category"@en,
        "Impactcategorie"@nl ;
    rdfs:comment "A domain in which impact may be experienced: financial, operational, reputational, legal, safety."@en,
        "Een domein waarin impact kan optreden: financieel, operationeel, reputationeel, juridisch, veiligheid."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:ImpactCategory ;
    owl:equivalentClass risk:ImpactCategory ;
    owl:sameAs risk:ImpactCategory .

