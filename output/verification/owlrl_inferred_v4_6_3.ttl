csf:DE_AE_03_Ex1 a owl:NamedIndividual,
        owl:Thing,
        csf:ImplementationExample,
        ext:FrameworkComponent ;
    rdfs:label "DE.AE-03.Ex1"@en,
        "DE.AE-03.Ex1"@nl ;
    rdfs:comment "Constantly transfer log data generated by other sources to a relatively small number of log servers"@en ;
    owl:sameAs csf:DE_AE_03_Ex1 ;
