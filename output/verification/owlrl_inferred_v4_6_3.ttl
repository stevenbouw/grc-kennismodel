csf:Category a owl:Class ;
    rdfs:label "CSF Category"@en,
        "CSF-Category"@nl ;
    rdfs:comment "A Category from NIST Cybersecurity Framework 2.0. Categories are subdivisions of Functions that group related cybersecurity outcomes. CSF 2.0 has 22 Categories distributed across 6 Functions."@en,
        "Een Category uit NIST Cybersecurity Framework 2.0. Categories zijn onderverdelingen van Functions die gerelateerde cybersecurity-uitkomsten groeperen. CSF 2.0 telt 22 Categories verdeeld over 6 Functions."@nl ;
    rdfs:subClassOf owl:Thing,
        csf:Category,
        ext:FrameworkComponent ;
    owl:equivalentClass csf:Category ;
    owl:sameAs csf:Category .

fw:Regulation a owl:Class ;
    rdfs:label "Regulation"@en,
        "Wet- en regelgeving"@nl ;
    rdfs:comment "A legally binding instrument issued by a governmental or supranational authority."@en,
        "Een juridisch bindend instrument, uitgevaardigd door een overheids- of supranationaal gezag."@nl ;
    rdfs:subClassOf owl:Thing,
        fw:GRCFramework,
        fw:Regulation ;
    owl:disjointWith fw:BestPractice,
        fw:Guideline,
        fw:Standard ;
    owl:equivalentClass fw:Regulation ;
    owl:sameAs fw:Regulation .

isms:ISMSDocument a owl:Class ;
    rdfs:label "ISMS Document"@en,
        "ISMS-document"@nl ;
    rdfs:comment "Any documented information required or maintained within the ISMS."@en,
        "Elk gedocumenteerde informatie die vereist of bijgehouden wordt binnen het ISMS."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ISMSDocument ;
    owl:equivalentClass isms:ISMSDocument ;
    owl:sameAs isms:ISMSDocument .

risk:Threat a owl:Class ;
    rdfs:label "Threat"@en,
        "Dreiging"@nl ;
    rdfs:comment "A potential cause of an unwanted incident that may result in harm to a system or organisation. [ISO/IEC 27000:2018]"@en,
        "Een potentiële oorzaak van een ongewenst incident dat kan resulteren in schade aan een systeem of organisatie. [ISO/IEC 27000:2018]"@nl ;
    rdfs:subClassOf owl:Thing,
        risk:Threat ;
    owl:equivalentClass risk:Threat ;
    owl:sameAs risk:Threat ;
    skos:closeMatch fw:NIST_SP_800_30_R1 ;
    prov:wasDerivedFrom fw:ISO_IEC_27005_2022 .

