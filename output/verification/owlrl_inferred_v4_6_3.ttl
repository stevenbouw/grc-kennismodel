    rdfs:label "COBIT domain"@en,
        "COBIT-domein (EDM/APO/BAI/DSS/MEA)"@nl ;
    rdfs:domain owl:Thing,
        ext:COBITObjective,
        ext:FrameworkComponent ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ext:cobitDomain ;
    owl:equivalentProperty ext:cobitDomain ;
    owl:sameAs ext:cobitDomain .

ext:cobitObjectiveID a owl:DatatypeProperty ;
