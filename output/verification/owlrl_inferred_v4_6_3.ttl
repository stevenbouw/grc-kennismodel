        risk:Asset ;
    bio:bioMaatregelNummer "5.22.1" ;
    bio:hasMaatregel "Jaarlijks wordt de prestatie van leveranciers op het gebied van informatiebeveiliging beoordeeld op vooraf vastgestelde prestatie-indicatoren, zoals in het contract opgenomen is." ;
    bio:implementsControl bio:ISO27002_5_22,
        ctrl:ISO27002_5_22 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_29_2 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
