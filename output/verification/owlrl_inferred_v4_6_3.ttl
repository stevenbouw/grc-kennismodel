fw:TBB_Informatie a skos:Concept ;
    rdfs:label "TBB Information"@en,
        "TBB Informatie"@nl ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    owl:sameAs fw:TBB_Informatie ;
    skos:definition "Information as a protected interest within the central government, regardless of medium or form."@en,
        "Informatie als beschermwaardig belang binnen de Rijksdienst, ongeacht drager of vorm."@nl ;
    skos:exactMatch asset:InformationAsset,
        isms:InformationAsset,
        risk:InformationAsset ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "information"@en,
        "informatie"@nl .

fw:transposedBy a owl:ObjectProperty ;
    rdfs:label "transposed by"@en,
        "omgezet door"@nl ;
    rdfs:comment "Links an EU Directive to the national law(s) that transpose it."@en,
        "Koppelt een EU-richtlijn aan de nationale wet(ten) die haar omzetten."@nl ;
    rdfs:domain owl:Thing,
        fw:EUDirective,
        fw:GRCFramework,
        fw:Regulation ;
    rdfs:range owl:Thing,
        fw:GRCFramework,
        fw:NationalLaw,
        fw:Regulation ;
    rdfs:subPropertyOf fw:transposedBy ;
    owl:equivalentProperty fw:transposedBy ;
    owl:sameAs fw:transposedBy .

fw:uitgewerktIn a owl:ObjectProperty ;
    rdfs:label "elaborated in"@en,
        "uitgewerkt in"@nl ;
    rdfs:comment "Links a national law to a general administrative order (AMvB) that elaborates it. Example v4.4.0: fw:CBW fw:uitgewerktIn fw:Cbb. Domain and range are both fw:NationalLaw following precedent (BesluitCIOStelsel, BesluitBVAStelsel and VIR/VIRBI are also plain fw:NationalLaw individuals without an AMvB subclass)."@en,
        "Koppelt een wet aan een algemene maatregel van bestuur (AMvB) die haar uitwerkt. Voorbeeld v4.4.0: fw:CBW fw:uitgewerktIn fw:Cbb. Domain en range zijn beide fw:NationalLaw conform precedent (BesluitCIOStelsel, BesluitBVAStelsel en VIR/VIRBI zijn ook gewone fw:NationalLaw-individuals zonder AMvB-subklasse)."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework,
        fw:NationalLaw,
        fw:Regulation ;
    rdfs:range owl:Thing,
        fw:GRCFramework,
        fw:NationalLaw,
        fw:Regulation ;
    rdfs:subPropertyOf fw:uitgewerktIn ;
    owl:equivalentProperty fw:uitgewerktIn ;
    owl:sameAs fw:uitgewerktIn .

isms:CL_Vertrouwelijk a owl:Thing,
        isms:InformationClassificationLevel ;
    rdfs:label "Confidential"@en,
        "Vertrouwelijk"@nl ;
    rdfs:comment "Sensitive information; disclosure may cause damage. VIR 2007."@en,
        "Gevoelige informatie; openbaarmaking kan schade toebrengen. VIR 2007."@nl ;
    owl:sameAs isms:CL_Vertrouwelijk .

isms:forCapability a owl:ObjectProperty ;
    rdfs:label "for capability"@en,
        "voor capability"@nl ;
    rdfs:comment "Inverse of isms:hasLevelDescription. Points from a LevelDescription back to the Capability."@en,
        "Inverse van isms:hasLevelDescription. Wijst van een LevelDescription terug naar de Capability."@nl ;
    rdfs:domain owl:Thing,
        isms:CapabilityLevelDescription ;
    rdfs:range owl:Thing,
        isms:MaturityCapability ;
    rdfs:subPropertyOf isms:forCapability ;
    owl:equivalentProperty isms:forCapability ;
    owl:inverseOf isms:hasLevelDescription ;
    owl:sameAs isms:forCapability .

isms:forSoA a owl:ObjectProperty ;
    rdfs:label "for SoA"@en,
        "behoort bij SoA"@nl ;
    rdfs:comment "Links a Statement of Applicability entry to the SoA it belongs to."@en,
        "Koppelt een SoA-entry aan de Statement of Applicability waartoe deze behoort."@nl ;
    rdfs:domain owl:Thing,
        isms:SoAEntry ;
    rdfs:range owl:Thing,
        isms:StatementOfApplicability ;
    rdfs:subPropertyOf isms:forSoA ;
    owl:equivalentProperty isms:forSoA ;
    owl:sameAs isms:forSoA .

isms:hasLevelDescription a owl:ObjectProperty ;
    rdfs:label "has level description"@en,
        "heeft niveau-beschrijving"@nl ;
    rdfs:comment "Links a MaturityCapability to its item-specific level descriptions (typically 5)."@en,
        "Koppelt een MaturityCapability aan zijn item-specifieke niveau-beschrijvingen (typisch 5)."@nl ;
    rdfs:domain owl:Thing,
        isms:MaturityCapability ;
    rdfs:range owl:Thing,
        isms:CapabilityLevelDescription ;
    rdfs:subPropertyOf isms:hasLevelDescription ;
    owl:equivalentProperty isms:hasLevelDescription ;
    owl:inverseOf isms:forCapability ;
    owl:sameAs isms:hasLevelDescription .

risk:IL_Significant a owl:Thing,
        risk:Impact,
        risk:ImpactLevel,
        risk:Risk ;
    rdfs:label "Significant (4)"@en,
        "Aanzienlijk (4)"@nl ;
    rdfs:comment "Severe consequences; major disruption, significant financial or reputational damage."@en,
        "Ernstige gevolgen; grote verstoring, aanzienlijke financiële of reputatieschade."@nl ;
    owl:sameAs risk:IL_Significant ;
    risk:hasImpactScore 4 .

risk:LL_Medium a owl:Thing,
        risk:Likelihood,
        risk:LikelihoodLevel,
        risk:Risk ;
    rdfs:label "Medium (3)"@en,
        "Gemiddeld (3)"@nl ;
    rdfs:comment "Event may occur (once in 1–5 years)."@en,
        "Gebeurtenis kan optreden (eenmaal in 1–5 jaar)."@nl ;
    owl:sameAs risk:LL_Medium ;
    risk:hasLikelihoodScore 3 .

risk:PhysicalVulnerability a owl:Class ;
    rdfs:label "Physical Vulnerability"@en,
        "Fysieke kwetsbaarheid"@nl ;
    rdfs:comment "A weakness in physical security measures, facilities or environment."@en,
        "Een zwakheid in fysieke beveiligingsmaatregelen, faciliteiten of omgeving."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:PhysicalVulnerability,
        risk:Vulnerability ;
    owl:equivalentClass risk:PhysicalVulnerability ;
    owl:sameAs risk:PhysicalVulnerability .

risk:R_001 a owl:Thing,
        risk:InformationSecurityRisk,
        risk:Risk ;
    owl:sameAs risk:R_001 ;
    risk:affects asset:InformationAsset,
        isms:InformationAsset,
        risk:InformationAsset,
        risk:SystemAsset ;
    risk:atManagementTier risk:Tier3_InformationSystem ;
    risk:hasImpact risk:IL_Critical ;
    risk:hasImpactCategory risk:IC_Availability,
        risk:IC_Financial,
        risk:IC_Integrity ;
    risk:hasInherentRiskScore 20 ;
    risk:hasLikelihood risk:LL_High ;
    risk:hasRiskDescription "Medewerkers klikken op kwaadaardige link waardoor ransomware wordt geïnstalleerd op bedrijfssystemen."@nl ;
    risk:hasRiskID "R-001" ;
    risk:hasRiskTitle "Ransomware via phishing e-mail"@nl ;
    risk:hasThreat risk:T_Ransomware ;
    risk:hasVulnerability risk:V_NoAwareness,
        risk:V_UnpatchedSoftware ;
    risk:mitigatedBy bio:ISO27002_6_03,
        bio:ISO27002_8_07,
        bio:ISO27002_8_13,
        ctrl:ISO27002_6_03,
        ctrl:ISO27002_8_07,
        ctrl:ISO27002_8_13 .

