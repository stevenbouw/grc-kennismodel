    bio:hasMaatregel "Door het uitvoeren van een expliciete risicoafweging worden de bedrijfskritische procesonderdelen met hun bijbehorende betrouwbaarheidseisen geïdentificeerd." ;
    bio:implementsControl bio:ISO27002_5_29,
        ctrl:ISO27002_5_29 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_5_31_2 a owl:NamedIndividual,
