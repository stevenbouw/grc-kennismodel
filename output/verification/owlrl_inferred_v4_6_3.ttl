isms:PDCACycle a owl:Class ;
    rdfs:label "PDCA Cycle"@en,
        "PDCA-cyclus"@nl ;
    rdfs:comment "An instance of the Plan-Do-Check-Act improvement cycle as applied to the ISMS."@en,
        "Een instantie van de Plan-Do-Check-Act-verbeteringscyclus zoals toegepast op het ISMS."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:PDCACycle ;
    owl:equivalentClass isms:PDCACycle ;
    owl:sameAs isms:PDCACycle .

isms:TopLevelPolicy a owl:Class ;
    rdfs:label "Top-Level Information Security Policy"@en,
        "Overkoepelend informatiebeveiligingsbeleid"@nl ;
    rdfs:comment "The single top-level IB policy approved by senior management. [ISO 27001:2022 Cl.5.2 / ISO 27002:2022 §5.1]"@en,
        "Het overkoepelende IB-beleid goedgekeurd door het topmanagement. [ISO 27001:2022 Cl.5.2 / ISO 27002:2022 §5.1]"@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ISMSDocument,
        isms:Policy,
        isms:TopLevelPolicy ;
    owl:equivalentClass isms:TopLevelPolicy ;
    owl:sameAs isms:TopLevelPolicy .

risk:EnvironmentalThreatSource a owl:Class ;
    rdfs:label "Environmental Threat Source"@en,
        "Omgevingsdreigingsbron"@nl ;
    rdfs:comment "Threat source arising from natural disasters, infrastructure failures, or other environmental events."@en,
        "Dreigingsbron voortkomend uit natuurrampen, infrastructuurstoringen of andere omgevingsgebeurtenissen."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:EnvironmentalThreatSource,
        risk:ThreatSource ;
    owl:equivalentClass risk:EnvironmentalThreatSource ;
    owl:sameAs risk:EnvironmentalThreatSource .

risk:TechnicalThreatSource a owl:Class ;
    rdfs:label "Technical Threat Source"@en,
        "Technische dreigingsbron"@nl ;
    rdfs:comment "Threat source arising from hardware or software failures, configuration errors or technical vulnerabilities."@en,
        "Dreigingsbron voortkomend uit hardware- of softwarefouten, configuratiefouten of technische kwetsbaarheden."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:TechnicalThreatSource,
        risk:ThreatSource ;
    owl:equivalentClass risk:TechnicalThreatSource ;
    owl:sameAs risk:TechnicalThreatSource .

