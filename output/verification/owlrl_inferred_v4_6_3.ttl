ext:ISO27001_10_2 a owl:NamedIndividual,
        owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:label "Nonconformity and corrective action"@en,
        "Afwijking en corrigerende maatregel"@nl ;
