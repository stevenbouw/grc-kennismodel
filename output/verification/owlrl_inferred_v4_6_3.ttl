    roles:isAccountableFor roles:ACT_LeveranciersBeheer ;
    roles:isConsultedFor roles:ACT_SoAOpstellen ;
    roles:isInformedAbout roles:ACT_BeheersmaatregelImplementatie ;
    roles:isMandatoryUnderDutchLaw false ;
    roles:isResponsibleFor roles:ACT_RestRisicoAanvaarden,
        roles:ACT_RisicoBehandelplanOpstellen,
        roles:ACT_RisicoBeoordelingUitvoeren ;
    roles:mandatedBy fw:BIO_2_0,
        fw:ISO_IEC_27001_2022 ;
    roles:reportsTo roles:R_SecretarisDirecteur .

roles:Responsibility a owl:Class ;
