    bio:implementsControl bio:ISO27002_7_01,
        ctrl:ISO27002_7_01 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_7_05_2 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
