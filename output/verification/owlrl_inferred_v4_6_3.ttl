csf:DE_AE_04_Ex1 a owl:NamedIndividual,
        owl:Thing,
        csf:ImplementationExample,
        ext:FrameworkComponent ;
    rdfs:label "DE.AE-04.Ex1"@en,
        "DE.AE-04.Ex1"@nl ;
    rdfs:comment "Use SIEMs or other tools to estimate impact and scope, and review and refine the estimates"@en ;
