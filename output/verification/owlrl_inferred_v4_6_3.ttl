    bio:bioMaatregelNummer "7.05.2" ;
    bio:hasMaatregel "Bij huisvesting van IT-apparatuur wordt rekening gehouden met de kans op gevolgen van rampen veroorzaakt door de natuur en menselijk handelen." ;
    bio:implementsControl bio:ISO27002_7_05,
        ctrl:ISO27002_7_05 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_07_3 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.07.3"@nl ;
    owl:sameAs bio:BIO2_8_07_3 ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.07.3" ;
    bio:hasMaatregel "De gebruikte antimalwaresoftware en bijbehorende herstelsoftware is actueel en wordt ondersteund door periodieke updates." ;
    bio:implementsControl bio:ISO27002_8_07,
        ctrl:ISO27002_8_07 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.08.1"@nl ;
    owl:sameAs bio:BIO2_8_08_1 ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.1" ;
    bio:hasMaatregel "Als de kans op misbruik en de verwachte schade beide hoog zijn (bijvoorbeeld met de NCSC-Inschalingsmatrix beveiligingsadviezen of leveranciersbeveiligingsadviezen), worden passende mitigerende maatregelen zo snel mogelijk, maar uiterlijk binnen een week getroffen." ;
    bio:implementsControl bio:ISO27002_8_08,
        ctrl:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_2 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.08.2"@nl ;
    owl:sameAs bio:BIO2_8_08_2 ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.2" ;
    bio:hasMaatregel "Op basis van een expliciete risicoafweging wordt bepaald op welke wijze mitigerende maatregelen getroffen worden." ;
    bio:implementsControl bio:ISO27002_8_08,
        ctrl:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_3 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.08.3"@nl ;
    owl:sameAs bio:BIO2_8_08_3 ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.3" ;
    bio:hasMaatregel "In de tussentijd of als installatie binnen een week niet mogelijk is, worden op basis van een expliciete risicoafweging mitigerende maatregelen getroffen." ;
    bio:implementsControl bio:ISO27002_8_08,
        ctrl:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_4 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.08.4"@nl ;
    owl:sameAs bio:BIO2_8_08_4 ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.4" ;
    bio:hasMaatregel "Informatiesystemen worden bij voorkeur jaarlijks gecontroleerd op technische naleving van beveiligingsnormen en risico’s ten aanzien van de feitelijke veiligheid. Dit kan bijvoorbeeld door (geautomatiseerde) kwetsbaarheidsanalyses, penetratietesten of red-teamingstesten." ;
    bio:implementsControl bio:ISO27002_8_08,
        ctrl:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_08_5 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.08.5"@nl ;
    owl:sameAs bio:BIO2_8_08_5 ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.08.5" ;
    bio:hasMaatregel "Internetfacing-systemen hebben een verplichte (bij voorkeur geautomatiseerde) penetratietest bij iedere nieuwe release of major update. Als daar bevindingen met een hoog risico uitkomen, mag het systeem niet in productie." ;
    bio:implementsControl bio:ISO27002_8_08,
        ctrl:ISO27002_8_08 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_21_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.21.1"@nl ;
    owl:sameAs bio:BIO2_8_21_1 ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:Software ;
    bio:bioMaatregelNummer "8.21.1" ;
    bio:hasMaatregel "In koppelpunten met externe of onvertrouwde zones zijn maatregelen getroffen om mogelijke aanvallen die de beschikbaarheid van de informatievoorziening negatief beïnvloeden (bijvoorbeeld DDoS-aanvallen, Distributed Denial of Service attacks) te signaleren en hierop te reageren." ;
    bio:implementsControl bio:ISO27002_8_21,
        ctrl:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_21_2 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.21.2"@nl ;
    owl:sameAs bio:BIO2_8_21_2 ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:Software ;
    bio:bioMaatregelNummer "8.21.2" ;
    bio:hasMaatregel "Het dataverkeer dat de organisatie binnenkomt of uitgaat, wordt bewaakt/geanalyseerd op kwaadaardige elementen middels detectievoorzieningen (zoals beschreven in de richtlijn voor implementatie van detectieoplossingen), zoals het Nationaal Detectie Netwerk (alleen voor rijksoverheidsorganisaties) of GDI, die worden ingezet op basis van een risicoafweging, mede aan de hand van de aard van de te beschermen gegevens en informatiesystemen." ;
    bio:implementsControl bio:ISO27002_8_21,
        ctrl:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_21_4 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.21.4"@nl ;
    owl:sameAs bio:BIO2_8_21_4 ;
    asset:appliesToAssetType asset:CommunicationFacility,
        asset:Software ;
    bio:bioMaatregelNummer "8.21.4" ;
    bio:hasMaatregel "Bij draadloze verbindingen zoals wifi en bij bedrade verbindingen buiten het gecontroleerd gebied wordt gebruik gemaakt van encryptiemiddelen waarvoor het Nationaal Bureau voor Verbindingsbeveiliging (NBV) een positief inzetadvies heeft afgegeven." ;
    bio:implementsControl bio:ISO27002_8_21,
        ctrl:ISO27002_8_21 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 2 .

bio:BIO2_8_27_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.27.1"@nl ;
    owl:sameAs bio:BIO2_8_27_1 ;
    asset:appliesToAssetType asset:InformationSystem,
        asset:Software ;
    bio:bioMaatregelNummer "8.27.1" ;
    bio:hasMaatregel "Zie overheidsmaatregel 8.25.1." ;
    bio:implementsControl bio:ISO27002_8_27,
        ctrl:ISO27002_8_27 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_8_29_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 8.29.1"@nl ;
    owl:sameAs bio:BIO2_8_29_1 ;
    asset:appliesToAssetType asset:Procedure,
        asset:Software ;
    bio:bioMaatregelNummer "8.29.1" ;
    bio:hasMaatregel "Voor acceptatietesten van systemen worden gestructureerde testmethodieken gebruikt. De testen worden bij voorkeur geautomatiseerd uitgevoerd." ;
    bio:implementsControl bio:ISO27002_8_29,
        ctrl:ISO27002_8_29 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

biz:DirectieBeoordeling a owl:Class ;
    rdfs:label "Management Review (Directiebeoordeling)"@en,
        "Directiebeoordeling"@nl ;
    rdfs:comment "The formal management review of the ISMS as required by ISO/IEC 27001:2022 Clause 9.3. Must cover changes in context, risk treatment outcomes, audit results, KPIs and improvement opportunities."@en,
        "De formele directiebeoordeling van het ISMS conform ISO/IEC 27001:2022 Clausule 9.3. Moet betrekking hebben op contextwijzigingen, risicobehandelingsresultaten, auditresultaten, KPI's en verbetermogelijkheden."@nl ;
    rdfs:subClassOf owl:Thing,
        biz:DirectieBeoordeling,
        biz:ManagementReport ;
    owl:equivalentClass biz:DirectieBeoordeling ;
    owl:sameAs biz:DirectieBeoordeling ;
    skos:relatedMatch ext:COSO_ERM_ReviewRevision .

biz:MaturityAssessment a owl:Class ;
    rdfs:label "Maturity Assessment"@en,
        "Volwassenheidsbeoordeling"@nl ;
    rdfs:comment "A formal evaluation of the current maturity level of a GRC domain or control area."@en,
        "Een formele evaluatie van het huidige volwassenheidsniveau van een GRC-domein of beheersgebied."@nl ;
    rdfs:subClassOf owl:Thing,
        biz:MaturityAssessment ;
    owl:equivalentClass biz:MaturityAssessment ;
    owl:sameAs biz:MaturityAssessment .

biz:SO_03 a owl:Thing,
        biz:StrategicObjective ;
    rdfs:label "SO-03: Regulatoire compliance"@nl ;
    owl:sameAs biz:SO_03 ;
    biz:objectiveDescription "Aantoonbaar voldoen aan alle wettelijke en regulatoire verplichtingen (NIS2/CBW, BIO 2.0, VIR/VIRBI)."@nl ;
    biz:objectiveID "SO-03" .

biz:SO_04 a owl:Thing,
        biz:StrategicObjective ;
    rdfs:label "SO-04: Vertrouwen en veerkracht"@nl ;
    owl:sameAs biz:SO_04 ;
    biz:objectiveDescription "Vertrouwen van burgers en partners behouden door transparantie en veerkracht."@nl ;
    biz:objectiveID "SO-04" .

compl:AuditProgram a owl:Class ;
    rdfs:label "Audit Programme"@en,
        "Auditprogramma"@nl ;
    rdfs:comment "A set of planned audits covering a defined scope and time period."@en,
        "Een reeks geplande audits die een gedefinieerd toepassingsgebied en tijdsperiode bestrijken."@nl ;
    rdfs:subClassOf owl:Thing,
        compl:AuditProgram ;
    owl:equivalentClass compl:AuditProgram ;
    owl:sameAs compl:AuditProgram .

compl:CD_IncidentManagement a owl:Thing,
        compl:ComplianceDomain ;
    rdfs:label "Incident Management & Reporting"@en,
        "Incidentbeheer en -melding"@nl ;
    owl:sameAs compl:CD_IncidentManagement .

compl:ContractualObligation a owl:Class ;
    rdfs:label "Contractual Obligation"@en,
        "Contractuele verplichting"@nl ;
    rdfs:comment "An obligation arising from a contract, SLA or processor agreement."@en,
        "Een verplichting uit een contract, SLA of verwerkersovereenkomst."@nl ;
    rdfs:subClassOf owl:Thing,
        compl:ContractualObligation,
        compl:Obligation ;
    owl:equivalentClass compl:ContractualObligation ;
    owl:sameAs compl:ContractualObligation .

compl:MajorNonConformity a owl:Class ;
    rdfs:label "Major Nonconformity"@en,
        "Majeure non-conformiteit"@nl ;
    rdfs:comment "A nonconformity that affects the capability of the ISMS to achieve intended results or violates a legal obligation."@en,
        "Een non-conformiteit die het vermogen van het ISMS aantast om beoogde resultaten te bereiken, of die een wettelijke verplichting schendt."@nl ;
    rdfs:subClassOf owl:Thing,
        compl:AuditFinding,
        compl:MajorNonConformity,
        compl:NonConformity ;
    owl:equivalentClass compl:MajorNonConformity ;
    owl:sameAs compl:MajorNonConformity .

compl:MinorNonConformity a owl:Class ;
    rdfs:label "Minor Nonconformity"@en,
        "Mineure non-conformiteit"@nl ;
    rdfs:comment "An isolated failure to meet a requirement, with limited impact on ISMS effectiveness."@en,
        "Een geïsoleerde tekortkoming in het voldoen aan een vereiste, met beperkte impact op de ISMS-effectiviteit."@nl ;
    rdfs:subClassOf owl:Thing,
        compl:AuditFinding,
        compl:MinorNonConformity,
        compl:NonConformity ;
    owl:equivalentClass compl:MinorNonConformity ;
    owl:sameAs compl:MinorNonConformity .

compl:OBL_NIS2_Art20 a owl:Thing,
        compl:LegalObligation,
        compl:Obligation ;
    owl:sameAs compl:OBL_NIS2_Art20 ;
    skos:closeMatch compl:OBL_ISO27001_Cl9_3 ;
    compl:accountableRole roles:R_Bestuur ;
    compl:belongsToDomain compl:CD_GovernanceOversight ;
    compl:hasArticleReference "Art. 20 NIS2 Directive (EU) 2022/2555" ;
    compl:hasDeadline "Continu / Ongoing" ;
    compl:hasObligationID "NIS2-ART20" ;
    compl:hasObligationTitle "Board accountability for cybersecurity"@en,
        "Bestuursverantwoordelijkheid voor cyberbeveiliging"@nl ;
    compl:isMandatory true ;
    compl:responsibleRole roles:R_CISO ;
    compl:sourcedFromFramework fw:NIS2_Directive .

compl:Observation a owl:Class ;
    rdfs:label "Observation / Opportunity for Improvement"@en,
        "Observatie / verbetermogelijkheid"@nl ;
    rdfs:comment "A finding that is not a nonconformity but indicates a potential improvement area."@en,
        "Een bevinding die geen non-conformiteit is maar een potentieel verbeterpunt aangeeft."@nl ;
    rdfs:subClassOf owl:Thing,
        compl:AuditFinding,
        compl:Observation ;
    owl:equivalentClass compl:Observation ;
    owl:sameAs compl:Observation .

compl:PositiveFinding a owl:Class ;
    rdfs:label "Positive Finding"@en,
        "Positieve bevinding"@nl ;
    rdfs:comment "An audit finding confirming that a requirement is effectively met."@en,
        "Een auditbevinding die bevestigt dat een vereiste effectief wordt nageleefd."@nl ;
    rdfs:subClassOf owl:Thing,
        compl:AuditFinding,
        compl:PositiveFinding ;
    owl:equivalentClass compl:PositiveFinding ;
    owl:sameAs compl:PositiveFinding .

compl:RemediationPlan a owl:Class ;
    rdfs:label "Remediation Plan"@en,
        "Verbeterplan"@nl ;
