        fw:GRCFramework,
        fw:InternationalStandard,
        fw:Standard ;
    owl:equivalentClass fw:InternationalStandard ;
    owl:sameAs fw:InternationalStandard .

isms:ApplicabilityDecision a owl:Class ;
    rdfs:label "Applicability Decision"@en,
        "Toepasselijkheidsbeslissing"@nl ;
    rdfs:comment "Whether an Annex A control is included or excluded in the SoA."@en,
        "Of een Bijlage A-beheersmaatregel is opgenomen of uitgesloten in de VvT."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ApplicabilityDecision ;
    owl:equivalentClass isms:ApplicabilityDecision ;
    owl:sameAs isms:ApplicabilityDecision .

isms:ImplementationStatus a owl:Class ;
    rdfs:label "Implementation Status"@en,
        "Implementatiestatus"@nl ;
    rdfs:comment "The current implementation state of a control within the ISMS scope."@en,
        "De huidige implementatiestatus van een beheersmaatregel binnen het ISMS-toepassingsgebied."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ImplementationStatus ;
    owl:equivalentClass isms:ImplementationStatus ;
    owl:sameAs isms:ImplementationStatus .

isms:StatementOfApplicability a owl:Class ;
    rdfs:label "Statement of Applicability (SoA)"@en,
        "Verklaring van Toepasselijkheid (VvT)"@nl ;
    rdfs:comment "A document required by ISO/IEC 27001:2022 Clause 6.1.3(d) listing all Annex A controls with applicability decisions, implementation status and justifications."@en,
        "Een document vereist door ISO/IEC 27001:2022 Clausule 6.1.3(d) met alle Annex A-beheersmaatregelen, toepasselijkheidsbesluiten, implementatiestatus en motivaties."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:StatementOfApplicability ;
    owl:equivalentClass isms:StatementOfApplicability ;
    owl:sameAs isms:StatementOfApplicability .

risk:Impact a owl:Class ;
    rdfs:label "Impact"@en,
        "Impact"@nl ;
    rdfs:comment "The consequence or outcome of a risk materialising: the effect on organisational objectives, operations, assets, individuals or reputation."@en,
        "De consequentie of uitkomst van een zich manifesterende risico: het effect op organisatiedoelstellingen, -activiteiten, -bedrijfsmiddelen, personen of reputatie."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:Impact ;
    owl:equivalentClass risk:Impact ;
    owl:sameAs risk:Impact ;
    skos:altLabel "Consequence"@en .

risk:Likelihood a owl:Class ;
    rdfs:label "Likelihood"@en,
        "Waarschijnlijkheid"@nl ;
    rdfs:comment "The chance of something happening, expressed qualitatively or quantitatively. [ISO 31000:2018]"@en,
        "De kans dat iets gebeurt, uitgedrukt kwalitatief of kwantitatief. [ISO 31000:2018]"@nl ;
    rdfs:subClassOf owl:Thing,
        risk:Likelihood ;
    owl:equivalentClass risk:Likelihood ;
    owl:sameAs risk:Likelihood .

roles:R_BVA a owl:Thing,
        roles:Role,
        roles:SpecialistRole ;
    owl:sameAs roles:R_BVA ;
    skos:exactMatch fw:BesluitBVAStelsel ;
    roles:advisesRole roles:R_CIO ;
    roles:hasRoleDescription "Wettelijk verplichte beveiligingsfunctionaris conform Besluit BVA-stelsel Rijksdienst. Verantwoordelijk voor de beveiliging van gerubriceerde informatie (VIRBI 2025) en de coördinatie van informatiebeveiliging."@nl ;
    roles:hasRoleID "BVA-01" ;
    roles:hasRoleTitle "Security Officer (BVA)"@en,
        "Beveiligingsambtenaar (BVA)"@nl ;
    roles:isConsultedFor roles:ACT_BeveiligingsbeleidVaststellen,
        roles:ACT_BewustwordingTraining,
        roles:ACT_IncidentAfhandelen,
        roles:ACT_RisicoBeoordelingUitvoeren,
        roles:ACT_RisicobeleidVaststellen ;
    roles:isMandatoryUnderDutchLaw true ;
    roles:isResponsibleFor roles:ACT_ComplianceMonitoring,
        roles:ACT_DirectieBeoordelingISMS,
        roles:ACT_NIS2MeldingPlicht ;
    roles:mandatedBy fw:BesluitBVAStelsel,
        fw:VIRBI_2025 ;
    roles:reportsTo roles:R_SecretarisDirecteur .

