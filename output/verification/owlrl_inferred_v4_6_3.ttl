ext:hasAttributionText a owl:DatatypeProperty ;
    rdfs:label "attribution text"@en,
        "attribuering-tekst"@nl ;
    rdfs:comment "Bilingual citation text for publication/dashboard output. Satisfies the source license attribution requirement."@en,
        "Tweetalige citeer-zin voor publicatie/dashboard-uitvoer. Voldoet aan attributievereiste van de bronlicentie."@nl ;
    rdfs:domain owl:Thing,
        ext:SourceAttribution ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ext:hasAttributionText ;
    owl:equivalentProperty ext:hasAttributionText ;
    owl:sameAs ext:hasAttributionText .

ext:hasAuditDomain a owl:ObjectProperty ;
    rdfs:label "has audit domain"@en,
        "heeft auditdomein"@nl ;
    rdfs:comment "Links ENSIA to one of its audit domains."@en,
        "Koppelt ENSIA aan een van de verantwoordingsdomeinen."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        ext:ENSIAAuditDomain ;
    rdfs:subPropertyOf ext:hasAuditDomain ;
    owl:equivalentProperty ext:hasAuditDomain ;
    owl:sameAs ext:hasAuditDomain .

ext:hasCbbArticle a owl:DatatypeProperty ;
    rdfs:label "Cbb article"@en,
        "Cbb-artikel"@nl ;
    rdfs:comment "Reference to the Cbb article providing the operational elaboration for this control. Source: CBW/NIS2 Control Framework (ADR & NOREA, CC-BY 4.0) — sheet 'Mapping BIO2' column G for bio:BIOControl subjects; sheet 'Cbw (NIS2) Control Framework' column D for ctrl:CBWControl subjects. Reference notation is taken verbatim from the source material; one control may carry multiple Cbb article references."@en,
        "Verwijzing naar het Cbb-artikel dat de operationele invulling vormt voor deze control. Bron: CBW/NIS2 Control Framework (ADR & NOREA, CC-BY 4.0) — sheet 'Mapping BIO2' kolom G voor bio:BIOControl-subjects; sheet 'Cbw (NIS2) Control Framework' kolom D voor ctrl:CBWControl-subjects. Ref-notatie wordt letterlijk overgenomen uit het bronmateriaal; één control kan meerdere Cbb-artikel-refs hebben."@nl ;
    rdfs:domain owl:Thing,
        ctrl:Control ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ext:hasCbbArticle ;
    owl:equivalentProperty ext:hasCbbArticle ;
    owl:sameAs ext:hasCbbArticle .

ext:hasCbwArticle a owl:DatatypeProperty ;
    rdfs:label "CBW article"@en,
        "Cbw-artikel"@nl ;
    rdfs:comment "Reference to the CBW article providing the legal basis for this control. Source: CBW/NIS2 Control Framework (ADR & NOREA, CC-BY 4.0) — sheet 'Mapping BIO2' column F for bio:BIOControl subjects; sheet 'Cbw (NIS2) Control Framework' column D for ctrl:CBWControl subjects. Reference notation is taken verbatim from the source material; one control may carry multiple CBW article references."@en,
        "Verwijzing naar het Cbw-artikel dat de juridische basis vormt voor deze control. Bron: CBW/NIS2 Control Framework (ADR & NOREA, CC-BY 4.0) — sheet 'Mapping BIO2' kolom F voor bio:BIOControl-subjects; sheet 'Cbw (NIS2) Control Framework' kolom D voor ctrl:CBWControl-subjects. Ref-notatie wordt letterlijk overgenomen uit het bronmateriaal; één control kan meerdere Cbw-artikel-refs hebben."@nl ;
    rdfs:domain owl:Thing,
        ctrl:Control ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ext:hasCbwArticle ;
    owl:equivalentProperty ext:hasCbwArticle ;
    owl:sameAs ext:hasCbwArticle .

ext:hasControlStatement a owl:DatatypeProperty ;
    rdfs:label "control statement"@en,
        "control-statement"@nl ;
    rdfs:comment "The operational core statement of a control: a concise description of the measure to be taken or outcome to be achieved. Distinguished from rdfs:comment: rdfs:comment may contain explanatory context; ext:hasControlStatement is the normative core requirement. First use in v4.4.0: 26 ctrl:CBWControl individuals (sheet 3 column F Beheersmaatregel text). Generic domain ctrl:Control makes it reusable for future NIST CSF, NIST 800-53, ISO 27002 controls."@en,
        "De operationele kern-statement van een control: een beknopte beschrijving van de te treffen maatregel of het te behalen resultaat. Onderscheid t.o.v. rdfs:comment: rdfs:comment kan toelichtende context bevatten; ext:hasControlStatement is de normatieve kern-eis. Eerste toepassing v4.4.0: 26 ctrl:CBWControl-individuals (sheet 3 kolom F Beheersmaatregel-tekst). Generic domain ctrl:Control maakt herbruikbaar voor toekomstige NIST CSF, NIST 800-53, ISO 27002-controls."@nl ;
    rdfs:domain owl:Thing,
        ctrl:Control ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ext:hasControlStatement ;
    owl:equivalentProperty ext:hasControlStatement ;
    owl:sameAs ext:hasControlStatement .

ext:hasHandreikingBBN a owl:DatatypeProperty ;
    rdfs:label "has Handreiking BBN"@en,
        "heeft Handreiking-BBN"@nl ;
    dcterms:source "Handreiking BIO2-opmaat v2.5" ;
    rdfs:comment "Baseline protection level (BBN) as assigned by the Handreiking BIO2-opmaat v2.5 (transition document). Applies broadly to baseline controls: both bio:BIOControl (ISO 27002-based) and bio:OverheidsMaatregel (government-specific). BBN is NOT defined in BIO 2.0 itself, only in the Handreiking. Valid values: 1 (baseline) and 2 (elevated). BBN 3 does not exist in this source."@en,
        "Basisbeveiligingsniveau (BBN) zoals toegekend door de Handreiking BIO2-opmaat v2.5 (transitiedocument). Van toepassing op baselinecontroles breed: zowel bio:BIOControl (ISO 27002-gebaseerd) als bio:OverheidsMaatregel (overheidsspecifiek). BBN is NIET gedefinieerd in BIO 2.0 zelf, maar uitsluitend in de Handreiking. Geldige waarden: 1 (basis) en 2 (verhoogd). BBN 3 bestaat niet in deze bron."@nl ;
    rdfs:domain owl:Thing,
        ctrl:Control ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ext:hasHandreikingBBN ;
    owl:equivalentProperty ext:hasHandreikingBBN ;
    owl:sameAs ext:hasHandreikingBBN .

ext:hasLicense a owl:DatatypeProperty ;
    rdfs:label "license"@en,
        "licentie"@nl ;
    rdfs:comment "Short license identifier (e.g. \"CC-BY 4.0\", \"public domain\", \"EU law\")."@en,
        "Korte aanduiding van de licentie (bv. \"CC-BY 4.0\", \"publiek domein\", \"EU-recht\")."@nl ;
    rdfs:domain owl:Thing,
        ext:SourceAttribution ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ext:hasLicense ;
    owl:equivalentProperty ext:hasLicense ;
    owl:sameAs ext:hasLicense .

ext:hasLicenseURL a owl:DatatypeProperty ;
    rdfs:label "license URL"@en,
        "licentie-URL"@nl ;
    rdfs:comment "URL to the official license text."@en,
        "URL naar de officiële licentietekst."@nl ;
    rdfs:domain owl:Thing,
        ext:SourceAttribution ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf ext:hasLicenseURL ;
    owl:equivalentProperty ext:hasLicenseURL ;
    owl:sameAs ext:hasLicenseURL .

ext:hasSourcePublicationDate a owl:DatatypeProperty ;
    rdfs:label "source publication date"@en,
        "publicatiedatum bron"@nl ;
    rdfs:comment "Date on which the external source material was officially published."@en,
        "Datum waarop het externe bronmateriaal officieel is gepubliceerd."@nl ;
    rdfs:domain owl:Thing,
        ext:SourceAttribution ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf ext:hasSourcePublicationDate ;
    owl:equivalentProperty ext:hasSourcePublicationDate ;
    owl:sameAs ext:hasSourcePublicationDate .

ext:hasSourceVersion a owl:DatatypeProperty ;
    rdfs:label "source version"@en,
        "versie bron"@nl ;
    rdfs:comment "Version identifier of the external source material (e.g. \"1.0\", \"v2.5\")."@en,
        "Versie-identificatie van het externe bronmateriaal (bv. \"1.0\", \"v2.5\")."@nl ;
    rdfs:domain owl:Thing,
        ext:SourceAttribution ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ext:hasSourceVersion ;
    owl:equivalentProperty ext:hasSourceVersion ;
    owl:sameAs ext:hasSourceVersion .

ext:hasUVInterpretation a owl:DatatypeProperty ;
    rdfs:label "UV interpretation"@en,
        "UV-interpretatie"@nl ;
    rdfs:comment "ADR/NOREA's interpretative elaboration of Commission Implementing Regulation (EU) 2024/2690 at control level, with its own numbering convention (1.1.2, 1.2.3, etc.). Source: CBW/NIS2 Control Framework (ADR & NOREA, version 1.0, 30 September 2025), sheet 'Cbw (NIS2) Control Framework', column H. NOT the verbatim UV text and NOT the ENISA Technical Implementation Guidance — both are separate sources."@en,
        "ADR/NOREA's interpretatieve uitwerking van Uitvoeringsverordening (EU) 2024/2690 op control-niveau, met eigen nummering-conventie (1.1.2, 1.2.3, etc.). Bronmateriaal: CBW/NIS2 Control Framework (ADR & NOREA, versie 1.0, 30 september 2025), sheet 'Cbw (NIS2) Control Framework', kolom H. NIET de letterlijke UV-tekst en NIET de ENISA Technical Implementation Guidance — beide zijn separate bronnen."@nl ;
    rdfs:domain owl:Thing,
        ctrl:Control ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf ext:hasUVInterpretation ;
    owl:equivalentProperty ext:hasUVInterpretation ;
    owl:sameAs ext:hasUVInterpretation .

ext:hasVIRBIDomain a owl:ObjectProperty ;
    rdfs:label "has VIRBI domain"@en,
        "heeft VIRBI-domein"@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        ext:VIRBISecurityDomain ;
    rdfs:subPropertyOf ext:hasVIRBIDomain ;
    owl:equivalentProperty ext:hasVIRBIDomain ;
    owl:sameAs ext:hasVIRBIDomain .

ext:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by"@en,
        "geimplementeerd door"@nl ;
    rdfs:domain owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:range owl:Thing,
        ctrl:Control ;
    rdfs:subPropertyOf ext:implementedBy ;
    owl:equivalentProperty ext:implementedBy ;
    owl:sameAs ext:implementedBy .

ext:isComponentOf a owl:ObjectProperty ;
    rdfs:label "is component of"@en,
        "is component van"@nl ;
    rdfs:comment "Links a framework component to the framework it belongs to. Standard property for component-framework relationships, replacing ad-hoc use of compl:derivedFrom for this purpose."@en,
        "Koppelt een kaderwerkcomponent aan het kaderwerk waartoe het behoort. Standaard-property voor component-framework relaties, vervangt ad-hoc gebruik van compl:derivedFrom voor dit doel."@nl ;
    rdfs:domain owl:Thing,
        ext:FrameworkComponent ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf ext:isComponentOf ;
    owl:equivalentProperty ext:isComponentOf ;
    owl:sameAs ext:isComponentOf .

ext:mappedToISO27002 a owl:ObjectProperty ;
    rdfs:label "mapped to ISO 27002"@en,
        "gekoppeld aan ISO 27002"@nl ;
    rdfs:domain owl:Thing,
        ctrl:Control,
        ext:NISTControl ;
    rdfs:range owl:Thing,
        ctrl:Control ;
    rdfs:subPropertyOf ext:mappedToISO27002 ;
    owl:equivalentProperty ext:mappedToISO27002 ;
    owl:sameAs ext:mappedToISO27002 .

ext:sourceAttribution a owl:ObjectProperty ;
    rdfs:label "source attribution"@en,
        "bron-attribuering"@nl ;
    rdfs:comment "Links an individual to a source attribution record. Domain is owl:Thing intentionally to allow attribution from arbitrary model individuals (controls, government measures, frameworks)."@en,
        "Koppelt een individual aan een bron-attribuering-record. Dom is bewust owl:Thing om koppeling vanaf willekeurige model-individuals (controls, overheidsmaatregelen, frameworks) toe te laten."@nl ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing,
        ext:SourceAttribution ;
    rdfs:subPropertyOf ext:sourceAttribution ;
    owl:equivalentProperty ext:sourceAttribution ;
    owl:sameAs ext:sourceAttribution .

fw:COSO a owl:Thing,
        fw:IssuingBody ;
    rdfs:label "COSO (Committee of Sponsoring Organizations of the Treadway Commission)"@en,
        "COSO (Committee of Sponsoring Organizations of the Treadway Commission)"@nl ;
    rdfs:comment "COSO is a joint initiative of five private-sector organisations dedicated to providing thought leadership through the development of comprehensive frameworks for enterprise risk management, internal control, and fraud deterrence."@en,
        "COSO is een gezamenlijk initiatief van vijf private-sector organisaties gericht op thought leadership door de ontwikkeling van frameworks voor enterprise risk management, interne beheersing en fraudepreventie."@nl ;
    owl:sameAs fw:COSO ;
    foaf:name "COSO" .

fw:DomainBusinessContinuity a owl:Thing,
        fw:FrameworkDomain ;
    rdfs:label "Business Continuity"@en,
        "Bedrijfscontinuïteit"@nl ;
    owl:sameAs fw:DomainBusinessContinuity .

fw:DomainPrivacy a owl:Thing,
        fw:FrameworkDomain ;
    rdfs:label "Privacy"@en,
        "Privacy"@nl ;
    owl:sameAs fw:DomainPrivacy .

fw:TBB_Personen a skos:Concept ;
    rdfs:label "TBB Persons"@en,
        "TBB Personen"@nl ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    owl:sameAs fw:TBB_Personen ;
    skos:definition "Natural persons as a protected interest within the central government."@en,
        "Natuurlijke personen als beschermwaardig belang binnen de Rijksdienst."@nl ;
    skos:exactMatch asset:HumanAsset,
        risk:HumanAsset ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "persons"@en,
        "personen"@nl .

fw:alignsWith a owl:ObjectProperty ;
    rdfs:label "aligns with"@en,
        "sluit aan op"@nl ;
    rdfs:comment "Indicates partial or full alignment between two frameworks."@en,
        "Geeft gedeeltelijke of volledige afstemming tussen twee kaderwerken aan."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf fw:alignsWith ;
    owl:equivalentProperty fw:alignsWith ;
    owl:sameAs fw:alignsWith .

fw:appliesInJurisdiction a owl:ObjectProperty ;
    rdfs:label "applies in jurisdiction"@en,
        "van toepassing in rechtsgebied"@nl ;
    rdfs:comment "Specifies the jurisdiction(s) in which a framework is applicable or binding."@en,
        "Specificeert de rechtsgebieden waarbinnen een kaderwerk van toepassing of bindend is."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:Jurisdiction ;
    rdfs:subPropertyOf fw:appliesInJurisdiction ;
    owl:equivalentProperty fw:appliesInJurisdiction ;
    owl:sameAs fw:appliesInJurisdiction .

fw:dektAf a owl:ObjectProperty ;
    rdfs:label "covers requirements of"@en,
        "dekt eisen af van"@nl ;
    rdfs:comment "Indicates that compliance with the subject framework substantially covers the requirements of the object framework. This is a directional, non-symmetric relationship: A fw:dektAf B means implementing A satisfies (most of) B's requirements."@en,
        "Geeft aan dat naleving van het subject-framework in hoge mate de eisen van het object-framework afdekt. Dit is een directionele, niet-symmetrische relatie: A fw:dektAf B betekent dat implementatie van A (het merendeel van) B's eisen vervult."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf fw:dektAf ;
    owl:equivalentProperty fw:dektAf ;
    owl:sameAs fw:dektAf .

fw:geeftITInvullingAan a owl:ObjectProperty ;
    rdfs:label "provides IT implementation of"@en,
        "geeft IT-invulling aan"@nl ;
    rdfs:comment "Indicates that the subject framework provides the IT-specific implementation or operationalisation of the (broader, enterprise-level) object framework. E.g. COBIT fw:geeftITInvullingAan COSO ICF."@en,
        "Geeft aan dat het subject-framework de IT-specifieke invulling of operationalisatie biedt van het (bredere, enterprise-level) object-framework. Bijv. COBIT fw:geeftITInvullingAan COSO ICF."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf fw:geeftITInvullingAan ;
    owl:equivalentProperty fw:geeftITInvullingAan ;
    owl:sameAs fw:geeftITInvullingAan .

fw:geeftRichtlijnenVoor a owl:ObjectProperty ;
    rdfs:label "provides implementation guidance for"@en,
        "geeft implementatierichtlijnen voor"@nl ;
    rdfs:comment "Indicates that a standard provides implementation guidance for the controls of another standard. Specifically: ISO 27002 provides guidance for the implementation of ISO 27001 Annex A controls."@en,
        "Geeft aan dat een norm implementatierichtlijnen biedt voor de controls uit een andere norm. Specifiek: ISO 27002 geeft richtlijnen voor de implementatie van ISO 27001 Bijlage A controls."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf fw:geeftRichtlijnenVoor ;
    owl:equivalentProperty fw:geeftRichtlijnenVoor ;
    owl:sameAs fw:geeftRichtlijnenVoor .

fw:hasDomain a owl:ObjectProperty ;
    rdfs:label "has domain"@en,
        "heeft domein"@nl ;
    rdfs:comment "Associates a framework with one or more thematic domains."@en,
        "Koppelt een kaderwerk aan een of meer thematische domeinen."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:FrameworkDomain ;
    rdfs:subPropertyOf fw:hasDomain ;
    owl:equivalentProperty fw:hasDomain ;
    owl:sameAs fw:hasDomain .

fw:hasIdentifier a owl:DatatypeProperty ;
    rdfs:label "has identifier"@en,
        "heeft identificatiecode"@nl ;
    rdfs:comment "A short unique identifier for the framework (e.g. 'ISO-27001-2022')."@en,
        "Een korte unieke identificatiecode voor het kaderwerk (bijv. 'ISO-27001-2022')."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf fw:hasIdentifier ;
    owl:equivalentProperty fw:hasIdentifier ;
    owl:sameAs fw:hasIdentifier .

fw:hasPublicationDate a owl:DatatypeProperty ;
    rdfs:label "has publication date"@en,
        "heeft publicatiedatum"@nl ;
    rdfs:comment "The official publication date of the framework or its version."@en,
        "De officiële publicatiedatum van het kaderwerk of zijn versie."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf fw:hasPublicationDate ;
    owl:equivalentProperty fw:hasPublicationDate ;
    owl:sameAs fw:hasPublicationDate .

fw:hasScope a owl:DatatypeProperty ;
    rdfs:label "has scope"@en,
        "heeft toepassingsgebied"@nl ;
    rdfs:comment "A textual description of the scope of the framework."@en,
        "Een tekstuele beschrijving van het toepassingsgebied van het kaderwerk."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf fw:hasScope ;
    owl:equivalentProperty fw:hasScope ;
    owl:sameAs fw:hasScope .

fw:hasVersion a owl:ObjectProperty ;
    rdfs:label "has version"@en,
        "heeft versie"@nl ;
    rdfs:comment "Links a framework to one of its published versions."@en,
        "Koppelt een kaderwerk aan een van zijn gepubliceerde versies."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:FrameworkVersion ;
    rdfs:subPropertyOf fw:hasVersion ;
    owl:equivalentProperty fw:hasVersion ;
    owl:sameAs fw:hasVersion .

fw:hasVersionLabel a owl:DatatypeProperty ;
    rdfs:label "has version label"@en,
        "heeft versielabel"@nl ;
    rdfs:comment "The version string of the framework (e.g. '2022', 'Rev.5', 'v2.0')."@en,
        "De versieaanduiding van het kaderwerk (bijv. '2022', 'Rev.5', 'v2.0')."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf fw:hasVersionLabel ;
    owl:equivalentProperty fw:hasVersionLabel ;
    owl:sameAs fw:hasVersionLabel .

fw:isMandatoryForDutchGovernment a owl:DatatypeProperty ;
    rdfs:label "is mandatory for Dutch government"@en,
        "verplicht voor Nederlandse overheid"@nl ;
    rdfs:comment "Indicates whether compliance with this framework is legally mandatory for Dutch government entities."@en,
        "Geeft aan of naleving van dit kaderwerk wettelijk verplicht is voor Nederlandse overheidsorganisaties."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf fw:isMandatoryForDutchGovernment ;
    owl:equivalentProperty fw:isMandatoryForDutchGovernment ;
    owl:sameAs fw:isMandatoryForDutchGovernment .

fw:isTranspositieVan a owl:ObjectProperty ;
    rdfs:label "is transposition of"@en,
        "is omzetting van"@nl ;
    rdfs:comment "Links a national law to the EU Directive it transposes. Inverse of fw:transposedBy."@en,
        "Koppelt een nationale wet aan de EU-richtlijn die zij omzet. Inverse van fw:transposedBy."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework,
        fw:NationalLaw,
        fw:Regulation ;
    rdfs:range owl:Thing,
        fw:EUDirective,
        fw:GRCFramework,
        fw:Regulation ;
    rdfs:subPropertyOf fw:isTranspositieVan ;
    owl:equivalentProperty fw:isTranspositieVan ;
    owl:inverseOf fw:transposedBy ;
    owl:sameAs fw:isTranspositieVan .

fw:issuedBy a owl:ObjectProperty ;
    rdfs:label "issued by"@en,
        "uitgegeven door"@nl ;
    rdfs:comment "Links a framework to its issuing body."@en,
        "Koppelt een kaderwerk aan de uitgevende instantie."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:IssuingBody ;
    rdfs:subPropertyOf fw:issuedBy ;
    owl:equivalentProperty fw:issuedBy ;
    owl:sameAs fw:issuedBy .

fw:officialURL a owl:DatatypeProperty ;
    rdfs:label "official URL"@en,
        "officiële URL"@nl ;
    rdfs:comment "The official web location where the framework can be accessed."@en,
        "De officiële weblocatie waar het kaderwerk kan worden geraadpleegd."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf fw:officialURL ;
    owl:equivalentProperty fw:officialURL ;
    owl:sameAs fw:officialURL .

fw:relatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related to"@en,
        "gerelateerd aan"@nl ;
    rdfs:comment "A symmetric property linking related frameworks (e.g. ISO 27001 and ISO 27002)."@en,
        "Een symmetrische eigenschap die gerelateerde kaderwerken koppelt (bijv. ISO 27001 en ISO 27002)."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf fw:relatedTo ;
    owl:equivalentProperty fw:relatedTo ;
    owl:sameAs fw:relatedTo .

fw:status a owl:DatatypeProperty ;
    rdfs:label "status"@en,
        "status"@nl ;
    rdfs:comment "The current legal or publication status of a framework (e.g. 'in force', 'in preparation', 'superseded')."@en,
        "De huidige juridische of publicatiestatus van een kaderwerk (bijv. 'van kracht', 'in voorbereiding', 'vervangen')."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf fw:status ;
    owl:equivalentProperty fw:status ;
    owl:sameAs fw:status .

fw:stelVerplicht a owl:ObjectProperty ;
    rdfs:label "mandates"@en,
        "stelt verplicht"@nl ;
    rdfs:comment "Indicates that the subject framework legally mandates the implementation of the object framework. E.g. VIR 2007 mandates BIO 2.0 for the Dutch central government."@en,
        "Geeft aan dat het subject-framework het object-framework wettelijk verplicht stelt. Bijv. VIR 2007 stelt BIO 2.0 verplicht voor de Rijksdienst."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf fw:stelVerplicht ;
    owl:equivalentProperty fw:stelVerplicht ;
    owl:sameAs fw:stelVerplicht .

fw:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en,
        "vervangt"@nl ;
    rdfs:comment "Indicates that this framework version supersedes an earlier version."@en,
        "Geeft aan dat dit kaderwerk een eerdere versie vervangt."@nl ;
    rdfs:domain owl:Thing,
        fw:GRCFramework ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf fw:supersedes ;
    owl:equivalentProperty fw:supersedes ;
    owl:sameAs fw:supersedes .

fw:toetst a owl:ObjectProperty ;
    rdfs:label "audits"@en,
        "toetst"@nl ;
