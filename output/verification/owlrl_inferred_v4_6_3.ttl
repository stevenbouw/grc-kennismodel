risk:IL_Moderate a owl:Thing,
        risk:Impact,
        risk:ImpactLevel,
        risk:Risk ;
    rdfs:label "Moderate (3)"@en,
        "Matig (3)"@nl ;
    rdfs:comment "Significant consequences; notable disruption to services or operations."@en,
        "Aanzienlijke gevolgen; merkbare verstoring van diensten of activiteiten."@nl ;
    owl:sameAs risk:IL_Moderate ;
    risk:hasImpactScore 3 .

risk:IL_Negligible a owl:Thing,
        risk:Impact,
        risk:ImpactLevel,
        risk:Risk ;
    rdfs:label "Negligible (1)"@en,
        "Verwaarloosbaar (1)"@nl ;
    rdfs:comment "Minimal consequence; easily recoverable, no significant disruption."@en,
        "Minimale gevolgen; eenvoudig herstelbaar, geen noemenswaardige verstoring."@nl ;
    owl:sameAs risk:IL_Negligible ;
    risk:hasImpactScore 1 .

risk:LL_Low a owl:Thing,
        risk:Likelihood,
        risk:LikelihoodLevel,
        risk:Risk ;
    rdfs:label "Low (2)"@en,
        "Laag (2)"@nl ;
    rdfs:comment "Event is unlikely to occur (once in 5–10 years)."@en,
        "Gebeurtenis is onwaarschijnlijk (eenmaal in 5–10 jaar)."@nl ;
    owl:sameAs risk:LL_Low ;
    risk:hasLikelihoodScore 2 .

risk:LL_VeryHigh a owl:Thing,
        risk:Likelihood,
        risk:LikelihoodLevel,
        risk:Risk ;
    rdfs:label "Very High (5)"@en,
        "Zeer hoog (5)"@nl ;
    rdfs:comment "Event is almost certain to occur (multiple times per year)."@en,
        "Gebeurtenis treedt bijna zeker op (meerdere keren per jaar)."@nl ;
    owl:sameAs risk:LL_VeryHigh ;
    risk:hasLikelihoodScore 5 .

risk:LL_VeryLow a owl:Thing,
        risk:Likelihood,
        risk:LikelihoodLevel,
        risk:Risk ;
    rdfs:label "Very Low (1)"@en,
        "Zeer laag (1)"@nl ;
    rdfs:comment "Event is very unlikely to occur (< once in 10 years)."@en,
        "Gebeurtenis is zeer onwaarschijnlijk (< eenmaal in 10 jaar)."@nl ;
    owl:sameAs risk:LL_VeryLow ;
    risk:hasLikelihoodScore 1 .

risk:R_004 a owl:Thing,
        risk:InformationSecurityRisk,
        risk:Risk ;
    owl:sameAs risk:R_004 ;
    risk:affects risk:ServiceAsset ;
    risk:atManagementTier risk:Tier3_InformationSystem ;
    risk:hasImpact risk:IL_Significant ;
    risk:hasImpactCategory risk:IC_Availability,
        risk:IC_Operational,
        risk:IC_Reputational ;
    risk:hasInherentRiskScore 12 ;
    risk:hasLikelihood risk:LL_Medium ;
    risk:hasRiskDescription "Een DDoS-aanval maakt een kritieke publiek-toegankelijke dienst onbereikbaar."@nl ;
    risk:hasRiskID "R-004" ;
    risk:hasRiskTitle "Uitval kritieke ICT-dienst door DDoS"@nl ;
    risk:hasThreat risk:T_DDoS ;
    risk:hasVulnerability risk:V_OpenPorts,
        risk:V_SinglePointOfFailure ;
    risk:mitigatedBy bio:ISO27002_8_14,
        bio:ISO27002_8_20,
        bio:ISO27002_8_22,
        ctrl:ISO27002_8_14,
        ctrl:ISO27002_8_20,
        ctrl:ISO27002_8_22 .

risk:TS_HardwareFault a owl:Thing,
        risk:TechnicalThreatSource,
        risk:ThreatSource ;
    rdfs:label "Hardware failure"@en,
        "Hardwarestoring"@nl ;
    owl:sameAs risk:TS_HardwareFault .

risk:TS_PowerFailure a owl:Thing,
        risk:EnvironmentalThreatSource,
        risk:ThreatSource ;
    rdfs:label "Power / utility failure"@en,
        "Stroom- / nutsuitval"@nl ;
    owl:sameAs risk:TS_PowerFailure .

risk:T_ConfigError a owl:Thing,
        risk:Threat ;
    rdfs:label "Configuration error / misconfiguration"@en,
        "Configuratiefout"@nl ;
    owl:sameAs risk:T_ConfigError ;
    risk:originatesFrom risk:TS_Negligent,
        risk:TS_SoftwareFault ;
    risk:threatens risk:SystemAsset .

risk:T_PhysicalIntrusion a owl:Thing,
        risk:Threat ;
    rdfs:label "Physical intrusion"@en,
        "Fysieke inbraak"@nl ;
    owl:sameAs risk:T_PhysicalIntrusion ;
    risk:originatesFrom risk:TS_Cybercriminal ;
    risk:threatens asset:InformationAsset,
        asset:PhysicalAsset,
        isms:InformationAsset,
        risk:InformationAsset,
        risk:PhysicalAsset .

risk:Tier1_Organisation a owl:NamedIndividual,
        owl:Thing,
        risk:RiskManagementTier ;
    rdfs:label "Tier 1 — Organisation"@en,
        "Tier 1 — Organisatie"@nl ;
    rdfs:comment "Addresses risk from an organisational perspective. Provides the context for all risk management activities: risk framing, risk governance, risk appetite, and organisational risk strategy."@en,
        "Adresseert risico vanuit organisatieperspectief. Biedt de context voor alle risicomanagementactiviteiten: risicokader, risicogovernance, risicobereidheid en organisatorische risicostrategie."@nl ;
    owl:sameAs risk:Tier1_Organisation ;
    skos:relatedMatch ext:COSO_ERM_GovernanceCulture,
        ext:COSO_ERM_StrategyObjectiveSetting .

risk:V_InadequateBackup a owl:Thing,
        risk:OrganisationalVulnerability,
        risk:Threat,
        risk:Vulnerability ;
    rdfs:label "Inadequate backup and recovery"@en,
        "Ontoereikende back-up en herstel"@nl ;
    owl:sameAs risk:V_InadequateBackup ;
    risk:exploits risk:T_NaturalHazard,
        risk:T_Ransomware .

risk:V_MissingMFA a owl:Thing,
        risk:TechnicalVulnerability,
        risk:Threat,
        risk:Vulnerability ;
    rdfs:label "Missing multi-factor authentication"@en,
        "Ontbrekende meervoudige authenticatie"@nl ;
    owl:sameAs risk:V_MissingMFA ;
    risk:exploits risk:T_Phishing,
        risk:T_UnauthorisedAccess .

risk:V_NoEncryption a owl:Thing,
        risk:TechnicalVulnerability,
        risk:Threat,
        risk:Vulnerability ;
    rdfs:label "Unencrypted data storage or transfer"@en,
        "Onversleutelde gegevensopslag of -overdracht"@nl ;
    owl:sameAs risk:V_NoEncryption ;
    risk:exploits risk:T_DataLeak .

risk:V_WeakPasswords a owl:Thing,
        risk:TechnicalVulnerability,
        risk:Threat,
        risk:Vulnerability ;
    rdfs:label "Weak authentication / passwords"@en,
        "Zwakke authenticatie / wachtwoorden"@nl ;
    owl:sameAs risk:V_WeakPasswords ;
    risk:exploits risk:T_UnauthorisedAccess .

roles:A_Accountable a owl:Thing,
