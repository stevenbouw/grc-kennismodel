ext:VIRBISecurityDomain a owl:Class ;
    rdfs:label "VIRBI Security Domain"@en,
        "VIRBI-beveiligingsdomein"@nl ;
    rdfs:comment "One of the eight security domains defined in the VIRBI 2025 Bijlage (Annex). Each domain contains minimum security measures per classification level (Dep.V, Stg.C, Stg.G, Stg.ZG)."@en,
        "Een van de acht beveiligingsdomeinen uit de VIRBI 2025 Bijlage. Elk domein bevat minimale beveiligingsmaatregelen per rubriceringsniveau (Dep.V, Stg.C, Stg.G, Stg.ZG)."@nl ;
    rdfs:subClassOf owl:Thing,
        ext:VIRBISecurityDomain ;
    owl:equivalentClass ext:VIRBISecurityDomain ;
    owl:sameAs ext:VIRBISecurityDomain .

fw:DomainInformationSecurity a owl:Thing,
        fw:FrameworkDomain ;
    rdfs:label "Information Security"@en,
        "Informatiebeveiliging"@nl ;
    owl:sameAs fw:DomainInformationSecurity .

fw:FrameworkDomain a owl:Class ;
    rdfs:label "Framework Domain"@en,
        "Kaderwerkdomein"@nl ;
    rdfs:comment "A thematic domain or subject area within a framework (e.g. Access Control, Risk Management)."@en,
        "Een thematisch domein of onderwerp binnen een kaderwerk (bijv. Toegangsbeveiliging, Risicobeheer)."@nl ;
    rdfs:subClassOf owl:Thing,
        fw:FrameworkDomain ;
    owl:equivalentClass fw:FrameworkDomain ;
    owl:sameAs fw:FrameworkDomain .

fw:JurisdictionNL a owl:Thing,
        fw:GRCFramework,
        fw:Jurisdiction ;
    rdfs:label "The Netherlands"@en,
        "Nederland"@nl ;
    owl:sameAs fw:JurisdictionNL ;
    fw:hasIdentifier "NL" .

fw:VIRBI_2025 a owl:Thing,
        compl:Obligation,
        fw:GRCFramework,
        fw:NationalLaw,
        fw:Regulation ;
    rdfs:label "VIRBI 2025 (Voorschrift Informatiebeveiliging Rijksdienst Bijzondere Informatie)"@en,
        "VIRBI 2025 (Voorschrift Informatiebeveiliging Rijksdienst Bijzondere Informatie)"@nl ;
    rdfs:comment "Dutch government regulation for handling classified and sensitive government information."@en,
        "Rijksregeling voor de beveiliging van bijzondere informatie bij de centrale overheid."@nl,
        "VIRBI 2025 bouwt voort op de BIO als basis (Bijlage, uitgangspunt A). Daarbovenop worden aanvullende maatregelen vereist per rubriceringsniveau. Publicatiedatum: 8 september 2025 (Stcrt. 2025, 30222). Gecorrigeerd 2026-03-19."@nl ;
    owl:sameAs fw:VIRBI_2025 ;
    ext:hasVIRBIDomain ext:VIRBI_Dom_Bedrijfsmiddelen,
        ext:VIRBI_Dom_BeheerBijzondereInformatie,
        ext:VIRBI_Dom_Communicatiebeveiliging,
        ext:VIRBI_Dom_FysiekeBeveiliging,
        ext:VIRBI_Dom_ICTBeveiliging,
        ext:VIRBI_Dom_Incidenten,
        ext:VIRBI_Dom_Toegangsbeveiliging,
        ext:VIRBI_Dom_VeiligPersoneel ;
    fw:appliesInJurisdiction fw:JurisdictionNL ;
    fw:hasDomain fw:DomainInformationSecurity ;
    fw:hasIdentifier "VIRBI-2025" ;
    fw:hasVersionLabel "2025" ;
    fw:isMandatoryForDutchGovernment true ;
    fw:issuedBy fw:DutchCentral ;
    fw:relatedTo fw:VIR_2007 ;
    fw:supersedes fw:VIRBI_2013 .

isms:ISMS a owl:Class ;
    rdfs:label "Information Security Management System (ISMS)"@en,
        "Managementsysteem voor informatiebeveiliging (ISMS)"@nl ;
    rdfs:comment "The overall management system, based on a business risk approach, to establish, implement, operate, monitor, review, maintain and improve information security. [ISO/IEC 27001:2022]"@en,
        "Het overkoepelende managementsysteem, gebaseerd op een zakelijke risicoaanpak, om informatiebeveiliging te vestigen, implementeren, exploiteren, monitoren, beoordelen, onderhouden en verbeteren. [ISO/IEC 27001:2022]"@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ISMS ;
    owl:equivalentClass isms:ISMS ;
    owl:sameAs isms:ISMS .

isms:ISMSCapability a owl:Class ;
    rdfs:label "ISMS Clause Capability"@en,
        "ISMS-clausule-capability"@nl ;
    rdfs:comment "An assessable capability for one of the 9 ISMS clauses (ISO 27001 chapters 4-10)."@en,
        "Een evaluatiebare capability voor één van de 9 ISMS-clausules (ISO 27001 hoofdstuk 4-10)."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ISMSCapability,
        isms:MaturityCapability ;
    owl:equivalentClass isms:ISMSCapability ;
    owl:sameAs isms:ISMSCapability .

