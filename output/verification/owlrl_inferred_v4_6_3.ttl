        "Imago en reputatie als beschermwaardig belang binnen de Rijksdienst."@nl ;
    skos:exactMatch asset:IntangibleAsset ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "image"@en,
        "imago"@nl .

fw:TBB_Informatiesystemen a skos:Concept ;
    rdfs:label "TBB Information Systems"@en,
