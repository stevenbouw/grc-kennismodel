bio:BIO2_5_36_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 5.36.1"@nl ;
    owl:sameAs bio:BIO2_5_36_1 ;
    asset:appliesToAssetType asset:Asset,
        risk:Asset ;
    bio:bioMaatregelNummer "5.36.1" ;
    bio:hasMaatregel "In de P&C-cyclus wordt gerapporteerd over informatiebeveiliging, resulterend in een jaarlijks af te geven In Control Verklaring (ICV) over de informatiebeveiliging. Indien voldoende herkenbaar kan de ICV voor informatiebeveiliging onderdeel zijn van de reguliere, generieke verantwoording." ;
    bio:implementsControl bio:ISO27002_5_36,
        ctrl:ISO27002_5_36 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_6_01_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 6.01.1"@nl ;
    owl:sameAs bio:BIO2_6_01_1 ;
    asset:appliesToAssetType asset:HumanAsset,
        risk:HumanAsset ;
    bio:bioMaatregelNummer "6.01.1" ;
    bio:hasMaatregel "Elke organisatie heeft een vastgesteld screeningsbeleid. Bij indiensttreding en bij functiewijziging kan een Verklaring Omtrent het Gedrag (VOG) gevraagd worden." ;
    bio:implementsControl bio:ISO27002_6_01,
        ctrl:ISO27002_6_01 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_6_02_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 6.02.1"@nl ;
    owl:sameAs bio:BIO2_6_02_1 ;
    asset:appliesToAssetType asset:HumanAsset,
        risk:HumanAsset ;
    bio:bioMaatregelNummer "6.02.1" ;
    bio:hasMaatregel "Alle medewerkers (intern en extern) zijn bij hun aanstelling of functiewisseling gewezen op hun verantwoordelijkheden ten aanzien van informatiebeveiliging. De voor hen geldende regelingen en instructies ten aanzien van informatiebeveiliging zijn eenvoudig toegankelijk." ;
    bio:implementsControl bio:ISO27002_6_02,
        ctrl:ISO27002_6_02 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_6_03_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 6.03.1"@nl ;
    owl:sameAs bio:BIO2_6_03_1 ;
    asset:appliesToAssetType asset:HumanAsset,
        risk:HumanAsset ;
    bio:bioMaatregelNummer "6.03.1" ;
    bio:hasMaatregel "Alle medewerkers hebben de verantwoordelijkheid bedrijfsinformatie te beschermen. Iedereen kent de regels en verplichtingen met betrekking tot informatiebeveiliging en daar waar relevant de speciale eisen voor gerubriceerde omgevingen." ;
    bio:implementsControl bio:ISO27002_6_03,
        ctrl:ISO27002_6_03 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_6_03_3 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 6.03.3"@nl ;
    owl:sameAs bio:BIO2_6_03_3 ;
    asset:appliesToAssetType asset:HumanAsset,
        risk:HumanAsset ;
    bio:bioMaatregelNummer "6.03.3" ;
    bio:hasMaatregel "Het management benadrukt bij aanstelling en interne overplaatsing en bijvoorbeeld in werkoverleggen of in personeelsgesprekken bij zijn medewerkers en contractanten het belang van opleiding en training op het gebied van informatiebeveiliging en stimuleert hen actief deze periodiek te volgen." ;
    bio:implementsControl bio:ISO27002_6_03,
        ctrl:ISO27002_6_03 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_7_01_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 7.01.1"@nl ;
    owl:sameAs bio:BIO2_7_01_1 ;
