        csf:ImplementationExample,
        ext:FrameworkComponent ;
    rdfs:label "DE.AE-02.Ex3"@en,
        "DE.AE-02.Ex3"@nl ;
    rdfs:comment "Regularly conduct manual reviews of log events for technologies that cannot be sufficiently monitored through automation"@en ;
    owl:sameAs csf:DE_AE_02_Ex3 ;
    csf:csfIdentifier "DE.AE-02.Ex3" ;
    csf:exemplifies csf:DE_AE_02 ;
    ext:isComponentOf fw:NIST_CSF_2_0 ;
    ext:sourceAttribution ext:Attr_NIST_CSF_2_0_Core_2024 .

csf:DE_AE_02_Ex4 a owl:NamedIndividual,
        owl:Thing,
        csf:ImplementationExample,
        ext:FrameworkComponent ;
    rdfs:label "DE.AE-02.Ex4"@en,
        "DE.AE-02.Ex4"@nl ;
