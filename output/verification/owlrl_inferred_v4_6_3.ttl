    rdfs:range xsd:string ;
    rdfs:subPropertyOf ext:cobitObjectiveID ;
    owl:equivalentProperty ext:cobitObjectiveID ;
    owl:sameAs ext:cobitObjectiveID .

ext:controlFamilyCode a owl:DatatypeProperty ;
    rdfs:label "control family code"@en,
