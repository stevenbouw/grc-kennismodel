fw:TBB_Goederen a skos:Concept ;
    rdfs:label "TBB Tangible Goods"@en,
        "TBB Goederen"@nl ;
    dcterms:source "Besluit BVA-stelsel Rijksdienst 2021 art. 1 lid k" ;
    owl:sameAs fw:TBB_Goederen ;
    skos:definition "Tangible consumable or inventoried goods as a protected interest within the central government."@en,
        "Tastbare verbruiks- of inventarisgoederen als beschermwaardig belang binnen de Rijksdienst."@nl ;
    skos:exactMatch asset:TangibleGoods ;
    skos:inScheme fw:BVATeBeschermenBelangen ;
    skos:prefLabel "tangible goods"@en,
