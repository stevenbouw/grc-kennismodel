fw:EURegulation a owl:Class ;
    rdfs:label "EU Regulation"@en,
        "EU-verordening"@nl ;
    rdfs:comment "An EU regulation directly applicable in all Member States without transposition."@en,
        "Een EU-verordening die rechtstreeks van toepassing is in alle lidstaten zonder omzetting."@nl ;
    rdfs:subClassOf owl:Thing,
        fw:EURegulation,
        fw:GRCFramework,
        fw:Regulation ;
    owl:equivalentClass fw:EURegulation ;
    owl:sameAs fw:EURegulation .

fw:FrameworkVersion a owl:Class ;
    rdfs:label "Framework Version"@en,
        "Kaderwerkversie"@nl ;
    rdfs:comment "A specific published version of a GRC framework (e.g. ISO/IEC 27001:2022)."@en,
        "Een specifieke gepubliceerde versie van een GRC-kaderwerk (bijv. ISO/IEC 27001:2022)."@nl ;
    rdfs:subClassOf owl:Thing,
        fw:FrameworkVersion ;
    owl:equivalentClass fw:FrameworkVersion ;
    owl:sameAs fw:FrameworkVersion .

fw:NIST a owl:Thing,
        fw:IssuingBody ;
    rdfs:label "National Institute of Standards and Technology"@en,
        "Nationaal Instituut voor Normen en Technologie (VS)"@nl ;
    owl:sameAs fw:NIST ;
    foaf:name "NIST" .

isms:ActPhase a owl:Class ;
    rdfs:label "Act Phase"@en,
        "Act-fase"@nl ;
    rdfs:comment "Take corrective actions and continually improve the ISMS. [ISO 27001:2022 Clause 10]"@en,
        "Neem corrigerende maatregelen en verbeter het ISMS continu. [ISO 27001:2022 Clausule 10]"@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ActPhase,
        isms:PDCAPhase ;
    owl:equivalentClass isms:ActPhase ;
    owl:sameAs isms:ActPhase .

isms:CheckPhase a owl:Class ;
    rdfs:label "Check Phase"@en,
        "Check-fase"@nl ;
    rdfs:comment "Monitor, measure, audit and review ISMS performance. [ISO 27001:2022 Clause 9]"@en,
        "Monitor, meet, audit en beoordeel ISMS-prestaties. [ISO 27001:2022 Clausule 9]"@nl ;
    rdfs:subClassOf owl:Thing,
        isms:CheckPhase,
        isms:PDCAPhase ;
    owl:equivalentClass isms:CheckPhase ;
    owl:sameAs isms:CheckPhase .

isms:ControlObjective a owl:Class ;
    rdfs:label "Control Objective"@en,
        "Beheersdoelstelling"@nl ;
    rdfs:comment "A statement of intent describing what is to be achieved by implementing controls in a given area."@en,
        "Een intentieformulering die beschrijft wat beoogd wordt te bereiken door het implementeren van beheersmaatregelen in een bepaald gebied."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ControlObjective ;
    owl:equivalentClass isms:ControlObjective ;
    owl:sameAs isms:ControlObjective .

isms:DoPhase a owl:Class ;
    rdfs:label "Do Phase"@en,
        "Do-fase"@nl ;
    rdfs:comment "Implement and operate controls, processes and procedures. [ISO 27001:2022 Clause 8]"@en,
        "Implementeer en beheer beheersmaatregelen, processen en procedures. [ISO 27001:2022 Clausule 8]"@nl ;
    rdfs:subClassOf owl:Thing,
        isms:DoPhase,
        isms:PDCAPhase ;
    owl:equivalentClass isms:DoPhase ;
    owl:sameAs isms:DoPhase .

isms:Guideline a owl:Class ;
    rdfs:label "Guideline"@en,
        "Richtlijn"@nl ;
    rdfs:comment "Advisory document providing recommended approaches (not mandatory)."@en,
        "Advisdocument met aanbevolen benaderingen (niet verplicht)."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:Guideline,
        isms:ISMSDocument ;
    owl:equivalentClass isms:Guideline ;
    owl:sameAs isms:Guideline .

isms:ISMSContext a owl:Class ;
    rdfs:label "ISMS Context"@en,
        "ISMS-context"@nl ;
    rdfs:comment "Internal and external issues relevant to the ISMS. [ISO/IEC 27001:2022 Clause 4.1]"@en,
        "Interne en externe onderwerpen die relevant zijn voor het ISMS. [ISO/IEC 27001:2022 Clausule 4.1]"@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ISMSContext ;
    owl:equivalentClass isms:ISMSContext ;
    owl:sameAs isms:ISMSContext .

isms:InterestedParty a owl:Class ;
    rdfs:label "Interested Party / Stakeholder"@en,
        "Belanghebbende"@nl ;
    rdfs:comment "Person or organisation that can affect, be affected by, or perceive itself to be affected by the ISMS. [ISO/IEC 27001:2022 Clause 4.2]"@en,
        "Persoon of organisatie die het ISMS kan beïnvloeden, erdoor beïnvloed kan worden, of zichzelf als beïnvloed beschouwt. [ISO/IEC 27001:2022 Clausule 4.2]"@nl ;
    rdfs:subClassOf owl:Thing,
        isms:InterestedParty ;
    owl:equivalentClass isms:InterestedParty ;
    owl:sameAs isms:InterestedParty .

isms:PlanPhase a owl:Class ;
    rdfs:label "Plan Phase"@en,
        "Plan-fase"@nl ;
    rdfs:comment "Establish ISMS scope, policy, risk assessment, risk treatment, SoA. [ISO 27001:2022 Clauses 4–6]"@en,
        "Stel ISMS-toepassingsgebied, beleid, risicobeoordeling, risicobehandeling, VvT vast. [ISO 27001:2022 Clausules 4–6]"@nl ;
    rdfs:subClassOf owl:Thing,
        isms:PDCAPhase,
        isms:PlanPhase ;
    owl:equivalentClass isms:PlanPhase ;
    owl:sameAs isms:PlanPhase .

isms:Record a owl:Class ;
    rdfs:label "Record (Documented Evidence)"@en,
        "Registratie (gedocumenteerd bewijs)"@nl ;
    rdfs:comment "Evidence of activities performed, retained as documented information."@en,
        "Bewijs van uitgevoerde activiteiten, bewaard als gedocumenteerde informatie."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ISMSDocument,
        isms:Record ;
    owl:equivalentClass isms:Record ;
    owl:sameAs isms:Record .

isms:WorkInstruction a owl:Class ;
    rdfs:label "Work Instruction"@en,
        "Werkinstructie"@nl ;
    rdfs:comment "Detailed step-by-step instructions for a specific task."@en,
        "Gedetailleerde stap-voor-stap instructies voor een specifieke taak."@nl ;
    rdfs:subClassOf owl:Thing,
        isms:ISMSDocument,
        isms:WorkInstruction ;
    owl:equivalentClass isms:WorkInstruction ;
    owl:sameAs isms:WorkInstruction .

risk:ComplianceRisk a owl:Class ;
    rdfs:label "Compliance Risk"@en,
        "Compliancerisico"@nl ;
    rdfs:comment "Risk arising from failure to comply with applicable laws, regulations, standards or contractual obligations."@en,
        "Risico voortvloeiend uit niet-naleving van toepasselijke wet- en regelgeving, normen of contractuele verplichtingen."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:ComplianceRisk,
        risk:Risk ;
    owl:equivalentClass risk:ComplianceRisk ;
    owl:sameAs risk:ComplianceRisk .

risk:HumanVulnerability a owl:Class ;
    rdfs:label "Human Vulnerability"@en,
        "Menselijke kwetsbaarheid"@nl ;
    rdfs:comment "A weakness related to people: lack of awareness, training, skills or susceptibility to social engineering."@en,
        "Een zwakheid gerelateerd aan mensen: gebrek aan bewustzijn, training, vaardigheden of vatbaarheid voor social engineering."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:HumanVulnerability,
        risk:Vulnerability ;
    owl:equivalentClass risk:HumanVulnerability ;
    owl:sameAs risk:HumanVulnerability .

risk:OperationalRisk a owl:Class ;
    rdfs:label "Operational Risk"@en,
        "Operationeel risico"@nl ;
    rdfs:comment "Risk arising from inadequate or failed internal processes, people, systems or from external events."@en,
        "Risico voortvloeiend uit tekortschietende of mislukte interne processen, mensen, systemen of externe gebeurtenissen."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:OperationalRisk,
        risk:Risk ;
    owl:equivalentClass risk:OperationalRisk ;
    owl:sameAs risk:OperationalRisk .

risk:ReportingRisk a owl:Class ;
    rdfs:label "Reporting Risk"@en,
        "Rapportagerisico"@nl ;
    rdfs:comment "Risk related to the reliability and integrity of managerial and financial reporting."@en,
        "Risico met betrekking tot betrouwbaarheid en integriteit van management- en financiële rapportage."@nl ;
    rdfs:isDefinedBy risk: ;
    rdfs:subClassOf owl:Thing,
        risk:ReportingRisk,
        risk:Risk ;
    owl:equivalentClass risk:ReportingRisk ;
    owl:sameAs risk:ReportingRisk ;
    skos:broadMatch ext:COSO_ERM_Performance .

risk:ResidualRisk a owl:Class ;
    rdfs:label "Residual Risk"@en,
        "Restrisico"@nl ;
    rdfs:comment "The risk remaining after risk treatment has been applied."@en,
        "Het risico dat overblijft nadat risicobehandeling is toegepast."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:ResidualRisk,
        risk:Risk ;
    owl:equivalentClass risk:ResidualRisk ;
    owl:sameAs risk:ResidualRisk .

risk:RiskAcceptance a owl:Class ;
    rdfs:label "Risk Acceptance"@en,
        "Risicoaanvaarding"@nl ;
    rdfs:comment "An informed decision to retain a risk without further treatment, within defined risk appetite."@en,
        "Een weloverwogen beslissing om een risico te behouden zonder verdere behandeling, binnen de gedefinieerde risicobereidheid."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskAcceptance,
        risk:RiskTreatment ;
    owl:equivalentClass risk:RiskAcceptance ;
    owl:sameAs risk:RiskAcceptance .

risk:RiskAppetite a owl:Class ;
    rdfs:label "Risk Appetite"@en,
        "Risicobereidheid"@nl ;
    rdfs:comment "The amount and type of risk an organisation is willing to pursue or retain in order to meet its strategic objectives."@en,
        "De hoeveelheid en het type risico dat een organisatie bereid is na te streven of te behouden om haar strategische doelstellingen te bereiken."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskAppetite ;
    owl:equivalentClass risk:RiskAppetite ;
    owl:sameAs risk:RiskAppetite ;
    skos:broadMatch fw:ISO_31000_2018 ;
    skos:relatedMatch ext:COSO_ERM_GovernanceCulture .

risk:RiskAvoidance a owl:Class ;
    rdfs:label "Risk Avoidance"@en,
        "Risicoafwijzing"@nl ;
    rdfs:comment "Decision not to start or continue with an activity that gives rise to a particular risk."@en,
        "Beslissing om een activiteit die aanleiding geeft tot een specifiek risico niet te starten of voort te zetten."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskAvoidance,
        risk:RiskTreatment ;
    owl:equivalentClass risk:RiskAvoidance ;
    owl:sameAs risk:RiskAvoidance .

risk:RiskCriteria a owl:Class ;
    rdfs:label "Risk Criteria"@en,
        "Risicocriteria"@nl ;
    rdfs:comment "Terms of reference against which the significance of a risk is evaluated."@en,
        "Referentiecriteria aan de hand waarvan de betekenis van een risico wordt beoordeeld."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskCriteria ;
    owl:equivalentClass risk:RiskCriteria ;
    owl:sameAs risk:RiskCriteria .

risk:RiskMitigation a owl:Class ;
    rdfs:label "Risk Mitigation"@en,
        "Risicomitigatie"@nl ;
    rdfs:comment "Reducing the likelihood or impact of a risk by implementing controls."@en,
        "Verminderen van de waarschijnlijkheid of impact van een risico door beheersmaatregelen te implementeren."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskMitigation,
        risk:RiskTreatment ;
    owl:equivalentClass risk:RiskMitigation ;
    owl:sameAs risk:RiskMitigation .

risk:RiskOwner a owl:Class ;
    rdfs:label "Risk Owner"@en,
        "Risico-eigenaar"@nl ;
    rdfs:comment "A person or entity with the accountability and authority to manage a risk."@en,
        "Een persoon of entiteit met de verantwoordelijkheid en bevoegdheid om een risico te beheren."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskOwner ;
    owl:equivalentClass risk:RiskOwner ;
    owl:sameAs risk:RiskOwner .

risk:RiskRegister a owl:Class ;
    rdfs:label "Risk Register"@en,
        "Risicoregister"@nl ;
    rdfs:comment "A documented record of identified risks, their assessment results, treatment decisions and residual risk."@en,
        "Een gedocumenteerd overzicht van geïdentificeerde risico's, beoordelingsresultaten, behandelbeslissingen en restrisico."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskRegister ;
    owl:equivalentClass risk:RiskRegister ;
    owl:sameAs risk:RiskRegister ;
    skos:relatedMatch ext:COSO_ERM_ReviewRevision .

risk:RiskScenario a owl:Class ;
    rdfs:label "Risk Scenario"@en,
        "Risicoscenario"@nl ;
    rdfs:comment "A described sequence of events that may result in the materialisation of a risk, including the threat, the exploited vulnerability and the impact on one or more assets."@en,
        "Een beschreven reeks gebeurtenissen die kan resulteren in het optreden van een risico, inclusief de dreiging, de benutte kwetsbaarheid en de impact op een of meer bedrijfsmiddelen."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskScenario ;
    owl:equivalentClass risk:RiskScenario ;
    owl:sameAs risk:RiskScenario .

risk:RiskTransfer a owl:Class ;
    rdfs:label "Risk Transfer / Sharing"@en,
        "Risico-overdracht / -deling"@nl ;
    rdfs:comment "Sharing the risk with another party, e.g. through insurance, contracts or outsourcing."@en,
        "Het risico delen met een andere partij, bijv. via verzekering, contracten of uitbesteding."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:RiskTransfer,
        risk:RiskTreatment ;
    owl:equivalentClass risk:RiskTransfer ;
    owl:sameAs risk:RiskTransfer .

risk:StrategicRisk a owl:Class ;
    rdfs:label "Strategic Risk"@en,
        "Strategisch risico"@nl ;
    rdfs:comment "Risk that affects the long-term objectives or strategic direction of the organisation."@en,
        "Risico dat de langetermijndoelstellingen of strategische richting van de organisatie beïnvloedt."@nl ;
    rdfs:subClassOf owl:Thing,
        risk:Risk,
        risk:StrategicRisk ;
    owl:equivalentClass risk:StrategicRisk ;
    owl:sameAs risk:StrategicRisk .

roles:ACT_BewustwordingTraining a owl:Thing,
        roles:GRCActivity ;
    owl:sameAs roles:ACT_BewustwordingTraining ;
    roles:hasActivityID "ACT-15" ;
    roles:hasActivityTitle "Conduct security awareness and training"@en,
        "Beveiligingsbewustwording en training uitvoeren"@nl .

roles:ACT_IncidentMelden a owl:Thing,
        roles:GRCActivity ;
    owl:sameAs roles:ACT_IncidentMelden ;
    roles:hasActivityID "ACT-09" ;
    roles:hasActivityTitle "Report information security incident"@en,
        "Informatiebeveiligingsincident melden"@nl .

roles:ACT_RestRisicoAanvaarden a owl:Thing,
        roles:GRCActivity ;
    owl:sameAs roles:ACT_RestRisicoAanvaarden ;
    roles:hasActivityID "ACT-04" ;
    roles:hasActivityTitle "Formally accept residual risk"@en,
        "Restrisico formeel aanvaarden"@nl .

roles:BVC a owl:Class,
        owl:Thing,
        roles:Role ;
    rdfs:label "Security Coordinator (BVC)"@en,
        "Beveiligingscoördinator (BVC)"@nl ;
    rdfs:comment "The Security Coordinator (BVC) is the designated officer for information security at the level of a service unit. Legal basis: Besluit BVA-stelsel Rijksdienst 2021, art. 6. Functional reporting line to the BVA; hierarchical reporting line to the service unit. BVC is a different role from the CISO (CIO-stelsel, organisation level)."@en,
        "De Beveiligingscoördinator (BVC) is de aangewezen functionaris voor informatiebeveiliging op het niveau van een dienstonderdeel. Grondslag: Besluit BVA-stelsel Rijksdienst 2021, art. 6. Functionele rapportagelijn naar de BVA; hiërarchische rapportagelijn naar dienstonderdeel. BVC is een andere rol dan de CISO (CIO-stelsel, organisatieniveau)."@nl ;
    rdfs:subClassOf owl:Thing,
        roles:BVC,
        roles:Role,
        roles:SpecialistRole ;
    owl:disjointWith roles:ManagementRole ;
    owl:equivalentClass roles:BVC ;
    owl:sameAs roles:BVC ;
    skos:note "BVC = BVA-stelsel (dienstonderdeel) | CISO = CIO-stelsel (organisatie)"@nl ;
    roles:mandatedBy fw:BesluitBVAStelsel .

roles:ExternalParty a owl:Class ;
    rdfs:label "External Party"@en,
        "Externe partij"@nl ;
    rdfs:comment "A supplier, contractor, regulatory body or other party outside the organisation."@en,
        "Een leverancier, aannemer, toezichthouder of andere partij buiten de organisatie."@nl ;
    rdfs:subClassOf owl:Thing,
        roles:Actor,
        roles:ExternalParty ;
    owl:equivalentClass roles:ExternalParty ;
    owl:sameAs roles:ExternalParty .

roles:OrganisationalUnit a owl:Class ;
    rdfs:label "Organisational Unit"@en,
        "Organisatorische eenheid"@nl ;
    rdfs:comment "A department, team, directorate or other formal organisational grouping."@en,
        "Een afdeling, team, directoraat of andere formele organisatorische groepering."@nl ;
    rdfs:subClassOf owl:Thing,
        roles:Actor,
        roles:OrganisationalUnit ;
    owl:equivalentClass roles:OrganisationalUnit ;
    owl:sameAs roles:OrganisationalUnit .

roles:Person a owl:Class ;
    rdfs:label "Person"@en,
        "Persoon"@nl ;
    rdfs:comment "An individual human actor within or associated with the organisation."@en,
        "Een individuele menselijke actor binnen of geassocieerd met de organisatie."@nl ;
    rdfs:subClassOf owl:Thing,
        roles:Actor,
        roles:Person ;
    owl:equivalentClass roles:Person ;
    owl:sameAs roles:Person .

