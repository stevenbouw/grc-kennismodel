fw:BesluitBVAStelsel a owl:Thing,
        compl:Obligation,
        fw:GRCFramework,
        fw:NationalLaw,
        fw:Regulation ;
    rdfs:label "Besluit BVA-stelsel Rijksdienst"@en,
        "Besluit BVA-stelsel Rijksdienst"@nl ;
    rdfs:comment "Dutch government decree establishing the Security Officer (Beveiligingsambtenaar) governance structure."@en,
        "Rijksbesluit waarmee de beveiligingsambtenaar (BVA) governance structuur is ingesteld."@nl ;
    owl:sameAs fw:BesluitBVAStelsel ;
    skos:relatedMatch ext:COBIT_EDM01 ;
