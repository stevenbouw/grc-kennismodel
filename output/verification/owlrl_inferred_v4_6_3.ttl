compl:REQ_NIS2_Art23_1 a owl:NamedIndividual,
        owl:Thing,
        compl:ComplianceRequirement,
        compl:Obligation,
        ext:NIS2Requirement ;
    rdfs:label "Requirement: NIS2 Art. 23 — early warning within 24 hours"@en,
        "Requirement: NIS2 art. 23 — vroege waarschuwing binnen 24 uur"@nl ;
    owl:sameAs compl:REQ_NIS2_Art23_1 ;
    compl:derivedFrom compl:OBL_NIS2_Art23 ;
    compl:hasDeadline "24 uur" ;
    compl:hasStatus compl:CS_NotAssessed ;
    compl:requirementID "NIS2-ART23-R1" ;
    compl:requirementText "Submit an early warning to the competent authority or CSIRT without undue delay and in any event within 24 hours of becoming aware of a significant incident."@en,
        "Dien een vroege waarschuwing in bij de bevoegde autoriteit of CSIRT zonder onnodige vertraging en in ieder geval binnen 24 uur na het bewust worden van een significant incident."@nl .

