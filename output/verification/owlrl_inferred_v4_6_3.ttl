ext:COBITObjective a owl:Class ;
    rdfs:label "COBIT 2019 Governance/Management Objective"@en,
        "COBIT 2019 Governance/Beheersdoelstelling"@nl ;
    rdfs:comment "One of the 40 COBIT 2019 governance or management objectives (ISACA). Corrected from v3: no longer rdfs:subClassOf fw:GRCFramework (a COBIT objective is not a framework)."@en,
        "Één van de 40 COBIT 2019 governance- of beheersdoelstellingen (ISACA). Gecorrigeerd t.o.v. v3: niet langer rdfs:subClassOf fw:GRCFramework (een COBIT-doelstelling is geen kaderwerk)."@nl ;
    rdfs:subClassOf owl:Thing,
        ext:COBITObjective,
        ext:FrameworkComponent ;
    owl:equivalentClass ext:COBITObjective ;
    owl:sameAs ext:COBITObjective .

ext:ISO27001_5_2 a owl:NamedIndividual,
        owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:label "Policy"@en,
        "Beleid"@nl ;
    owl:sameAs ext:ISO27001_5_2 ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "Het topmanagement stelt een informatiebeveiligingsbeleid vast dat past bij het doel van de organisatie en IB-doelstellingen bevat of een kader biedt voor het vaststellen daarvan."@nl ;
    ext:alignsWithHSClause ext:HSClause_5_Leadership ;
    ext:clauseNumber "5.2" .

ext:NIST_IR_8 a owl:NamedIndividual,
        owl:Thing,
        ctrl:Control,
        ext:NISTControl ;
    rdfs:label "IR-8"@en ;
    owl:sameAs ext:NIST_IR_8 ;
    ctrl:definedInFramework fw:NIST_SP_800_53_R5 ;
    ctrl:hasControlDomain ext:NIST_CF_IR ;
    ctrl:hasControlID "IR-8" ;
    ext:mappedToISO27002 bio:ISO27002_5_24,
        bio:ISO27002_5_25,
        bio:ISO27002_5_26,
        ctrl:ISO27002_5_24,
        ctrl:ISO27002_5_25,
        ctrl:ISO27002_5_26 .

ext:SourceAttribution a owl:Class ;
    rdfs:label "source attribution"@en,
        "bron-attribuering"@nl ;
    rdfs:comment "A source attribution record capturing the licence, origin and version of external source material. Linked to a using individual via ext:sourceAttribution to express CC-BY attribution and similar obligations structurally. First mandatory use in v4.4.0: ENISA Technical Implementation Guidance (CC-BY 4.0) via Route 5."@en,
        "Een bron-attribuering-record dat de licentie, herkomst en versie van extern bronmateriaal vastlegt. Wordt aan een gebruikend individual gekoppeld via ext:sourceAttribution om CC-BY-attribuering en vergelijkbare verplichtingen structureel uit te drukken. Eerste verplichte toepassing v4.4.0: ENISA Technical Implementation Guidance (CC-BY 4.0) via Route 5."@nl ;
    rdfs:subClassOf owl:Thing,
        ext:SourceAttribution ;
    owl:equivalentClass ext:SourceAttribution ;
    owl:sameAs ext:SourceAttribution .

fw:DORA_Regulation a owl:Thing,
        compl:Obligation,
        fw:EURegulation,
        fw:GRCFramework,
        fw:Regulation ;
    rdfs:label "DORA Regulation (EU) 2022/2554"@en,
        "DORA-verordening (EU) 2022/2554"@nl ;
    rdfs:comment "Digital Operational Resilience Act – requirements for ICT risk management in the financial sector."@en,
        "Digital Operational Resilience Act – eisen voor ICT-risicobeheer in de financiële sector."@nl ;
    owl:sameAs fw:DORA_Regulation ;
    fw:appliesInJurisdiction fw:JurisdictionEU ;
    fw:hasDomain fw:DomainICTServiceManagement,
        fw:DomainRiskManagement ;
    fw:hasIdentifier "EU-2022-2554" ;
    fw:hasPublicationDate "2022-12-27"^^xsd:date ;
    fw:hasVersionLabel "2022/2554" ;
    fw:isMandatoryForDutchGovernment false ;
    fw:issuedBy fw:EuropeanCommission ;
    fw:officialURL "https://eur-lex.europa.eu/legal-content/NL/TXT/?uri=CELEX:32022R2554"^^xsd:anyURI .

"""Secretaris/Algemeen directeur
Proceseigenaar""" a xsd:string ;
    owl:sameAs """Secretaris/Algemeen directeur
Proceseigenaar""" .

bio:ISO27002_5_12 a owl:NamedIndividual,
        owl:Thing,
        bio:BIOControl,
        ctrl:Control,
        ctrl:ISO27002Control ;
    rdfs:label "Classification of information"@en,
        "Classificeren van informatie"@nl ;
    rdfs:comment "Informatie behoort te worden geclassificeerd volgens de informatiebeveiligingsbehoeften van de organisatie, op basis van de eisen voor vertrouwelijkheid, integriteit, beschikbaarheid en relevante eisen van belanghebbenden."@nl ;
    owl:sameAs bio:ISO27002_5_12,
        ctrl:ISO27002_5_12 ;
    skos:broadMatch compl:NIS2_Art21_i ;
    asset:appliesToAssetType asset:InformationAsset,
        isms:InformationAsset,
        risk:InformationAsset ;
    bio:bioControlNummer "5.12" ;
    bio:correspondsToISO bio:ISO27002_5_12,
        ctrl:ISO27002_5_12 ;
    bio:hasControlType "Organisatorisch" ;
    bio:hasIBEigenschap """#Vertrouwelijkheid
#Integriteit
#Beschikbaarheid""" ;
    bio:hasOverheidsMaatregel bio:BIO2_5_12_1 ;
    bio:hasVerantwoordelijke "Proceseigenaar" ;
    ctrl:belongsToFramework fw:ISO_IEC_27002_2022 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ctrl:hasControlID "5.12" ;
    ctrl:hasControlTitle "Classificeren van informatie"@nl ;
    ctrl:hasControlType ctrl:Preventief ;
    ctrl:hasCybersecurityConcept ctrl:Identificeren ;
    ctrl:hasOperationalCapability ctrl:OC_Informatiebescherming ;
    ctrl:hasSecurityDomain ctrl:SD_Bescherming,
        ctrl:SD_Verdediging ;
    ctrl:hasSecurityProperty ctrl:Beschikbaarheid,
        ctrl:Integriteit,
        ctrl:Vertrouwelijkheid ;
    ctrl:hasTheme ctrl:Organisatorisch ;
    ctrl:isApplicableInBIO true ;
    ext:hasHandreikingBBN 1 .

