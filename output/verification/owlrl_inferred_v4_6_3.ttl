csf:CSFTier a owl:Class ;
    rdfs:label "CSF Tier"@en,
        "CSF Tier"@nl ;
    rdfs:comment "NIST Cybersecurity Framework 2.0 Tier (4 levels: Partial, Risk Informed, Repeatable, Adaptive). Characterizes organizational profile. Name explicit 'CSFTier' to prevent naming collision with risk:RiskManagementTier (NIST SP 800-39 organisational tiers, 3 levels)."@en,
        "NIST Cybersecurity Framework 2.0 Tier (4 levels: Partial, Risk Informed, Repeatable, Adaptive). Karakteriseert organizational profile. Naam expliciet 'CSFTier' om naamcollision met risk:RiskManagementTier (NIST SP 800-39 organisational tiers, 3 levels) te voorkomen."@nl ;
    rdfs:subClassOf owl:Thing,
        csf:CSFTier,
        ext:FrameworkComponent ;
    owl:equivalentClass csf:CSFTier ;
    owl:sameAs csf:CSFTier .

