        owl:Thing,
        csf:ImplementationExample,
        ext:FrameworkComponent ;
    rdfs:label "RS.MA-03.Ex3"@en,
        "RS.MA-03.Ex3"@nl ;
    rdfs:comment "Select incident response strategies for active incidents by balancing the need to quickly recover from an incident with the need to observe the attacker or conduct a more thorough investigation"@en ;
    owl:sameAs csf:RS_MA_03_Ex3 ;
    csf:csfIdentifier "RS.MA-03.Ex3" ;
    csf:exemplifies csf:RS_MA_03 ;
