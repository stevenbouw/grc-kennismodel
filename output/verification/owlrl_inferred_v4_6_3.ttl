roles:isInformedAbout a owl:ObjectProperty ;
    rdfs:label "is informed about (I)"@en,
        "wordt geïnformeerd over (I)"@nl ;
    rdfs:comment "RACI-I: The role receives information after decisions are made; one-way."@en,
        "RACI-I: De rol ontvangt informatie na besluitvorming; één richting."@nl ;
    rdfs:domain owl:Thing,
        roles:Role ;
    rdfs:range owl:Thing,
        roles:GRCActivity ;
    rdfs:subPropertyOf roles:isInformedAbout ;
    owl:equivalentProperty roles:isInformedAbout ;
    owl:sameAs roles:isInformedAbout .

roles:isMandatoryUnderDutchLaw a owl:DatatypeProperty ;
    rdfs:label "is mandatory under Dutch law"@en,
        "verplicht op basis van Nederlandse wetgeving"@nl ;
    rdfs:domain owl:Thing,
        roles:Role ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf roles:isMandatoryUnderDutchLaw ;
    owl:equivalentProperty roles:isMandatoryUnderDutchLaw ;
    owl:sameAs roles:isMandatoryUnderDutchLaw .

roles:isProcessOwnerOf a owl:ObjectProperty ;
    rdfs:label "is process owner of"@en,
        "is proceseigenaar van"@nl ;
    rdfs:domain owl:Thing,
        roles:Role ;
    rdfs:range owl:Thing,
        roles:GRCActivity ;
    rdfs:subPropertyOf roles:isProcessOwnerOf ;
    owl:equivalentProperty roles:isProcessOwnerOf ;
    owl:sameAs roles:isProcessOwnerOf .

roles:isResponsibleFor a owl:ObjectProperty ;
    rdfs:label "is responsible for (R)"@en,
        "is uitvoerend verantwoordelijk voor (R)"@nl ;
    rdfs:comment "RACI-R: The role performs the activity. Multiple roles can share R."@en,
        "RACI-R: De rol voert de activiteit uit. Meerdere rollen kunnen R delen."@nl ;
    rdfs:domain owl:Thing,
        roles:Role ;
    rdfs:range owl:Thing,
        roles:GRCActivity ;
    rdfs:subPropertyOf roles:isResponsibleFor ;
    owl:equivalentProperty roles:isResponsibleFor ;
    owl:sameAs roles:isResponsibleFor .

roles:isRiskOwnerOf a owl:ObjectProperty ;
    rdfs:label "is risk owner of"@en,
        "is risico-eigenaar van"@nl ;
    rdfs:domain owl:Thing,
        roles:Role ;
    rdfs:range owl:Thing,
        risk:Risk ;
    rdfs:subPropertyOf roles:isRiskOwnerOf ;
    owl:equivalentProperty roles:isRiskOwnerOf ;
    owl:sameAs roles:isRiskOwnerOf .

roles:mandatedBy a owl:ObjectProperty ;
    rdfs:label "mandated by"@en,
        "verplicht gesteld door"@nl ;
    rdfs:comment "The role is formally required by a legal instrument or standard."@en,
        "De rol is formeel vereist door een wettelijk instrument of norm."@nl ;
    rdfs:domain owl:Thing,
        roles:Role ;
    rdfs:range owl:Thing,
        fw:GRCFramework ;
    rdfs:subPropertyOf roles:mandatedBy ;
    owl:equivalentProperty roles:mandatedBy ;
    owl:sameAs roles:mandatedBy .

roles:performsControl a owl:ObjectProperty ;
    rdfs:label "performs control"@en,
        "voert beheersmaatregel uit"@nl ;
    rdfs:domain owl:Thing,
        roles:Role ;
    rdfs:range owl:Thing,
        ctrl:Control ;
    rdfs:subPropertyOf roles:performsControl ;
    owl:equivalentProperty roles:performsControl ;
    owl:sameAs roles:performsControl .

roles:reportsTo a owl:ObjectProperty ;
    rdfs:label "reports to"@en,
        "rapporteert aan"@nl ;
    rdfs:comment "Hierarchical reporting relationship between roles."@en,
        "Hiërarchische rapportagerelatie tussen rollen."@nl ;
    rdfs:domain owl:Thing,
        roles:Role ;
    rdfs:range owl:Thing,
        roles:Role ;
    rdfs:subPropertyOf roles:reportsTo ;
    owl:equivalentProperty roles:reportsTo ;
    owl:sameAs roles:reportsTo .

