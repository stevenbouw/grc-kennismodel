    owl:equivalentClass roles:RACIAssignment ;
    owl:sameAs roles:RACIAssignment .

roles:R_CIO a owl:Thing,
        roles:ManagementRole,
        roles:Role ;
    owl:sameAs roles:R_CIO ;
    skos:exactMatch fw:BesluitCIOStelsel ;
    roles:hasRoleDescription "Verantwoordelijk voor het ICT-beleid en de informatiehuishouding van de organisatie. Formele rol conform Besluit CIO-stelsel Rijksdienst."@nl ;
    roles:hasRoleID "CIO-01" ;
    roles:hasRoleTitle "Chief Information Officer (CIO)"@en,
        "Chief Information Officer (CIO)"@nl ;
    roles:isConsultedFor roles:ACT_DirectieBeoordelingISMS,
        roles:ACT_RisicobeleidVaststellen ;
    roles:isInformedAbout roles:ACT_RisicoBeoordelingUitvoeren ;
    roles:isMandatoryUnderDutchLaw true ;
