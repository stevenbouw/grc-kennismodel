ctrl:OperationalCapability a owl:Class ;
    rdfs:label "Operational Capability"@en,
        "Operationele capaciteit"@nl ;
    rdfs:comment "ISO/IEC 27002:2022 attribute: the operational capability that a control supports (e.g. Governance, Asset Management, Identity and Access Management). 16 values defined."@en,
        "ISO/IEC 27002:2022-attribuut: de operationele capaciteit die een beheersmaatregel ondersteunt (bijv. Governance, Bedrijfsmiddelenbeheer, Identiteits- en toegangsbeheer). 16 waarden gedefinieerd."@nl ;
    rdfs:subClassOf owl:Thing,
        ctrl:OperationalCapability ;
    owl:equivalentClass ctrl:OperationalCapability ;
    owl:sameAs ctrl:OperationalCapability .

ext:BCMRequirement a owl:Class ;
    rdfs:label "BCM Requirement"@en,
        "BCM-eis"@nl ;
    rdfs:subClassOf owl:Thing,
        compl:ComplianceRequirement,
        ext:BCMRequirement ;
    owl:equivalentClass ext:BCMRequirement ;
    owl:sameAs ext:BCMRequirement .

ext:ISO27001_6_1_3 a owl:NamedIndividual,
        owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:label "Information security risk treatment"@en,
        "Behandeling van informatiebeveiligingsrisicos"@nl ;
    rdfs:comment "ISO 27001 cl. 6.1.3 requires the organisation to compare the necessary controls (determined through risk assessment) with the controls in Annex A, to verify that no necessary controls have been overlooked. Annex A contains the same 93 controls as ISO 27002:2022."@en,
        "ISO 27001 cl. 6.1.3 vereist dat de organisatie de noodzakelijke beheersmaatregelen (bepaald via risicobeoordeling) vergelijkt met de beheersmaatregelen in Bijlage A, om te verifiëren dat geen noodzakelijke maatregelen over het hoofd zijn gezien. Bijlage A bevat dezelfde 93 controls als ISO 27002:2022."@nl ;
    owl:sameAs ext:ISO27001_6_1_3 ;
    compl:derivedFrom fw:ISO_IEC_27001_2022 ;
    compl:requirementText "De organisatie definieert en past een risicobehandelingsproces toe, selecteert maatregelen en stelt een Verklaring van Toepasselijkheid op."@nl ;
    ext:alignsWithHSClause ext:HSClause_6_Planning ;
    ext:clauseNumber "6.1.3" ;
    ext:implementedBy bio:ISO27002_5_01,
        bio:ISO27002_5_19,
        ctrl:ISO27002_5_01,
        ctrl:ISO27002_5_19 .

ext:ISO27001_8_3 a owl:NamedIndividual,
        owl:Thing,
        compl:ComplianceRequirement,
        ext:ISMSRequirement ;
    rdfs:label "Information security risk treatment"@en,
        "Behandeling van informatiebeveiligingsrisicos"@nl ;
