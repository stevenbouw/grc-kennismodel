bio:BIO2_5_03_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 5.03.1"@nl ;
    owl:sameAs bio:BIO2_5_03_1 ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem,
        isms:InformationAsset,
        risk:HumanAsset,
        risk:InformationAsset ;
    bio:bioMaatregelNummer "5.03.1" ;
    bio:hasMaatregel "Er zijn maatregelen getroffen die onbedoelde of ongeautoriseerde toegang tot bedrijfsmiddelen waarnemen of voorkomen." ;
    bio:implementsControl bio:ISO27002_5_03,
        ctrl:ISO27002_5_03 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_17_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 5.17.1"@nl ;
    owl:sameAs bio:BIO2_5_17_1 ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem,
        isms:InformationAsset,
        risk:HumanAsset,
        risk:InformationAsset ;
    bio:bioMaatregelNummer "5.17.1" ;
    bio:hasMaatregel """Bij het aanloggen op een vertrouwde zone:
(a) is het gebruik van tweefactor-authenticatie altijd verplicht;
(b) is de minimale wachtwoordlengte 12 posities en wordt het wachtwoord minimaal halfjaarlijks vernieuwd als geen tweefactor-authenticatie mogelijk is (zie ook 8.5.1);
(c) mogen wachtwoorden niet worden hergebruikt;
(d) zijn de tekens van een wachtwoord zo willekeurig mogelijk gekozen dat individuele tekens of combinaties van tekens geen voorspellende waarde hebben voor de rest van het""" ;
    bio:implementsControl bio:ISO27002_5_17,
        ctrl:ISO27002_5_17 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_18_1 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
        ctrl:Control ;
    rdfs:label "BIO2 Maatregel 5.18.1"@nl ;
    owl:sameAs bio:BIO2_5_18_1 ;
    asset:appliesToAssetType asset:HumanAsset,
        asset:InformationAsset,
        asset:InformationSystem,
        isms:InformationAsset,
        risk:HumanAsset,
        risk:InformationAsset ;
    bio:bioMaatregelNummer "5.18.1" ;
    bio:hasMaatregel "Er is uitsluitend toegang verleend tot informatiesystemen na autorisatie door een bevoegde functionaris." ;
    bio:implementsControl bio:ISO27002_5_18,
        ctrl:ISO27002_5_18 ;
    ctrl:definedInFramework fw:BIO_2_0 ;
    ext:hasHandreikingBBN 1 .

bio:BIO2_5_18_2 a owl:NamedIndividual,
        owl:Thing,
        bio:OverheidsMaatregel,
